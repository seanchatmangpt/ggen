{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.dev/receipt/pack/v1",
  "title": "ggen portable receipt envelope (RFC-GPACK-001 §54-56)",
  "$comment": "This schema is the only cross-language bridge for the portable receipt envelope (schema URI https://ggen.dev/receipt/pack/v1, RFC-GPACK-001 §54-56). The Rust BLAKE3 chain receipt (.ggen-v2/receipt.json) and this portable envelope are deliberately NON-equivalent formats (RFC §56) — do not merge. ggen_igniter's priv/schema/receipt.schema.json is a DIFFERENT format entirely; do not merge them. Any change to the Serialize structs in crates/ggen-engine/src/portable_receipt.rs must be mirrored here in the same dependency-closed transition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec",
    "engine",
    "toolchain",
    "environment",
    "subject",
    "dependencies",
    "composition",
    "graph",
    "admission",
    "consequences",
    "work_order",
    "replay",
    "standing"
  ],
  "properties": {
    "schema": {
      "const": "https://ggen.dev/receipt/pack/v1"
    },
    "spec": {
      "type": "string",
      "pattern": "^RFC-GPACK-001-"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "cargo"],
      "properties": {
        "rustc": { "type": "string", "minLength": 1 },
        "cargo": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "family", "variables_count", "variables_sha256"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "variables_count": { "type": "integer", "minimum": 0 },
        "variables_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "version", "pack_digest"],
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "pack_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "const": "UNKNOWN" }
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "digest", "scope"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "scope": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["SEMANTICS", "LAW", "PROJECTION"] }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_packs"],
      "properties": {
        "resolved_packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_digest"],
      "properties": {
        "canonical_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "const": "UNKNOWN" }
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates_attempted", "refusals"],
      "properties": {
        "gates_attempted": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "refusals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "operation", "sha256"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["MANAGED_WRITE", "MANAGED_INJECT"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "work_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "canonical_digest"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "canonical_digest": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "const": "UNKNOWN" }
          ]
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["UNKNOWN", "PASS"] }
      }
    },
    "standing": {
      "type": "string",
      "pattern": "^(ALIVE|PARTIAL_ALIVE|BLOCKED|BUILD_BROKEN|UNSUPPORTED|REFUSED:[A-Z0-9_]+)$"
    }
  }
}
