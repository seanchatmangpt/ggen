# schema/frontmatter-schema.ttl — closed-vocabulary definition of template
# frontmatter (crate::template::Frontmatter).
#
# Meta-ontology of the frontmatter block's own shape, not a domain ontology
# rendered by a template. Single source of truth this crate's
# `deny_unknown_fields` Frontmatter struct must match exactly — enforced by
# tests/frontmatter_schema_match.rs.
#
# PROJ-302 (no-private-abstraction gate) extended to crates/ggen. This is the
# full field set found across sibling implementations (~/ggen's Frontmatter,
# and the kgen/unjucks SHACL prior art) — every field is either implemented
# with real, enforced behavior (see the per-field comments and
# docs/v26.7.4/GGEN_TOML_SCHEMA_MAPPING.md) or, where noted, structurally
# accepted with an explicitly stated behavioral limitation (never silently
# claimed as fully enforced when it is not).

@prefix ggenspec: <https://praxis.dev/ggen/schema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix fm:       <https://praxis.dev/ggen/frontmatter#> .

ggenspec:Frontmatter
    a               ggenspec:Section ;
    rdfs:label      "Frontmatter" ;
    rdfs:comment    "Closed frontmatter key set for a ggen template: Hygen-derived write semantics plus ontology-driven output-phase Tera projection (crate::template::Frontmatter)." ;
    ggenspec:hasField
        ggenspec:Frontmatter-to ,
        ggenspec:Frontmatter-sparql ,
        ggenspec:Frontmatter-for_each ,
        ggenspec:Frontmatter-construct ,
        ggenspec:Frontmatter-inject ,
        ggenspec:Frontmatter-before ,
        ggenspec:Frontmatter-after ,
        ggenspec:Frontmatter-at_line ,
        ggenspec:Frontmatter-skip_if ,
        ggenspec:Frontmatter-unless_exists ,
        ggenspec:Frontmatter-force ,
        ggenspec:Frontmatter-when ,
        ggenspec:Frontmatter-skip_empty ,
        ggenspec:Frontmatter-from ,
        ggenspec:Frontmatter-sh_before ,
        ggenspec:Frontmatter-sh_after ,
        ggenspec:Frontmatter-backup ,
        ggenspec:Frontmatter-shape ,
        ggenspec:Frontmatter-determinism ,
        ggenspec:Frontmatter-freeze_policy ,
        ggenspec:Frontmatter-freeze_slots_dir ,
        ggenspec:Frontmatter-rdf ,
        ggenspec:Frontmatter-rdf_inline ,
        ggenspec:Frontmatter-prefixes ,
        ggenspec:Frontmatter-base .

ggenspec:Frontmatter-to
    a ggenspec:Field ; ggenspec:name "to" ; ggenspec:type xsd:string ;
    ggenspec:required true ;
    rdfs:comment "Output path relative to the project root (Tera-renderable)." .

ggenspec:Frontmatter-sparql
    a ggenspec:Field ; ggenspec:name "sparql" ; ggenspec:type ggenspec:MapOfString ;
    ggenspec:required false ;
    rdfs:comment "Named SPARQL queries available to the template body. Defaults to empty." .

ggenspec:Frontmatter-for_each
    a ggenspec:Field ; ggenspec:name "for_each" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Explicit named sparql result governing projection cardinality. Dynamic to paths fan out per row; static paths aggregate row-rendered bodies. Defaults to absent, preserving historical implicit driver behavior." .

ggenspec:Frontmatter-construct
    a ggenspec:Field ; ggenspec:name "construct" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Optional CONSTRUCT query whose result feeds the template." .

ggenspec:Frontmatter-inject
    a ggenspec:Field ; ggenspec:name "inject" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "Inject into an existing file instead of creating a new one. Defaults to false." .

ggenspec:Frontmatter-before
    a ggenspec:Field ; ggenspec:name "before" ; ggenspec:type ggenspec:MatchDeclaration ;
    ggenspec:required false ;
    rdfs:comment "Inject before a host-content selector. Bare strings preserve contains+line+first; structured declarations support contains|exact|regex, auto|line|file scope, first|last|unique|nth occurrence, one-based index, case sensitivity, and trim. Pattern is Tera-rendered per output." .

ggenspec:Frontmatter-after
    a ggenspec:Field ; ggenspec:name "after" ; ggenspec:type ggenspec:MatchDeclaration ;
    ggenspec:required false ;
    rdfs:comment "Inject after a host-content selector. Same matcher algebra and sane defaults as before." .

ggenspec:Frontmatter-at_line
    a ggenspec:Field ; ggenspec:name "at_line" ; ggenspec:type xsd:nonNegativeInteger ;
    ggenspec:required false ;
    rdfs:comment "Inject at this 1-based line number." .

ggenspec:Frontmatter-skip_if
    a ggenspec:Field ; ggenspec:name "skip_if" ; ggenspec:type ggenspec:MatchDeclaration ;
    ggenspec:required false ;
    rdfs:comment "Skip when a host-content selector matches. Bare strings preserve whole-file substring behavior; structured declarations use the shared matcher algebra with auto resolving to file scope." .

ggenspec:Frontmatter-unless_exists
    a ggenspec:Field ; ggenspec:name "unless_exists" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "Skip the write entirely when the target file already exists. Defaults to false." .

ggenspec:Frontmatter-force
    a ggenspec:Field ; ggenspec:name "force" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "Overwrite an existing, differing file instead of failing closed. Defaults to false." .

ggenspec:Frontmatter-when
    a ggenspec:Field ; ggenspec:name "when" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "SPARQL ASK guard: generate only when the graph satisfies it." .

ggenspec:Frontmatter-skip_empty
    a ggenspec:Field ; ggenspec:name "skip_empty" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "Skip the write when the rendered body is empty. Defaults to false." .

ggenspec:Frontmatter-from
    a ggenspec:Field ; ggenspec:name "from" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Load the Tera body from this path instead (relative to the template file's own directory); frontmatter fields still come from this file. Implemented in sync.rs::parse_template_file." .

ggenspec:Frontmatter-sh_before
    a ggenspec:Field ; ggenspec:name "sh_before" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Shell command Tera-rendered per output and run after all templates render but before this output's write decision, cwd = project root. It still runs when the later write decision skips. Refused if it matches the bounded shell denylist; this is not a sandbox." .

ggenspec:Frontmatter-sh_after
    a ggenspec:Field ; ggenspec:name "sh_after" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Shell command Tera-rendered per output and run after a successful Written/Injected outcome (never after Skipped). Same bounded denylist and cwd as sh_before." .

ggenspec:Frontmatter-backup
    a ggenspec:Field ; ggenspec:name "backup" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "Before overwriting an existing file (force or inject), copy it to <path>.bak first. Defaults to false." .

ggenspec:Frontmatter-shape
    a ggenspec:Field ; ggenspec:name "shape" ; ggenspec:type ggenspec:ListOfString ;
    ggenspec:required false ;
    rdfs:comment "Tera-renderable SHACL shape file paths (relative to the project root) declared as governing each output. LIMITATION: existence-checked only — no SHACL engine runs in this crate yet, so listed shapes are not evaluated against rendered output." .

ggenspec:Frontmatter-determinism
    a ggenspec:Field ; ggenspec:name "determinism" ; ggenspec:type xsd:boolean ;
    ggenspec:required false ;
    rdfs:comment "When true, the sync pipeline renders this template's body twice with identical inputs and refuses if the bytes differ — a real, enforced assertion, not an opaque/unchecked value as in sibling schemas." .

ggenspec:Frontmatter-freeze_policy
    a ggenspec:Field ; ggenspec:name "freeze_policy" ; ggenspec:type ggenspec:FreezePolicy ;
    ggenspec:required false ;
    rdfs:comment "Freeze policy for this output once written (never|always|checksum). Defaults to never (no freeze behavior) when absent." .

ggenspec:Frontmatter-freeze_slots_dir
    a ggenspec:Field ; ggenspec:name "freeze_slots_dir" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "Tera-renderable directory (relative to the project root) storing per-output BLAKE3 checksums for freeze_policy: checksum. Required when that policy is set; ignored otherwise." .

ggenspec:FreezePolicy
    a ggenspec:EnumType ;
    ggenspec:enumValue "never" , "always" , "checksum" ;
    rdfs:comment "never: no freeze behavior (default). always: skip regeneration once the target exists, unconditionally. checksum: skip only when on-disk content no longer matches ggen's last-recorded checksum (human edit detected); otherwise proceed and record the new checksum." .

ggenspec:Frontmatter-rdf
    a ggenspec:Field ; ggenspec:name "rdf" ; ggenspec:type ggenspec:ListOfString ;
    ggenspec:required false ;
    rdfs:comment "RDF/Turtle file paths loaded into a per-template overlay graph, resolved relative to the template file's own directory (never the project root); same traversal-safety check as from:. Accepts a bare string or a YAML sequence. Defaults to empty." .

ggenspec:Frontmatter-rdf_inline
    a ggenspec:Field ; ggenspec:name "rdf_inline" ; ggenspec:type ggenspec:ListOfString ;
    ggenspec:required false ;
    rdfs:comment "Literal inline Turtle text (not file paths), loaded into the same per-template overlay graph as rdf:. Same string-or-sequence acceptance as rdf:. Defaults to empty." .

ggenspec:Frontmatter-prefixes
    a ggenspec:Field ; ggenspec:name "prefixes" ; ggenspec:type ggenspec:MapOfString ;
    ggenspec:required false ;
    rdfs:comment "Extra Turtle @prefix declarations (prefix name -> IRI) prepended before parsing rdf:/rdf_inline: content. Defaults to empty." .

ggenspec:Frontmatter-base
    a ggenspec:Field ; ggenspec:name "base" ; ggenspec:type xsd:string ;
    ggenspec:required false ;
    rdfs:comment "RDF base IRI (@base) prepended before parsing rdf:/rdf_inline: content." .

ggenspec:MapOfString  a ggenspec:MapType ; ggenspec:valueType xsd:string .
ggenspec:ListOfString a ggenspec:ListType ; ggenspec:valueType xsd:string .


ggenspec:MatchDeclaration
    a ggenspec:UnionType ;
    ggenspec:variant xsd:string , ggenspec:MatchRule ;
    rdfs:comment "Either a compatibility bare string or a structured MatchRule." .

ggenspec:MatchRule
    a ggenspec:ObjectType ;
    ggenspec:requiredField "pattern" ;
    ggenspec:optionalField "matcher" , "scope" , "occurrence" , "index" , "case_sensitive" , "trim" ;
    rdfs:comment "Defaults: matcher=contains, scope=auto, occurrence=first, index=1, case_sensitive=true, trim=false." .

ggenspec:MatchKind
    a ggenspec:EnumType ;
    ggenspec:enumValue "contains" , "exact" , "regex" .

ggenspec:MatchScope
    a ggenspec:EnumType ;
    ggenspec:enumValue "auto" , "line" , "file" .

ggenspec:MatchOccurrence
    a ggenspec:EnumType ;
    ggenspec:enumValue "first" , "last" , "unique" , "nth" .


# ---------------------------------------------------------------------------
# CP8 (Gall's-Law checkpoint 8): real SHACL shapes for a slice of frontmatter.
#
# Additive to this file -- the 25 ggenspec:hasField declarations above are
# UNTOUCHED, so tests/frontmatter_schema_match.rs's field-name-equality drift
# gate keeps passing unmodified.
#
# This section targets a SEPARATE class, `fm:Frontmatter` (an actual parsed
# frontmatter *instance*, projected to RDF facts by
# crate::frontmatter_rdf::project_frontmatter), not `ggenspec:Frontmatter`
# (the meta-schema class describing the field set itself, used only by the
# drift gate above). Nothing before this comment is a real, enforced SHACL
# shape -- the pre-CP8 file had zero `sh:` triples; `shape:`-declared
# constraints validate *rendered template output* against user-authored
# shape docs (crate::sync::admit_shape_files), never the frontmatter block
# itself. This is a new, narrower code path: 4 of Frontmatter's 25 fields,
# chosen for having a real, checkable-with-core-SHACL-only constraint
# (no sh:sparql/sh:if -- conditional cross-field constraints, e.g.
# "freeze_slots_dir required when freeze_policy=checksum", are deliberately
# left OUT of this slice; SHACL-SPARQL target/constraint component support in
# the praxis-graphlaw backend has not been proven in this workspace, and 3 of
# the 4 chosen fields already have real, checkable constraints under vanilla
# sh:minCount/sh:minLength/sh:minInclusive/sh:datatype alone):
#
#   - to:               required (sh:minCount 1), non-empty (sh:minLength 1)
#   - at_line:           when present, an integer >= 1 (sh:minInclusive 1) --
#                        catches the otherwise-silent zero/negative 1-based
#                        line number a hand-written or generated frontmatter
#                        block could carry
#   - sh_before:         when present, non-empty (sh:minLength 1) -- an empty
#                        shell command would silently no-op past
#                        shell_safety's denylist check without ever being
#                        flagged
#   - sh_after:          same as sh_before, same reasoning
#
# The other 18 fields (sparql, for_each, construct, inject, before, after,
# skip_if, unless_exists, force, skip_empty, backup, shape,
# determinism, freeze_policy, freeze_slots_dir, rdf, rdf_inline, prefixes)
# are deliberately left unprojected and unshaped in this slice -- see
# crate::frontmatter_rdf's module doc for the exact same list stated next to
# the real projection code, and for why `inject`/`freeze_policy` specifically
# were considered and rejected (no value constraint beyond what Rust's type
# system already enforces).
#
# `when`/`from`/`base` were added in a later pass on the exact same
# criterion as the original 4: each is an `Option<String>` where Rust's type
# system does not forbid an empty-but-present string, so `sh:minLength 1`
# is a real, non-vacuous check (mirrors sh_before/sh_after exactly):
#
#   - when:              SPARQL ASK guard string, non-empty when present
#   - from:               alternate template body source path, non-empty when present
#   - base:               RDF base IRI, non-empty when present

fm:Frontmatter a rdfs:Class ;
    rdfs:comment "One projected frontmatter block instance (crate::frontmatter_rdf::project_frontmatter), distinct from ggenspec:Frontmatter (the meta-schema describing the field set)." .

ggenspec:FrontmatterInstanceShape
    a sh:NodeShape ;
    sh:targetClass fm:Frontmatter ;
    rdfs:comment "CP8 slice: 7 of 25 frontmatter fields, chosen for a real core-SHACL-checkable constraint. See the CP8 comment block above for the full field-selection rationale." ;
    sh:property [
        sh:path fm:to ;
        sh:name "to" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `to` is required and must be a non-empty output path" ;
    ] ;
    sh:property [
        sh:path fm:atLine ;
        sh:name "at_line" ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "frontmatter `at_line`, when present, must be a 1-based line number >= 1" ;
    ] ;
    sh:property [
        sh:path fm:shBefore ;
        sh:name "sh_before" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `sh_before`, when present, must be a non-empty shell command" ;
    ] ;
    sh:property [
        sh:path fm:shAfter ;
        sh:name "sh_after" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `sh_after`, when present, must be a non-empty shell command" ;
    ] ;
    sh:property [
        sh:path fm:when ;
        sh:name "when" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `when`, when present, must be a non-empty SPARQL ASK guard" ;
    ] ;
    sh:property [
        sh:path fm:from ;
        sh:name "from" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `from`, when present, must be a non-empty source path" ;
    ] ;
    sh:property [
        sh:path fm:base ;
        sh:name "base" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "frontmatter `base`, when present, must be a non-empty RDF base IRI" ;
    ] .
