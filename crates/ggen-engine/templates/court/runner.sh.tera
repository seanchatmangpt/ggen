#!/usr/bin/env bash
# SHIM-COURT runner — GENERATED by `ggen court compile` (gate {{ gate_id }}).
# Do not edit: recompile from the vc: catalog instead.
# Protocol: sha256 baseline -> before -> shim -> after -> restore.
# Every step is sha-verified; any mismatch exits 2 (COURT_BLOCKED) BEFORE
# the mutation is allowed to matter. Fail-closed by construction.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
GATE_ID="{{ gate_id }}"
TARGET_FILE="{{ target }}"
EXPECTED_POST_HASH="{{ expected_post_hash }}"
STATUS="{{ status }}"
SHIM_TS="{{ shim_ts }}"
WITNESS_TS="{{ witness_ts }}"
MUTANT_KIND="{{ mutant_kind }}"

sha() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

die_blocked() { echo "COURT_BLOCKED: $*" >&2; exit 2; }

# Guard compiled from the register row: a REFUSED verdict (e.g. a witness
# receipt predating its shim) refuses the flip — exit 1 = VACUOUS GATE, loud.
if [ "$STATUS" = "REFUSED" ]; then
  echo "VACUOUS GATE ({{ code }}): {{ detail }}" >&2
  exit 1
fi
if [ "$STATUS" = "UNKNOWN" ]; then
  echo "SKIP (loud): {{ detail }}" >&2
  exit 3
fi

[ -n "${GATE_CMD:-}" ] || {
  echo "SKIP (loud): GATE_CMD not set — cannot run the court, never a silent pass" >&2
  exit 3
}

TMP="$(mktemp -d)"
RESTORED=0
cleanup() {
  if [ "$RESTORED" = "0" ] && [ -f "$TMP/before-copy" ]; then
    cp "$TMP/before-copy" "$TARGET_FILE"
    R="$(sha "$TARGET_FILE")"
    if [ "$R" != "$BASELINE" ]; then
      echo "COURT_BLOCKED: restore tamper: $R != baseline $BASELINE" >&2
      exit 2
    fi
    echo "restored on exit sha256=$R (byte-exact)"
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT

# Step 1 — baseline: capture the pre-mutation identity.
[ -f "$TARGET_FILE" ] || die_blocked "baseline: target $TARGET_FILE is absent"
cp "$TARGET_FILE" "$TMP/before-copy"
BASELINE="$(sha "$TARGET_FILE")"
echo "step1 baseline sha256=$BASELINE"

# Step 2 — before: prove the gate passes on the clean tree.
if ! $GATE_CMD >"$TMP/gate-before.out" 2>&1; then
  die_blocked "before: gate already refuses the clean tree — court premise broken"
fi
echo "step2 before: gate passes clean"

# Step 3 — shim: apply the mutation, sha-verified.
patch -p1 --silent < "$DIR/shim.patch" || die_blocked "shim: patch did not apply"
SHIMMED="$(sha "$TARGET_FILE")"
[ "$SHIMMED" != "$BASELINE" ] || die_blocked "shim: target digest unchanged — mutation did not land"
if [ -n "$EXPECTED_POST_HASH" ] && [ "$SHIMMED" != "$EXPECTED_POST_HASH" ]; then
  die_blocked "shim: post-shim digest $SHIMMED != expected $EXPECTED_POST_HASH"
fi
echo "step3 shim sha256=$SHIMMED (kind=$MUTANT_KIND)"

# Step 4 — after: the gate MUST refuse the mutant. A gate that passes with
# the mutant present is a vacuous gate (no surviving detection).
if $GATE_CMD >"$TMP/gate-after.out" 2>&1; then
  echo "VACUOUS GATE: gate $GATE_ID passed with mutant applied — no surviving detection" >&2
  exit 1
fi
echo "step4 after: gate refuses mutant (detection witnessed)"

# Step 5 — restore: byte-exact, sha-verified.
cp "$TMP/before-copy" "$TARGET_FILE"
RESTORED_SHA="$(sha "$TARGET_FILE")"
[ "$RESTORED_SHA" = "$BASELINE" ] || die_blocked "restore tamper: $RESTORED_SHA != baseline $BASELINE"
RESTORED=1
echo "step5 restore sha256=$RESTORED_SHA (byte-exact)"
echo "COURT PASS: gate $GATE_ID detected its mutant (witness_ts=$WITNESS_TS >= shim_ts=$SHIM_TS)"
