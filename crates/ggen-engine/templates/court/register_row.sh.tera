# COURT REGISTER ROW — GENERATED by `ggen court compile` (gate {{ gate_id }}).
# Sourceable shell row; the KD-COVERS flip guard is compiled in, never
# data-dependent: witness_ts >= shim_ts is enforced structurally below.
COURT_GATE_ID="{{ gate_id }}"
COURT_TARGET="{{ target }}"
COURT_SHIM_TS="{{ shim_ts }}"
COURT_WITNESS_TS="{{ witness_ts }}"
COURT_STATUS="{{ status }}"
COURT_VERDICT_CODE="{{ code }}"

court_register_guard() {
  case "$COURT_STATUS" in
    REFUSED)
      echo "VACUOUS GATE ($COURT_VERDICT_CODE): flip refused" >&2
      return 1
      ;;
    UNKNOWN)
      echo "SKIP (loud): flip unverifiable ($COURT_VERDICT_CODE)" >&2
      return 3
      ;;
  esac
  if [ "${COURT_WITNESS_TS:-0}" -lt "${COURT_SHIM_TS:-0}" ]; then
    echo "VACUOUS GATE (WITNESS_STALE): witness predates shim" >&2
    return 1
  fi
  return 0
}
