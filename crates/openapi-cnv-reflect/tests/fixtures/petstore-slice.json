{
  "openapi": "3.0.3",
  "info": {
    "title": "Petstore Slice",
    "version": "1.2.3"
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["pets"],
        "summary": "List pets, optionally filtered by tag.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return.",
            "schema": { "type": "integer" }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Filter by pet tag.",
            "schema": { "type": "string" }
          }
        ]
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPetById",
        "tags": ["pets"],
        "summary": "Get one pet by its ID.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "The pet's identifier.",
            "schema": { "type": "string" }
          }
        ]
      }
    },
    "/store/inventory": {
      "get": {
        "operationId": "getInventory",
        "tags": ["store"],
        "summary": "Return pet inventory counts by status.",
        "parameters": []
      }
    },
    "/store/order/{orderId}": {
      "get": {
        "operationId": "getOrderById",
        "tags": ["store"],
        "summary": "Find purchase order by ID.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "ID of the order to fetch.",
            "schema": { "type": "integer" }
          }
        ]
      }
    },
    "/store/order": {
      "post": {
        "operationId": "placeOrder",
        "tags": ["store"],
        "summary": "Place an order (not a GET -- must be skipped, not reflected).",
        "parameters": []
      }
    }
  }
}
