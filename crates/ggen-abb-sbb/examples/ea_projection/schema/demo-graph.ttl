# Demo EA graph individual set -- Turtle transcription of the checked-in kernel
# fixture crates/ggen-abb-sbb/fixtures/marketplace-ea-graph.json (WO-04
# deliverable 3). Authoring surface for the Turtle -> ggen.ea.graph.v1
# projection: authoring happens here, in the geag: vocabulary defined by
# ontologies/shapes/ea-graph.shacl.ttl; ea.graph.json is GENERATED, never
# hand-edited.
#
# Byte-law: every literal below is the exact value the golden JSON carries
# (ids, digests, artifact templates, ports). The projected output must be
# byte-identical to the fixture.
@prefix geag: <https://ggen.dev/ns/ea-graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---- Strategy --------------------------------------------------------------
<https://ggen.dev/ns/ea-graph#node-strategy> a geag:Strategy ;
    geag:id "strategy:real-time-ops" ;
    geag:title "Real-time operations" .

# ---- Capability ------------------------------------------------------------
<https://ggen.dev/ns/ea-graph#node-cap-1> a geag:Capability ;
    geag:id "cap:event-ingest" ;
    geag:strategy "strategy:real-time-ops" .

# ---- Abb -------------------------------------------------------------------
<https://ggen.dev/ns/ea-graph#node-abb-1> a geag:Abb ;
    geag:id "abb:event-ingest" ;
    geag:capability "cap:event-ingest" ;
    geag:contract "contract:ingest" .

# ---- ArchitectureContract --------------------------------------------------
<https://ggen.dev/ns/ea-graph#node-contract-1> a geag:ArchitectureContract ;
    geag:id "contract:ingest" ;
    geag:abb "abb:event-ingest" ;
    geag:version "1.0.0" ;
    geag:max_artifacts 3 ;
    geag:authority_ceiling "CONSTRUCT" ;
    geag:required_ports "port:events-in" ,
        "port:receipts-out" .

