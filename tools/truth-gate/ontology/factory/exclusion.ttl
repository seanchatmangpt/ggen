@prefix tg: <https://ggen.dev/truth-gate#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:exclusionPolicy a tg:AdmissionPolicy ;
  rdfs:label "exclusion admission policy" ;
  tg:domain "exclusion" ;
  tg:defaultDecision tg:Refuse ;
  tg:requires tg:exclusionIdentity, tg:exclusionBoundary, tg:exclusionReceipt .

tg:exclusionIdentity a tg:Requirement ;
  tg:key "exclusion:identity" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:exclusionBoundary a tg:Requirement ;
  tg:key "exclusion:boundary" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:exclusionReceipt a tg:Requirement ;
  tg:key "exclusion:receipt" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:exclusionDecision a tg:DecisionShape ;
  tg:records tg:ExactSubject, tg:ObservationEpoch, tg:MissingRequirement ;
  tg:replayable true ;
  tg:closedWorld true .

tg:exclusionProjection a tg:GeneratedProjection ;
  tg:source tg:exclusionPolicy ;
  tg:target "src/factory/exclusion.rs" ;
  tg:manualEditAllowed false .
