@prefix tg: <https://ggen.dev/truth-gate#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:falsifierPolicy a tg:AdmissionPolicy ;
  rdfs:label "falsifier admission policy" ;
  tg:domain "falsifier" ;
  tg:defaultDecision tg:Refuse ;
  tg:requires tg:falsifierIdentity, tg:falsifierBoundary, tg:falsifierReceipt .

tg:falsifierIdentity a tg:Requirement ;
  tg:key "falsifier:identity" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:falsifierBoundary a tg:Requirement ;
  tg:key "falsifier:boundary" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:falsifierReceipt a tg:Requirement ;
  tg:key "falsifier:receipt" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:falsifierDecision a tg:DecisionShape ;
  tg:records tg:ExactSubject, tg:ObservationEpoch, tg:MissingRequirement ;
  tg:replayable true ;
  tg:closedWorld true .

tg:falsifierProjection a tg:GeneratedProjection ;
  tg:source tg:falsifierPolicy ;
  tg:target "src/factory/falsifier.rs" ;
  tg:manualEditAllowed false .
