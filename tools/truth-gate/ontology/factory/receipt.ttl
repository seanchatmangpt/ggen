@prefix tg: <https://ggen.dev/truth-gate#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:receiptPolicy a tg:AdmissionPolicy ;
  rdfs:label "receipt admission policy" ;
  tg:domain "receipt" ;
  tg:defaultDecision tg:Refuse ;
  tg:requires tg:receiptIdentity, tg:receiptBoundary, tg:receiptReceipt .

tg:receiptIdentity a tg:Requirement ;
  tg:key "receipt:identity" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:receiptBoundary a tg:Requirement ;
  tg:key "receipt:boundary" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:receiptReceipt a tg:Requirement ;
  tg:key "receipt:receipt" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:receiptDecision a tg:DecisionShape ;
  tg:records tg:ExactSubject, tg:ObservationEpoch, tg:MissingRequirement ;
  tg:replayable true ;
  tg:closedWorld true .

tg:receiptProjection a tg:GeneratedProjection ;
  tg:source tg:receiptPolicy ;
  tg:target "src/factory/receipt.rs" ;
  tg:manualEditAllowed false .
