@prefix tg: <https://ggen.dev/truth-gate#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:replayPolicy a tg:AdmissionPolicy ;
  rdfs:label "replay admission policy" ;
  tg:domain "replay" ;
  tg:defaultDecision tg:Refuse ;
  tg:requires tg:replayIdentity, tg:replayBoundary, tg:replayReceipt .

tg:replayIdentity a tg:Requirement ;
  tg:key "replay:identity" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:replayBoundary a tg:Requirement ;
  tg:key "replay:boundary" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:replayReceipt a tg:Requirement ;
  tg:key "replay:receipt" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:replayDecision a tg:DecisionShape ;
  tg:records tg:ExactSubject, tg:ObservationEpoch, tg:MissingRequirement ;
  tg:replayable true ;
  tg:closedWorld true .

tg:replayProjection a tg:GeneratedProjection ;
  tg:source tg:replayPolicy ;
  tg:target "src/factory/replay.rs" ;
  tg:manualEditAllowed false .
