@prefix tg: <https://ggen.dev/truth-gate#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tg:constructPolicy a tg:AdmissionPolicy ;
  rdfs:label "construct admission policy" ;
  tg:domain "construct" ;
  tg:defaultDecision tg:Refuse ;
  tg:requires tg:constructIdentity, tg:constructBoundary, tg:constructReceipt .

tg:constructIdentity a tg:Requirement ;
  tg:key "construct:identity" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:constructBoundary a tg:Requirement ;
  tg:key "construct:boundary" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:constructReceipt a tg:Requirement ;
  tg:key "construct:receipt" ;
  tg:subjectBinding tg:ExactSubject ;
  tg:onMissing tg:Refuse .

tg:constructDecision a tg:DecisionShape ;
  tg:records tg:ExactSubject, tg:ObservationEpoch, tg:MissingRequirement ;
  tg:replayable true ;
  tg:closedWorld true .

tg:constructProjection a tg:GeneratedProjection ;
  tg:source tg:constructPolicy ;
  tg:target "src/factory/construct.rs" ;
  tg:manualEditAllowed false .
