set shell := ["bash", "-euo", "pipefail", "-c"]

root := "../.."
manifest := root / "docs/v26.8.1/manifest.toml"

observe:
    cargo run --manifest-path tools/v26.8.1/Cargo.toml -- --root {{root}} --observe-only

verify:
    cargo run --manifest-path tools/v26.8.1/Cargo.toml -- --root {{root}}

fmt:
    cargo fmt --manifest-path tools/v26.8.1/Cargo.toml -- --check

check:
    cargo check --manifest-path tools/v26.8.1/Cargo.toml

clippy:
    cargo clippy --manifest-path tools/v26.8.1/Cargo.toml --all-targets -- -D warnings

crown: fmt check clippy observe
    test -s {{root}}/.ggen/v26.8.1/verifier-report.json
    test -s {{root}}/.ggen/v26.8.1/receipt.json

release:
    cargo run --manifest-path tools/v26.8.1/Cargo.toml -- --root {{root}}

clean:
    rm -rf {{root}}/.ggen/v26.8.1 tools/v26.8.1/target
