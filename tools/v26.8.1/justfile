set shell := ["bash", "-euo", "pipefail", "-c"]

root := "../.."

observe:
    cargo run --manifest-path Cargo.toml --bin ggen-v26-8-1-verifier -- --root {{root}} --observe-only

verify:
    cargo run --manifest-path Cargo.toml --bin ggen-v26-8-1-verifier -- --root {{root}}

step-two:
    python3 step_two.py --root {{root}}

fmt:
    cargo fmt --manifest-path Cargo.toml -- --check

check:
    cargo check --manifest-path Cargo.toml

clippy:
    cargo clippy --manifest-path Cargo.toml --all-targets -- -D warnings

crown: fmt check clippy observe
    test -s {{root}}/.ggen/v26.8.1/verifier-report.json
    test -s {{root}}/.ggen/v26.8.1/receipt.json

release:
    cargo run --manifest-path Cargo.toml --bin ggen-v26-8-1-verifier -- --root {{root}}

clean:
    rm -rf {{root}}/.ggen/v26.8.1 target
