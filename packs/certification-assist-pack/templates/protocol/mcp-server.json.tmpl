{
  "name": "certification-assist",
  "version": "26.7.30",
  "protocolVersion": "2025-11-25",
  "taskAugmentation": false,
  "instructions": "Expose capability standing as resources and bounded tools. Never directly promote standing.",
  "resources": [
{% set first_resource = true %}{% for row in results %}{% if row["kind"] == "resource" %}{% if not first_resource %},{% endif %}
    {
      "name": "{{ row["name"] }}",
      "uri": "{{ row["uri"] }}",
      "description": "{{ row["description"] }}",
      "mimeType": "application/json"
    }{% set_global first_resource = false %}{% endif %}{% endfor %}
  ],
  "tools": [
{% set first_tool = true %}{% for row in results %}{% if row["kind"] == "tool" %}{% if not first_tool %},{% endif %}
    {
      "name": "{{ row["name"] }}",
      "description": "{{ row["description"] }}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }{% set_global first_tool = false %}{% endif %}{% endfor %}
  ]
}
