#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CONSUMER="$ROOT/consumer/certification-assist"
REPORT="$ROOT/VERIFIER_REPORT.json"
MCP_SMOKE="$ROOT/MCP_SMOKE.jsonl"

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/../../target}"

# Generated sources are formatted only in the ephemeral consumer. Authored repository files remain read-only.
cargo fmt --manifest-path "$CONSUMER/Cargo.toml"
cargo test --manifest-path "$CONSUMER/Cargo.toml"
(
  cd "$ROOT"
  cargo run --manifest-path "$CONSUMER/Cargo.toml" --bin verify
)

cargo run --quiet --manifest-path "$CONSUMER/Cargo.toml" --bin mcp_server >"$MCP_SMOKE" <<'JSON'
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"crown","version":"26.7.30"}}}
{"jsonrpc":"2.0","id":2,"method":"resources/list","params":{}}
{"jsonrpc":"2.0","id":3,"method":"tools/list","params":{}}
{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"propose-promotion","arguments":{}}}
JSON

python3 - "$CONSUMER" "$REPORT" "$MCP_SMOKE" <<'PY'
import json
import pathlib
import sys

consumer = pathlib.Path(sys.argv[1])
report_path = pathlib.Path(sys.argv[2])
mcp_smoke_path = pathlib.Path(sys.argv[3])

mcp = json.loads((consumer / "protocol/mcp-server.json").read_text())
assert mcp["protocolVersion"] == "2025-11-25"
assert mcp["taskAugmentation"] is False
assert len(mcp["resources"]) == 3
assert len(mcp["tools"]) == 5
assert sum(1 for tool in mcp["tools"] if tool["requiresApproval"]) == 1
assert not any("task" in tool["name"] for tool in mcp["tools"])

mcp_responses = [json.loads(line) for line in mcp_smoke_path.read_text().splitlines() if line]
assert len(mcp_responses) == 4
assert mcp_responses[0]["result"]["protocolVersion"] == "2025-11-25"
assert len(mcp_responses[1]["result"]["resources"]) == 3
assert len(mcp_responses[2]["result"]["tools"]) == 5
assert mcp_responses[3]["result"]["isError"] is True
assert "REFUSED" in mcp_responses[3]["result"]["content"][0]["text"]

a2a = json.loads((consumer / "protocol/a2a-agent-card.json").read_text())
assert "protocolVersion" not in a2a
assert "preferredTransport" not in a2a
assert "url" not in a2a
assert len(a2a["supportedInterfaces"]) == 1
assert a2a["supportedInterfaces"][0]["protocolBinding"] == "JSONRPC"
assert a2a["supportedInterfaces"][0]["protocolVersion"] == "1.0"
assert len(a2a["skills"]) == 6

self_play = json.loads((consumer / "protocol/a2a-self-play-task.json").read_text())
assert self_play["id"] == "self-play-architecture-narration-v26-7-30"
assert self_play["status"]["state"] == "TASK_STATE_COMPLETED"
assert len(self_play["history"]) == 3
assert len(self_play["artifacts"]) == 1
assert self_play["artifacts"][0]["parts"][0].keys() >= {"data", "mediaType"}
assert self_play["artifacts"][0]["parts"][0]["data"]["standingPromoted"] is False
assert all(message["role"] in {"ROLE_USER", "ROLE_AGENT"} for message in self_play["history"])
assert all(len(part.keys() & {"text", "raw", "url", "data"}) == 1 for message in self_play["history"] for part in message["parts"])

speedrun = json.loads((consumer / "automation/SPEEDRUN_PLAN.json").read_text())
assert speedrun["policy"]["dependencyClosureRequired"] is True
assert speedrun["policy"]["directActuation"] is False
assert len(speedrun["objectives"]) == 8
assert all(item["priority"] > 0 for item in speedrun["objectives"])

release = json.loads((consumer / "RELEASE_STANDING.json").read_text())
assert release["standing"] == "UNKNOWN"
assert release["externalCredentialsObserved"] is False
assert release["learningEfficacyObserved"] is False

report = json.loads(report_path.read_text())
assert report["standing"] == "ALIVE"
assert report["capabilities"] == 12
assert report["proof_surfaces"] == 36
assert report["objectives"] == 8
assert report["triple_darkness_gaps"] >= 1
PY

printf 'CertificationAssist crown: ALIVE / 12 capabilities / 36 proof surfaces\n'
