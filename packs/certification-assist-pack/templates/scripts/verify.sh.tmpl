#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CONSUMER="$ROOT/consumer/certification-assist"
REPORT="$ROOT/VERIFIER_REPORT.json"

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/../../target}"

cargo fmt --manifest-path "$CONSUMER/Cargo.toml" -- --check
cargo test --manifest-path "$CONSUMER/Cargo.toml"
(
  cd "$ROOT"
  cargo run --manifest-path "$CONSUMER/Cargo.toml" --bin verify
)

python3 - "$CONSUMER" "$REPORT" <<'PY'
import json
import pathlib
import sys

consumer = pathlib.Path(sys.argv[1])
report_path = pathlib.Path(sys.argv[2])

mcp = json.loads((consumer / "protocol/mcp-server.json").read_text())
assert mcp["protocolVersion"] == "2025-11-25"
assert mcp["taskAugmentation"] is False
assert len(mcp["resources"]) == 3
assert len(mcp["tools"]) == 5
assert sum(1 for tool in mcp["tools"] if tool["requiresApproval"]) == 1
assert not any("task" in tool["name"] for tool in mcp["tools"])

a2a = json.loads((consumer / "protocol/a2a-agent-card.json").read_text())
assert a2a["protocolVersion"] == "1.0.0"
assert a2a["preferredTransport"] == "JSONRPC"
assert len(a2a["skills"]) == 6

speedrun = json.loads((consumer / "automation/SPEEDRUN_PLAN.json").read_text())
assert speedrun["policy"]["dependencyClosureRequired"] is True
assert speedrun["policy"]["directActuation"] is False
assert len(speedrun["objectives"]) == 8
assert all(item["priority"] > 0 for item in speedrun["objectives"])

report = json.loads(report_path.read_text())
assert report["standing"] == "ALIVE"
assert report["capabilities"] == 12
assert report["proof_surfaces"] == 36
assert report["objectives"] == 8
assert report["triple_darkness_gaps"] >= 1
PY

printf 'CertificationAssist crown: ALIVE / 12 capabilities / 36 proof surfaces\n'
