#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct AutonomicLearningReport {
    pub monitored_objectives: usize,
    pub analyzed_gaps: usize,
    pub intents: Vec<PracticeIntent>,
    pub planning_converged: bool,
    pub standing_promoted: bool,
}

pub fn autonomic_learning_plan() -> Result<AutonomicLearningReport, AssistError> {
    if AUTONOMIC_CONFIG.max_cycles == 0
        || AUTONOMIC_CONFIG.max_cycles > 8
        || AUTONOMIC_CONFIG.direct_actuation
        || !AUTONOMIC_CONFIG.promotion_requires_evidence
    {
        return Err(AssistError::InvalidAutonomicPolicy);
    }
    let plan = speedrun_plan()?;
    let intents = plan
        .iter()
        .take(AUTONOMIC_CONFIG.max_cycles)
        .enumerate()
        .map(|(index, item)| PracticeIntent {
            cycle: index + 1,
            objective_slug: item.objective_slug.clone(),
            probe: match index % 6 {
                0 => ProbeKind::Recall,
                1 => ProbeKind::Explanation,
                2 => ProbeKind::Whiteboard,
                3 => ProbeKind::Lab,
                4 => ProbeKind::Failure,
                _ => ProbeKind::Transfer,
            },
            actuation_performed: false,
            promotion_performed: false,
        })
        .collect::<Vec<_>>();
    Ok(AutonomicLearningReport {
        monitored_objectives: OBJECTIVES.len(),
        analyzed_gaps: plan.len(),
        planning_converged: intents.len() == plan.len().min(AUTONOMIC_CONFIG.max_cycles),
        intents,
        standing_promoted: false,
    })
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct EvidenceArtifact {
    pub evidence_id: String,
    pub objective_slug: String,
    pub dimension: String,
    pub payload_digest: [u8; 32],
    pub evidence_digest: [u8; 32],
}

impl EvidenceArtifact {
    pub fn issue(evidence_id: &str, objective_slug: &str, dimension: &str, payload: &[u8]) -> Self {
        let payload_digest: [u8; 32] = blake3::hash(payload).into();
        let evidence_digest = evidence_digest(evidence_id, objective_slug, dimension, &payload_digest);
        Self {
            evidence_id: evidence_id.to_string(),
            objective_slug: objective_slug.to_string(),
            dimension: dimension.to_string(),
            payload_digest,
            evidence_digest,
        }
    }

    pub fn verify(&self) -> Result<(), AssistError> {
        let expected = evidence_digest(
            &self.evidence_id,
            &self.objective_slug,
            &self.dimension,
            &self.payload_digest,
        );
        if self.evidence_digest != expected {
            return Err(AssistError::EvidenceMismatch);
        }
        Ok(())
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct StandingReceipt {
    pub objective_slug: String,
    pub from: StandingLevel,
    pub to: StandingLevel,
    pub evidence_digest: [u8; 32],
    pub predecessor: Option<[u8; 32]>,
    pub receipt_digest: [u8; 32],
}

impl StandingReceipt {
    fn issue(
        objective_slug: &str,
        from: StandingLevel,
        to: StandingLevel,
        evidence_digest: [u8; 32],
        predecessor: Option<[u8; 32]>,
    ) -> Self {
        let receipt_digest = standing_receipt_digest(
            objective_slug,
            from,
            to,
            &evidence_digest,
            predecessor.as_ref(),
        );
        Self {
            objective_slug: objective_slug.to_string(),
            from,
            to,
            evidence_digest,
            predecessor,
            receipt_digest,
        }
    }

    pub fn verify(&self) -> Result<(), AssistError> {
        let expected = standing_receipt_digest(
            &self.objective_slug,
            self.from,
            self.to,
            &self.evidence_digest,
            self.predecessor.as_ref(),
        );
        if self.receipt_digest != expected {
            return Err(AssistError::ReceiptMismatch);
        }
        Ok(())
    }
}

pub struct StandingLedger {
    current: BTreeMap<&'static str, StandingLevel>,
    receipts: Vec<StandingReceipt>,
}

impl StandingLedger {
    pub fn new() -> Result<Self, AssistError> {
        validate_objectives()?;
        let current = OBJECTIVES
            .iter()
            .map(|item| Ok((item.slug, item.current_level()?)))
            .collect::<Result<BTreeMap<_, _>, AssistError>>()?;
        Ok(Self {
            current,
            receipts: Vec::new(),
        })
    }

    pub fn standing(&self, slug: &str) -> Result<StandingLevel, AssistError> {
        self.current
            .get(slug)
            .copied()
            .ok_or_else(|| AssistError::UnknownObjective(slug.to_string()))
    }

    pub fn promote(
        &mut self,
        slug: &'static str,
        to: StandingLevel,
        evidence: Option<&EvidenceArtifact>,
    ) -> Result<StandingReceipt, AssistError> {
        let from = self.standing(slug)?;
        let evidence = evidence.ok_or_else(|| AssistError::MissingEvidence(slug.to_string()))?;
        evidence.verify()?;
        if evidence.objective_slug != slug {
            return Err(AssistError::EvidenceMismatch);
        }
        if from.next() != Some(to) {
            return Err(AssistError::InvalidTransition { from, to });
        }
        let predecessor = self.receipts.last().map(|receipt| receipt.receipt_digest);
        let receipt = StandingReceipt::issue(slug, from, to, evidence.evidence_digest, predecessor);
        receipt.verify()?;
        self.current.insert(slug, to);
        self.receipts.push(receipt.clone());
        Ok(receipt)
    }
}

#[derive(Default)]
pub struct StandingReplayVerifier {
    seen: HashSet<[u8; 32]>,
    predecessor: Option<[u8; 32]>,
}

impl StandingReplayVerifier {
    pub fn replay(&mut self, receipt: &StandingReceipt) -> Result<(), AssistError> {
        receipt.verify()?;
        if self.seen.contains(&receipt.receipt_digest) {
            return Err(AssistError::DuplicateReplay);
        }
        if receipt.predecessor != self.predecessor {
            return Err(AssistError::ReceiptMismatch);
        }
        self.seen.insert(receipt.receipt_digest);
        self.predecessor = Some(receipt.receipt_digest);
        Ok(())
    }
}

fn evidence_digest(
    evidence_id: &str,
    objective_slug: &str,
    dimension: &str,
    payload_digest: &[u8; 32],
) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-evidence/v1");
    put(&mut hasher, evidence_id.as_bytes());
    put(&mut hasher, objective_slug.as_bytes());
    put(&mut hasher, dimension.as_bytes());
    hasher.update(payload_digest);
    hasher.finalize().into()
}

fn standing_receipt_digest(
    objective_slug: &str,
    from: StandingLevel,
    to: StandingLevel,
    evidence_digest: &[u8; 32],
    predecessor: Option<&[u8; 32]>,
) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-standing-receipt/v1");
    put(&mut hasher, objective_slug.as_bytes());
    hasher.update(&[from as u8, to as u8]);
    hasher.update(evidence_digest);
    match predecessor {
        Some(value) => {
            hasher.update(&[1]);
            hasher.update(value);
        }
        None => {
            hasher.update(&[0]);
        }
    }
    hasher.finalize().into()
}

fn put(hasher: &mut blake3::Hasher, value: &[u8]) {
    hasher.update(&(value.len() as u64).to_le_bytes());
    hasher.update(value);
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct OperatingReceipts {
    pub automatic_receipt: [u8; 32],
    pub autonomic_receipt: [u8; 32],
}

pub fn execute_operating_rail() -> Result<OperatingReceipts, Box<dyn Error>> {
    let temp = tempfile::tempdir()?;
    let actuator = FilesystemActuator::new(temp.path().join("actuation"));
    let machine = FoundationMachine::new(ExecutionPolicy::full_level5(1024 * 1024));
    let mut router = TriggerRouter::new();
    router.insert(Route::new(
        "practice",
        Dimension::AutomationClosure,
        "certification-practice-plan",
    )?)?;
    router.insert(Route::new(
        "repair",
        Dimension::AutonomicClosure,
        "certification-practice-repair",
    )?)?;
    let mut runtime = AutomaticRuntime::new(
        TriggerAdmissionPolicy::new(["practice", "repair"], 4096, 10_000),
        router,
        OperationsGovernor::new(
            RetryPolicy::new(2, 1),
            CircuitBreaker::new(3),
            ErrorBudget::new(8, 1),
        ),
    );
    let mut observer = FilesystemConsequenceObserver;
    let automatic = runtime.execute(
        Trigger::new(
            "certification-practice-event",
            "practice",
            1,
            b"plan=systems-dominion".to_vec(),
        ),
        &machine,
        &actuator,
        &mut observer,
    )?;
    automatic.verify()?;

    let initial = Action::new(
        "certification-practice-initial",
        Dimension::AutonomicClosure,
        b"state=unplanned".to_vec(),
    );
    let initial_grant = machine.derive_grant(&initial)?;
    let initial_receipt = actuator.actuate(&initial_grant, &initial)?;
    let mut resource = AutonomicResource::new(
        "certification-practice-resource",
        b"state=planned".to_vec(),
        initial_receipt.action_id,
        "repair",
    )?;
    let autonomic = AutonomicOperationsController::new(3).converge(
        &mut resource,
        &mut runtime,
        &machine,
        &actuator,
        &mut observer,
    )?;
    autonomic.verify()?;
    if !autonomic.converged {
        return Err("automatic/autonomic CertificationAssist rail did not converge".into());
    }
    Ok(OperatingReceipts {
        automatic_receipt: automatic.receipt_digest,
        autonomic_receipt: autonomic.receipt_digest,
    })
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct VerifierReport {
    pub standing: &'static str,
    pub capabilities: usize,
    pub proof_surfaces: usize,
    pub objectives: usize,
    pub triple_darkness_gaps: usize,
    pub speedrun_digest: [u8; 32],
    pub self_play_digest: [u8; 32],
    pub standing_receipt: [u8; 32],
    pub automatic_receipt: [u8; 32],
    pub autonomic_receipt: [u8; 32],
}

pub fn verify() -> Result<VerifierReport, Box<dyn Error>> {
    if CAPABILITIES.len() != 12 || CAPABILITIES.len() * REQUIRED_PROOF_SURFACES != 36 {
        return Err("capability crown cardinality mismatch".into());
    }
    let plan = speedrun_plan()?;
    if plan.len() != OBJECTIVES.len() {
        return Err("speedrun plan is not objective-complete".into());
    }
    let triple_darkness_gaps = HORIZON_GAPS
        .iter()
        .copied()
        .filter(|gap| is_triple_darkness(*gap))
        .count();
    if triple_darkness_gaps == 0 {
        return Err("Triple Darkness fixture was not detected".into());
    }
    let self_play = run_self_play("architecture-narration")?;
    let autonomic = autonomic_learning_plan()?;
    if autonomic.standing_promoted
        || autonomic
            .intents
            .iter()
            .any(|intent| intent.actuation_performed || intent.promotion_performed)
    {
        return Err(Box::new(AssistError::DirectActuationRefused));
    }

    let mut ledger = StandingLedger::new()?;
    let current = ledger.standing("network-flow")?;
    let next = current
        .next()
        .ok_or(AssistError::InvalidTransition { from: current, to: current })?;
    if !matches!(
        ledger.promote("network-flow", next, None),
        Err(AssistError::MissingEvidence(_))
    ) {
        return Err("evidence-free promotion was not refused".into());
    }
    let evidence = EvidenceArtifact::issue(
        "network-flow-whiteboard-witness",
        "network-flow",
        "visualization",
        b"client->dns->edge->load-balancer->service->store",
    );
    let receipt = ledger.promote("network-flow", next, Some(&evidence))?;
    let mut replay = StandingReplayVerifier::default();
    replay.replay(&receipt)?;
    if !matches!(replay.replay(&receipt), Err(AssistError::DuplicateReplay)) {
        return Err("duplicate standing replay was not refused".into());
    }

    let operating = execute_operating_rail()?;
    Ok(VerifierReport {
        standing: "ALIVE",
        capabilities: CAPABILITIES.len(),
        proof_surfaces: CAPABILITIES.len() * REQUIRED_PROOF_SURFACES,
        objectives: OBJECTIVES.len(),
        triple_darkness_gaps,
        speedrun_digest: speedrun_digest(&plan),
        self_play_digest: self_play.digest,
        standing_receipt: receipt.receipt_digest,
        automatic_receipt: operating.automatic_receipt,
        autonomic_receipt: operating.autonomic_receipt,
    })
}
