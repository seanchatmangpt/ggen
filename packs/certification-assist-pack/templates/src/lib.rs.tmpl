    let prompt = match kind {
        ProbeKind::Recall => format!("Define {} without vendor product names.", item.concept),
        ProbeKind::Explanation => format!("Explain why {} exists and name its tradeoff.", item.name),
        ProbeKind::Whiteboard => item.draw_next.to_string(),
