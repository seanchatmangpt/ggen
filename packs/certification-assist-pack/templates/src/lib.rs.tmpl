#[derive(Debug, Clone, PartialEq, Eq)]
pub enum AssistError {
    UnknownObjective(String),
    DuplicateObjective(String),
    InvalidStanding(u8),
    InvalidPriority(String),
    MissingPrerequisite(String),
    ObjectiveCycle,
    MissingEvidence(String),
    EvidenceMismatch,
    InvalidTransition { from: StandingLevel, to: StandingLevel },
    ReceiptMismatch,
    DuplicateReplay,
    InvalidSelfPlayRoles,
    InvalidAutonomicPolicy,
    DirectActuationRefused,
    IncompleteWhiteboard(String),
}

impl Display for AssistError {
    fn fmt(&self, formatter: &mut Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{self:?}")
    }
}

impl Error for AssistError {}

pub fn objective(slug: &str) -> Result<Objective, AssistError> {
    OBJECTIVES
        .iter()
        .copied()
        .find(|item| item.slug == slug)
        .ok_or_else(|| AssistError::UnknownObjective(slug.to_string()))
}

pub fn validate_objectives() -> Result<(), AssistError> {
    let mut slugs = BTreeSet::new();
    for item in OBJECTIVES {
        if !slugs.insert(item.slug) {
            return Err(AssistError::DuplicateObjective(item.slug.to_string()));
        }
        let current = item.current_level()?;
        let target = item.target_level()?;
        if target <= current || item.learning_cost == 0 {
            return Err(AssistError::InvalidPriority(item.slug.to_string()));
        }
    }
    for item in OBJECTIVES {
        if let Some(required) = item.requires_slug {
            if !slugs.contains(required) {
                return Err(AssistError::MissingPrerequisite(required.to_string()));
            }
        }
    }
    Ok(())
}

pub fn priority_score(item: Objective) -> Result<u64, AssistError> {
    let denominator = item
        .learning_cost
        .checked_mul(item.existing_coverage + 1)
        .ok_or_else(|| AssistError::InvalidPriority(item.slug.to_string()))?;
    if denominator == 0 {
        return Err(AssistError::InvalidPriority(item.slug.to_string()));
    }
    let numerator = item
        .interview_frequency
        .checked_mul(item.ecosystem_dependency)
        .and_then(|value| value.checked_mul(item.transfer_breadth))
        .and_then(|value| value.checked_mul(item.gatekeeping_value))
        .and_then(|value| value.checked_mul(item.darkness_risk))
        .ok_or_else(|| AssistError::InvalidPriority(item.slug.to_string()))?;
    Ok(numerator / denominator)
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct SpeedrunItem {
    pub order: usize,
    pub objective_slug: String,
    pub priority: u64,
    pub prerequisite: Option<String>,
}

pub fn speedrun_plan() -> Result<Vec<SpeedrunItem>, AssistError> {
    validate_objectives()?;
    let mut remaining: BTreeMap<&str, Objective> =
        OBJECTIVES.iter().map(|item| (item.slug, *item)).collect();
    let mut selected: BTreeSet<&str> = BTreeSet::new();
    let mut plan = Vec::with_capacity(remaining.len());
    while !remaining.is_empty() {
        let mut candidates = remaining
            .values()
            .copied()
            .filter(|item| item.requires_slug.map_or(true, |required| selected.contains(required)))
            .map(|item| Ok((item, priority_score(item)?)))
            .collect::<Result<Vec<_>, AssistError>>()?;
        candidates.sort_by(|left, right| {
            right
                .1
                .cmp(&left.1)
                .then_with(|| left.0.order.cmp(&right.0.order))
                .then_with(|| left.0.slug.cmp(right.0.slug))
        });
        let Some((chosen, score)) = candidates.first().copied() else {
            return Err(AssistError::ObjectiveCycle);
        };
        remaining.remove(chosen.slug);
        selected.insert(chosen.slug);
        plan.push(SpeedrunItem {
            order: plan.len() + 1,
            objective_slug: chosen.slug.to_string(),
            priority: score,
            prerequisite: chosen.requires_slug.map(str::to_string),
        });
    }
    Ok(plan)
}

pub fn speedrun_digest(plan: &[SpeedrunItem]) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-speedrun/v1");
    for item in plan {
        put(&mut hasher, item.objective_slug.as_bytes());
        hasher.update(&item.priority.to_le_bytes());
        put(
            &mut hasher,
            item.prerequisite.as_deref().unwrap_or_default().as_bytes(),
        );
    }
    hasher.finalize().into()
}

pub fn is_triple_darkness(gap: HorizonGap) -> bool {
    !gap.knowledge_present && !gap.gap_awareness && !gap.dependency_known
}

