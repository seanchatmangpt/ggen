pub fn run_self_play(slug: &str) -> Result<A2aTask, AssistError> {
    if SELF_PLAY_ROLES.len() != 3
        || SELF_PLAY_ROLES[0].slug != "candidate-twin"
        || SELF_PLAY_ROLES[1].slug != "examiner-twin"
        || SELF_PLAY_ROLES[2].slug != "domain-adjudicator"
    {
        return Err(AssistError::InvalidSelfPlayRoles);
    }
    let item = objective(slug)?;
    let current = item.current_level()?;
    let target = item.target_level()?;
    let projection = whiteboard_projection(slug)?;
    let messages = vec![
        A2aMessage {
            role: "candidate-twin".to_string(),
            parts: vec![format!("current-standing={current:?}"), projection.say_next.clone()],
        },
        A2aMessage {
            role: "examiner-twin".to_string(),
            parts: vec![format!("target-standing={target:?}"), projection.watch_for.clone()],
        },
        A2aMessage {
            role: "domain-adjudicator".to_string(),
            parts: vec![format!("gap={}", item.target - item.current), projection.why.clone()],
        },
    ];
    let artifact = A2aArtifact {
        artifact_id: format!("standing-gap-{slug}"),
        name: "Capability Standing Adjudication".to_string(),
        parts: vec![projection.draw_next, projection.tradeoff],
    };
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-a2a-task/v1");
    put(&mut hasher, slug.as_bytes());
    let messages_json = serde_json::to_vec(&messages).map_err(|_| AssistError::ReceiptMismatch)?;
    let artifact_json = serde_json::to_vec(&artifact).map_err(|_| AssistError::ReceiptMismatch)?;
    put(&mut hasher, &messages_json);
    put(&mut hasher, &artifact_json);
    let digest = hasher.finalize().into();
    Ok(A2aTask {
        task_id: format!("self-play-{slug}"),
        state: A2aTaskState::Completed,
        context_id: "certification-assist-systems-dominion".to_string(),
        messages,
        artifacts: vec![artifact],
        digest,
    })
}

