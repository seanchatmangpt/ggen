@prefix fa: <https://ggen.dev/packs/cs2-fleet-adapter#> .
@prefix mp: <https://ggen.dev/packs/multi-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

fa:Consumer a rdfs:Class .
fa:Binding a rdfs:Class .
fa:Language a rdfs:Class .
fa:Transport a rdfs:Class .
fa:Pack a rdfs:Class .
fa:subjectIri a rdf:Property .
fa:consumerName a rdf:Property .
fa:language a rdf:Property .
fa:namespace a rdf:Property .
fa:outputPath a rdf:Property .
fa:transport a rdf:Property .
fa:schemaVersion a rdf:Property .
fa:bindingKey a rdf:Property .
fa:consumes a rdf:Property .
fa:projects a rdf:Property .
fa:Elixir a fa:Language .
fa:Rust a fa:Language .
fa:Json a fa:Language .
fa:Sql a fa:Language .
fa:OpenApi a fa:Language .
fa:Protobuf a fa:Language .
fa:Http a fa:Transport .
fa:File a fa:Transport .
fa:CS2FleetAdapterPack a fa:Pack ;
  rdfs:label "CS2 Fleet Adapter Pack" ;
  fa:schemaVersion "1"^^xsd:integer ;
  fa:projects mp:Projection .
