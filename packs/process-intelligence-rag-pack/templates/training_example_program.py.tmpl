---
to: "src/generate_training_example.py"
sparql:
  row: |
    PREFIX dspy: <http://seanchatmangpt.github.io/packs/dspy#>
    PREFIX pirag: <http://seanchatmangpt.github.io/packs/process-intelligence-rag#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?peName ?peType ?tfName ?tfType ?ifName ?ifType ?tvName ?tvType WHERE {
      dspy:GenerateTrainingExampleSignature dcterms:title ?title ;
          dspy:hasInput ?pe , ?tf ; dspy:hasOutput ?if_ , ?tv .
      ?pe dspy:name ?peName ; dspy:pythonType ?peType .
      FILTER(?peName = "process_evidence")
      ?tf dspy:name ?tfName ; dspy:pythonType ?tfType .
      FILTER(?tfName = "target_feature_name")
      ?if_ dspy:name ?ifName ; dspy:pythonType ?ifType .
      FILTER(?ifName = "input_features")
      ?tv dspy:name ?tvName ; dspy:pythonType ?tvType .
      FILTER(?tvName = "target_value")
    }
---
"""{{ row[0].title }} -- generated by process-intelligence-rag-pack.

Every field below echoes literals already stored in the ontology against
dspy-pack's real Signature/InputField/OutputField vocabulary -- nothing here is
synthesized, per pack-authoring-pack's "templates echo, they never synthesize" rule.
"""

import dspy


class {{ row[0].title }}(dspy.Signature):
    """Given real, computed process evidence about one occurrence of a named
    process-related problem, manufacture one (input_features, target_value)
    training-example pair -- never guessed from the model's own unconstrained
    priors."""

    {{ row[0].peName }}: {{ row[0].peType }} = dspy.InputField()
    {{ row[0].tfName }}: {{ row[0].tfType }} = dspy.InputField()
    {{ row[0].ifName }}: {{ row[0].ifType }} = dspy.OutputField()
    {{ row[0].tvName }}: {{ row[0].tvType }} = dspy.OutputField()
