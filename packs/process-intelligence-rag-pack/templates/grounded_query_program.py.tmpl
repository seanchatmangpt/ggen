---
to: "src/grounded_process_query.py"
sparql:
  row: |
    PREFIX dspy: <http://seanchatmangpt.github.io/packs/dspy#>
    PREFIX pirag: <http://seanchatmangpt.github.io/packs/process-intelligence-rag#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?qName ?qType ?gfName ?gfType ?aName ?aType ?cName ?cType WHERE {
      pirag:GroundedProcessQuerySignature dcterms:title ?title ;
          dspy:hasInput ?q , ?gf ; dspy:hasOutput ?a , ?c .
      ?q dspy:name ?qName ; dspy:pythonType ?qType .
      FILTER(?qName = "question")
      ?gf dspy:name ?gfName ; dspy:pythonType ?gfType .
      FILTER(?gfName = "grounding_facts")
      ?a dspy:name ?aName ; dspy:pythonType ?aType .
      FILTER(?aName = "answer")
      ?c dspy:name ?cName ; dspy:pythonType ?cType .
      FILTER(?cName = "grounding_citations")
    }
