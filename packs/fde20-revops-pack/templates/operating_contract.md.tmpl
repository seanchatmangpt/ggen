  offer: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?description ?rate ?currency ?unit ?llmRole ?deterministic ?brce ?receipt WHERE {
      ?o a fde20:Offer ; dcterms:title ?title ; dcterms:description ?description ;
