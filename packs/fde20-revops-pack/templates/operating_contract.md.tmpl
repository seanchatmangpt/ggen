         fde20:llmRole ?llmRole ; fde20:deterministicFirst ?deterministic ;
         fde20:brceRequired ?brce ; fde20:receiptRequired ?receipt .
    }
  stages: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?label ?slug ?kind ?objective ?entry ?exit ?ceiling ?receipt WHERE {
      ?s a fde20:RevOpsStage ; skos:prefLabel ?label ; fde20:stageOrder ?order ;
         fde20:stageSlug ?slug ; fde20:operationKind ?kind ; fde20:objective ?objective ;
         fde20:entryCriterion ?entry ; fde20:exitCriterion ?exit ;
         fde20:standingCeiling ?ceiling ; fde20:requiresReceipt ?receipt .
    } ORDER BY ?order
