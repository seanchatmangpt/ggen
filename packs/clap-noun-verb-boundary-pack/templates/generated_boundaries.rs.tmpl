---
to: src/generated_boundaries.rs
sparql:
  rows: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?crate_name WHERE { ?cli a cnv:Cli ; cnv:crateName ?crate_name . }
    ORDER BY ?crate_name
---
//! Admitted external boundaries for `{{ rows[0].crate_name }}`.
//!
//! GENERATED by ggen. All filesystem access is rooted, relative, symlink-
//! refusing, no-clobber, and receipt-bearing. No command may actuate outside
//! this module.

use std::ffi::OsStr;
use std::fs::{self, OpenOptions};
use std::io::Write;
use std::path::{Component, Path, PathBuf};
use std::time::{SystemTime, UNIX_EPOCH};

use clap_noun_verb::{NounVerbError, Result};
use serde_json::{json, Value};

/// Fully admitted filesystem capability for one generated command.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct FilesystemBoundarySpec {
    /// Relative root beneath the process working directory.
    pub root: &'static str,
    /// Whether successful mutation must emit a content-bound receipt.
    pub receipt_required: bool,
    /// Replay policy declared by the ontology.
    pub replay_mode: &'static str,
}

/// Atomically create one JSON record and emit a BLAKE3-bound receipt.
pub fn write_json(
    spec: FilesystemBoundarySpec,
    id: &str,
    value: &Value,
) -> Result<Value> {
    let root = admitted_root(spec.root)?;
    refuse_symlink_components(&root)?;
    fs::create_dir_all(&root).map_err(|error| execution_error("create boundary root", &error))?;
    refuse_symlink_components(&root)?;

    let safe_id = admitted_component(id)?;
    let destination = root.join(format!("{safe_id}.json"));
    let bytes = serde_json::to_vec_pretty(value)
        .map_err(|error| execution_error("serialize boundary value", &error))?;
    let temporary = unique_temporary_path(&root, &safe_id)?;

    let write_result = (|| -> Result<()> {
        {
            let mut file = OpenOptions::new()
                .write(true)
                .create_new(true)
                .open(&temporary)
                .map_err(|error| execution_error("create temporary boundary file", &error))?;
            file.write_all(&bytes)
                .map_err(|error| execution_error("write temporary boundary file", &error))?;
            file.sync_all()
                .map_err(|error| execution_error("sync temporary boundary file", &error))?;
        }

        // A hard link publishes the fully-synced inode only when the destination
        // does not already exist. Unlike rename on Unix, this cannot silently
        // replace a concurrent writer's record.
        fs::hard_link(&temporary, &destination).map_err(|error| {
            if error.kind() == std::io::ErrorKind::AlreadyExists {
                NounVerbError::execution_error(format!(
                    "filesystem boundary refused overwrite of {}",
                    destination.display()
                ))
            } else {
                execution_error("publish boundary file", &error)
            }
        })?;
        Ok(())
    })();

    let _ = fs::remove_file(&temporary);
    write_result?;

    let digest = blake3::hash(&bytes).to_hex().to_string();
    Ok(json!({
        "status": "written",
        "path": destination.to_string_lossy(),
        "blake3": digest,
        "receipt_required": spec.receipt_required,
        "replay_mode": spec.replay_mode,
        "record": value,
    }))
}

/// Read every admitted JSON record in deterministic filename order.
pub fn list_json(spec: FilesystemBoundarySpec) -> Result<Value> {
    let root = admitted_root(spec.root)?;
    if !root.exists() {
        return Ok(json!({ "total": 0, "records": [] }));
    }
    refuse_symlink_components(&root)?;

    let mut paths = Vec::new();
    for entry in fs::read_dir(&root).map_err(|error| execution_error("read boundary root", &error))? {
        let entry = entry.map_err(|error| execution_error("read boundary entry", &error))?;
        let file_type = entry
            .file_type()
            .map_err(|error| execution_error("inspect boundary entry", &error))?;
        if file_type.is_symlink() {
            return Err(NounVerbError::execution_error(format!(
                "filesystem boundary refused symlink {}",
                entry.path().display()
            )));
        }
        if file_type.is_file()
            && entry
                .path()
                .extension()
                .is_some_and(|extension| extension == OsStr::new("json"))
        {
            paths.push(entry.path());
        }
    }
    paths.sort();

    let mut records = Vec::with_capacity(paths.len());
    for path in paths {
        let bytes = fs::read(&path).map_err(|error| execution_error("read boundary JSON", &error))?;
        let value: Value = serde_json::from_slice(&bytes)
            .map_err(|error| execution_error("parse boundary JSON", &error))?;
        records.push(value);
    }

    Ok(json!({ "total": records.len(), "records": records }))
}

fn admitted_root(root: &str) -> Result<PathBuf> {
    let path = Path::new(root);
    if root.is_empty() || path.is_absolute() {
        return Err(NounVerbError::execution_error(
            "filesystem boundary root must be a non-empty relative path",
        ));
    }
    for component in path.components() {
        match component {
            Component::Normal(_) | Component::CurDir => {}
            Component::ParentDir | Component::RootDir | Component::Prefix(_) => {
                return Err(NounVerbError::execution_error(format!(
                    "filesystem boundary root contains a forbidden component: {root}"
                )));
            }
        }
    }
    Ok(path.to_path_buf())
}

fn admitted_component(component: &str) -> Result<String> {
    let valid = !component.is_empty()
        && component != "."
        && component != ".."
        && component
            .chars()
            .all(|character| character.is_alphanumeric() || matches!(character, '-' | '_' | '.'));
    if !valid {
        return Err(NounVerbError::execution_error(format!(
            "filesystem boundary refused unsafe record identifier: {component:?}"
        )));
    }
    Ok(component.to_owned())
}

fn refuse_symlink_components(path: &Path) -> Result<()> {
    let mut current = PathBuf::new();
    for component in path.components() {
        match component {
            Component::CurDir => continue,
            Component::Normal(component) => current.push(component),
            Component::ParentDir | Component::RootDir | Component::Prefix(_) => {
                return Err(NounVerbError::execution_error(format!(
                    "filesystem boundary contained a forbidden component: {}",
                    path.display()
                )));
            }
        }

        match fs::symlink_metadata(&current) {
            Ok(metadata) if metadata.file_type().is_symlink() => {
                return Err(NounVerbError::execution_error(format!(
                    "filesystem boundary refused symlink component {}",
                    current.display()
                )));
            }
            Ok(_) => {}
            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
            Err(error) => return Err(execution_error("inspect filesystem boundary", &error)),
        }
    }
    Ok(())
}

fn unique_temporary_path(root: &Path, id: &str) -> Result<PathBuf> {
    let nanos = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map_err(|error| execution_error("read system clock", &error))?
        .as_nanos();
    Ok(root.join(format!(".{id}.{}.{}.tmp", std::process::id(), nanos)))
}

fn execution_error(context: &str, error: &impl std::fmt::Display) -> NounVerbError {
    NounVerbError::execution_error(format!("{context}: {error}"))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn unsafe_record_identifiers_are_refused() {
        for value in ["", ".", "..", "../escape", "a/b", "a\\b"] {
            assert!(admitted_component(value).is_err(), "{value:?} must be refused");
        }
    }

    #[test]
    fn safe_record_identifiers_are_preserved() {
        assert_eq!(admitted_component("Widget-1.0").unwrap(), "Widget-1.0");
    }

    #[test]
    fn parent_roots_are_refused() {
        assert!(admitted_root("../outside").is_err());
        assert!(admitted_root("/absolute").is_err());
    }

    #[cfg(unix)]
    #[test]
    fn intermediate_symlink_components_are_refused() {
        use std::os::unix::fs::symlink;

        let nonce = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap()
            .as_nanos();
        let root = PathBuf::from(format!(
            ".cnv-symlink-test-{}-{nonce}",
            std::process::id()
        ));
        let target = root.join("target");
        let link = root.join("link");
        fs::create_dir_all(&target).unwrap();
        symlink(&target, &link).unwrap();
        assert!(refuse_symlink_components(&link.join("child")).is_err());
        fs::remove_dir_all(&root).unwrap();
    }
}
