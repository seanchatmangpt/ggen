sparql:
  rows: |
    PREFIX ghtf: <http://seanchatmangpt.github.io/packs/gh-terraform#>
    SELECT ?alias (GROUP_CONCAT(?body; separator="\n\n") AS ?bodies) WHERE {
      ?org a ghtf:OrgTenant ; ghtf:orgAlias ?alias .
      ?repoInd a ghtf:ManagedRepo ; ghtf:org ?org ; ghtf:baselineProfile ?profile .
      ?profile ghtf:member ?instance .
      ?instance ghtf:hclBody ?body .
    } GROUP BY ?alias ORDER BY ?alias
