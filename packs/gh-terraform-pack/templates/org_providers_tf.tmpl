---
to: infra/terraform/github/providers.tf
sparql:
  rows: |
    PREFIX ghtf: <http://seanchatmangpt.github.io/packs/gh-terraform#>
    SELECT ?alias ?owner ?prefix WHERE {
      ?org a ghtf:OrgTenant ; ghtf:orgAlias ?alias ; ghtf:orgOwner ?owner ; ghtf:appAuthVarPrefix ?prefix .
    } ORDER BY ?alias
---
# GENERATED by `ggen sync` from packs/gh-terraform-pack/ontology.ttl — OrgTenant provider aliasing
# 第十六章: 生成単位は責任工程ごとに分離する。 Do not edit; edit the ontology.

{% for row in rows %}provider "github" {
  alias = "{{ row.alias }}"
  owner = "{{ row.owner }}"

  app_auth {
    id              = var.{{ row.prefix }}_app_id
    installation_id = var.{{ row.prefix }}_app_installation_id
    pem_file        = var.{{ row.prefix }}_app_pem_file
  }
}

{% endfor %}