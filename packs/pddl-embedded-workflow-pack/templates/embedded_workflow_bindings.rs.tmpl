---
to: crates/bcinr-pddl/tests/embedded_workflow_generated.rs
sparql:
  domain: "PREFIX wf: <http://seanchatmangpt.github.io/packs/pddl-embedded-workflow#> SELECT ?domainName ?bindingName ?commandEnum WHERE { ?d a wf:Domain ; wf:domainName ?domainName ; wf:bindingName ?bindingName ; wf:commandEnum ?commandEnum } LIMIT 1"
  actions: "PREFIX wf: <http://seanchatmangpt.github.io/packs/pddl-embedded-workflow#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?actionName ?variant ?arity ?kind ?comment WHERE { ?a a wf:Action ; wf:actionName ?actionName ; wf:variant ?variant ; wf:arity ?arity ; wf:executionKind ?k . ?k rdfs:label ?kind . OPTIONAL { ?a rdfs:comment ?comment } } ORDER BY ?actionName"
skip_if: "ggen:local-override"
---
{%- set d = domain | first -%}
//! `{{ d.commandEnum }}` bindings for the `{{ d.domainName }}` embedded
//! workflow — GENERATED by `ggen sync` from the `pddl-embedded-workflow-pack`
//! ontology (`wf:Domain`/`wf:Action` individuals). Do not edit by hand: this
//! file is a pure projection of the ontology; there is no logic slot here.
//! To freeze this file against regeneration, add a comment containing the
//! literal marker "ggen" + ":" + "local-override".
//!
//! The real PDDL domain text stays hand-written and owned separately by the
//! application (see `examples/embedded_workflow.rs`'s `DOMAIN` constant) —
//! this pack only generates the Rust-side command enum and binding, never
//! PDDL text itself. An application should assert
//! `{{ d.bindingName | pascal_case }}Binding::supported_actions()` against
//! the real domain's action set at startup so ontology/domain drift is
//! caught immediately rather than silently at plan time. This file lives
//! under `tests/` rather than `examples/` because it is a module of
//! bindings, not a binary — `examples/*.rs` requires `fn main`, `tests/*.rs`
//! does not.

#![cfg(feature = "mfw-planner")]

use bcinr_pddl::prelude::*;
use serde::Serialize;

/// Default adapter routing for one `{{ d.commandEnum }}` variant. Generated
/// as a plain, overridable function — not a hard-coded dispatch decision on
/// the command type itself — so a deployment (e.g. a test harness) can route
/// every command through a single adapter regardless of this default.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ExecutionKind {
    /// Routes through `workflow_cmd::adapters::TaskGroupAdapter` by default.
    Local,
    /// Routes through `workflow_cmd::adapters::OutboxAdapter` by default.
    Durable,
    /// Routes through `workflow_cmd::adapters::ApprovalAdapter` by default.
    HumanApproval,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
pub enum {{ d.commandEnum }} {
{%- for a in actions %}
    /// `{{ a.actionName }}` — {{ a.comment | default(value="(no comment)") }}
    {{ a.variant }},
{%- endfor %}
}

/// Default execution-kind routing for each generated `{{ d.commandEnum }}`
/// variant. Override at the dispatch call site; this is a default, not an
/// authority boundary.
pub fn default_execution_kind(command: &{{ d.commandEnum }}) -> ExecutionKind {
    match command {
{%- for a in actions %}
        {{ d.commandEnum }}::{{ a.variant }} => ExecutionKind::{{ a.kind | pascal_case }},
{%- endfor %}
    }
}

#[derive(Debug, Clone, Copy)]
pub struct {{ d.bindingName | pascal_case }}Binding;

impl ActionBinding for {{ d.bindingName | pascal_case }}Binding {
    type Command = {{ d.commandEnum }};
    type Error = String;

    fn binding_name(&self) -> &str {
        "{{ d.bindingName }}"
    }

    fn supported_actions(&self) -> Vec<&str> {
        vec![
{%- for a in actions %}
            "{{ a.actionName }}",
{%- endfor %}
        ]
    }

    fn bind(&self, action: &ActionInvocation) -> Result<Self::Command, Self::Error> {
        match (action.name.as_str(), action.arguments.as_slice()) {
{%- for a in actions %}
{%- if a.arity == 0 %}
            ("{{ a.actionName }}", []) => Ok(Self::Command::{{ a.variant }}),
{%- endif %}
{%- endfor %}
            _ => Err(format!("unbound workflow action: {}", action.label)),
        }
    }
}

impl TryFrom<ActionInvocation> for {{ d.commandEnum }} {
    type Error = String;

    fn try_from(action: ActionInvocation) -> Result<Self, Self::Error> {
        {{ d.bindingName | pascal_case }}Binding.bind(&action)
    }
}

#[cfg(test)]
mod generated_binding_proof {
    //! Real end-to-end proof, not a hand-transcribed assertion: the real
    //! PDDL domain text below is `examples/embedded_workflow.rs`'s own
    //! `DOMAIN` constant, planned through a real `EmbeddedWorkflow`, and
    //! bound through the generated `{{ d.bindingName | pascal_case }}Binding`
    //! above — proving the ontology's action names/arities actually match
    //! the real domain, not just that the template rendered valid syntax.
    use super::*;
    use std::borrow::Cow;

    const DOMAIN: &str = "(define (domain {{ d.domainName }})
  (:requirements :strips)
  (:predicates (paid) (reserved) (customer-notified))
  (:action reserve-inventory
    :parameters ()
    :precondition (paid)
    :effect (reserved))
  (:action notify-customer
    :parameters ()
    :precondition (paid)
    :effect (customer-notified)))";

    struct Order {
        id: u64,
        paid: bool,
    }

    impl WorkflowProblem for Order {
        fn to_pddl_problem(&self) -> Cow<'_, str> {
            let mut problem =
                StripsProblemBuilder::new(format!("order-{}", self.id), "{{ d.domainName }}")
                    .expect("application identifiers must be valid PDDL symbols");
            if self.paid {
                problem
                    .add_nullary_fact("paid")
                    .expect("domain predicates are compile-time constants");
            }
            problem
                .add_nullary_goal("reserved")
                .expect("domain predicates are compile-time constants")
                .add_nullary_goal("customer-notified")
                .expect("domain predicates are compile-time constants");
            Cow::Owned(
                problem
                    .build()
                    .expect("the application always supplies a goal")
                    .into_string(),
            )
        }
    }

    chicago_tdd_tools::test!(
        generated_binding_matches_the_real_domains_actual_actions,
        {
            let mut workflow =
                EmbeddedWorkflow::new(DOMAIN).expect("embedded planning domain must parse");
            let order = Order { id: 42, paid: true };
            let verified = workflow.plan(&order).expect("workflow should be admitted");
            let registry = BindingRegistry::new({{ d.bindingName | pascal_case }}Binding)
                .expect("generated binding schema should validate");
            let coverage = registry.coverage(
                verified
                    .batches()
                    .iter()
                    .flat_map(|batch| batch.actions().iter().map(|action| action.name.clone())),
            );
            assert!(
                coverage.is_complete(),
                "generated binding's action set must match the real domain's planned actions: {coverage:?}"
            );
            let commands = verified
                .bind::<{{ d.commandEnum }}>()
                .expect("every planner action must have a generated Rust binding");
            for batch in commands.batches() {
                for command in batch.actions() {
                    let _kind = default_execution_kind(command);
                }
            }
        }
    );
}
