{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schema/vision-2030-program.v1.json",
  "title": "ggen Vision 2030 Phase Change Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program", "required_domains", "horizons", "capabilities"],
  "properties": {
    "schema": {"const": "ggen.vision2030.program.v1"},
    "program": {"$ref": "#/$defs/program"},
    "required_domains": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "horizons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/horizon"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "target_year", "phase_change_target",
        "trusted_issuers", "trusted_brokers"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target_year": {"const": 2030},
        "phase_change_target": {"type": "integer", "minimum": 1000},
        "trusted_issuers": {"$ref": "#/$defs/key_registry"},
        "trusted_brokers": {"$ref": "#/$defs/key_registry"}
      }
    },
    "key_registry": {
      "description": "issuer/broker id -> hex-encoded ed25519 public key. Mirrors `Program.trusted_issuers` / `Program.trusted_brokers` (BTreeMap<String,String>) in crates/ggen-cli/src/cmds/vision2030/mod.rs, which serde REQUIRES (no #[serde(default)]). An empty map is legal and is the correct starting state: the evaluator refuses any external_acceptance / execution_grant signed by an unregistered key.",
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "minimum_alive_capabilities"],
      "properties": {
        "year": {"type": "integer", "minimum": 2026, "maximum": 2030},
        "minimum_alive_capabilities": {"type": "integer", "minimum": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "iri", "domain", "horizon", "blue_ocean_move", "authority",
        "summary", "dependencies", "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "iri": {"type": "string", "format": "uri"},
        "domain": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 2026, "maximum": 2030},
        "blue_ocean_move": {"enum": ["eliminate", "reduce", "raise", "create"]},
        "authority": {"enum": ["observe", "recommend", "construct", "actuate"]},
        "summary": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "description": "Evidence roles bound to this capability. Deliberately NO `required` list: the live evaluator (crates/ggen-cli/src/cmds/vision2030/evaluation.rs) classifies a capability with an EMPTY evidence map as DESIGNED, never as ALIVE -- an empty map is the honest, legal state for a catalog entry that has no evidence yet. Requiring all 7 roles here would make a DESIGNED manifest fail schema validation while the real CLI accepts it, i.e. the schema would be stricter than the code it documents. ALIVE standing is decided by the evaluator's evidence checks (all 7 REQUIRED_EVIDENCE roles present, digests match, issuer signatures verify), not by this schema.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sbb_report": {"$ref": "#/$defs/evidence"},
            "positive": {"$ref": "#/$defs/evidence"},
            "negative": {"$ref": "#/$defs/evidence"},
            "verifier": {"$ref": "#/$defs/evidence"},
            "receipt": {"$ref": "#/$defs/evidence"},
            "replay": {"$ref": "#/$defs/evidence"},
            "external_acceptance": {"$ref": "#/$defs/evidence"},
            "execution_grant": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "digest"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^blake3[:-][0-9A-Fa-f]{64}$"}
      }
    }
  }
}
