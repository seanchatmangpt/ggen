{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schema/vision-2030-program.v1.json",
  "title": "ggen Vision 2030 Phase Change Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program", "required_domains", "horizons", "capabilities"],
  "properties": {
    "schema": {"const": "ggen.vision2030.program.v1"},
    "program": {"$ref": "#/$defs/program"},
    "required_domains": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "horizons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/horizon"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "target_year", "phase_change_target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target_year": {"const": 2030},
        "phase_change_target": {"type": "integer", "minimum": 1000}
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "minimum_alive_capabilities"],
      "properties": {
        "year": {"type": "integer", "minimum": 2026, "maximum": 2030},
        "minimum_alive_capabilities": {"type": "integer", "minimum": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "iri", "domain", "horizon", "blue_ocean_move", "authority",
        "summary", "dependencies", "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "iri": {"type": "string", "format": "uri"},
        "domain": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 2026, "maximum": 2030},
        "blue_ocean_move": {"enum": ["eliminate", "reduce", "raise", "create"]},
        "authority": {"enum": ["observe", "recommend", "construct", "actuate"]},
        "summary": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sbb_report", "positive", "negative", "verifier", "receipt", "replay",
            "external_acceptance"
          ],
          "properties": {
            "sbb_report": {"$ref": "#/$defs/evidence"},
            "positive": {"$ref": "#/$defs/evidence"},
            "negative": {"$ref": "#/$defs/evidence"},
            "verifier": {"$ref": "#/$defs/evidence"},
            "receipt": {"$ref": "#/$defs/evidence"},
            "replay": {"$ref": "#/$defs/evidence"},
            "external_acceptance": {"$ref": "#/$defs/evidence"},
            "execution_grant": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "digest"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^blake3[:-][0-9A-Fa-f]{64}$"}
      }
    }
  }
}
