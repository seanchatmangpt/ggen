{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schema/vision-2030-maximalism.v1.json",
  "title": "Vision 2030 Combinatorial Maximalism Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program", "required_domains", "required_outcomes", "horizons", "capabilities"],
  "properties": {
    "schema": {"const": "ggen.vision2030.maximalism.v1"},
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "target_year", "minimum_multiplier"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target_year": {"const": 2030},
        "minimum_multiplier": {"type": "integer", "minimum": 1000}
      }
    },
    "required_domains": {"$ref": "#/$defs/nonEmptySet"},
    "required_outcomes": {"$ref": "#/$defs/nonEmptySet"},
    "horizons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "minimum_alive_capabilities"],
        "properties": {
          "year": {"type": "integer", "minimum": 2026, "maximum": 2030},
          "minimum_alive_capabilities": {"type": "integer", "minimum": 1}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "nonEmptySet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "digest"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^blake3[:-][0-9A-Fa-f]{64}$"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "iri", "domain", "horizon", "authority", "surface", "summary",
        "outcomes", "dependencies", "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "iri": {"type": "string", "format": "uri"},
        "domain": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 2026, "maximum": 2030},
        "authority": {"enum": ["observe", "recommend", "construct", "actuate"]},
        "surface": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "outcomes": {"$ref": "#/$defs/nonEmptySet"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sbb_report", "positive", "negative", "adversarial", "verifier",
            "passport", "receipt", "replay", "external_acceptance"
          ],
          "properties": {
            "sbb_report": {"$ref": "#/$defs/evidence"},
            "positive": {"$ref": "#/$defs/evidence"},
            "negative": {"$ref": "#/$defs/evidence"},
            "adversarial": {"$ref": "#/$defs/evidence"},
            "verifier": {"$ref": "#/$defs/evidence"},
            "passport": {"$ref": "#/$defs/evidence"},
            "receipt": {"$ref": "#/$defs/evidence"},
            "replay": {"$ref": "#/$defs/evidence"},
            "external_acceptance": {"$ref": "#/$defs/evidence"},
            "execution_grant": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    }
  }
}
