---
to: generated/lean/Main.lean
force: true
sparql:
  pipeline: |
    PREFIX lr: <https://chatmangpt.com/ontology/lean4-rust#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?crate_name ?function_name ?bound ?witness_input ?witness_output
           ?proof_theorem ?witness_theorem ?fixed_point_theorem ?receipt_algorithm WHERE {
      ?pipeline a lr:Pipeline ;
                dcterms:title ?title ;
                lr:crateName ?crate_name ;
                lr:rustFunctionName ?function_name ;
                lr:bound ?bound ;
                lr:witnessInput ?witness_input ;
                lr:witnessOutput ?witness_output ;
                lr:proofTheorem ?proof_theorem ;
                lr:witnessTheorem ?witness_theorem ;
                lr:fixedPointTheorem ?fixed_point_theorem ;
                lr:receiptAlgorithm ?receipt_algorithm .
    }
    LIMIT 1
---
{% for p in pipeline %}namespace Lean4Rust

def bound : Nat := {{ p.bound }}
def witnessInput : Nat := {{ p.witness_input }}
def witnessOutput : Nat := {{ p.witness_output }}

def step (x : Nat) : Nat :=
  if x < bound then x + 1 else bound

theorem step_le (x : Nat) : step x ≤ bound := by
  unfold step
  split
  next h => exact Nat.succ_le_of_lt h
  next _ => exact Nat.le_refl bound

theorem step_witness : step witnessInput = witnessOutput := by
  decide

theorem step_fixed_point : step bound = bound := by
  simp [step]

structure ProofReceipt : Type where
  theoremName : String
  witnessTheorem : String
  fixedPointTheorem : String
  boundProof : ∀ x, step x ≤ bound
  witnessProof : step witnessInput = witnessOutput
  fixedPointProof : step bound = bound

def proofReceipt : ProofReceipt := {
  theoremName := {{ p.proof_theorem | json_encode | safe }}
  witnessTheorem := {{ p.witness_theorem | json_encode | safe }}
  fixedPointTheorem := {{ p.fixed_point_theorem | json_encode | safe }}
  boundProof := step_le
  witnessProof := step_witness
  fixedPointProof := step_fixed_point
}

def proofReceiptJson (receipt : ProofReceipt) : String :=
  "{\"schema\":\"ggen.lean4-rust/proof/v1\",\"standing\":\"PROVEN\",\"pipeline\":\"bounded-successor\",\"bound\":" ++
  toString bound ++
  ",\"witness_input\":" ++ toString witnessInput ++
  ",\"witness_output\":" ++ toString witnessOutput ++
  ",\"theorems\":[\"" ++ receipt.theoremName ++
  "\",\"" ++ receipt.witnessTheorem ++
  "\",\"" ++ receipt.fixedPointTheorem ++ "\"]}\n"

def cargoToml : String :=
  "[package]\n" ++
  "name = \"{{ p.crate_name }}\"\n" ++
  "version = \"0.1.0\"\n" ++
  "edition = \"2024\"\n\n" ++
  "[dependencies]\n" ++
  "blake3 = \"1.8\"\n\n" ++
  "[workspace]\n"

def rustLib : String :=
  "//! GENERATED by the ggen-first Lean 4 proof emitter.\n" ++
  "//! The Rust surface does not exist until Lean admits `step_le`,\n" ++
  "//! `step_witness`, and `step_fixed_point`.\n\n" ++
  "pub const BOUND: u64 = " ++ toString bound ++ ";\n" ++
  "pub const WITNESS_INPUT: u64 = " ++ toString witnessInput ++ ";\n" ++
  "pub const WITNESS_OUTPUT: u64 = " ++ toString witnessOutput ++ ";\n\n" ++
  "pub fn {{ p.function_name }}(x: u64) -> u64 {\n" ++
  "    if x < BOUND { x + 1 } else { BOUND }\n" ++
  "}\n\n" ++
  "#[cfg(test)]\n" ++
  "mod tests {\n" ++
  "    use super::*;\n\n" ++
  "    #[test]\n" ++
  "    fn lean_witness_is_preserved() {\n" ++
  "        assert_eq!({{ p.function_name }}(WITNESS_INPUT), WITNESS_OUTPUT);\n" ++
  "    }\n\n" ++
  "    #[test]\n" ++
  "    fn lean_bound_is_preserved() {\n" ++
  "        for input in 0..=(BOUND + 2) {\n" ++
  "            assert!({{ p.function_name }}(input) <= BOUND);\n" ++
  "        }\n" ++
  "    }\n\n" ++
  "    #[test]\n" ++
  "    fn lean_fixed_point_is_preserved() {\n" ++
  "        assert_eq!({{ p.function_name }}(BOUND), BOUND);\n" ++
  "    }\n" ++
  "}\n"

def rustMain : String :=
  "use std::{fs, path::PathBuf};\n\n" ++
  "use lean_proof_cell::{bounded_step, WITNESS_INPUT};\n\n" ++
  "fn main() {\n" ++
  "    let input = std::env::args()\n" ++
  "        .nth(1)\n" ++
  "        .map(|value| value.parse::<u64>().expect(\"input must be a u64\"))\n" ++
  "        .unwrap_or(WITNESS_INPUT);\n" ++
  "    let output = bounded_step(input);\n" ++
  "    let proof_path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n" ++
  "        .join(\"../lean/proof-receipt.json\");\n" ++
  "    let proof_bytes = fs::read(proof_path).expect(\"Lean proof receipt must exist\");\n" ++
  "    let proof_digest = blake3::hash(&proof_bytes).to_hex();\n" ++
  "    let mut receipt = String::from(\"{\\\"schema\\\":\\\"ggen.lean4-rust/execution/v1\\\",\\\"standing\\\":\\\"EXECUTED\\\",\\\"input\\\":\");\n" ++
  "    receipt.push_str(&input.to_string());\n" ++
  "    receipt.push_str(\",\\\"output\\\":\");\n" ++
  "    receipt.push_str(&output.to_string());\n" ++
  "    receipt.push_str(\",\\\"lean_proof_blake3\\\":\\\"\");\n" ++
  "    receipt.push_str(&proof_digest);\n" ++
  "    receipt.push_str(\"\\\"}\");\n" ++
  "    println!(\"{receipt}\");\n" ++
  "}\n"

def emitRust (receipt : ProofReceipt) : IO Unit := do
  IO.FS.createDirAll "../rust/src"
  IO.FS.writeFile "proof-receipt.json" (proofReceiptJson receipt)
  IO.FS.writeFile "../rust/Cargo.toml" cargoToml
  IO.FS.writeFile "../rust/src/lib.rs" rustLib
  IO.FS.writeFile "../rust/src/main.rs" rustMain

def main : IO Unit := emitRust proofReceipt

end Lean4Rust

def main : IO Unit := Lean4Rust.main
{% endfor %}