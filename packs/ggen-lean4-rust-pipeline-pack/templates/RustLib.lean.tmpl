---
to: generated/lean/RustLib.lean
force: true
sparql:
  pipeline: |
    PREFIX lr: <https://chatmangpt.com/ontology/lean4-rust#>
    SELECT ?crate_name ?function_name WHERE {
      ?pipeline a lr:Pipeline ;
                lr:crateName ?crate_name ;
                lr:rustFunctionName ?function_name .
    }
    LIMIT 1
---
{% for p in pipeline %}import Fortune5Policy

namespace Lean4Rust

def cargoToml : String :=
  "[package]\n" ++
  "name = \"{{ p.crate_name }}\"\n" ++
  "version = \"0.2.0\"\n" ++
  "edition = \"2024\"\n" ++
  "default-run = \"{{ p.crate_name }}\"\n\n" ++
  "[dependencies]\n" ++
  "blake3 = \"1.8\"\n\n" ++
  "[workspace]\n"

def rustLib : String :=
  "//! GENERATED by the ggen-first Lean 4 proof emitter.\n" ++
  "//! Lean admits the bounded-successor and Fortune 5 deployment-policy theorem bundles\n" ++
  "//! before this Rust surface can exist.\n\n" ++
  "pub const BOUND: u64 = " ++ toString bound ++ ";\n" ++
  "pub const WITNESS_INPUT: u64 = " ++ toString witnessInput ++ ";\n" ++
  "pub const WITNESS_OUTPUT: u64 = " ++ toString witnessOutput ++ ";\n" ++
  "pub const R1_P99_NS: u64 = " ++ toString r1P99Nanos ++ ";\n" ++
  "pub const R1_TICK_BUDGET: u64 = " ++ toString r1TickBudget ++ ";\n" ++
  "pub const W1_P99_NS: u64 = " ++ toString w1P99Nanos ++ ";\n" ++
  "pub const C1_P99_NS: u64 = " ++ toString c1P99Nanos ++ ";\n" ++
  "pub const REGION_COUNT: u64 = " ++ toString regionCount ++ ";\n" ++
  "pub const REGION_QUORUM: u64 = " ++ toString regionQuorum ++ ";\n" ++
  "pub const SPIFFE_ID: &str = \"" ++ spiffeId ++ "\";\n" ++
  "pub const CERTIFICATE_REFRESH_SECONDS: u64 = " ++ toString certificateRefreshSeconds ++ ";\n" ++
  "pub const KEY_ROTATION_SECONDS: u64 = " ++ toString keyRotationSeconds ++ ";\n" ++
  "pub const CANARY_REQUIRED: bool = true;\n" ++
  "pub const STAGING_VALIDATION_REQUIRED: bool = true;\n" ++
  "pub const AUTO_ROLLBACK_REQUIRED: bool = true;\n" ++
  "pub const PROMOTION_RECEIPT_REQUIRED: bool = true;\n" ++
  "pub const CROSS_REGION_REPLICATION_REQUIRED: bool = true;\n" ++
  "pub const RECEIPT_SYNCHRONIZATION_REQUIRED: bool = true;\n" ++
  "pub const FAILOVER_REQUIRED: bool = true;\n" ++
  "pub const LEGAL_HOLD_REQUIRED: bool = true;\n" ++
  "pub const MTLS_REQUIRED: bool = true;\n" ++
  "pub const AWS_KMS_REQUIRED: bool = true;\n" ++
  "pub const AZURE_KEY_VAULT_REQUIRED: bool = true;\n" ++
  "pub const HASHICORP_VAULT_REQUIRED: bool = true;\n" ++
  "pub const NETWORK_POLICY_REQUIRED: bool = true;\n" ++
  "pub const FIREWALL_POLICY_REQUIRED: bool = true;\n" ++
  "pub const OTEL_REQUIRED: bool = true;\n" ++
  "pub const SLO_ALERT_REQUIRED: bool = true;\n" ++
  "pub const GUARD_ALERT_REQUIRED: bool = true;\n" ++
  "pub const RECEIPT_MISMATCH_ALERT_REQUIRED: bool = true;\n" ++
  "pub const PERFORMANCE_DEGRADATION_ALERT_REQUIRED: bool = true;\n" ++
  "pub const SUPPORTED_KMS_PROVIDERS: [&str; 3] = [\"aws-kms\", \"azure-key-vault\", \"hashicorp-vault\"];\n\n" ++
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n" ++
  "pub enum SloClass { R1, W1, C1 }\n\n" ++
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n" ++
  "pub enum DeploymentStage { Canary, Staging, Production }\n\n" ++
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n" ++
  "pub enum PromotionDecision { PromoteStaging, PromoteProduction, Hold, Rollback, Refuse }\n\n" ++
  "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n" ++
  "pub struct DeploymentObservation {\n" ++
  "    pub stage: DeploymentStage,\n" ++
  "    pub slo_class: SloClass,\n" ++
  "    pub observed_p99_ns: u64,\n" ++
  "    pub observed_p99_ticks: u64,\n" ++
  "    pub canary_validated: bool,\n" ++
  "    pub staging_validated: bool,\n" ++
  "    pub quorum_acks: u64,\n" ++
  "    pub receipt_synchronized: bool,\n" ++
  "    pub failover_ready: bool,\n" ++
  "    pub legal_hold_ready: bool,\n" ++
  "    pub spiffe_authenticated: bool,\n" ++
  "    pub certificate_age_seconds: u64,\n" ++
  "    pub key_age_seconds: u64,\n" ++
  "    pub mtls_established: bool,\n" ++
  "    pub network_policy_enforced: bool,\n" ++
  "    pub firewall_policy_enforced: bool,\n" ++
  "    pub otel_correlated: bool,\n" ++
  "}\n\n" ++
  "pub fn {{ p.function_name }}(x: u64) -> u64 {\n" ++
  "    if x < BOUND { x + 1 } else { BOUND }\n" ++
  "}\n\n" ++
  "pub const fn slo_target_ns(class: SloClass) -> u64 {\n" ++
  "    match class { SloClass::R1 => R1_P99_NS, SloClass::W1 => W1_P99_NS, SloClass::C1 => C1_P99_NS }\n" ++
  "}\n\n" ++
  "pub const fn slo_class_name(class: SloClass) -> &'static str {\n" ++
  "    match class { SloClass::R1 => \"R1\", SloClass::W1 => \"W1\", SloClass::C1 => \"C1\" }\n" ++
  "}\n\n" ++
  "pub const fn stage_name(stage: DeploymentStage) -> &'static str {\n" ++
  "    match stage { DeploymentStage::Canary => \"CANARY\", DeploymentStage::Staging => \"STAGING\", DeploymentStage::Production => \"PRODUCTION\" }\n" ++
  "}\n\n" ++
  "pub const fn promotion_decision_name(decision: PromotionDecision) -> &'static str {\n" ++
  "    match decision {\n" ++
  "        PromotionDecision::PromoteStaging => \"PROMOTE_STAGING\",\n" ++
  "        PromotionDecision::PromoteProduction => \"PROMOTE_PRODUCTION\",\n" ++
  "        PromotionDecision::Hold => \"HOLD\",\n" ++
  "        PromotionDecision::Rollback => \"ROLLBACK\",\n" ++
  "        PromotionDecision::Refuse => \"REFUSE\",\n" ++
  "    }\n" ++
  "}\n\n" ++
  "pub const fn slo_compliant(observation: &DeploymentObservation) -> bool {\n" ++
  "    match observation.slo_class {\n" ++
  "        SloClass::R1 => observation.observed_p99_ns <= R1_P99_NS && observation.observed_p99_ticks <= R1_TICK_BUDGET,\n" ++
  "        SloClass::W1 => observation.observed_p99_ns <= W1_P99_NS,\n" ++
  "        SloClass::C1 => observation.observed_p99_ns <= C1_P99_NS,\n" ++
  "    }\n" ++
  "}\n\n" ++
  "pub const fn all_promotion_gates(observation: &DeploymentObservation) -> bool {\n" ++
  "    CANARY_REQUIRED && observation.canary_validated\n" ++
  "        && STAGING_VALIDATION_REQUIRED && observation.staging_validated\n" ++
  "        && observation.quorum_acks >= REGION_QUORUM\n" ++
  "        && CROSS_REGION_REPLICATION_REQUIRED\n" ++
  "        && RECEIPT_SYNCHRONIZATION_REQUIRED && observation.receipt_synchronized\n" ++
  "        && FAILOVER_REQUIRED && observation.failover_ready\n" ++
  "        && LEGAL_HOLD_REQUIRED && observation.legal_hold_ready\n" ++
  "        && observation.spiffe_authenticated\n" ++
  "        && observation.certificate_age_seconds <= CERTIFICATE_REFRESH_SECONDS\n" ++
  "        && observation.key_age_seconds <= KEY_ROTATION_SECONDS\n" ++
  "        && MTLS_REQUIRED && observation.mtls_established\n" ++
  "        && AWS_KMS_REQUIRED && AZURE_KEY_VAULT_REQUIRED && HASHICORP_VAULT_REQUIRED\n" ++
  "        && NETWORK_POLICY_REQUIRED && observation.network_policy_enforced\n" ++
  "        && FIREWALL_POLICY_REQUIRED && observation.firewall_policy_enforced\n" ++
  "        && OTEL_REQUIRED && observation.otel_correlated\n" ++
  "        && SLO_ALERT_REQUIRED && GUARD_ALERT_REQUIRED\n" ++
  "        && RECEIPT_MISMATCH_ALERT_REQUIRED && PERFORMANCE_DEGRADATION_ALERT_REQUIRED\n" ++
  "        && PROMOTION_RECEIPT_REQUIRED\n" ++
  "}\n\n" ++
  "pub const fn evaluate_promotion(observation: &DeploymentObservation) -> PromotionDecision {\n" ++
  "    if !slo_compliant(observation) {\n" ++
  "        PromotionDecision::Rollback\n" ++
  "    } else if !all_promotion_gates(observation) {\n" ++
  "        PromotionDecision::Refuse\n" ++
  "    } else {\n" ++
  "        match observation.stage {\n" ++
  "            DeploymentStage::Canary => PromotionDecision::PromoteStaging,\n" ++
  "            DeploymentStage::Staging => PromotionDecision::PromoteProduction,\n" ++
  "            DeploymentStage::Production => PromotionDecision::Hold,\n" ++
  "        }\n" ++
  "    }\n" ++
  "}\n\n" ++
  "pub const fn canonical_observation() -> DeploymentObservation {\n" ++
  "    DeploymentObservation {\n" ++
  "        stage: DeploymentStage::Staging, slo_class: SloClass::C1, observed_p99_ns: 400_000_000, observed_p99_ticks: 0,\n" ++
  "        canary_validated: true, staging_validated: true, quorum_acks: 3, receipt_synchronized: true,\n" ++
  "        failover_ready: true, legal_hold_ready: true, spiffe_authenticated: true,\n" ++
  "        certificate_age_seconds: 1_800, key_age_seconds: 3_600, mtls_established: true,\n" ++
  "        network_policy_enforced: true, firewall_policy_enforced: true, otel_correlated: true,\n" ++
  "    }\n" ++
  "}\n\n" ++
  "pub fn scenario_observation(name: &str) -> Option<DeploymentObservation> {\n" ++
  "    let mut observation = canonical_observation();\n" ++
  "    match name {\n" ++
  "        \"canonical\" => {},\n" ++
  "        \"canary\" => observation.stage = DeploymentStage::Canary,\n" ++
  "        \"production\" => observation.stage = DeploymentStage::Production,\n" ++
  "        \"slo-violation\" => observation.observed_p99_ns = C1_P99_NS + 1,\n" ++
  "        \"quorum-loss\" => observation.quorum_acks = REGION_QUORUM - 1,\n" ++
  "        \"security-expired\" => { observation.certificate_age_seconds = CERTIFICATE_REFRESH_SECONDS + 1; observation.key_age_seconds = KEY_ROTATION_SECONDS + 1; },\n" ++
  "        \"receipt-mismatch\" => observation.receipt_synchronized = false,\n" ++
  "        \"failover-unready\" => observation.failover_ready = false,\n" ++
  "        _ => return None,\n" ++
  "    }\n" ++
  "    Some(observation)\n" ++
  "}\n\n" ++
  "pub fn regional_receipt_digest(proof_bytes: &[u8], scenario: &str, quorum_acks: u64) -> String {\n" ++
  "    let mut hasher = blake3::Hasher::new();\n" ++
  "    hasher.update(proof_bytes);\n" ++
  "    hasher.update(scenario.as_bytes());\n" ++
  "    hasher.update(&REGION_COUNT.to_le_bytes());\n" ++
  "    hasher.update(&quorum_acks.to_le_bytes());\n" ++
  "    hasher.finalize().to_hex().to_string()\n" ++
  "}\n\n" ++
  "#[cfg(test)]\n" ++
  "mod tests {\n" ++
  "    use super::*;\n\n" ++
  "    #[test]\n" ++
  "    fn lean_witness_is_preserved() { assert_eq!({{ p.function_name }}(WITNESS_INPUT), WITNESS_OUTPUT); }\n\n" ++
  "    #[test]\n" ++
  "    fn lean_bound_is_preserved() { for input in 0..=(BOUND + 2) { assert!({{ p.function_name }}(input) <= BOUND); } }\n\n" ++
  "    #[test]\n" ++
  "    fn lean_fixed_point_is_preserved() { assert_eq!({{ p.function_name }}(BOUND), BOUND); }\n\n" ++
  "    #[test]\n" ++
  "    fn fortune5_slo_targets_are_ordered() { assert!(R1_P99_NS < W1_P99_NS && W1_P99_NS < C1_P99_NS); }\n\n" ++
  "    #[test]\n" ++
  "    fn canonical_staging_promotes_to_production() { assert_eq!(evaluate_promotion(&canonical_observation()), PromotionDecision::PromoteProduction); }\n\n" ++
  "    #[test]\n" ++
  "    fn canary_promotes_to_staging() { assert_eq!(evaluate_promotion(&scenario_observation(\"canary\").unwrap()), PromotionDecision::PromoteStaging); }\n\n" ++
  "    #[test]\n" ++
  "    fn production_holds() { assert_eq!(evaluate_promotion(&scenario_observation(\"production\").unwrap()), PromotionDecision::Hold); }\n\n" ++
  "    #[test]\n" ++
  "    fn slo_violation_rolls_back() { assert_eq!(evaluate_promotion(&scenario_observation(\"slo-violation\").unwrap()), PromotionDecision::Rollback); }\n\n" ++
  "    #[test]\n" ++
  "    fn quorum_loss_refuses() { assert_eq!(evaluate_promotion(&scenario_observation(\"quorum-loss\").unwrap()), PromotionDecision::Refuse); }\n\n" ++
  "    #[test]\n" ++
  "    fn expired_security_refuses() { assert_eq!(evaluate_promotion(&scenario_observation(\"security-expired\").unwrap()), PromotionDecision::Refuse); }\n\n" ++
  "    #[test]\n" ++
  "    fn receipt_mismatch_refuses() { assert_eq!(evaluate_promotion(&scenario_observation(\"receipt-mismatch\").unwrap()), PromotionDecision::Refuse); }\n\n" ++
  "    #[test]\n" ++
  "    fn failover_unready_refuses() { assert_eq!(evaluate_promotion(&scenario_observation(\"failover-unready\").unwrap()), PromotionDecision::Refuse); }\n\n" ++
  "    #[test]\n" ++
  "    fn all_kms_and_network_controls_are_required() { assert_eq!(SUPPORTED_KMS_PROVIDERS, [\"aws-kms\", \"azure-key-vault\", \"hashicorp-vault\"]); assert!(MTLS_REQUIRED && NETWORK_POLICY_REQUIRED && FIREWALL_POLICY_REQUIRED); }\n\n" ++
  "    #[test]\n" ++
  "    fn regional_receipt_digest_changes_with_quorum() { let proof = b\"proof\"; assert_ne!(regional_receipt_digest(proof, \"canonical\", 3), regional_receipt_digest(proof, \"canonical\", 2)); }\n" ++
  "}\n"

end Lean4Rust
{% endfor %}
