@prefix lr:      <https://chatmangpt.com/ontology/lean4-rust#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

lr:Pipeline a rdfs:Class ;
    rdfs:label "ggen-first Lean 4 to Rust pipeline" ;
    rdfs:subClassOf prov:Activity .

lr:LeanProofProgram a rdfs:Class ;
    rdfs:label "Lean proof and Rust emitter" ;
    rdfs:subClassOf prov:Entity .

lr:RustArtifact a rdfs:Class ;
    rdfs:label "Rust artifact emitted by an admitted Lean program" ;
    rdfs:subClassOf prov:Entity .

lr:ProofReceipt a rdfs:Class ;
    rdfs:label "Lean proof admission receipt" ;
    rdfs:subClassOf prov:Entity .

lr:ExecutionReceipt a rdfs:Class ;
    rdfs:label "Rust execution receipt bound to a Lean proof receipt" ;
    rdfs:subClassOf prov:Entity .

lr:Fortune5Policy a rdfs:Class ;
    rdfs:label "Fortune 5 deployment admission and promotion policy" ;
    rdfs:subClassOf prov:Entity .

lr:crateName a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:identifier .
lr:rustFunctionName a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:identifier .
lr:leanToolchain a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:requires .
lr:bound a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:witnessInput a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:witnessOutput a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:proofTheorem a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:references .
lr:witnessTheorem a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:references .
lr:fixedPointTheorem a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:references .
lr:receiptAlgorithm a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:format .

lr:r1P99Nanos a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:r1TickBudget a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:w1P99Nanos a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:c1P99Nanos a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:nonNegativeInteger .
lr:r1Measurement a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string .
lr:w1Measurement a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string .
lr:c1Measurement a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:string .

lr:canaryRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:stagingValidationRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:autoRollbackRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:promotionReceiptRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .

lr:regionCount a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:positiveInteger .
lr:regionQuorum a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:positiveInteger .
lr:crossRegionReplicationRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:receiptSynchronizationRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:failoverRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:legalHoldRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .

lr:spiffeId a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:anyURI .
lr:certificateRefreshSeconds a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:positiveInteger .
lr:keyRotationSeconds a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:positiveInteger .
lr:mtlsRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:awsKmsRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:azureKeyVaultRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:hashicorpVaultRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:networkPolicyRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:firewallPolicyRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .

lr:otelRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:sloAlertRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:guardAlertRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:receiptMismatchAlertRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .
lr:performanceDegradationAlertRequired a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range xsd:boolean .

lr:manufactures a rdf:Property ; rdfs:domain lr:Pipeline ; rdfs:range prov:Entity ; rdfs:subPropertyOf prov:generated .
lr:admittedBy a rdf:Property ; rdfs:domain lr:RustArtifact ; rdfs:range lr:ProofReceipt ; rdfs:subPropertyOf prov:wasDerivedFrom .
lr:bindsProofReceipt a rdf:Property ; rdfs:domain lr:ExecutionReceipt ; rdfs:range lr:ProofReceipt ; rdfs:subPropertyOf prov:wasDerivedFrom .
