---
to: "docs/k8s-design-sketch/pod-resource-summary.md"
sparql:
  rows: |
    PREFIX k8s: <http://seanchatmangpt.github.io/packs/k8s#>
    SELECT ?podName ?containerIndex ?containerName ?image ?cpuLimit ?memoryLimit WHERE {
      ?pod a k8s:PodSpec ; k8s:podName ?podName ; k8s:hasContainer ?c .
      ?c k8s:containerIndex ?containerIndex ; k8s:containerName ?containerName ; k8s:image ?image .
      OPTIONAL {
        ?c k8s:hasResourceRequirements ?rr .
        ?rr k8s:cpuLimit ?cpuLimit ; k8s:memoryLimit ?memoryLimit .
      }
    } ORDER BY ?podName ?containerIndex
---
