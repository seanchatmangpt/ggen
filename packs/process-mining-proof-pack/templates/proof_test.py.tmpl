import importlib

PIPELINE_NAME = "{{ row.pipelineName }}"
PLANNER = "{{ row.planner }}"
DOMAIN = "{{ row.domain }}"
POWL_PROJECTOR = "{{ row.powlProjector }}"
OCEL_REPLAY_ENGINE = "{{ row.ocelReplayEngine }}"
CONFORMANCE_CHECKER = "{{ row.conformanceChecker }}"


def _resolve(dotted_path: str):
    """Real dynamic import + attribute lookup -- no fabrication: this either
    resolves to the real object the ontology named, or raises."""
    module_name, _, attr = dotted_path.rpartition(".")
    module = importlib.import_module(module_name)
    return getattr(module, attr)


def test_every_declared_stage_function_resolves_to_a_real_callable():
    """PLANNER/DOMAIN are descriptive (PLANNER may be a call expression, not a
    bare dotted path; DOMAIN is a directory), so only the three real,
    dotted-importable stage functions are resolved and checked here. Each was
    admitted by gates/010_pipeline_grounded_or_refused.rq -- an incomplete
    pipeline could not have reached this generated file at all."""
    for dotted_path in (POWL_PROJECTOR, OCEL_REPLAY_ENGINE, CONFORMANCE_CHECKER):
        target = _resolve(dotted_path)
        assert callable(target), f"{dotted_path} must resolve to a real callable"
