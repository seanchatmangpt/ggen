               gsh:mustNotDo ?mustNot ; gsh:acceptanceCriterion ?acceptance ;
               gsh:verificationCommand ?verify ; gsh:status ?status .
      ?severityNode skos:prefLabel ?severity .
    } ORDER BY ?order ?category ?id
