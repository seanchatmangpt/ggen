---
to: generated/GGEN_SELF_HOST_JIRA.csv
sparql:
  findings: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?severity ?id ?category ?summary ?rationale ?evidence ?must ?mustNot ?acceptance ?verify WHERE {
      ?f a gsh:Finding ; gsh:findingId ?id ; gsh:category ?category ; gsh:severity ?severityNode ;
         gsh:severityOrder ?order ; gsh:summary ?summary ; gsh:rationale ?rationale ;
         gsh:evidencePath ?evidence ; gsh:mustDo ?must ; gsh:mustNotDo ?mustNot ;
         gsh:acceptanceCriterion ?acceptance ; gsh:verificationCommand ?verify .
      ?severityNode skos:prefLabel ?severity .
    } ORDER BY ?order ?category ?id
---
External ID,Issue Type,Summary,Priority,Labels,Description
{% for row in findings %}"{{ row.id }}","Task","{{ row.summary | replace(from="\"", to="\"\"") }}","{{ row.severity }}","ggen-self-host,{{ row.category }}","WHY: {{ row.rationale | replace(from="\"", to="\"\"") }} MUST: {{ row.must | replace(from="\"", to="\"\"") }} MUST NOT: {{ row.mustNot | replace(from="\"", to="\"\"") }} ACCEPTANCE: {{ row.acceptance | replace(from="\"", to="\"\"") }} EVIDENCE: {{ row.evidence }} VERIFY: {{ row.verify | replace(from="\"", to="\"\"") }}"
{% endfor %}