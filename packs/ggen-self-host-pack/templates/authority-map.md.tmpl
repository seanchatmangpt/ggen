---
to: generated/AUTHORITY_MAP.md
sparql:
  files: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT (GROUP_CONCAT(?line; separator="\n") AS ?rows) WHERE {
      {
        SELECT ?path ?label ?load ?generated WHERE {
          ?file a gsh:RepositoryFile ; gsh:path ?path ; gsh:authorityClass ?class ;
                gsh:loadBearing ?load ; gsh:generatedMarker ?generated .
          ?class skos:prefLabel ?label .
        } ORDER BY ?label ?path
      }
      BIND(CONCAT("| `", STR(?path), "` | ", STR(?label), " | ", STR(?load), " | ", STR(?generated), " |") AS ?line)
    }
