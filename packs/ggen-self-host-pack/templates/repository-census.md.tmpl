---
to: generated/REPOSITORY_CENSUS.md
sparql:
  program: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    SELECT ?revision ?digest ?files ?crates ?members ?packs ?workflows ?templates ?scripts ?generated ?findings ?blocking ?unknown WHERE {
      ?p a gsh:SelfHostProgram ; gsh:revision ?revision ; gsh:observationDigest ?digest ;
         gsh:fileCount ?files ; gsh:crateCount ?crates ; gsh:workspaceMemberCount ?members ;
         gsh:packCount ?packs ; gsh:workflowCount ?workflows ; gsh:templateCount ?templates ;
         gsh:scriptCount ?scripts ; gsh:generatedCount ?generated ; gsh:findingCount ?findings ;
         gsh:blockingFindingCount ?blocking ; gsh:unknownAuthorityCount ?unknown .
    }
  authorities: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?label (COUNT(?file) AS ?count) WHERE {
      ?file a gsh:RepositoryFile ; gsh:authorityClass ?class .
      ?class skos:prefLabel ?label .
    } GROUP BY ?label ORDER BY DESC(?count) ?label
  severities: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?label (COUNT(?finding) AS ?count) WHERE {
      ?finding a gsh:Finding ; gsh:severity ?severity ; gsh:severityOrder ?order .
      ?severity skos:prefLabel ?label .
    } GROUP BY ?order ?label ORDER BY ?order
---
