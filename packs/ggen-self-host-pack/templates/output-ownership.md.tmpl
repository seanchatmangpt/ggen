  claims: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    SELECT ?consumer ?path ?owner ?kind WHERE {
      ?claim a gsh:OutputClaim ; gsh:consumer ?consumer ; gsh:outputPath ?path ;
             gsh:owner ?owner ; gsh:claimKind ?kind .
    } ORDER BY ?consumer ?path ?owner
  collisions: |
    PREFIX gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#>
    SELECT ?consumer ?path (COUNT(?claim) AS ?writers) WHERE {
      ?claim a gsh:OutputClaim ; gsh:claimKind "active-manifest-rule" ;
             gsh:consumer ?consumer ; gsh:outputPath ?path .
    } GROUP BY ?consumer ?path HAVING(COUNT(?claim) > 1) ORDER BY ?consumer ?path
---
