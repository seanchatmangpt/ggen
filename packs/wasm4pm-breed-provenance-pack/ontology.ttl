@prefix wbp:  <http://seanchatmangpt.github.io/packs/wasm4pm-breed-provenance#> .
@prefix errc: <http://seanchatmangpt.github.io/packs/gh-actions-errc#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Vocabulary — the generalized domain-capability-pack shape, applied to a
# SECOND real duplication case: wasm4pm's 55-entry cognition-breed catalog
# (~/wasm4pm/ggen/ontology/breeds.ttl) is independently, fully re-admitted
# under the IDENTICAL subject IRIs and predicate vocabulary (compat:*) by
# TWO separate ggen packs -- packs/wasm4pm-facts-pack and
# packs/wasm4pm-cognition-pack -- confirmed 2026-08-11 by direct grep of
# both packs' real ontology.ttl: both declare exactly 55
# `a compat:CognitionBreed` individuals, and their 55 `compat:breedId`
# values are set-identical (diff of sorted extracted ids -> empty).
#
# wasm4pm-facts-pack DOES already drift-check ITSELF against the live
# ~/wasm4pm upstream checkout (scripts/check_upstream_drift.sh) -- that is
# a real, existing guard and is NOT this pack's target. What has NO guard
# anywhere in the workspace is pack-to-pack consistency: nothing checks
# that wasm4pm-cognition-pack's independently-typed 55-breed copy still
# matches wasm4pm-facts-pack's (or upstream's) 55-breed copy. If one pack's
# ontology.ttl is hand-edited (a breed added/removed/renamed) without the
# other being updated in lockstep, no gate in this workspace catches it --
# confirmed by reading both packs' gates/ directories: wasm4pm-facts-pack's
# gates/{010_required,020_single_valued,030_value_constraints}.rq validate
# its OWN graph shape only; wasm4pm-cognition-pack has no gates/ directory
# at all (`find packs/wasm4pm-cognition-pack -iname 'gates' -o -iname
# '*.rq'` -> empty).
#################################################################

wbp:Breed a rdfs:Class ;
    rdfs:label "One real wasm4pm cognition-breed identity, transcribed verbatim from the canonical upstream source (~/wasm4pm/ggen/ontology/breeds.ttl) -- never hand-summarized or invented." .

wbp:order a rdf:Property ; rdfs:domain wbp:Breed .
wbp:breedId a rdf:Property ; rdfs:domain wbp:Breed ;
    rdfs:comment "The real compat:breedId value from the canonical source -- the join key both consuming packs (wasm4pm-facts-pack, wasm4pm-cognition-pack) key their own copies on." .
wbp:sourceRepo a rdf:Property ; rdfs:domain wbp:Breed ;
    rdfs:comment "The real repo this breed identity's facts were transcribed from." .
wbp:sourceFile a rdf:Property ; rdfs:domain wbp:Breed ;
    rdfs:comment "The real file path within sourceRepo this breed identity's facts were transcribed from." .

wbp:PackAdoption a rdfs:Class ;
    rdfs:label "One consuming ggen pack's own admitted copy of the canonical breed set (the pack-projection). wbp:admits must be a strict subset of real wbp:Breed individuals -- enforced by gates/030_admits_subset.rq, not merely documented." .

wbp:ownerPack a rdf:Property ; rdfs:domain wbp:PackAdoption ;
    rdfs:comment "The real packs/<name> directory that independently re-admits this breed set." .
wbp:admits a rdf:Property ; rdfs:domain wbp:PackAdoption ; rdfs:range wbp:Breed .

wbp:BreedSourceManifest a rdfs:Class ;
    rdfs:label "Declares how many real wbp:Breed individuals SHOULD exist for one (sourceRepo, sourceFile) pair -- the count gate (gates/020_exact_count_per_source.rq) checks the real count against this, per source, mirroring domain-capability-pack's dcp:CapabilitySourceManifest so a second upstream source (a different wasm4pm ontology file, or a different platform's catalog) is an additive fact, not a rewrite of this pack's gates." .

wbp:manifestSourceRepo a rdf:Property ; rdfs:domain wbp:BreedSourceManifest .
wbp:manifestSourceFile a rdf:Property ; rdfs:domain wbp:BreedSourceManifest .
wbp:expectedBreedCount a rdf:Property ; rdfs:domain wbp:BreedSourceManifest .

#################################################################
# Worked instance: wasm4pm's real 55-breed catalog (2026-08-11)
#
# breedId values transcribed verbatim, in real declaration order, from
# packs/wasm4pm-cognition-pack/ontology.ttl (itself transcribed verbatim
# from ~/wasm4pm/ggen/ontology/breeds.ttl -- see that pack's own ontology.ttl
# header comment). Order follows the real declaration order in that file.
#################################################################

wbp:WasmBreedsManifest a wbp:BreedSourceManifest ;
    wbp:manifestSourceRepo "wasm4pm" ;
    wbp:manifestSourceFile "ggen/ontology/breeds.ttl" ;
    wbp:expectedBreedCount 55 .

wbp:Breed_strips a wbp:Breed ;
    wbp:order 1 ; wbp:breedId "strips" ;
    wbp:sourceRepo "wasm4pm" ; wbp:sourceFile "ggen/ontology/breeds.ttl" .

wbp:Breed_gps a wbp:Breed ;
