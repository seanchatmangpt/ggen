#################################################################
# Pack-projections: the two REAL, currently-shipping ggen packs that each
# independently re-admit this same 55-breed set under identical subject
# IRIs (packs/wasm4pm-facts-pack/ontology.ttl, packs/wasm4pm-cognition-pack/
# ontology.ttl) -- confirmed 2026-08-11 by direct grep: both declare all 55
# breedId values above, with zero divergence today. This is the drift risk
# this pack's gates exist to catch THE NEXT TIME one of those two packs is
# hand-edited without the other -- not a hypothetical, since domain-
# capability-pack's own SREGym instance already demonstrated exactly this
# failure mode (a hand-maintained copy silently going stale) in a sibling
# case.
#################################################################

wbp:WasmFactsPackAdoption a wbp:PackAdoption ;
    wbp:ownerPack "wasm4pm-facts-pack" ;
    wbp:admits wbp:Breed_strips, wbp:Breed_gps, wbp:Breed_htn_planning, wbp:Breed_partial_order_plan, wbp:Breed_prolog, wbp:Breed_default_logic, wbp:Breed_circumscription, wbp:Breed_description_logic, wbp:Breed_bayesian_network, wbp:Breed_dempster_shafer, wbp:Breed_fuzzy_logic, wbp:Breed_mycin, wbp:Breed_eliza, wbp:Breed_soar, wbp:Breed_act_r, wbp:Breed_hearsay, wbp:Breed_abductive_ibe, wbp:Breed_abductive_lp, wbp:Breed_allen_temporal, wbp:Breed_event_calculus, wbp:Breed_situation_calculus, wbp:Breed_ltl_monitor, wbp:Breed_ctl_check, wbp:Breed_analogy_sme, wbp:Breed_cbr, wbp:Breed_episodic_memory, wbp:Breed_frames_inheritance, wbp:Breed_script_sam, wbp:Breed_construction_grammar, wbp:Breed_autoinstinct_learning, wbp:Breed_autoinstinct_neurosis, wbp:Breed_autoinstinct_semantics, wbp:Breed_autoinstinct_vision, wbp:Breed_belief_merging, wbp:Breed_markov_logic, wbp:Breed_problog, wbp:Breed_csp_ac3, wbp:Breed_clp, wbp:Breed_asp, wbp:Breed_sat_cdcl, wbp:Breed_tableaux, wbp:Breed_contingent_plan, wbp:Breed_mdp, wbp:Breed_pomdp, wbp:Breed_ebl, wbp:Breed_ilp, wbp:Breed_rl_symbolic, wbp:Breed_version_space, wbp:Breed_dendral, wbp:Breed_naive_physics, wbp:Breed_qualitative_reason, wbp:Breed_morphological, wbp:Breed_triz, wbp:Breed_meta_reasoning, wbp:Breed_ocpm_route_discoverer .

wbp:WasmCognitionPackAdoption a wbp:PackAdoption ;
    wbp:ownerPack "wasm4pm-cognition-pack" ;
    wbp:admits wbp:Breed_strips, wbp:Breed_gps, wbp:Breed_htn_planning, wbp:Breed_partial_order_plan, wbp:Breed_prolog, wbp:Breed_default_logic, wbp:Breed_circumscription, wbp:Breed_description_logic, wbp:Breed_bayesian_network, wbp:Breed_dempster_shafer, wbp:Breed_fuzzy_logic, wbp:Breed_mycin, wbp:Breed_eliza, wbp:Breed_soar, wbp:Breed_act_r, wbp:Breed_hearsay, wbp:Breed_abductive_ibe, wbp:Breed_abductive_lp, wbp:Breed_allen_temporal, wbp:Breed_event_calculus, wbp:Breed_situation_calculus, wbp:Breed_ltl_monitor, wbp:Breed_ctl_check, wbp:Breed_analogy_sme, wbp:Breed_cbr, wbp:Breed_episodic_memory, wbp:Breed_frames_inheritance, wbp:Breed_script_sam, wbp:Breed_construction_grammar, wbp:Breed_autoinstinct_learning, wbp:Breed_autoinstinct_neurosis, wbp:Breed_autoinstinct_semantics, wbp:Breed_autoinstinct_vision, wbp:Breed_belief_merging, wbp:Breed_markov_logic, wbp:Breed_problog, wbp:Breed_csp_ac3, wbp:Breed_clp, wbp:Breed_asp, wbp:Breed_sat_cdcl, wbp:Breed_tableaux, wbp:Breed_contingent_plan, wbp:Breed_mdp, wbp:Breed_pomdp, wbp:Breed_ebl, wbp:Breed_ilp, wbp:Breed_rl_symbolic, wbp:Breed_version_space, wbp:Breed_dendral, wbp:Breed_naive_physics, wbp:Breed_qualitative_reason, wbp:Breed_morphological, wbp:Breed_triz, wbp:Breed_meta_reasoning, wbp:Breed_ocpm_route_discoverer .

#################################################################
# ERRC grid — reuses errc:Finding verbatim from packs/gh-actions-errc-pack
# (same class/predicate IRIs as domain-capability-pack, not reinvented a
# third/fourth time).
#################################################################

errc:EliminateDuplicatedBreedCatalog a errc:Finding ;
    rdfs:label "Eliminate: two independently-typed full copies of wasm4pm's 55-breed catalog with no cross-pack drift guard" ;
    errc:category "Eliminate" ;
    errc:statement "packs/wasm4pm-facts-pack/ontology.ttl and packs/wasm4pm-cognition-pack/ontology.ttl each independently declare all 55 compat:CognitionBreed individuals under identical subject IRIs, transcribed by two separate hand-authoring passes from the same upstream ~/wasm4pm/ggen/ontology/breeds.ttl. wasm4pm-facts-pack checks itself against upstream (scripts/check_upstream_drift.sh); nothing checks the two packs against EACH OTHER." ;
    errc:evidence "Direct grep, 2026-08-11: both files' `a compat:CognitionBreed` count is 55; sorted compat:breedId value sets are identical (diff -> empty). wasm4pm-cognition-pack has no gates/ directory at all." ;
    errc:impact "Eliminable once one pack imports/generates from the other instead of hand-duplicating -- named follow-up, out of scope for this pack version (matches domain-capability-pack's own precedent of admitting the fact, not fixing the upstream duplication, in its first version)." .

errc:CreateWasmBreedProvenancePack a errc:Finding ;
    rdfs:label "Create: packs/wasm4pm-breed-provenance-pack itself, generalizing domain-capability-pack's Capability/CapabilitySourceManifest/LabAllowlist shape to a SECOND real case" ;
    errc:category "Create" ;
    errc:statement "wbp:Breed / wbp:BreedSourceManifest / wbp:PackAdoption, admitting wasm4pm's real 55-breed catalog and both consuming packs' real (currently set-identical) adoption, with the same two gate shapes (exact-count-per-source, admits-subset) domain-capability-pack proved." ;
    errc:evidence "This pack's own ontology.ttl (55 wbp:Breed + 1 wbp:BreedSourceManifest + 2 wbp:PackAdoption individuals) and gates/." ;
    errc:impact "Proves the domain-capability-pack shape generalizes past its one original case (an external domain vs. one lab allowlist) to a different topology (one upstream source vs. two sibling-pack re-admissions of the SAME full set), without rewriting the pattern." .
