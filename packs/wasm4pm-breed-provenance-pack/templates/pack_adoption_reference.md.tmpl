---
to: "docs/wasm4pm-breed-provenance/breed-provenance.md"
sparql:
  rows: |
    PREFIX wbp: <http://seanchatmangpt.github.io/packs/wasm4pm-breed-provenance#>
    SELECT ?order ?breedId ?sourceRepo ?sourceFile ?adoptedByFacts ?adoptedByCognition WHERE {
      ?breed a wbp:Breed ; wbp:order ?order ; wbp:breedId ?breedId ;
          wbp:sourceRepo ?sourceRepo ; wbp:sourceFile ?sourceFile .
      BIND(EXISTS {
        ?factsAdoption a wbp:PackAdoption ; wbp:ownerPack "wasm4pm-facts-pack" ;
            wbp:admits ?breed .
      } AS ?adoptedByFacts)
      BIND(EXISTS {
        ?cogAdoption a wbp:PackAdoption ; wbp:ownerPack "wasm4pm-cognition-pack" ;
            wbp:admits ?breed .
      } AS ?adoptedByCognition)
    } ORDER BY ?order
---
