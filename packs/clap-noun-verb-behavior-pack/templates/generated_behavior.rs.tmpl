---
to: src/generated_behavior.rs
sparql:
  rows: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?crate_name WHERE { ?cli a cnv:Cli ; cnv:crateName ?crate_name . }
    ORDER BY ?crate_name
---
//! Closed behavior interpreter for `{{ rows[0].crate_name }}`.
//!
//! GENERATED by ggen. Ontology values select variants of this enum; they can
//! never inject Rust source or name an unresolved consumer handler.

use clap_noun_verb::{NounVerbError, Result};
use serde_json::{Map, Number, Value};

use crate::generated_boundaries::{self, FilesystemBoundarySpec};

/// Complete executable behavior admitted for one generated command.
#[derive(Clone, Copy, Debug, PartialEq)]
pub enum BehaviorSpec {
    /// Return bounded JSON data.
    StaticJson { json: &'static str },
    /// Return all typed command inputs as an object.
    Echo,
    /// Evaluate a closed binary operator over two named inputs.
    Expression {
        operator: &'static str,
        left: &'static str,
        right: &'static str,
    },
    /// Atomically create a JSON record through an admitted filesystem boundary.
    FilesystemWrite {
        boundary: FilesystemBoundarySpec,
        id_argument: &'static str,
    },
    /// Read sorted JSON records through an admitted filesystem boundary.
    FilesystemList { boundary: FilesystemBoundarySpec },
    /// Fail closed with an ontology-declared error.
    Refusal {
        code: &'static str,
        message: &'static str,
    },
}

/// Execute a generated behavior against typed inputs captured by the route.
pub fn execute(spec: BehaviorSpec, inputs: Map<String, Value>) -> Result<Value> {
    match spec {
        BehaviorSpec::StaticJson { json } => serde_json::from_str(json).map_err(|error| {
            NounVerbError::execution_error(format!("invalid admitted static JSON: {error}"))
        }),
        BehaviorSpec::Echo => Ok(Value::Object(inputs)),
        BehaviorSpec::Expression {
            operator,
            left,
            right,
        } => execute_expression(operator, left, right, &inputs),
        BehaviorSpec::FilesystemWrite {
            boundary,
            id_argument,
        } => {
            let id = inputs.get(id_argument).ok_or_else(|| {
                NounVerbError::execution_error(format!(
                    "generated behavior missing id argument {id_argument:?}"
                ))
            })?;
            let id = scalar_text(id)?;
            generated_boundaries::write_json(boundary, &id, &Value::Object(inputs))
        }
        BehaviorSpec::FilesystemList { boundary } => generated_boundaries::list_json(boundary),
        BehaviorSpec::Refusal { code, message } => {
            Err(NounVerbError::execution_error(format!("{code}: {message}")))
        }
    }
}

fn execute_expression(
    operator: &str, left_name: &str, right_name: &str, inputs: &Map<String, Value>,
) -> Result<Value> {
    let left = inputs.get(left_name).ok_or_else(|| {
        NounVerbError::execution_error(format!("expression missing argument {left_name:?}"))
    })?;
    let right = inputs.get(right_name).ok_or_else(|| {
        NounVerbError::execution_error(format!("expression missing argument {right_name:?}"))
    })?;

    match operator {
        "concat" => Ok(Value::String(format!(
            "{}{}",
            scalar_text(left)?,
            scalar_text(right)?
        ))),
        "add" | "subtract" | "multiply" | "divide" => numeric_op(operator, left, right),
        other => Err(NounVerbError::execution_error(format!(
            "unsupported generated expression operator {other:?}"
        ))),
    }
}

/// Evaluate `add`/`subtract`/`multiply`/`divide` while preserving the
/// declared `i64` type from the ontology (`cnv:valueKind`) when both
/// operands are exact integers. Falls back to `f64` arithmetic when either
/// operand isn't representable as `i64`, or when `divide` doesn't produce
/// an exact integer quotient -- otherwise `add(2i64, 3i64)` would silently
/// return the JSON float `5.0` instead of the JSON integer `5`, breaking
/// the ontology's own type contract for every integer-typed argument.
fn numeric_op(operator: &str, left: &Value, right: &Value) -> Result<Value> {
    if let (Some(left), Some(right)) = (left.as_i64(), right.as_i64()) {
        return integer_op(operator, left, right);
    }
    float_op(operator, left, right)
}

fn integer_op(operator: &str, left: i64, right: i64) -> Result<Value> {
    let checked = match operator {
        "add" => left.checked_add(right),
        "subtract" => left.checked_sub(right),
        "multiply" => left.checked_mul(right),
        "divide" => {
            if right == 0 {
                return Err(NounVerbError::execution_error(
                    "division by zero was refused",
                ));
            }
            if left % right != 0 {
                // Not an exact integer quotient: fall back to float
                // precision rather than silently truncate.
                return numeric_value(left as f64 / right as f64);
            }
            left.checked_div(right)
        }
        other => {
            return Err(NounVerbError::execution_error(format!(
                "unsupported generated expression operator {other:?}"
            )))
        }
    };
    checked
        .map(|value| Value::Number(Number::from(value)))
        .ok_or_else(|| NounVerbError::execution_error("integer expression overflowed i64"))
}

fn float_op(operator: &str, left: &Value, right: &Value) -> Result<Value> {
    let left = as_f64(left)?;
    let right = as_f64(right)?;
    match operator {
        "add" => numeric_value(left + right),
        "subtract" => numeric_value(left - right),
        "multiply" => numeric_value(left * right),
        "divide" => {
            if is_signed_zero(right) {
                return Err(NounVerbError::execution_error(
                    "division by zero was refused",
                ));
            }
            numeric_value(left / right)
        }
        other => Err(NounVerbError::execution_error(format!(
            "unsupported generated expression operator {other:?}"
        ))),
    }
}

fn is_signed_zero(value: f64) -> bool {
    matches!(value.to_bits(), 0 | 0x8000_0000_0000_0000)
}

fn as_f64(value: &Value) -> Result<f64> {
    value.as_f64().ok_or_else(|| {
        NounVerbError::execution_error(format!("expected numeric JSON value, found {value}"))
    })
}

fn numeric_value(value: f64) -> Result<Value> {
    Number::from_f64(value)
        .map(Value::Number)
        .ok_or_else(|| NounVerbError::execution_error("expression produced a non-finite number"))
}

fn scalar_text(value: &Value) -> Result<String> {
    match value {
        Value::String(value) => Ok(value.clone()),
        Value::Bool(value) => Ok(value.to_string()),
        Value::Number(value) => Ok(value.to_string()),
        Value::Null | Value::Array(_) | Value::Object(_) => Err(NounVerbError::execution_error(
            format!("expected scalar JSON value, found {value}"),
        )),
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::json;

    #[test]
    fn static_json_is_data_not_source() {
        let value = execute(
            BehaviorSpec::StaticJson {
                json: r#"{"status":"alive"}"#,
            },
            Map::new(),
        )
        .unwrap();
        assert_eq!(value, json!({ "status": "alive" }));
    }

    #[test]
    fn expression_add_preserves_integer_type() {
        let mut inputs = Map::new();
        inputs.insert("left".to_owned(), json!(2));
        inputs.insert("right".to_owned(), json!(3));
        let value = execute(
            BehaviorSpec::Expression {
                operator: "add",
                left: "left",
                right: "right",
            },
            inputs,
        )
        .unwrap();
        // Both operands are JSON integers, so the result must stay an
        // integer (5), not silently widen to a float (5.0).
        assert_eq!(value, json!(5));
        assert!(value.as_i64().is_some());
    }

    #[test]
    fn expression_divide_falls_back_to_float_on_inexact_quotient() {
        let mut inputs = Map::new();
        inputs.insert("left".to_owned(), json!(7));
        inputs.insert("right".to_owned(), json!(2));
        let value = execute(
            BehaviorSpec::Expression {
                operator: "divide",
                left: "left",
                right: "right",
            },
            inputs,
        )
        .unwrap();
        assert_eq!(value, json!(3.5));
    }

    #[test]
    fn expression_add_with_float_input_stays_float() {
        let mut inputs = Map::new();
        inputs.insert("left".to_owned(), json!(2.5));
        inputs.insert("right".to_owned(), json!(1.5));
        let value = execute(
            BehaviorSpec::Expression {
                operator: "add",
                left: "left",
                right: "right",
            },
            inputs,
        )
        .unwrap();
        assert_eq!(value, json!(4.0));
    }

    #[test]
    fn division_by_signed_zero_fails_closed() {
        for divisor in [0.0, -0.0] {
            let mut inputs = Map::new();
            inputs.insert("left".to_owned(), json!(2));
            inputs.insert("right".to_owned(), json!(divisor));
            assert!(
                execute(
                    BehaviorSpec::Expression {
                        operator: "divide",
                        left: "left",
                        right: "right",
                    },
                    inputs,
                )
                .is_err()
            );
        }
    }
}
