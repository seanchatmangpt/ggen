//! Closed behavior interpreter for `{{ rows[0].crate_name }}`.
//!
//! GENERATED by ggen. Ontology values select variants of this enum; they can
//! never inject Rust source or name an unresolved consumer handler.

use clap_noun_verb::{NounVerbError, Result};
use serde_json::{Map, Number, Value};

use crate::generated_boundaries::{self, FilesystemBoundarySpec};

/// Complete executable behavior admitted for one generated command.
#[derive(Clone, Copy, Debug, PartialEq)]
pub enum BehaviorSpec {
    /// Return bounded JSON data.
    StaticJson { json: &'static str },
    /// Return all typed command inputs as an object.
    Echo,
    /// Evaluate a closed binary operator over two named inputs.
    Expression {
        operator: &'static str,
        left: &'static str,
        right: &'static str,
    },
    /// Atomically create a JSON record through an admitted filesystem boundary.
    FilesystemWrite {
        boundary: FilesystemBoundarySpec,
        id_argument: &'static str,
    },
    /// Read sorted JSON records through an admitted filesystem boundary.
    FilesystemList { boundary: FilesystemBoundarySpec },
    /// Fail closed with an ontology-declared error.
    Refusal {
        code: &'static str,
        message: &'static str,
    },
}

/// Execute a generated behavior against typed inputs captured by the route.
pub fn execute(spec: BehaviorSpec, inputs: Map<String, Value>) -> Result<Value> {
    match spec {
        BehaviorSpec::StaticJson { json } => serde_json::from_str(json).map_err(|error| {
            NounVerbError::execution_error(format!("invalid admitted static JSON: {error}"))
        }),
        BehaviorSpec::Echo => Ok(Value::Object(inputs)),
        BehaviorSpec::Expression {
            operator,
            left,
            right,
        } => execute_expression(operator, left, right, &inputs),
        BehaviorSpec::FilesystemWrite {
            boundary,
            id_argument,
        } => {
            let id = inputs.get(id_argument).ok_or_else(|| {
                NounVerbError::execution_error(format!(
                    "generated behavior missing id argument {id_argument:?}"
                ))
            })?;
            let id = scalar_text(id)?;
            generated_boundaries::write_json(boundary, &id, &Value::Object(inputs))
        }
        BehaviorSpec::FilesystemList { boundary } => generated_boundaries::list_json(boundary),
        BehaviorSpec::Refusal { code, message } => Err(NounVerbError::execution_error(format!(
            "{code}: {message}"
        ))),
    }
}

fn execute_expression(
    operator: &str,
    left_name: &str,
    right_name: &str,
    inputs: &Map<String, Value>,
) -> Result<Value> {
    let left = inputs.get(left_name).ok_or_else(|| {
        NounVerbError::execution_error(format!("expression missing argument {left_name:?}"))
    })?;
    let right = inputs.get(right_name).ok_or_else(|| {
        NounVerbError::execution_error(format!("expression missing argument {right_name:?}"))
    })?;

    match operator {
        "concat" => Ok(Value::String(format!(
            "{}{}",
            scalar_text(left)?,
            scalar_text(right)?
        ))),
        "add" => numeric_value(as_f64(left)? + as_f64(right)?),
        "subtract" => numeric_value(as_f64(left)? - as_f64(right)?),
        "multiply" => numeric_value(as_f64(left)? * as_f64(right)?),
        "divide" => {
            let divisor = as_f64(right)?;
            if divisor == 0.0 {
                return Err(NounVerbError::execution_error(
                    "division by zero was refused",
                ));
            }
            numeric_value(as_f64(left)? / divisor)
        }
        other => Err(NounVerbError::execution_error(format!(
            "unsupported generated expression operator {other:?}"
        ))),
    }
}

fn as_f64(value: &Value) -> Result<f64> {
    value.as_f64().ok_or_else(|| {
        NounVerbError::execution_error(format!("expected numeric JSON value, found {value}"))
    })
}

fn numeric_value(value: f64) -> Result<Value> {
    Number::from_f64(value).map(Value::Number).ok_or_else(|| {
        NounVerbError::execution_error("expression produced a non-finite number")
    })
}

fn scalar_text(value: &Value) -> Result<String> {
    match value {
        Value::String(value) => Ok(value.clone()),
        Value::Bool(value) => Ok(value.to_string()),
        Value::Number(value) => Ok(value.to_string()),
        Value::Null | Value::Array(_) | Value::Object(_) => Err(NounVerbError::execution_error(
            format!("expected scalar JSON value, found {value}"),
        )),
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde_json::json;

    #[test]
    fn static_json_is_data_not_source() {
        let value = execute(
            BehaviorSpec::StaticJson {
                json: r#"{"status":"alive"}"#,
            },
            Map::new(),
        )
        .unwrap();
        assert_eq!(value, json!({ "status": "alive" }));
    }

    #[test]
    fn expression_add_uses_typed_inputs() {
        let mut inputs = Map::new();
        inputs.insert("left".to_owned(), json!(2));
        inputs.insert("right".to_owned(), json!(3));
        let value = execute(
            BehaviorSpec::Expression {
                operator: "add",
                left: "left",
                right: "right",
            },
            inputs,
        )
        .unwrap();
        assert_eq!(value, json!(5.0));
    }

    #[test]
    fn division_by_zero_fails_closed() {
        let mut inputs = Map::new();
        inputs.insert("left".to_owned(), json!(2));
        inputs.insert("right".to_owned(), json!(0));
        assert!(execute(
            BehaviorSpec::Expression {
                operator: "divide",
                left: "left",
                right: "right",
            },
            inputs,
        )
        .is_err());
    }
}
