# Expected: 11 rows, capability/problem/* (TICKET-018).
PREFIX schema: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?c ?name WHERE {
  ?c a schema:Action ; schema:name ?name ;
     dcterms:isPartOf <https://github.com/seanchatmangpt/ggen/blob/main/packs/wasm4pm-interview-assist-pack/capability-category/problem> .
}
ORDER BY ?c
