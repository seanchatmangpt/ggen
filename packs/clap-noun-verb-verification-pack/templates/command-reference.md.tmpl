---
to: docs/command-reference.md
sparql:
  cli: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?binary_name ?about WHERE { ?cli a cnv:Cli ; cnv:binaryName ?binary_name ; cnv:about ?about . }
    ORDER BY ?binary_name
  commands: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?command ?noun ?verb ?about WHERE {
      ?noun_node a cnv:Noun ; cnv:name ?noun ; cnv:hasCommand ?command .
      ?command a cnv:Command ; cnv:name ?verb ; cnv:about ?about ; cnv:belongsToNoun ?noun_node .
    }
    ORDER BY ?noun ?verb
  arguments: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?command ?name ?about ?value_kind
           (STR(?required_value) AS ?required)
           (STR(?position_value) AS ?position)
           (COALESCE(STR(?long), "") AS ?long_flag)
           (COALESCE(STR(?short), "") AS ?short_flag)
           (COALESCE(STR(?environment_raw), "") AS ?environment)
    WHERE {
      ?command a cnv:Command ; cnv:hasArgument ?argument .
      ?argument a cnv:Argument ; cnv:name ?name ; cnv:about ?about ;
                cnv:valueKind ?value_kind ; cnv:required ?required_value ;
                cnv:position ?position_value .
      OPTIONAL { ?argument cnv:longFlag ?long }
      OPTIONAL { ?argument cnv:shortFlag ?short }
      OPTIONAL { ?argument cnv:environmentVariable ?environment_raw }
    }
    ORDER BY ?command ?position_value ?name
