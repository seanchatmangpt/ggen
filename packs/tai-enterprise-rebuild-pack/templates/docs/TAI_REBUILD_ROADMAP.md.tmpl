---
to: consumer/tai-enterprise-rebuild/docs/TAI_REBUILD_ROADMAP.md
sparql:
  program: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?version ?broker WHERE {
      ?program a tai:EnterpriseRebuildProgram ; dcterms:title ?title ; tai:version ?version ; tai:requiredBroker ?broker .
    }
  phases: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?identifier ?label ?outcome WHERE {
      ?phase a tai:EnterprisePhase ; tai:order ?order ; tai:identifier ?identifier ; skos:prefLabel ?label ; tai:outcome ?outcome .
    } ORDER BY ?order
  families: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?identifier ?label ?outcome WHERE {
      ?family a tai:BuildingBlockFamily ; tai:order ?order ; tai:identifier ?identifier ; skos:prefLabel ?label ; tai:outcome ?outcome .
    } ORDER BY ?order
  scenarios: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?identifier ?label ?trigger WHERE {
      ?scenario a tai:SimulationScenario ; tai:order ?order ; tai:identifier ?identifier ; skos:prefLabel ?label ; tai:trigger ?trigger .
    } ORDER BY ?order
---
