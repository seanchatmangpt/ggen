---
to: consumer/tai-enterprise-rebuild/src/bin/tai_rebuild.rs
---
#![forbid(unsafe_code)]

use std::{env, path::Path};

use tai_enterprise_rebuild::{verify_receipt, write_bundle};

fn usage() -> &'static str {
    "usage: tai-rebuild roadmap <scenario> <output-dir> | simulate <scenario> <output-dir> | verify <receipt-file>"
}

fn run() -> Result<serde_json::Value, String> {
    let mut args = env::args().skip(1);
    let verb = args.next().ok_or_else(|| usage().to_string())?;
    match verb.as_str() {
        "roadmap" | "simulate" => {
            let scenario = args.next().ok_or_else(|| usage().to_string())?;
            let output = args.next().ok_or_else(|| usage().to_string())?;
            if args.next().is_some() {
                return Err(usage().to_string());
            }
            let summary = write_bundle(Path::new(&output), &scenario, &verb)
                .map_err(|error| error.to_string())?;
            serde_json::to_value(summary).map_err(|error| error.to_string())
        }
        "verify" => {
            let receipt = args.next().ok_or_else(|| usage().to_string())?;
            if args.next().is_some() {
                return Err(usage().to_string());
            }
            let verified = verify_receipt(Path::new(&receipt)).map_err(|error| error.to_string())?;
            Ok(serde_json::json!({
                "status": "VERIFIED",
                "scenario": verified.scenario,
                "operation": verified.operation,
                "digest": verified.digest,
                "directActuation": verified.direct_actuation,
            }))
        }
        _ => Err(format!("unknown verb {verb}; {}", usage())),
    }
}

fn main() {
    match run() {
        Ok(value) => {
            println!("{}", serde_json::to_string_pretty(&value).expect("JSON serialization must succeed"));
        }
        Err(error) => {
            eprintln!("{error}");
            std::process::exit(2);
        }
    }
}
