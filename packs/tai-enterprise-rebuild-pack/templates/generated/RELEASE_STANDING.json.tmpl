---
to: consumer/tai-enterprise-rebuild/RELEASE_STANDING.json
sparql:
  counts: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    SELECT (COUNT(DISTINCT ?phase) AS ?phases) (COUNT(DISTINCT ?family) AS ?families)
           (COUNT(DISTINCT ?cert) AS ?certifications) (COUNT(DISTINCT ?scenario) AS ?scenarios)
           (COUNT(DISTINCT ?cap) AS ?recentCapabilities) (COUNT(DISTINCT ?obligation) AS ?obligations)
    WHERE {
      ?phase a tai:EnterprisePhase . ?family a tai:BuildingBlockFamily . ?cert a tai:CertificationHorizon .
      ?scenario a tai:SimulationScenario . ?cap a tai:RecentGgenCapability . ?obligation a tai:EvidenceObligation .
    }
---
{% set c = counts | first %}
{
  "schema": "ggen.release-standing.v1",
  "product": "tai-enterprise-rebuild",
  "standing": "UNKNOWN",
  "reason": "Source generation cannot self-promote a simulated enterprise reconstruction.",
  "declaredCrown": {
    "phases": {{ c.phases }},
    "families": {{ c.families }},
    "certifications": {{ c.certifications }},
    "scenarios": {{ c.scenarios }},
    "recentCapabilities": {{ c.recentCapabilities }},
    "obligations": {{ c.obligations }}
  },
  "directActuation": false,
  "requiredBroker": "BRCE",
  "externalEnterpriseStanding": "UNKNOWN",
  "externalCertificationStanding": "UNKNOWN"
}
