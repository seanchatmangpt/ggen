---
to: consumer/tai-enterprise-rebuild/generated/roadmap.json
sparql:
  phases: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?identifier ?label ?outcome WHERE {
      ?phase a tai:EnterprisePhase ; tai:order ?order ; tai:identifier ?identifier ; skos:prefLabel ?label ; tai:outcome ?outcome .
    } ORDER BY ?order
  dependencies: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    SELECT ?phaseId ?predecessorId WHERE {
      ?phase a tai:EnterprisePhase ; tai:identifier ?phaseId ; tai:dependsOn ?predecessor .
      ?predecessor a tai:EnterprisePhase ; tai:identifier ?predecessorId .
    } ORDER BY ?phaseId ?predecessorId
  families: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    SELECT ?phaseId ?familyId WHERE {
      ?phase a tai:EnterprisePhase ; tai:identifier ?phaseId ; tai:requiresFamily ?family .
      ?family a tai:BuildingBlockFamily ; tai:identifier ?familyId .
    } ORDER BY ?phaseId ?familyId
  certifications: |
    PREFIX tai: <https://chatmangpt.com/ontology/tai-rebuild#>
    SELECT ?phaseId ?certificationId WHERE {
      ?phase a tai:EnterprisePhase ; tai:identifier ?phaseId ; tai:requiresCertification ?certification .
      ?certification a tai:CertificationHorizon ; tai:identifier ?certificationId .
    } ORDER BY ?phaseId ?certificationId
---
{
  "schema": "ggen.tai.roadmap.v1",
  "standing": "UNKNOWN",
  "standingReason": "A generated simulation roadmap cannot claim that the enterprise has been rebuilt.",
  "phases": [
{% for row in phases %}    {
      "order": {{ row["order"] }},
      "id": "{{ row["identifier"] }}",
      "label": "{{ row["label"] }}",
      "outcome": "{{ row["outcome"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "dependencies": [
{% for row in dependencies %}    {
      "phase": "{{ row["phaseId"] }}",
      "dependsOn": "{{ row["predecessorId"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "familyBindings": [
{% for row in families %}    {
      "phase": "{{ row["phaseId"] }}",
      "family": "{{ row["familyId"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "certificationBindings": [
{% for row in certifications %}    {
      "phase": "{{ row["phaseId"] }}",
      "certification": "{{ row["certificationId"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}  ]
}
