  tai:sourcePr 500 ; tai:sourcePath "packs/ggen-combinatorial-maximalism-pack" ;
  tai:integrationMode "planning" ;
  tai:integrationRole "Explores reversible enterprise designs before authority, verification, and actuation are admitted." .

