@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Reusable vocabulary.
tai:EnterpriseRebuildProgram a rdfs:Class .
tai:BuildingBlockFamily a rdfs:Class .
tai:EnterprisePhase a rdfs:Class .
tai:CertificationHorizon a rdfs:Class .
tai:SimulationScenario a rdfs:Class .
tai:RecentGgenCapability a rdfs:Class .
tai:EvidenceObligation a rdfs:Class .
tai:RoadmapGenerator a rdfs:Class .

tai:version a rdf:Property .
tai:order a rdf:Property .
tai:identifier a rdf:Property .
tai:outcome a rdf:Property .
tai:dependsOn a rdf:Property .
tai:requiresFamily a rdf:Property .
tai:requiresCertification a rdf:Property .
tai:requiredBroker a rdf:Property .
tai:directActuation a rdf:Property .
tai:llmCalls a rdf:Property .
tai:sourcePr a rdf:Property .
tai:sourcePath a rdf:Property .
tai:integrationRole a rdf:Property .
tai:integrationMode a rdf:Property .
tai:humanBoundary a rdf:Property .
tai:automatableWork a rdf:Property .
tai:knowledgeBody a rdf:Property .
tai:failurePrevention a rdf:Property .
tai:trigger a rdf:Property .
tai:mutation a rdf:Property .
tai:expectedStanding a rdf:Property .
tai:evidenceKind a rdf:Property .
tai:falsifier a rdf:Property .
tai:generator a rdf:Property .
tai:phase a rdf:Property .
tai:family a rdf:Property .
tai:certification a rdf:Property .
tai:scenario a rdf:Property .
tai:recentCapability a rdf:Property .
tai:evidenceObligation a rdf:Property .

# Exact recent ggen capability rails admitted for the TAI composition.
tai:cap-book-self-host a tai:RecentGgenCapability ;
  tai:order 1 ; skos:prefLabel "Level-Five book self-host and 360-degree validation" ;
  tai:sourcePr 493 ; tai:sourcePath "packs/level-five-book-pack" ;
  tai:integrationMode "projection" ;
  tai:integrationRole "Makes enterprise doctrine an ontology-owned, reproducible projection rather than manually maintained prose." .

tai:cap-zero-code-cnv a tai:RecentGgenCapability ;
  tai:order 2 ; skos:prefLabel "Universal zero-code clap-noun-verb CLI manufacture" ;
  tai:sourcePr 496 ; tai:sourcePath "packs/clap-noun-verb-pack" ;
  tai:integrationMode "projection" ;
  tai:integrationRole "Manufactures operator command surfaces from admitted RDF without consumer-authored handlers." .

tai:cap-namespace a tai:RecentGgenCapability ;
  tai:order 3 ; skos:prefLabel "chatmangpt.com namespace binding" ;
  tai:sourcePr 499 ; tai:sourcePath ".chatmangpt/namespace.toml" ;
  tai:integrationMode "identity" ;
  tai:integrationRole "Gives the reconstructed enterprise and every generated block stable public identity without implying standing." .

tai:cap-combinatorial-maximalism a tai:RecentGgenCapability ;
