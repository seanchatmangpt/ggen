---
to: docs/FORTUNE5_DEPLOYMENT_BLOCKS_CATALOG.md
force: true
sparql:
  catalog: |
    PREFIX bb: <http://seanchatmangpt.github.io/packs/fortune5-bblock#>
    SELECT ?catalogVersion ?directActuation WHERE {
      ?catalog a bb:Catalog ;
               bb:catalogVersion ?catalogVersion ;
               bb:directActuation ?directActuation .
    }
  providers: |
    PREFIX bb: <http://seanchatmangpt.github.io/packs/fortune5-bblock#>
    SELECT ?providerId ?title
           (GROUP_CONCAT(DISTINCT ?alias; separator=", ") AS ?aliases)
    WHERE {
      ?provider a bb:Provider ;
                bb:providerId ?providerId ;
                bb:title ?title .
      OPTIONAL { ?provider bb:alias ?alias }
    }
    GROUP BY ?providerId ?title
    ORDER BY ?providerId
  groups: |
    PREFIX bb: <http://seanchatmangpt.github.io/packs/fortune5-bblock#>
    SELECT ?groupId ?title ?description ?outputDirectory
           (GROUP_CONCAT(DISTINCT ?depId; separator=", ") AS ?deps)
           (GROUP_CONCAT(DISTINCT ?common; separator=", ") AS ?commonPacks)
           (GROUP_CONCAT(DISTINCT ?aws; separator=", ") AS ?awsPacks)
           (GROUP_CONCAT(DISTINCT ?azure; separator=", ") AS ?azurePacks)
           (GROUP_CONCAT(DISTINCT ?gcp; separator=", ") AS ?gcpPacks)
    WHERE {
      ?group a bb:BlockGroup ;
             bb:groupId ?groupId ;
             bb:title ?title ;
             bb:description ?description ;
             bb:outputDirectory ?outputDirectory .
      OPTIONAL { ?group bb:dependsOn ?dep . ?dep bb:groupId ?depId }
      OPTIONAL { ?group bb:commonPack ?common }
      OPTIONAL { ?group bb:awsPack ?aws }
      OPTIONAL { ?group bb:azurePack ?azure }
      OPTIONAL { ?group bb:gcpPack ?gcp }
    }
    GROUP BY ?groupId ?title ?description ?outputDirectory
    ORDER BY ?groupId
