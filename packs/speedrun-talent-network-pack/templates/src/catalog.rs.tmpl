#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "UPPERCASE")]
pub enum HttpMethod {
    Get,
    Post,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum RestOperation {
    SearchJobs,
    GetJob,
    ListCompanies,
    GetCompany,
    ListCollections,
    GetCollection,
    GetHiringStats,
    GetOpenApiSpec,
}

impl RestOperation {
    #[must_use]
    pub const fn operation_id(self) -> &'static str {
        match self {
            Self::SearchJobs => "searchJobs",
            Self::GetJob => "getJob",
            Self::ListCompanies => "listCompanies",
            Self::GetCompany => "getCompany",
            Self::ListCollections => "listCollections",
            Self::GetCollection => "getCollection",
            Self::GetHiringStats => "getHiringStats",
            Self::GetOpenApiSpec => "getOpenApiSpec",
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum PublicResource {
    LlmsText,
    JobsMarkdown,
    JobsRss,
}

impl PublicResource {
    #[must_use]
    pub const fn path(self) -> &'static str {
        match self {
            Self::LlmsText => "/llms.txt",
            Self::JobsMarkdown => "/jobs.md",
            Self::JobsRss => "/jobs.rss",
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum McpTool {
    SearchJobs,
    GetJob,
    GetCompany,
    ListCollections,
    GetCollection,
    GetHiringStats,
    ListCompanies,
    GetNetworkInfo,
    JoinNetwork,
    ExpressInterest,
}

impl McpTool {
    #[must_use]
    pub const fn as_str(self) -> &'static str {
        match self {
            Self::SearchJobs => "search_jobs",
            Self::GetJob => "get_job",
            Self::GetCompany => "get_company",
            Self::ListCollections => "list_collections",
            Self::GetCollection => "get_collection",
            Self::GetHiringStats => "get_hiring_stats",
            Self::ListCompanies => "list_companies",
            Self::GetNetworkInfo => "get_network_info",
            Self::JoinNetwork => "join_network",
            Self::ExpressInterest => "express_interest",
        }
    }

    #[must_use]
    pub const fn requires_consent(self) -> bool {
        matches!(self, Self::JoinNetwork | Self::ExpressInterest)
    }
}
