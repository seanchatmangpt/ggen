PREFIX rwr: <https://ggen.dev/ontology/rwr-level5#>

SELECT ?dimension ?surface WHERE {
  VALUES (?dimension ?surface) {
    (rwr:processIntegration rwr:Execution)
    (rwr:processIntegration rwr:State)
    (rwr:processIntegration rwr:Causality)
    (rwr:processStandardization rwr:Execution)
    (rwr:processStandardization rwr:Process)
    (rwr:processStandardization rwr:State)
    (rwr:operatingModelDecisionRights rwr:Governance)
    (rwr:operatingModelDecisionRights rwr:Process)
    (rwr:operatingModelDecisionRights rwr:Causality)
    (rwr:coreProcesses rwr:Process)
    (rwr:coreProcesses rwr:Execution)
    (rwr:coreProcesses rwr:State)
    (rwr:sharedData rwr:State)
    (rwr:sharedData rwr:Execution)
    (rwr:sharedData rwr:Causality)
    (rwr:linkingAutomation rwr:Execution)
    (rwr:linkingAutomation rwr:Process)
    (rwr:linkingAutomation rwr:Causality)
    (rwr:customerPartnerChannels rwr:External)
    (rwr:customerPartnerChannels rwr:Execution)
    (rwr:customerPartnerChannels rwr:State)
    (rwr:technologyStandardization rwr:Governance)
    (rwr:technologyStandardization rwr:State)
    (rwr:technologyStandardization rwr:Execution)
    (rwr:operationalBackbone rwr:Execution)
    (rwr:operationalBackbone rwr:State)
    (rwr:operationalBackbone rwr:Telemetry)
    (rwr:reusableBusinessComponents rwr:Execution)
    (rwr:reusableBusinessComponents rwr:State)
    (rwr:reusableBusinessComponents rwr:Economics)
    (rwr:ecosystemInterfaces rwr:External)
    (rwr:ecosystemInterfaces rwr:Governance)
    (rwr:ecosystemInterfaces rwr:Execution)
    (rwr:enterpriseGovernance rwr:Governance)
    (rwr:enterpriseGovernance rwr:Process)
    (rwr:enterpriseGovernance rwr:Causality)
    (rwr:projectManagement rwr:Process)
    (rwr:projectManagement rwr:Execution)
    (rwr:projectManagement rwr:Governance)
    (rwr:architectureLinkingMechanisms rwr:Governance)
    (rwr:architectureLinkingMechanisms rwr:Process)
    (rwr:architectureLinkingMechanisms rwr:Execution)
    (rwr:reliabilityTransparency rwr:Telemetry)
    (rwr:reliabilityTransparency rwr:State)
    (rwr:reliabilityTransparency rwr:Execution)
    (rwr:strategicAgility rwr:Economics)
    (rwr:strategicAgility rwr:Execution)
    (rwr:strategicAgility rwr:Process)
    (rwr:economicValue rwr:Economics)
    (rwr:economicValue rwr:State)
    (rwr:economicValue rwr:Causality)
    (rwr:machineryClosure rwr:Execution)
    (rwr:machineryClosure rwr:State)
    (rwr:machineryClosure rwr:Causality)
    (rwr:automationClosure rwr:Execution)
    (rwr:automationClosure rwr:Process)
    (rwr:automationClosure rwr:Causality)
    (rwr:autonomicClosure rwr:Execution)
    (rwr:autonomicClosure rwr:Telemetry)
    (rwr:autonomicClosure rwr:Causality)
    (rwr:receiptReplay rwr:Execution)
    (rwr:receiptReplay rwr:State)
    (rwr:receiptReplay rwr:Causality)
  }
  FILTER NOT EXISTS { ?dimension rwr:requiresSurface ?surface }
}
