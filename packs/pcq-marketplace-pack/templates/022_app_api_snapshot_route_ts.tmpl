---
to: "app/api/snapshot/route.ts"
sparql:
  apps: >
    PREFIX pcq: <https://ggen.dev/packs/pcq-marketplace#> SELECT ?displayName WHERE { ?app a pcq:MarketplaceApplication ; pcq:displayName ?displayName . } LIMIT 1
---
{% for app in apps -%}
import { getMarketEngine } from '@/lib/market';

export const dynamic = 'force-dynamic';
export const runtime = 'nodejs';

export async function GET() {
  return Response.json(getMarketEngine().snapshot(), {
    headers: { 'cache-control': 'no-store' },
  });
}
{% endfor -%}
