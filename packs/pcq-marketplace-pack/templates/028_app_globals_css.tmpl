---
to: "app/globals.css"
sparql:
  apps: >
    PREFIX pcq: <https://ggen.dev/packs/pcq-marketplace#> SELECT ?displayName WHERE { ?app a pcq:MarketplaceApplication ; pcq:displayName ?displayName . } LIMIT 1
---
{% for app in apps -%}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#060a12;color:#eef7ff;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{background:radial-gradient(circle at 35% -10%,#14314c 0,transparent 34%),radial-gradient(circle at 90% 0,#18283f 0,transparent 26%),#060a12}.shell{min-height:100vh;padding:22px;display:grid;gap:16px}.topbar{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #213249;padding:0 2px 16px}.eyebrow{margin:0 0 8px;color:#6edcff;font:600 11px/1.2 ui-monospace,monospace;letter-spacing:.19em}.topbar h1{margin:0;font-size:clamp(28px,4vw,50px);letter-spacing:-.045em}.live-pill{display:flex;gap:9px;align-items:center;text-transform:uppercase;font:700 11px/1 ui-monospace,monospace;letter-spacing:.13em;color:#9bb0c8;border:1px solid #2a3d57;border-radius:999px;padding:10px 13px}.live-pill span{width:8px;height:8px;border-radius:50%;background:#748399}.live-pill.live{color:#9bffc1;border-color:#2f6d4a}.live-pill.live span{background:#57f99a;box-shadow:0 0 14px #57f99a}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.metric-card,.panel{border:1px solid #1d2d42;background:linear-gradient(180deg,rgba(15,24,38,.94),rgba(8,14,24,.94));box-shadow:0 18px 60px rgba(0,0,0,.22)}.metric-card{padding:16px 18px;border-radius:14px;display:grid;gap:8px}.metric-card span,.metric-card small,.panel-heading span,.panel-heading em{color:#7890aa;font:600 10px/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.metric-card strong{font-size:23px;letter-spacing:-.03em}.workspace{min-height:690px;display:grid;grid-template-columns:minmax(260px,330px) minmax(480px,1fr) minmax(280px,360px);gap:12px}.panel{position:relative;border-radius:16px;overflow:hidden}.market-panel,.ledger-panel{padding:16px}.panel-heading{display:flex;align-items:center;justify-content:space-between;padding:2px 2px 15px}.panel-heading div{display:grid;gap:5px}.panel-heading strong{font-size:14px}.panel-heading em{font-style:normal;color:#64d9ff}.listing-stack{display:grid;gap:10px;max-height:620px;overflow:auto;padding-right:3px}.listing{border:1px solid #21344b;background:#0b1422;border-radius:12px;padding:13px;display:grid;gap:12px;transition:.2s ease}.listing:hover{transform:translateY(-1px);border-color:#356184;background:#0d192a}.listing-top,.listing-bottom{display:flex;justify-content:space-between;align-items:center}.category,.proof{font:700 9px/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.12em}.category{color:#64d9ff}.proof{color:#91f7b6}.listing h2{margin:0;font-size:14px;line-height:1.35}.listing-bottom div{display:grid;gap:3px}.listing-bottom strong{font:700 13px/1.2 ui-monospace,monospace}.listing-bottom small{color:#7389a2;font-size:11px}.listing button{border:1px solid #3b7798;background:#102b3c;color:#d8f5ff;border-radius:8px;padding:8px 11px;font:700 10px/1 ui-monospace,monospace;text-transform:uppercase;cursor:pointer}.listing button:hover{background:#16415a}.listing button:disabled{opacity:.45;cursor:not-allowed}.map-panel{min-height:690px;background:radial-gradient(circle at 50% 48%,#0f2940,#07101c 55%,#050a12);isolation:isolate}.map-panel:after{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(86,175,220,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(86,175,220,.04) 1px,transparent 1px);background-size:30px 30px;z-index:2}.map-overlay{position:absolute;z-index:3;top:16px;left:16px;display:grid;gap:6px;padding:11px 13px;background:rgba(5,11,20,.76);border:1px solid #27415d;border-radius:10px;backdrop-filter:blur(8px)}.map-overlay span{color:#6edcff;font:700 9px/1 ui-monospace,monospace;letter-spacing:.16em}.map-overlay strong{font-size:13px}.receipt{border:1px solid #775c2d;background:linear-gradient(145deg,#211b12,#13151a);border-radius:12px;padding:14px;display:grid;gap:7px;margin-bottom:12px}.receipt span{color:#ffc86d;font:700 9px/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.14em}.receipt strong{font:700 13px/1.2 ui-monospace,monospace}.receipt small{color:#ad9c7c}.error{color:#ff8e98;font:600 12px/1.4 ui-monospace,monospace}.event-tape{display:grid;gap:2px;max-height:570px;overflow:auto}.event-tape article{display:grid;grid-template-columns:72px 1fr auto;gap:8px;align-items:center;border-bottom:1px solid #18283a;padding:10px 2px}.event-tape>article>span{font:700 9px/1 ui-monospace,monospace;text-transform:uppercase}.event-tape .settlement{color:#ffc566}.event-tape .quote{color:#61d8ff}.event-tape div{display:grid;gap:4px;min-width:0}.event-tape strong{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-tape small{color:#6f849c;font-size:9px}.event-tape em{font:700 9px/1 ui-monospace,monospace;font-style:normal;color:#b9c7d8}@media(max-width:1180px){.workspace{grid-template-columns:300px 1fr}.ledger-panel{grid-column:1/-1}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.shell{padding:12px}.topbar{align-items:flex-start;gap:12px}.metrics,.workspace{grid-template-columns:1fr}.map-panel{min-height:520px}.market-panel,.ledger-panel{grid-column:auto}.topbar h1{font-size:30px}}
{% endfor -%}
