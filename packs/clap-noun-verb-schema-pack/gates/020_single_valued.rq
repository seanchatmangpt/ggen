# MESSAGE: functional zero-code CLI properties must have exactly one value; any row is a refusal.
PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
SELECT ?subject ?property (COUNT(?value) AS ?count) WHERE {
  VALUES ?property {
    cnv:binaryName cnv:crateName cnv:version cnv:edition cnv:rustVersion cnv:about
    cnv:name cnv:fieldName cnv:valueKind cnv:required cnv:position cnv:testValue
    cnv:belongsToNoun cnv:hasBehavior
    cnv:longFlag cnv:shortFlag cnv:environmentVariable cnv:defaultValue
    cnv:group cnv:requires cnv:conflictsWith cnv:valueHint cnv:hidden cnv:global
    cnv:exclusive cnv:helpHeading cnv:multiple cnv:valueDelimiter
    cnv:jsonValue cnv:operator cnv:leftArgument cnv:rightArgument
    cnv:usesBoundary cnv:idArgument cnv:refusalCode cnv:refusalMessage
    cnv:rootPath cnv:receiptRequired cnv:replayMode
  }
  ?subject ?property ?value .
}
GROUP BY ?subject ?property
HAVING (COUNT(?value) > 1)
ORDER BY ?subject ?property
