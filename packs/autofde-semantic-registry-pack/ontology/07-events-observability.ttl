    reg:priority reg:P0 ;
    reg:recordStanding reg:ALIVE ;
    reg:sourceStanding reg:UNKNOWN ;
    reg:projectionStanding reg:UNKNOWN ;
    reg:validationStanding reg:UNKNOWN ;
    dcat:landingPage <https://github.com/cloudevents/spec> ;
    reg:canonicalLocationStatus reg:DeclaredByInventory ;
    reg:versionStatus reg:NeedsPinning ;
    reg:licenseStatus reg:NeedsReview ;
    reg:retrievalStatus reg:NotRetrieved ;
    reg:sourceDigestStatus reg:NotRetrieved ;
    reg:projectionDigestStatus reg:NotGenerated ;
    reg:inventoryLine "207"^^xsd:positiveInteger, "292"^^xsd:positiveInteger, "512"^^xsd:positiveInteger ;
    reg:listedAs "CloudEvents" ;
    reg:inventorySection "6. Events, observations and telemetry", "9. APIs, integration and messaging", "Mandatory P0 imports" ;
    reg:classificationBasis "policy-inferred", "source-declared" .

