pack:07-events-observability
    a owl:Ontology, dcat:DatasetSeries, reg:SemanticPack ;
    dcterms:identifier "07-events-observability" ;
    dcterms:title "07 Events Observability" ;
    dcterms:description "Portable events, telemetry semantics, object-centric logs, lineage, SLOs and operational context." ;
    reg:recordStanding reg:ALIVE .

src:cloudevents
    a dcat:Dataset, reg:PublicSemanticSource ;
    dcterms:identifier "cloudevents" ;
