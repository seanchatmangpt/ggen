pack:12-ai-agent
    a owl:Ontology, dcat:DatasetSeries, reg:SemanticPack ;
    dcterms:identifier "12-ai-agent" ;
    dcterms:title "12 Ai Agent" ;
    dcterms:description "AI model, dataset, agent, tool telemetry, privacy, evaluation and governance semantics." ;
    reg:recordStanding reg:ALIVE .

src:datasheets-for-datasets
    a dcat:Dataset, reg:PublicSemanticSource ;
    dcterms:identifier "datasheets-for-datasets" ;
    dcterms:title "Datasheets for Datasets" ;
    dcterms:description "Dataset documentation" ;
    reg:sourceKind reg:Schema ;
    reg:transformation reg:GenerateProjection ;
    reg:memberOfPack pack:12-ai-agent ;
    reg:primaryPack pack:12-ai-agent ;
    reg:recordStanding reg:ALIVE ;
    reg:sourceStanding reg:UNKNOWN ;
    reg:projectionStanding reg:UNKNOWN ;
    reg:validationStanding reg:UNKNOWN ;
    reg:canonicalLocationStatus reg:NeedsResolution ;
    reg:versionStatus reg:NeedsPinning ;
    reg:licenseStatus reg:NeedsReview ;
    reg:retrievalStatus reg:NotRetrieved ;
    reg:sourceDigestStatus reg:NotRetrieved ;
    reg:projectionDigestStatus reg:NotGenerated ;
    reg:inventoryLine "321"^^xsd:positiveInteger ;
    reg:listedAs "Datasheets for Datasets" ;
    reg:inventorySection "10. Software, AI and supply-chain semantics" ;
    reg:classificationBasis "source-declared" .

