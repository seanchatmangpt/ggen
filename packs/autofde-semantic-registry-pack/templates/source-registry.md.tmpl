---
to: docs/autofde-semantic-registry.md
sparql:
  pack_counts: |
    PREFIX reg: <https://ggen.io/ontology/autofde-registry/v1#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?pack_id (COUNT(?source) AS ?source_count) WHERE {
      ?source a reg:PublicSemanticSource ; reg:primaryPack ?pack .
      ?pack dcterms:identifier ?pack_id .
    }
    GROUP BY ?pack_id
    ORDER BY ?pack_id
  standing_counts: |
    PREFIX reg: <https://ggen.io/ontology/autofde-registry/v1#>
    SELECT ?source_standing ?projection_standing (COUNT(?source) AS ?source_count) WHERE {
      ?source a reg:PublicSemanticSource ;
              reg:sourceStanding ?source_standing ;
              reg:projectionStanding ?projection_standing .
    }
    GROUP BY ?source_standing ?projection_standing
    ORDER BY ?source_standing ?projection_standing
  p0_sources: |
    PREFIX reg: <https://ggen.io/ontology/autofde-registry/v1#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?identifier ?title ?source_standing ?projection_standing WHERE {
      ?source a reg:PublicSemanticSource ;
              reg:priority reg:P0 ;
              dcterms:identifier ?identifier ;
              dcterms:title ?title ;
              reg:sourceStanding ?source_standing ;
              reg:projectionStanding ?projection_standing .
    }
    ORDER BY ?identifier
  provider_sources: |
    PREFIX reg: <https://ggen.io/ontology/autofde-registry/v1#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?identifier ?title ?transformation WHERE {
      ?source a reg:PublicSemanticSource ;
              reg:priority reg:P0Provider ;
              dcterms:identifier ?identifier ;
              dcterms:title ?title ;
              reg:transformation ?transformation .
    }
    ORDER BY ?identifier
---
# AutoFDE Federated Semantic Registry

This document is generated from `packs/autofde-semantic-registry-pack/ontology.ttl`.
The registry distinguishes ontology, schema, knowledge-base/catalog, and protocol
sources. Registry records can be `ALIVE` while external source bytes and generated
projections remain `UNKNOWN`; presence in this report grants no execution authority.

