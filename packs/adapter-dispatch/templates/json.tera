{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{ target_path }}",
  "title": "{{ subject }} → {{ consumer }}",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject": { "const": "{{ subject }}" },
    "consumer": { "const": "{{ consumer }}" }
  },
  "required": ["subject", "consumer"]
}
