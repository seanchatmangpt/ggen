---
to: "docs/domain-capability/sregym-capabilities.md"
sparql:
  rows: |
    PREFIX dcp: <http://seanchatmangpt.github.io/packs/domain-capability#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?order ?slug ?label ?consequence ?worldBinding ?sourceRepo ?sourceFile ?admitted WHERE {
      ?cap a dcp:Capability ; dcp:order ?order ; dcp:slug ?slug ; rdfs:label ?label ;
          dcp:consequence ?consequence ; dcp:worldBinding ?worldBinding ;
          dcp:sourceRepo ?sourceRepo ; dcp:sourceFile ?sourceFile .
      BIND(EXISTS { ?allowlist dcp:allows ?cap } AS ?admitted)
    } ORDER BY ?order
---
