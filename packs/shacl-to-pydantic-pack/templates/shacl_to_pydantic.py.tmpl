---
to: "src/shacl_pydantic_models.py"
sparql:
  models: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?className ?description WHERE { ?model a sp:PydanticModel ; sp:derivedFromShape ?shape ; sp:className ?className . OPTIONAL { ?model dcterms:description ?description } } ORDER BY ?className"
  fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?modelClassName ?fieldName ?pythonType ?description WHERE { ?model a sp:PydanticModel ; sp:derivedFromShape ?shape ; sp:className ?modelClassName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:datatype ?dt . BIND(REPLACE(STR(?path), \"^.*[/#]\", \"\") AS ?fieldName) BIND(IF(?dt = <http://www.w3.org/2001/XMLSchema#string>, \"str\", IF(?dt = <http://www.w3.org/2001/XMLSchema#boolean>, \"bool\", IF(?dt IN (<http://www.w3.org/2001/XMLSchema#integer>, <http://www.w3.org/2001/XMLSchema#long>), \"int\", \"float\"))) AS ?pythonType) OPTIONAL { ?prop sh:description ?descRaw } OPTIONAL { ?prop dcterms:description ?descRaw2 } BIND(COALESCE(?descRaw, ?descRaw2, CONCAT(?fieldName, \" field\")) AS ?description) } ORDER BY ?modelClassName ?fieldName"
---
"""Pydantic models derived from real SHACL shapes -- generated by
shacl-to-pydantic-pack's shacl_to_pydantic.py.tmpl, the second real projection target reusing
shacl-projection-pack's shared sp:derivedFromShape / sp:isPrimaryOutput vocabulary. Every field
below echoes literals already computed by the frontmatter SPARQL from real sh:PropertyShape
facts -- nothing here is synthesized, per pack-authoring-pack's "templates echo, they never
synthesize" rule.
"""

import pydantic

{% for m in models %}
class {{ m.className }}(pydantic.BaseModel):
    """{{ m.description | default(value=m.className) }}"""

{% for f in fields %}{% if f.modelClassName == m.className %}    {{ f.fieldName }}: {{ f.pythonType }} = pydantic.Field(description="{{ f.description }}")
{% endif %}{% endfor %}

{% endfor %}