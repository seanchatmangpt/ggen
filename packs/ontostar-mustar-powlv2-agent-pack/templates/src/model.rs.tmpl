//! GPT-5.6 capability routing and broker-only inference intents.

use std::collections::BTreeMap;

use serde::{Deserialize, Serialize};
use thiserror::Error;

use crate::catalog::{
    ModelProfileSpec, ModelTier, AGENT_REQUIRED_BROKER, MODEL_GENERATION, MODEL_PROFILES,
    MODEL_PROVIDER,
};

pub const MODEL_INTENT_SCHEMA: &str = "ggen.agent.model-intent.v1";

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum ModelTask {
    OntologyExtraction,
    PowlCandidatePlanning,
    AdversarialVerification,
}

impl ModelTask {
    #[must_use]
    pub const fn as_str(self) -> &'static str {
        match self {
            Self::OntologyExtraction => "ontology_extraction",
            Self::PowlCandidatePlanning => "powl_candidate_planning",
            Self::AdversarialVerification => "adversarial_verification",
        }
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct ModelInferenceIntent {
    pub schema: String,
    pub intent_id: String,
    pub broker: String,
    pub provider: String,
    pub generation: String,
    pub tier: ModelTier,
    pub task: ModelTask,
    pub input_digest: String,
    pub candidate_only: bool,
    pub execution_authority: bool,
    pub programmatic_tool_calling: bool,
    pub multi_agent_beta: bool,
    #[serde(default)]
    pub constraints: BTreeMap<String, String>,
}

#[derive(Debug, Error)]
pub enum ModelRefusal {
    #[error("model input must be an admitted BLAKE3 digest")]
    InvalidInputDigest,
    #[error("the ontology does not declare a profile for the selected model tier")]
    MissingModelProfile,
    #[error("model intent serialization failed: {0}")]
    Serialization(#[from] serde_json::Error),
}

#[must_use]
pub const fn routed_tier(task: ModelTask) -> ModelTier {
    match task {
        ModelTask::OntologyExtraction => ModelTier::Luna,
        ModelTask::PowlCandidatePlanning => ModelTier::Terra,
        ModelTask::AdversarialVerification => ModelTier::Sol,
    }
}

pub fn model_intent(
    task: ModelTask,
    input_digest: &str,
    constraints: BTreeMap<String, String>,
) -> Result<ModelInferenceIntent, ModelRefusal> {
    if !is_blake3_urn(input_digest) {
        return Err(ModelRefusal::InvalidInputDigest);
    }
    let tier = routed_tier(task);
    let profile = profile_for(tier).ok_or(ModelRefusal::MissingModelProfile)?;
    let identity = digest_value(&(
        MODEL_INTENT_SCHEMA,
        AGENT_REQUIRED_BROKER,
        profile.identifier,
        task,
        input_digest,
        &constraints,
    ))?;
    Ok(ModelInferenceIntent {
        schema: MODEL_INTENT_SCHEMA.to_string(),
        intent_id: identity,
        broker: AGENT_REQUIRED_BROKER.to_string(),
        provider: MODEL_PROVIDER.to_string(),
        generation: MODEL_GENERATION.to_string(),
        tier,
        task,
        input_digest: input_digest.to_string(),
        candidate_only: profile.candidate_only,
        execution_authority: profile.execution_authority,
        programmatic_tool_calling: profile.programmatic_tool_calling,
        multi_agent_beta: profile.multi_agent_beta,
        constraints,
    })
}

#[must_use]
pub fn profile_for(tier: ModelTier) -> Option<&'static ModelProfileSpec> {
    MODEL_PROFILES
        .iter()
        .find(|profile| profile.tier == tier.as_str())
}

pub fn digest_value<T: Serialize>(value: &T) -> Result<String, serde_json::Error> {
    let bytes = serde_json::to_vec(value)?;
    Ok(format!("urn:blake3:{}", blake3::hash(&bytes).to_hex()))
}

#[must_use]
pub fn is_blake3_urn(value: &str) -> bool {
    value
        .strip_prefix("urn:blake3:")
        .is_some_and(|digest| digest.len() == 64 && digest.bytes().all(|byte| byte.is_ascii_hexdigit()))
}
