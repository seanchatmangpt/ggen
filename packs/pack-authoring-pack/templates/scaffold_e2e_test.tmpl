//! Chicago-TDD end-to-end proof for `packs/{{ packName }}` — GENERATED by
//! `ggen sync` from `packs/pack-authoring-pack/ontology.ttl`'s
//! `pat:NewPackSpec` individual for "{{ packName }}". Edit that individual
//! (or add real content assertions below), not this file directly — a
//! re-sync will overwrite hand edits here except inside the TODO section.

#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]

mod support;

use std::path::{Path, PathBuf};

use ggen_engine::sync::{sync, SyncOptions};
use support::{assert_gate_refuses, assert_idempotent, scaffold_pack};

fn packs_dir() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../packs")
}

#[test]
fn {{ packName | replace(from="-", to="_") }}_generates_and_is_idempotent() {
    let (_dir, project) = scaffold_pack(&packs_dir().join("{{ packName }}"));

    sync(
        &project,
        SyncOptions {
            dry_run: false,
            ..Default::default()
        },
    )
    .expect("first sync");

    // TODO: assert on real generated file content here (read the exact
    // output path(s) your templates declare and assert exact substrings —
    // see docs/pack-authoring/how-to-write-a-chicago-e2e-test.md). A test
    // that only proves `sync()` succeeds, without reading what it wrote, is
    // not yet a Chicago-TDD proof.

    assert_idempotent(&project);
}

#[test]
fn {{ packName | replace(from="-", to="_") }}_gate_refuses_missing_{{ requiredProp }}() {
    let (_dir, project) = scaffold_pack(&packs_dir().join("{{ packName }}"));
    sync(
        &project,
        SyncOptions {
            dry_run: false,
            ..Default::default()
        },
    )
    .expect("baseline sync must succeed before sabotage");

    assert_gate_refuses(
        &project,
        "@prefix {{ prefixName }}: <http://seanchatmangpt.github.io/packs/{{ packName }}#> .\n\
         {{ prefixName }}:Sabotage a {{ prefixName }}:{{ className }} .\n",
        "010_required",
    );
}
