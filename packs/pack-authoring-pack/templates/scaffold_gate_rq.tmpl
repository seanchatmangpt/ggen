---
to: "packs/{{ packName }}/gates/010_required.rq"
sparql:
  rows: |
    PREFIX pat: <http://seanchatmangpt.github.io/packs/pack-authoring#>
    SELECT ?packName ?className ?prefixName ?requiredProp WHERE {
      ?spec a pat:NewPackSpec ; pat:packName ?packName ; pat:className ?className ;
            pat:prefixName ?prefixName ; pat:requiredProp ?requiredProp .
    } ORDER BY ?packName
---
# MESSAGE: every {{ prefixName }}:{{ className }} must have a non-empty {{ prefixName }}:{{ requiredProp }}.
# Any row = a subject missing its required property.
PREFIX {{ prefixName }}: <http://seanchatmangpt.github.io/packs/{{ packName }}#>
SELECT ?s ?missing WHERE {
  {
    ?s a {{ prefixName }}:{{ className }} . BIND({{ prefixName }}:{{ requiredProp }} AS ?missing)
  }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
