---
to: src/typer_app.py
sparql:
  applications: "PREFIX typer: <http://seanchatmangpt.github.io/packs/typer#> SELECT ?name ?help WHERE { ?app a typer:Application ; typer:name ?name ; typer:help ?help . } ORDER BY ?app"
  commands: "PREFIX typer: <http://seanchatmangpt.github.io/packs/typer#> SELECT ?name ?function ?help ?argument ?argumentHelp ?message WHERE { ?command a typer:Command ; typer:name ?name ; typer:function ?function ; typer:help ?help ; typer:argument ?argument ; typer:argumentHelp ?argumentHelp ; typer:message ?message . } ORDER BY ?name"
---
# GENERATED by ggen from typer-pack/ontology.ttl. Do not hand-edit.
from __future__ import annotations

import typer

app = typer.Typer(
    name={{ applications[0].name | json_encode | safe }},
    help={{ applications[0].help | json_encode | safe }},
    no_args_is_help=True,
)


@app.callback()
def root() -> None:
    """Keep ontology commands as explicit subcommands, including one-command apps."""

{% for command in commands %}
@app.command({{ command.name | json_encode | safe }})
def {{ command.function }}(
    {{ command.argument }}: str = typer.Argument(..., help={{ command.argumentHelp | json_encode | safe }}),
) -> None:
    """{{ command.help }}"""
    typer.echo({{ command.message | json_encode | safe }}.format({{ command.argument }}={{ command.argument }}))

{% endfor %}
if __name__ == "__main__":
    app()
