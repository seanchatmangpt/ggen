const LIVE_COMMANDS: &[LiveCommand] = &[
{% for cmd in commands %}    LiveCommand {
        noun: "{{ cmd.noun }}",
        verb: "{{ cmd.verb }}",
        fn_name: "{{ cmd.noun | snake_case }}_{{ cmd.verb | snake_case }}",
        handler: "{{ cmd.handler }}",
        doc: "{{ cmd.doc }}",
        return_type: "{{ cmd.return_type }}",
        has_static_response: {% if cmd.static_response %}true{% else %}false{% endif %},
        args: &[
{%- if cmd.args %}
{%- for spec in cmd.args | split(pat="@@") %}
{%- set parts = spec | split(pat="|") %}
{%- set field = parts[0] %}
{%- set rust_type = parts[1] %}
{%- set required = parts[2] %}
{%- if field in reserved %}{% set_global ident = "r#" ~ field %}{% else %}{% set_global ident = field %}{% endif %}
            LiveArg { ident: "{{ ident }}", rust_type: "{{ rust_type }}", required: {{ required }} },
{%- endfor %}
{%- endif %}
        ],
    },
{% endfor %}];

const LIVE_NOUNS: &[LiveNoun] = &[
{% for row in nouns %}    LiveNoun { noun: "{{ row.noun }}", noun_upper: "{{ row.noun | upper }}", about: "{{ row.about }}" },
{% endfor %}];

const LIVE_STATIC_RESPONSES: &[(&str, &str)] = &[
{%- for cmd in commands %}
{%- if cmd.static_response %}
    ("{{ cmd.noun }}:{{ cmd.verb }}", r#"Ok({{ cmd.static_response }})"#),
{%- endif %}
{%- endfor %}
];

fn routes_only() -> &'static str {
    ROUTES
        .split("#[cfg(test)]")
        .next()
        .expect("ROUTES is a non-empty &str; split always yields >=1 part")
}

fn assert_command_in_routes(cmd: &LiveCommand) {
    assert!(ROUTES.contains(&format!("/// {}", cmd.doc)));
    assert!(ROUTES.contains(&format!("#[verb(\"{}\", \"{}\")]", cmd.verb, cmd.noun)));
    assert!(ROUTES.contains(&format!("fn {}(", cmd.fn_name)));
    let expected_return = format!(") -> Result<{}> ", cmd.return_type) + "{";
    assert!(ROUTES.contains(&expected_return));
    for arg in cmd.args {
        let expected_param = if arg.required {
            format!("{}: {}", arg.ident, arg.rust_type)
        } else {
            format!("{}: Option<{}>", arg.ident, arg.rust_type)
        };
        assert!(
            ROUTES.contains(&expected_param),
            "live command {}:{} missing semantic parameter {:?}",
            cmd.noun,
            cmd.verb,
            expected_param
        );
    }
    if !cmd.has_static_response {
        assert!(ROUTES.contains(&format!("crate::verbs::handlers::{}(", cmd.handler)));
    }
}

fn assert_command_in_docs_md(cmd: &LiveCommand) {
    let row = format!(
        "| `{}` | `{}` | `{}` | {} |",
        cmd.noun, cmd.verb, cmd.handler, cmd.doc
    );
    assert!(DOCS_MD.contains(&row), "missing generated docs row {row:?}");
}

fn assert_noun_in_routes(noun: &LiveNoun) {
    assert!(ROUTES.contains(&format!(
        "static REGISTER_{}_NOUN: fn() = register_{}_noun;",
        noun.noun_upper, noun.noun
    )));
    assert!(ROUTES.contains(&format!("\"{}\",", noun.noun)));
    assert!(ROUTES.contains(&format!("\"{}\",", noun.about)));
}

#[test]
fn sparql_queries_returned_at_least_one_row_each() {
    assert!(!LIVE_COMMANDS.is_empty());
    assert!(!LIVE_NOUNS.is_empty());
    assert!(!LIVE_STATIC_RESPONSES.is_empty());
}

#[test]
fn command_and_noun_counts_match_generated_routes_right_now() {
    assert_eq!(routes_only().matches("#[verb(").count(), LIVE_COMMANDS.len());
    assert_eq!(
        routes_only().matches("CommandRegistry::register_noun(").count(),
        LIVE_NOUNS.len()
    );
}

#[test]
fn every_live_command_matches_generated_routes_right_now() {
    for cmd in LIVE_COMMANDS {
        assert_command_in_routes(cmd);
    }
}

#[test]
fn every_live_command_matches_generated_docs_md_right_now() {
    for cmd in LIVE_COMMANDS {
        assert_command_in_docs_md(cmd);
    }
}

fn compact_rust_projection(value: &str) -> String {
    value.chars().filter(|ch| !ch.is_whitespace()).collect()
}

fn wrapper_diagnostic(key: &str) -> &str {
    let fn_name = key.replace(':', "_");
    let marker = format!("fn {fn_name}(");
    let Some(start) = ROUTES.find(&marker) else {
        return "<wrapper-not-found>";
    };
    let tail = &ROUTES[start..];
    let len = tail.len().min(1400);
    &tail[..len]
}

#[test]
fn every_live_static_response_matches_generated_routes_right_now() {
    let compact_routes = compact_rust_projection(ROUTES);
    for (key, expected_body) in LIVE_STATIC_RESPONSES {
        let compact_expected = compact_rust_projection(expected_body);
        assert!(
            compact_routes.contains(&compact_expected),
            "live static response mismatch for {key}; expected_compact={compact_expected:?}; wrapper={:?}",
            wrapper_diagnostic(key)
        );
    }
}

#[test]
fn every_live_noun_matches_generated_routes_right_now() {
    for noun in LIVE_NOUNS {
        assert_noun_in_routes(noun);
    }
}

#[test]
fn live_command_order_is_lexical_ascending_by_noun_then_verb() {
    let keys: Vec<(&str, &str)> = LIVE_COMMANDS.iter().map(|c| (c.noun, c.verb)).collect();
    let mut sorted_keys = keys.clone();
    sorted_keys.sort_unstable();
    assert_eq!(keys, sorted_keys);
}

#[test]
fn live_noun_order_is_lexical_ascending() {
    let names: Vec<&str> = LIVE_NOUNS.iter().map(|n| n.noun).collect();
    let mut sorted_names = names.clone();
    sorted_names.sort_unstable();
    assert_eq!(names, sorted_names);
}

#[test]
fn generated_artifacts_reject_unknown_command() {
    assert!(!ROUTES.contains("#[verb(\"not-a-real-verb\", \"not-a-real-noun\")]"));
    assert!(!DOCS_MD.contains("| `not-a-real-noun` |"));
}
