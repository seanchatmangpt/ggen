---
to: tests/clap_noun_verb_sparql_derived_proof.rs
sparql:
  commands: "PREFIX cnv: <http://seanchatmangpt.github.io/packs/clap-noun-verb#> SELECT ?noun ?verb ?handler ?doc ?return_type ?args ?static_response WHERE { ?c a cnv:Command ; cnv:noun ?noun ; cnv:verb ?verb ; cnv:handler ?handler ; cnv:doc ?doc ; cnv:returnType ?return_type ; cnv:args ?args . OPTIONAL { ?c cnv:staticResponse ?static_response } } ORDER BY ?noun ?verb"
  nouns: "PREFIX cnv: <http://seanchatmangpt.github.io/packs/clap-noun-verb#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?noun ?about WHERE { ?n a cnv:Noun ; rdfs:label ?noun ; rdfs:comment ?about } ORDER BY ?noun"
---
//! Generated by clap-noun-verb-pack. Do not edit.
//!
//! This integration proof is independently regenerated from the live union
//! graph on every ggen sync and compares that live projection with the route
//! and Markdown artifacts currently on disk.

const ROUTES: &str =
    include_str!(concat!(env!("CARGO_MANIFEST_DIR"), "/src/clap_noun_verb_routes.rs"));
const DOCS_MD: &str =
    include_str!(concat!(env!("CARGO_MANIFEST_DIR"), "/docs/clap_noun_verb_routes.md"));

struct LiveArg {
    ident: &'static str,
    rust_type: &'static str,
    required: bool,
}

struct LiveCommand {
    noun: &'static str,
    verb: &'static str,
    fn_name: &'static str,
    handler: &'static str,
    doc: &'static str,
    return_type: &'static str,
    has_static_response: bool,
    args: &'static [LiveArg],
}

struct LiveNoun {
    noun: &'static str,
    noun_upper: &'static str,
    about: &'static str,
}

