    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?noun ?verb ?about WHERE {
      ?noun_node a cnv:Noun ; cnv:name ?noun ; cnv:hasCommand ?command .
      ?command a cnv:Command ; cnv:name ?verb ; cnv:about ?about ;
               cnv:belongsToNoun ?noun_node ; cnv:hasBehavior ?behavior .
      ?behavior a cnv:CustomBehavior .
    }
    ORDER BY ?noun ?verb
