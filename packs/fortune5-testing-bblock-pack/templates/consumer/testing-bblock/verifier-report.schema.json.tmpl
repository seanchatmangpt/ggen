{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schemas/testing/verifier-report-v1.json",
  "title": "ggen Testing BBlock Verifier Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "standing", "suite_order", "suite_count", "alive_count", "blocked_count", "build_broken_count", "chain_head", "receipts"],
  "properties": {
    "schema": {"const": "ggen.testing.verifier-report.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "standing": {"enum": ["ALIVE", "BLOCKED", "BUILD_BROKEN"]},
    "suite_order": {
      "type": "array",
      "items": {"enum": ["protocol-unit", "property-fuzz", "stdio-http-integration", "cli-e2e", "security", "chaos", "stress", "benchmark", "replay"]},
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true
    },
    "suite_count": {"type": "integer", "minimum": 1, "maximum": 9},
    "alive_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "blocked_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "build_broken_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "chain_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "suite", "status", "started_at", "finished_at", "duration_ms", "previous_digest", "evidence_path", "evidence_blake3", "error", "digest_algorithm", "digest"],
        "properties": {
          "schema": {"const": "ggen.testing.suite-receipt.v1"},
          "suite": {"enum": ["protocol-unit", "property-fuzz", "stdio-http-integration", "cli-e2e", "security", "chaos", "stress", "benchmark", "replay"]},
          "status": {"enum": ["ALIVE", "BLOCKED", "BUILD_BROKEN"]},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": "number", "minimum": 0},
          "previous_digest": {"type": "string", "pattern": "^(GENESIS|[0-9a-f]{64})$"},
          "evidence_path": {"type": "string", "minLength": 1},
          "evidence_blake3": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "error": {"type": ["string", "null"]},
          "digest_algorithm": {"const": "blake3"},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
