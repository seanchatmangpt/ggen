# MESSAGE: DSPy signatures, fields, and modules must be dependency-closed, typed, and renderable as valid Python identifiers. Any row is a refusal.
#
# ENGINE CONSTRAINT (found by real execution, 2026-08-10): praxis-graphlaw's SPARQL evaluator
# stack-overflows on this query's deeply nested UNION algebra tree somewhere between 139 (fine)
# and 158 (`fatal runtime error: stack overflow`, confirmed via a real `cargo test` run against
# the default thread stack size) UNION branches -- this is a real recursion-depth limit in the
# engine, not a query-logic bug. Prefer VALUES-table-driven consolidated blocks (one UNION
# branch covering N properties/classes via a `VALUES (?a ?b) { ... }` table, see the
# "Consolidated ..." blocks below) over one UNION branch per property/kind when adding new
# checks -- do not let this file's branch count creep back toward ~150 unmeasured.
PREFIX dspy: <http://seanchatmangpt.github.io/packs/dspy#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?subject ?violation WHERE {
  {
    ?subject a dspy:Signature .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:className dcterms:title dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    # hasInput/hasOutput are required UNLESS the signature is dspy:derivedFromShaclShape
    # (2026-08-11) -- a SHACL-derived signature's fields come from its shape's real
    # sh:property facts instead, validated separately by
    # gates/020_shacl_signature_admission.rq, not by this hand-declared-individual path.
    ?subject a dspy:Signature .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER NOT EXISTS { ?subject dspy:derivedFromShaclShape ?anyShape }
    VALUES ?property { dspy:hasInput dspy:hasOutput }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a ?fieldType .
    VALUES ?fieldType { dspy:InputField dspy:OutputField dspy:PydanticModelField }
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:name dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a ?fieldType .
    VALUES ?fieldType { dspy:InputField dspy:OutputField }
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER NOT EXISTS { ?subject dspy:pythonType ?t }
    FILTER NOT EXISTS { ?subject dspy:hasLiteralOption ?o }
    FILTER NOT EXISTS { ?subject dspy:hasPydanticModelType ?m }
    BIND("field must have exactly one of dspy:pythonType, dspy:hasLiteralOption, or dspy:hasPydanticModelType" AS ?violation)
  } UNION {
    ?subject a dspy:PydanticModelField .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER NOT EXISTS { ?subject dspy:pythonType ?t }
    BIND("PydanticModelField missing required dspy:pythonType (nested model fields are out of scope)" AS ?violation)
  } UNION {
    ?subject dspy:pythonType ?t ; dspy:hasLiteralOption ?o .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    BIND("field must have exactly one of dspy:pythonType, dspy:hasLiteralOption, or dspy:hasPydanticModelType, not more than one" AS ?violation)
  } UNION {
    ?subject dspy:pythonType ?t ; dspy:hasPydanticModelType ?m .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    BIND("field must have exactly one of dspy:pythonType, dspy:hasLiteralOption, or dspy:hasPydanticModelType, not more than one" AS ?violation)
  } UNION {
    ?subject dspy:hasLiteralOption ?o ; dspy:hasPydanticModelType ?m .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    BIND("field must have exactly one of dspy:pythonType, dspy:hasLiteralOption, or dspy:hasPydanticModelType, not more than one" AS ?violation)
  } UNION {
    ?subject dspy:hasPydanticModelType ?model .
    FILTER NOT EXISTS { ?model a dspy:PydanticModel }
    BIND("hasPydanticModelType target is not a dspy:PydanticModel" AS ?violation)
  } UNION {
    ?subject a dspy:PydanticModel .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:pydanticClassName dspy:hasModelField dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:PydanticModel ; dspy:pydanticClassName ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("pydanticClassName is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:PydanticModel ; dspy:hasModelField ?field .
    FILTER NOT EXISTS { ?field a dspy:PydanticModelField }
    BIND("hasModelField target is not a dspy:PydanticModelField" AS ?violation)
  } UNION {
    ?subject a dspy:Module .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:name dspy:kind dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?kind { "Predict" "ChainOfThought" "ReAct" "ProgramOfThought" "MultiChainComparison" "RLM" "CodeAct" }
    FILTER NOT EXISTS { ?subject dspy:signature ?s }
    BIND(CONCAT(STR(?kind), " module missing required dspy:signature") AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?kind { "BestOfN" "Refine" }
    VALUES ?property { dspy:wrapsModule dspy:rewardFunction dspy:refineN dspy:refineThreshold }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT(STR(?kind), " module missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module .
    VALUES ?propA { dspy:signature dspy:wrapsModule dspy:hasStep dspy:hopQuerySignature dspy:trainsetName dspy:hasParallelStep }
    VALUES ?propB { dspy:signature dspy:wrapsModule dspy:hasStep dspy:hopQuerySignature dspy:trainsetName dspy:hasParallelStep }
    ?subject ?propA ?a ; ?propB ?b .
    FILTER(STR(?propA) < STR(?propB))
    BIND("module must declare exactly one of dspy:signature, dspy:wrapsModule, dspy:hasStep (Pipeline), dspy:hopQuerySignature (MultiHop), dspy:trainsetName (KNN), or dspy:hasParallelStep (Parallel), not more than one" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "CodeAct" .
    FILTER NOT EXISTS { ?subject dspy:hasLocalTool ?tool }
    BIND("CodeAct module missing required dspy:hasLocalTool (dspy.CodeAct's real 'tools' parameter has no default)" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "Pipeline" .
    VALUES ?property { dspy:hasStep dspy:pipelineSignature dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("Pipeline module missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "MultiHop" .
    VALUES ?property { dspy:hopQuerySignature dspy:hopAnswerSignature dspy:retrieveK dspy:maxHops dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("MultiHop module missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "KNN" .
    VALUES ?property { dspy:trainsetName dspy:usesEmbedder dspy:kValue dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("KNN module missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "Parallel" .
    VALUES ?property { dspy:hasParallelStep dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("Parallel module missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Signature ; dspy:hasInput ?field .
    FILTER NOT EXISTS { ?field a dspy:InputField }
    BIND("hasInput target is not a dspy:InputField" AS ?violation)
  } UNION {
    ?subject a dspy:Signature ; dspy:hasOutput ?field .
    FILTER NOT EXISTS { ?field a dspy:OutputField }
    BIND("hasOutput target is not a dspy:OutputField" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:signature ?signature .
    FILTER NOT EXISTS { ?signature a dspy:Signature }
    BIND("module signature target is not a dspy:Signature" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:wrapsModule ?wrapped .
    FILTER NOT EXISTS { ?wrapped a dspy:Module }
    BIND("wrapsModule target is not a dspy:Module" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind ; dspy:maxIters ?value .
    FILTER(?kind NOT IN ("ReAct", "ProgramOfThought", "CodeAct"))
    BIND("only ReAct/ProgramOfThought/CodeAct modules may declare dspy:maxIters" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:maxIters ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("maxIters is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:comparisonM dspy:comparisonTemperature }
    ?subject ?property ?value .
    FILTER(?kind != "MultiChainComparison")
    BIND(CONCAT("only a MultiChainComparison module may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:comparisonM ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("comparisonM is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:maxIterations dspy:maxLlmCalls dspy:maxOutputChars dspy:verboseFlag }
    ?subject ?property ?value .
    FILTER(?kind != "RLM")
    BIND(CONCAT("only an RLM module may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module .
    VALUES ?property { dspy:maxIterations dspy:maxLlmCalls dspy:maxOutputChars }
    ?subject ?property ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND(CONCAT(STR(?property), " is not a positive integer") AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind ; dspy:hasLocalTool ?tool .
    FILTER(?kind != "CodeAct")
    BIND("only a CodeAct module may declare dspy:hasLocalTool" AS ?violation)
  } UNION {
    ?subject dspy:hasLocalTool ?tool .
    FILTER NOT EXISTS { ?tool a dspy:LocalTool }
    BIND("hasLocalTool target is not a dspy:LocalTool" AS ?violation)
  } UNION {
    ?subject a dspy:LocalTool .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:name dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:wrapsModule dspy:rewardFunction dspy:refineN dspy:refineThreshold dspy:refineFailCount }
    ?subject ?property ?value .
    FILTER(?kind NOT IN ("BestOfN", "Refine"))
    BIND(CONCAT("only a BestOfN/Refine module may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:rewardFunction ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("rewardFunction is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:refineN ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("refineN is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:refineFailCount ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND("refineFailCount is not a non-negative integer" AS ?violation)
  } UNION {
    # Consolidated required-property-existence check for the 4 new leaf classes (kept as one
    # VALUES-driven block rather than one UNION branch per class -- this engine's SPARQL
    # evaluator hits real recursion-depth limits well before 160 UNION branches, confirmed by
    # a real stack overflow during this session's own development; see git history).
    ?subject a ?type .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES (?type ?property) {
      (dspy:PipelineStep dspy:stepIndex) (dspy:PipelineStep dspy:stepVarName) (dspy:PipelineStep dspy:stepKind)
      (dspy:ArgBinding dspy:argName) (dspy:ArgBinding dspy:argSourceKind) (dspy:ArgBinding dspy:argSourceField)
      (dspy:ParallelStep dspy:stepIndex) (dspy:ParallelStep dspy:stepModule)
      (dspy:EmbedderConfig dspy:embedderModel)
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT(STR(?type), " missing required ", STR(?property)) AS ?violation)
  } UNION {
    # Consolidated target-type check across every new object property (same recursion-depth
    # reason as above).
    ?subject ?property ?target .
    VALUES (?property ?expectedClass) {
      (dspy:hasStep dspy:PipelineStep) (dspy:stepSignature dspy:Signature)
      (dspy:pipelineSignature dspy:Signature) (dspy:hasArgBinding dspy:ArgBinding)
      (dspy:argSourceStep dspy:PipelineStep) (dspy:hopQuerySignature dspy:Signature)
      (dspy:hopAnswerSignature dspy:Signature) (dspy:usesEmbedder dspy:EmbedderConfig)
      (dspy:hasParallelStep dspy:ParallelStep) (dspy:stepModule dspy:Module)
    }
    FILTER NOT EXISTS { ?target a ?expectedClass }
    BIND(CONCAT(STR(?property), " target is not a ", STR(?expectedClass)) AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepKind ?k .
    FILTER(?k != "Retrieve")
    FILTER NOT EXISTS { ?subject dspy:stepSignature ?s }
    BIND("PipelineStep missing required dspy:stepSignature (required unless dspy:stepKind is \"Retrieve\")" AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepKind "Retrieve" .
    FILTER NOT EXISTS { ?subject dspy:retrieveK ?k }
    BIND("Retrieve-kind PipelineStep missing required dspy:retrieveK" AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepKind "Retrieve" ; dspy:stepSignature ?s .
    BIND("Retrieve-kind PipelineStep must not declare dspy:stepSignature" AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepKind ?k ; dspy:retrieveK ?r .
    FILTER(?k != "Retrieve")
    BIND("only a Retrieve-kind PipelineStep may declare dspy:retrieveK" AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepKind ?value .
    FILTER(STR(?value) NOT IN ("Retrieve", "Predict", "ChainOfThought", "ReAct", "ProgramOfThought", "MultiChainComparison", "RLM", "CodeAct"))
    BIND("stepKind is outside the admitted set" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind ; dspy:pipelineSignature ?value .
    FILTER(?kind != "Pipeline")
    BIND("only a Pipeline module may declare dspy:pipelineSignature" AS ?violation)
  } UNION {
    ?subject a dspy:ArgBinding ; dspy:argSourceKind ?value .
    FILTER(STR(?value) NOT IN ("PipelineInput", "StepOutput"))
    BIND("argSourceKind is outside the admitted set" AS ?violation)
  } UNION {
    ?subject a dspy:ArgBinding ; dspy:argSourceKind "StepOutput" .
    FILTER NOT EXISTS { ?subject dspy:argSourceStep ?s }
    BIND("ArgBinding with argSourceKind \"StepOutput\" missing required dspy:argSourceStep" AS ?violation)
  } UNION {
    ?subject a dspy:ArgBinding ; dspy:argSourceKind "PipelineInput" ; dspy:argSourceStep ?s .
    BIND("ArgBinding with argSourceKind \"PipelineInput\" must not declare dspy:argSourceStep" AS ?violation)
  } UNION {
    ?subject a dspy:PipelineStep ; dspy:stepIndex ?myIndex ; dspy:hasArgBinding ?binding .
    ?binding dspy:argSourceStep ?src .
    ?src dspy:stepIndex ?srcIndex .
    FILTER(?srcIndex >= ?myIndex)
    BIND("ArgBinding's dspy:argSourceStep must have a lower dspy:stepIndex than the binding's own step" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:hopQuerySignature dspy:hopAnswerSignature dspy:maxHops dspy:retrieveK }
    ?subject ?property ?value .
    FILTER(?kind != "MultiHop")
    BIND(CONCAT("only a MultiHop module may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:trainsetName dspy:usesEmbedder dspy:kValue }
    ?subject ?property ?value .
    FILTER(?kind != "KNN")
    BIND(CONCAT("only a KNN module may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:EmbedderConfig ; dspy:embedderModel ?value .
    FILTER(STRLEN(STR(?value)) = 0)
    BIND("embedderModel must not be empty" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind .
    VALUES ?property { dspy:parallelNumThreads dspy:parallelMaxErrors dspy:accessExamples dspy:returnFailedExamples dspy:provideTraceback dspy:disableProgressBar dspy:parallelTimeout dspy:stragglerLimit }
    ?subject ?property ?value .
    FILTER(?kind != "Parallel")
    BIND(CONCAT("only a Parallel module may declare ", STR(?property)) AS ?violation)
  } UNION {
    # Consolidated positive-int check across every new integer property with no dedicated
    # non-negative/other-range check below (same recursion-depth reason as above).
    ?subject ?property ?value .
    VALUES ?property { dspy:retrieveK dspy:kValue dspy:embedderBatchSize dspy:parallelNumThreads dspy:parallelTimeout dspy:stragglerLimit dspy:maxHops }
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND(CONCAT(STR(?property), " is not a positive integer") AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:parallelMaxErrors ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND("parallelMaxErrors is not a non-negative integer" AS ?violation)
  } UNION {
    ?subject dspy:name ?value .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("name is not a Python identifier" AS ?violation)
  } UNION {
    ?subject dspy:trainsetName ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("trainsetName is not a Python identifier" AS ?violation)
  } UNION {
    ?subject dspy:stepVarName ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("stepVarName is not a Python identifier" AS ?violation)
  } UNION {
    ?subject dspy:argName ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("argName is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:Signature ; dspy:className ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("className is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?value .
    FILTER(STR(?value) NOT IN ("Predict", "ChainOfThought", "ReAct", "ProgramOfThought", "MultiChainComparison", "RLM", "CodeAct", "BestOfN", "Refine", "Pipeline", "MultiHop", "KNN", "Parallel"))
    BIND("kind is outside the admitted module set" AS ?violation)
  } UNION {
    ?subject dspy:pythonType ?value .
    FILTER(STR(?value) NOT IN ("str", "int", "float", "bool"))
    BIND("pythonType is outside the admitted primitive set" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind "ReAct" .
    FILTER NOT EXISTS { ?subject dspy:usesMCPServer ?server }
    BIND("ReAct module missing dspy:usesMCPServer" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:kind ?kind ; dspy:usesMCPServer ?server .
    FILTER(?kind != "ReAct")
    BIND("only a ReAct module may declare dspy:usesMCPServer" AS ?violation)
  } UNION {
    ?subject a dspy:Module ; dspy:usesMCPServer ?server .
    FILTER NOT EXISTS { ?server a dspy:MCPServerConnection }
    BIND("usesMCPServer target is not a dspy:MCPServerConnection" AS ?violation)
  } UNION {
    ?subject a dspy:MCPServerConnection .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:name dspy:command dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:MCPServerConnection ; dspy:hasArg ?arg .
    FILTER NOT EXISTS { ?arg a dspy:ServerArg }
    BIND("hasArg target is not a dspy:ServerArg" AS ?violation)
  } UNION {
    ?subject a dspy:ServerArg .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:argIndex dspy:argValue }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:ServerArg ; dspy:argIndex ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND("argIndex is not a non-negative integer" AS ?violation)
  } UNION {
    ?subject dspy:hasLiteralOption ?option .
    FILTER NOT EXISTS { ?option a dspy:LiteralOption }
    BIND("hasLiteralOption target is not a dspy:LiteralOption" AS ?violation)
  } UNION {
    ?subject a dspy:LiteralOption .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:optionIndex dspy:optionValue }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:LiteralOption ; dspy:optionIndex ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND("optionIndex is not a non-negative integer" AS ?violation)
  } UNION {
    ?subject dspy:isListType ?value .
    FILTER NOT EXISTS { ?subject dspy:hasLiteralOption ?o }
    BIND("only a field with dspy:hasLiteralOption may declare dspy:isListType" AS ?violation)
  } UNION {
    ?subject dspy:geInt ?value .
    FILTER(!EXISTS { ?subject dspy:pythonType "int" })
    BIND("dspy:geInt is only valid when dspy:pythonType is \"int\"" AS ?violation)
  } UNION {
    ?subject dspy:leInt ?value .
    FILTER(!EXISTS { ?subject dspy:pythonType "int" })
    BIND("dspy:leInt is only valid when dspy:pythonType is \"int\"" AS ?violation)
  } UNION {
    ?subject dspy:geInt ?ge ; dspy:leInt ?le .
    FILTER(?ge > ?le)
    BIND("dspy:geInt must be <= dspy:leInt" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?k .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER(?k != "Ensemble")
    VALUES ?property { dspy:name dspy:kind dspy:optimizes dspy:metricFunction dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind "Ensemble" .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:name dspy:kind dspy:hasEnsembleMember dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("Ensemble optimizer missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind "Ensemble" .
    VALUES ?property { dspy:optimizes dspy:metricFunction }
    ?subject ?property ?value .
    BIND(CONCAT("Ensemble optimizer must not declare ", STR(?property), " (its real compile() takes a program list, no metric/target-Module concept)") AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?value .
    FILTER(STR(?value) NOT IN (
      "GEPA", "GRPO", "BootstrapFewShot", "BootstrapFewShotWithRandomSearch",
      "BootstrapFewShotWithOptuna", "BootstrapFinetune", "COPRO", "SignatureOptimizer",
      "MIPROv2", "AvatarOptimizer", "BetterTogether", "InferRules", "SIMBA", "LabeledFewShot",
      "Ensemble", "KNNFewShot"
    ))
    BIND("optimizer kind is outside the admitted set" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:optimizes ?module .
    FILTER NOT EXISTS { ?module a dspy:Module }
    BIND("optimizes target is not a dspy:Module" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:metricFunction ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("metricFunction is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:auto ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:auto" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:auto ?value .
    FILTER(STR(?value) NOT IN ("light", "medium", "heavy"))
    BIND("auto is outside the admitted budget set" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:reflectionModel ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:reflectionModel" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:trackStats ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:trackStats" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:numTrainSteps ?value .
    FILTER(?kind != "GRPO")
    BIND("only a GRPO optimizer may declare dspy:numTrainSteps" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:numTrainSteps ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("numTrainSteps is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:numThreads ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("numThreads is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:useMerge ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:useMerge" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:maxFullEvals ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:maxFullEvals" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:maxFullEvals ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("maxFullEvals is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:auto ?a ; dspy:maxFullEvals ?m .
    BIND("dspy:auto and dspy:maxFullEvals are mutually exclusive (dspy.GEPA requires exactly one of auto/max_full_evals/max_metric_calls)" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind "GEPA" .
    FILTER NOT EXISTS { ?subject dspy:auto ?a }
    FILTER NOT EXISTS { ?subject dspy:maxFullEvals ?m }
    BIND("a GEPA optimizer must declare exactly one of dspy:auto or dspy:maxFullEvals" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:reflectionMinibatchSize ?value .
    FILTER(?kind != "GEPA")
    BIND("only a GEPA optimizer may declare dspy:reflectionMinibatchSize" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:reflectionMinibatchSize ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("reflectionMinibatchSize is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:multitask ?value .
    FILTER(?kind != "GRPO")
    BIND("only a GRPO optimizer may declare dspy:multitask" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:excludeDemos ?value .
    FILTER(?kind != "GRPO")
    BIND("only a GRPO optimizer may declare dspy:excludeDemos" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:useTrainAsVal ?value .
    FILTER(?kind != "GRPO")
    BIND("only a GRPO optimizer may declare dspy:useTrainAsVal" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind "BootstrapFewShotWithOptuna" .
    FILTER NOT EXISTS { ?subject dspy:compileMaxDemos ?v }
    BIND("BootstrapFewShotWithOptuna optimizer missing required dspy:compileMaxDemos (its real compile() 'max_demos' has no default)" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:maxBootstrappedDemos dspy:maxLabeledDemos }
    ?subject ?property ?value .
    FILTER(?kind NOT IN ("BootstrapFewShot", "BootstrapFewShotWithRandomSearch", "BootstrapFewShotWithOptuna", "MIPROv2", "KNNFewShot"))
    BIND(CONCAT("only BootstrapFewShot/BootstrapFewShotWithRandomSearch/BootstrapFewShotWithOptuna/MIPROv2/KNNFewShot may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:maxRounds ?value .
    FILTER(?kind NOT IN ("BootstrapFewShot", "BootstrapFewShotWithRandomSearch", "BootstrapFewShotWithOptuna", "KNNFewShot"))
    BIND("only BootstrapFewShot/BootstrapFewShotWithRandomSearch/BootstrapFewShotWithOptuna may declare dspy:maxRounds" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:optimizerMaxErrors ?value .
    FILTER(?kind NOT IN ("BootstrapFewShot", "BootstrapFewShotWithRandomSearch", "MIPROv2"))
    BIND("only BootstrapFewShot/BootstrapFewShotWithRandomSearch/MIPROv2 may declare dspy:optimizerMaxErrors" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:metricThreshold ?value .
    FILTER(?kind NOT IN ("BootstrapFewShot", "BootstrapFewShotWithRandomSearch"))
    BIND("only BootstrapFewShot/BootstrapFewShotWithRandomSearch may declare dspy:metricThreshold" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:numCandidatePrograms ?value .
    FILTER(?kind NOT IN ("BootstrapFewShotWithRandomSearch", "BootstrapFewShotWithOptuna"))
    BIND("only BootstrapFewShotWithRandomSearch/BootstrapFewShotWithOptuna may declare dspy:numCandidatePrograms" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:stopAtScore ?value .
    FILTER(?kind != "BootstrapFewShotWithRandomSearch")
    BIND("only a BootstrapFewShotWithRandomSearch optimizer may declare dspy:stopAtScore" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:multitaskFinetune ?value .
    FILTER(?kind != "BootstrapFinetune")
    BIND("only a BootstrapFinetune optimizer may declare dspy:multitaskFinetune" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:promptModel ?value .
    FILTER(?kind NOT IN ("COPRO", "SignatureOptimizer", "MIPROv2", "SIMBA"))
    BIND("only COPRO/SignatureOptimizer/MIPROv2/SIMBA may declare dspy:promptModel" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:taskModel ?value .
    FILTER(?kind != "MIPROv2")
    BIND("only an MIPROv2 optimizer may declare dspy:taskModel" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:breadth dspy:depth dspy:initTemperature }
    ?subject ?property ?value .
    FILTER(?kind NOT IN ("COPRO", "SignatureOptimizer"))
    BIND(CONCAT("only COPRO/SignatureOptimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:optimizerVerbose ?value .
    FILTER(?kind NOT IN ("SignatureOptimizer", "MIPROv2"))
    BIND("only SignatureOptimizer/MIPROv2 may declare dspy:optimizerVerbose" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:numCandidates ?value .
    FILTER(?kind NOT IN ("MIPROv2", "InferRules", "SIMBA"))
    BIND("only MIPROv2/InferRules/SIMBA may declare dspy:numCandidates" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:seedInt ?value .
    FILTER(?kind NOT IN ("MIPROv2", "BetterTogether"))
    BIND("only MIPROv2/BetterTogether may declare dspy:seedInt" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:logDir ?value .
    FILTER(?kind != "MIPROv2")
    BIND("only an MIPROv2 optimizer may declare dspy:logDir" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:avatarMaxIters dspy:lowerBound dspy:upperBound dspy:maxPositiveInputs dspy:maxNegativeInputs dspy:optimizeFor }
    ?subject ?property ?value .
    FILTER(?kind != "AvatarOptimizer")
    BIND(CONCAT("only an AvatarOptimizer optimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:optimizeFor ?value .
    FILTER(STR(?value) NOT IN ("max", "min"))
    BIND("optimizeFor is outside the admitted set" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:wrapsPromptOptimizer dspy:wrapsWeightOptimizer }
    ?subject ?property ?value .
    FILTER(?kind != "BetterTogether")
    BIND(CONCAT("only a BetterTogether optimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject dspy:wrapsPromptOptimizer ?value .
    FILTER NOT EXISTS { ?value a dspy:Optimizer }
    BIND("wrapsPromptOptimizer target is not a dspy:Optimizer" AS ?violation)
  } UNION {
    ?subject dspy:wrapsWeightOptimizer ?value .
    FILTER NOT EXISTS { ?value a dspy:Optimizer }
    BIND("wrapsWeightOptimizer target is not a dspy:Optimizer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:numRules ?value .
    FILTER(?kind != "InferRules")
    BIND("only an InferRules optimizer may declare dspy:numRules" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:bsize dspy:maxSteps dspy:maxDemos dspy:demoInputFieldMaxlen dspy:temperatureForSampling dspy:temperatureForCandidates }
    ?subject ?property ?value .
    FILTER(?kind != "SIMBA")
    BIND(CONCAT("only a SIMBA optimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:compileMaxDemos ?value .
    FILTER(?kind != "BootstrapFewShotWithOptuna")
    BIND("only a BootstrapFewShotWithOptuna optimizer may declare dspy:compileMaxDemos" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind ; dspy:kValue ?value .
    FILTER(?kind NOT IN ("LabeledFewShot", "KNNFewShot"))
    BIND("only a LabeledFewShot/KNNFewShot optimizer may declare dspy:kValue" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer .
    VALUES ?property { dspy:maxBootstrappedDemos dspy:maxLabeledDemos dspy:maxRounds dspy:optimizerMaxErrors
                        dspy:numCandidatePrograms dspy:breadth dspy:depth dspy:numCandidates
                        dspy:avatarMaxIters dspy:maxPositiveInputs
                        dspy:maxNegativeInputs dspy:numRules dspy:bsize dspy:maxSteps dspy:maxDemos
                        dspy:demoInputFieldMaxlen dspy:compileMaxDemos }
    ?subject ?property ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND(CONCAT(STR(?property), " is not a positive integer") AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:trainsetName dspy:usesEmbedder }
    ?subject ?property ?value .
    FILTER(?kind != "KNNFewShot")
    BIND(CONCAT("only a KNNFewShot optimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind "KNNFewShot" .
    VALUES ?property { dspy:kValue dspy:trainsetName dspy:usesEmbedder dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("KNNFewShot optimizer missing required ", STR(?property)) AS ?violation)
  } UNION {
    # Consolidated required-property + target-type checks for dspy:EnsembleMember (same
    # recursion-depth reason as the Module-side consolidated blocks above).
    ?subject a dspy:EnsembleMember .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    VALUES ?property { dspy:stepIndex dspy:memberModule }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("EnsembleMember missing required ", STR(?property)) AS ?violation)
  } UNION {
    ?subject ?property ?target .
    VALUES (?property ?expectedClass) { (dspy:hasEnsembleMember dspy:EnsembleMember) (dspy:memberModule dspy:Module) }
    FILTER NOT EXISTS { ?target a ?expectedClass }
    BIND(CONCAT(STR(?property), " target is not a ", STR(?expectedClass)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:kind ?kind .
    VALUES ?property { dspy:reduceFunctionName dspy:ensembleSize dspy:ensembleDeterministic }
    ?subject ?property ?value .
    FILTER(?kind != "Ensemble")
    BIND(CONCAT("only an Ensemble optimizer may declare ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:reduceFunctionName ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("reduceFunctionName is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:ensembleSize ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND("ensembleSize is not a positive integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:ensembleDeterministic true .
    BIND("dspy:ensembleDeterministic = true is refused: dspy.Ensemble's real 'deterministic' flag is unimplemented in the installed dspy 3.1.3 itself (raises AssertionError, \"TODO: Implement example hashing for deterministic ensemble.\")" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer ; dspy:seedInt ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND("seedInt is not a non-negative integer" AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer .
    VALUES ?property { dspy:lowerBound dspy:upperBound }
    ?subject ?property ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value < 0)
    BIND(CONCAT(STR(?property), " is not a non-negative integer") AS ?violation)
  } UNION {
    ?subject a dspy:Optimizer .
    VALUES ?property { dspy:reflectionModel dspy:promptModel dspy:taskModel }
    ?subject ?property ?lm .
    FILTER NOT EXISTS { ?lm a dspy:LMConfig }
    BIND(CONCAT(STR(?property), " target is not a dspy:LMConfig") AS ?violation)
  } UNION {
    ?subject a dspy:LMConfig .
    FILTER(STRSTARTS(STR(?subject), "http://seanchatmangpt.github.io/packs/dspy#"))
    FILTER NOT EXISTS { ?subject dspy:modelName ?m }
    BIND("LMConfig missing required dspy:modelName" AS ?violation)
  } UNION {
    ?subject a dspy:LMConfig ; dspy:modelName ?value .
    FILTER(STRLEN(STR(?value)) = 0)
    BIND("modelName must not be empty" AS ?violation)
  } UNION {
    ?subject a dspy:LMConfig .
    VALUES ?property { dspy:maxTokens dspy:numRetries }
    ?subject ?property ?value .
    FILTER(!(DATATYPE(?value) = xsd:integer) || ?value <= 0)
    BIND(CONCAT(STR(?property), " is not a positive integer") AS ?violation)
  } UNION {
    ?subject a dspy:LMConfig ; dspy:modelType ?value .
    FILTER(STR(?value) NOT IN ("chat", "text", "responses"))
    BIND("modelType is outside the admitted set" AS ?violation)
  }
}
ORDER BY ?subject ?violation
