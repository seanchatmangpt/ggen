    rdfs:comment "GEPA-only. A dspy:LMConfig rendered as dspy.LM(...) and given to dspy.GEPA's real 'reflection_lm' parameter." .

dspy:modelName a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:string ;
    rdfs:comment "Required. dspy.LM's real 'model' parameter, e.g. \"openai/gpt-4o\" -- free-form (provider/model-id shaped), deliberately NOT validated as a Python identifier the way dspy:name is." .

