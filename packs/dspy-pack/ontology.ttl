dspy:maxTokens a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:integer ;
    rdfs:comment "Optional, positive integer. dspy.LM's real 'max_tokens' parameter -- real, load-bearing per-call-site tuning (e.g. a cheap classification call at max_tokens=500 vs. an agentic call at max_tokens=16000), not a hypothetical need." .

dspy:lmCache a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:boolean ;
    rdfs:comment "Optional. dspy.LM's real 'cache' parameter (default True in dspy 3.1.3)." .

dspy:numRetries a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:integer ;
    rdfs:comment "Optional, positive integer. dspy.LM's real 'num_retries' parameter (default 3 in dspy 3.1.3)." .

dspy:modelType a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:string ;
    rdfs:comment "Optional. One of chat, text, responses -- dspy.LM's real 'model_type' parameter (default \"chat\")." .

dspy:useDeveloperRole a rdf:Property ; rdfs:domain dspy:LMConfig ; rdfs:range xsd:boolean ;
    rdfs:comment "Optional. dspy.LM's real 'use_developer_role' parameter (default False)." .

dspy:trackStats a rdf:Property ; rdfs:domain dspy:Optimizer ; rdfs:range xsd:boolean ;
    rdfs:comment "GEPA-only. dspy.GEPA's real 'track_stats' parameter." .

dspy:numTrainSteps a rdf:Property ; rdfs:domain dspy:Optimizer ; rdfs:range xsd:integer ;
