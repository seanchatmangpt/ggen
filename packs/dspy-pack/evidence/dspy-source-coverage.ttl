dspyaud:src-SIMBA a dspyaud:DSPySourceClass ; dspyaud:role "Optimizer" ;
    dspyaud:pythonSymbol "SIMBA" ; dspyaud:sourceFile "dspy/teleprompt/simba.py" .
dspyaud:src-BootstrapFewShotWithOptuna a dspyaud:DSPySourceClass ; dspyaud:role "Optimizer" ;
    dspyaud:pythonSymbol "BootstrapFewShotWithOptuna" ; dspyaud:sourceFile "dspy/teleprompt/teleprompt_optuna.py" .
dspyaud:src-LabeledFewShot a dspyaud:DSPySourceClass ; dspyaud:role "Optimizer" ;
    dspyaud:pythonSymbol "LabeledFewShot" ; dspyaud:sourceFile "dspy/teleprompt/vanilla.py" .
dspyaud:src-GEPA a dspyaud:DSPySourceClass ; dspyaud:role "Optimizer" ;
    dspyaud:pythonSymbol "GEPA" ; dspyaud:sourceFile "dspy/teleprompt/gepa/gepa.py" ;
    dspyaud:tutorialCoverage "gepa" .

