# Coverage ledger, NOT pack vocabulary: real class-name facts transcribed from the installed
# dspy 3.1.3 source tree (`site-packages/dspy/predict/*.py`, `site-packages/dspy/teleprompt/**/*.py`,
# `grep '^class ' `, cross-checked 2026-08-10), plus the pack's own admitted-kind facts mirrored
# verbatim from gates/010_admission.rq's closed VALUES lists. Lives under a separate `dspyaud:`
# (audit) namespace/class set, distinct from the `dspy:` consumer-facing vocabulary in
# ../ontology.ttl -- composing dspy-pack never loads this file, so it cannot affect a consumer's
# generated output. It exists solely so queries/coverage_cross_reference.rq can run a real SPARQL
# join instead of a hand-maintained prose table.
#
# Drift guard: scripts/coverage_check.py re-parses gates/010_admission.rq's VALUES lists at run
# time and fails loudly if they've diverged from the dspyaud:AdmittedKind facts below -- the
# facts are not trusted on their own.
@prefix dspyaud: <http://seanchatmangpt.github.io/packs/dspy/audit#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ── Real DSPy Module subclasses (dspy/predict/*.py, dspy 3.1.3) ──────────────

dspyaud:src-BestOfN a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "BestOfN" ; dspyaud:sourceFile "dspy/predict/best_of_n.py" .
dspyaud:src-ChainOfThought a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "ChainOfThought" ; dspyaud:sourceFile "dspy/predict/chain_of_thought.py" ;
    dspyaud:tutorialCoverage "general", "mcp", "gepa" .
dspyaud:src-CodeAct a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "CodeAct" ; dspyaud:sourceFile "dspy/predict/code_act.py" .
dspyaud:src-KNN a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "KNN" ; dspyaud:sourceFile "dspy/predict/knn.py" .
dspyaud:src-MultiChainComparison a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "MultiChainComparison" ; dspyaud:sourceFile "dspy/predict/multi_chain_comparison.py" .
dspyaud:src-Parallel a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "Parallel" ; dspyaud:sourceFile "dspy/predict/parallel.py" .
dspyaud:src-Predict a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "Predict" ; dspyaud:sourceFile "dspy/predict/predict.py" ;
    dspyaud:tutorialCoverage "general" .
dspyaud:src-ProgramOfThought a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "ProgramOfThought" ; dspyaud:sourceFile "dspy/predict/program_of_thought.py" .
dspyaud:src-ReAct a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "ReAct" ; dspyaud:sourceFile "dspy/predict/react.py" ;
    dspyaud:tutorialCoverage "mcp" .
dspyaud:src-Refine a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "Refine" ; dspyaud:sourceFile "dspy/predict/refine.py" .
dspyaud:src-RLM a dspyaud:DSPySourceClass ; dspyaud:role "Module" ;
    dspyaud:pythonSymbol "RLM" ; dspyaud:sourceFile "dspy/predict/rlm.py" .

# ── Real DSPy Teleprompter (optimizer) subclasses (dspy/teleprompt/**/*.py, dspy 3.1.3) ──────

