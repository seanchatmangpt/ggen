---
to: "src/dspy_shacl_signatures.py"
sparql:
  signatures: "PREFIX dspy: <http://seanchatmangpt.github.io/packs/dspy#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?className ?description WHERE { ?signature a dspy:Signature ; dspy:derivedFromShaclShape ?shape ; dspy:className ?className . OPTIONAL { ?signature dcterms:description ?description } } ORDER BY ?className"
  fields: "PREFIX dspy: <http://seanchatmangpt.github.io/packs/dspy#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?signatureClassName ?fieldName ?pythonType ?description ?isOutput WHERE { ?signature a dspy:Signature ; dspy:derivedFromShaclShape ?shape ; dspy:className ?signatureClassName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:datatype ?dt . BIND(REPLACE(STR(?path), \"^.*[/#]\", \"\") AS ?fieldName) BIND(IF(?dt = <http://www.w3.org/2001/XMLSchema#string>, \"str\", IF(?dt = <http://www.w3.org/2001/XMLSchema#boolean>, \"bool\", IF(?dt IN (<http://www.w3.org/2001/XMLSchema#integer>, <http://www.w3.org/2001/XMLSchema#long>), \"int\", \"float\"))) AS ?pythonType) OPTIONAL { ?prop sh:description ?descRaw } OPTIONAL { ?prop dcterms:description ?descRaw2 } BIND(COALESCE(?descRaw, ?descRaw2, CONCAT(?fieldName, \" property\")) AS ?description) BIND(EXISTS { ?prop dspy:isOutputField true } AS ?isOutput) } ORDER BY ?signatureClassName ?isOutput ?fieldName"
---
"""DSPy Signatures derived from real SHACL shapes -- generated by dspy-pack's
dspy_shacl_signature.py.tmpl, the ggen-native port of the ttl2dspy.py lineage
(SHACL NodeShape -> dspy.Signature). Every field below echoes literals already
computed by the frontmatter SPARQL from real sh:PropertyShape facts -- nothing
here is synthesized, per pack-authoring-pack's "templates echo, they never
synthesize" rule.
"""

import dspy

{% for s in signatures %}
class {{ s.className }}(dspy.Signature):
    """{{ s.description | default(value=s.className) }}"""

{% for f in fields %}{% if f.signatureClassName == s.className and not f.isOutput %}    {{ f.fieldName }}: {{ f.pythonType }} = dspy.InputField(desc="{{ f.description }}")
{% endif %}{% endfor %}{% for f in fields %}{% if f.signatureClassName == s.className and f.isOutput %}    {{ f.fieldName }}: {{ f.pythonType }} = dspy.OutputField(desc="{{ f.description }}")
{% endif %}{% endfor %}

{% endfor %}