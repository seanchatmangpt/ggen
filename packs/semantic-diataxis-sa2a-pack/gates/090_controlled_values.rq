# MESSAGE: Capability taxonomy and consequence values are semantic identities, not free-form
# strings. Categories must be typed IRIs; consequence is closed to observational/constructive/consequential.
PREFIX sd: <https://ggen.dev/semantic-diataxis#>
SELECT ?s ?violation WHERE {
  {
    ?s a sd:Capability ; sd:category ?category .
    FILTER(!isIRI(?category))
    BIND("capability-category-must-be-iri" AS ?violation)
  }
  UNION {
    ?s a sd:Capability ; sd:category ?category .
    FILTER NOT EXISTS { ?category a sd:CapabilityCategory }
    BIND("capability-category-must-be-typed" AS ?violation)
  }
  UNION {
    ?s sd:consequence ?consequence .
    FILTER(
      ?consequence != "observational" &&
      ?consequence != "constructive" &&
      ?consequence != "consequential"
    )
    BIND("invalid-consequence" AS ?violation)
  }
  UNION {
    ?s a sd:SemanticDocument ; sd:semanticSubject ?subject .
    FILTER NOT EXISTS { ?subject a sd:SemanticSubject }
    BIND("document-subject-must-be-typed" AS ?violation)
  }
  UNION {
    ?s a sd:SemanticDocument ; sd:relatedCapability ?capability .
    FILTER NOT EXISTS { ?capability a sd:Capability }
    BIND("related-capability-must-be-typed" AS ?violation)
  }
  UNION {
    ?s a sd:HowTo ; sd:requiresCapability ?capability .
    FILTER NOT EXISTS { ?capability a sd:Capability }
    BIND("required-capability-must-be-typed" AS ?violation)
  }
  UNION {
    ?s a sd:SemanticDocument ; sd:docPath ?path .
    ?other a sd:SemanticDocument ; sd:docPath ?path .
    FILTER(STR(?s) < STR(?other))
    BIND("document-output-path-collision" AS ?violation)
  }
  UNION {
    ?s a sd:HowTo ; sd:slug ?slug .
    ?other a sd:HowTo ; sd:slug ?slug .
    FILTER(STR(?s) < STR(?other))
    BIND("howto-machine-output-collision" AS ?violation)
  }
  UNION {
    ?s a sd:Capability ; sd:slug ?slug .
    ?other a sd:Capability ; sd:slug ?slug .
    FILTER(STR(?s) < STR(?other))
    BIND("capability-output-collision" AS ?violation)
  }
  UNION {
    ?s a sd:HowTo ;
       sd:relatedCapability ?related ;
       sd:requiresCapability ?required .
    FILTER(?related != ?required)
    BIND("howto-capability-projections-disagree" AS ?violation)
  }
}
ORDER BY ?s ?violation
