# MESSAGE: Semantic identity and routing fields are single-valued. Multiple values would make
# SA2A selection or replay ambiguous. Any returned row is a conflicting property.
PREFIX sd: <https://ggen.dev/semantic-diataxis#>
SELECT ?s ?property ?v1 ?v2 WHERE {
  VALUES ?property {
    sd:repository sd:revision sd:digest
    sd:docPath sd:slug sd:title sd:semanticSubject sd:standing sd:provenance sd:owner
    sd:freshnessBoundary sd:falsifier sd:authority sd:relatedCapability
    sd:achieves sd:precondition sd:requiresCapability sd:requiresAuthority sd:procedure
    sd:expectedObservation sd:postcondition sd:failureMap sd:rollback
    sd:receiptSchema sd:replayProcedure
    sd:category sd:consequence
  }
  ?s ?property ?v1, ?v2 .
  FILTER(STR(?v1) < STR(?v2))
}
ORDER BY ?s ?property ?v1 ?v2
