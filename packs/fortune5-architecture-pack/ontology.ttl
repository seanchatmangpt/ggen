f5:LifecycleState a rdfs:Class .
f5:Criticality a rdfs:Class .
f5:ReplicationMode a rdfs:Class .
f5:ExecutionPath a rdfs:Class .

f5:Proposed a f5:LifecycleState .
f5:Admitted a f5:LifecycleState .
f5:Active a f5:LifecycleState .
f5:Deprecated a f5:LifecycleState .
f5:Retired a f5:LifecycleState .

f5:Tier0 a f5:Criticality .
