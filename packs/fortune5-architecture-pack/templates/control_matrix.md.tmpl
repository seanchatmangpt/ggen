---
to: docs/FORTUNE5_CONTROL_MATRIX.md
force: true
sparql:
  controls: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?assetId ?criticality ?slo ?capacity ?replication ?identity ?kms ?observability ?supervision WHERE {
      ?asset a f5:ArchitectureAsset ;
             f5:assetId ?assetId ;
             f5:criticality ?criticalityNode .
      OPTIONAL { ?asset f5:hasSlo ?sloValue }
      OPTIONAL { ?asset f5:hasCapacityEnvelope ?capacityValue }
      OPTIONAL { ?asset f5:hasReplicationPolicy ?replicationValue }
      OPTIONAL { ?asset f5:hasIdentityPolicy ?identityValue }
      OPTIONAL { ?asset f5:hasKmsPolicy ?kmsValue }
      OPTIONAL { ?asset f5:hasObservabilityPolicy ?observabilityValue }
      OPTIONAL { ?asset f5:hasSupervisionPolicy ?supervisionValue }
      BIND(REPLACE(STR(?criticalityNode), "^.*#", "") AS ?criticality)
      BIND(IF(BOUND(?sloValue), "YES", "NO") AS ?slo)
      BIND(IF(BOUND(?capacityValue), "YES", "NO") AS ?capacity)
      BIND(IF(BOUND(?replicationValue), "YES", "NO") AS ?replication)
      BIND(IF(BOUND(?identityValue), "YES", "NO") AS ?identity)
      BIND(IF(BOUND(?kmsValue), "YES", "NO") AS ?kms)
      BIND(IF(BOUND(?observabilityValue), "YES", "NO") AS ?observability)
      BIND(IF(BOUND(?supervisionValue), "YES", "NO") AS ?supervision)
    }
    ORDER BY ?criticality ?assetId
  autonomics: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?policyId ?broker ?direct ?parallelism ?algorithm WHERE {
      ?policy a f5:AutonomicPolicy ;
              f5:autonomicPolicyId ?policyId ;
              f5:broker ?broker ;
              f5:directActuation ?direct ;
              f5:maxParallelism ?parallelism ;
              f5:receiptAlgorithm ?algorithm .
    } ORDER BY ?policyId
---
