---
to: docs/FORTUNE5_CONTROL_MATRIX.md
force: true
sparql:
  controls: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?assetId ?criticality
           (IF(EXISTS { ?asset f5:hasSlo ?slo }, "YES", "NO") AS ?slo)
           (IF(EXISTS { ?asset f5:hasCapacityEnvelope ?capacity }, "YES", "NO") AS ?capacity)
           (IF(EXISTS { ?asset f5:hasReplicationPolicy ?replication }, "YES", "NO") AS ?replication)
           (IF(EXISTS { ?asset f5:hasIdentityPolicy ?identity }, "YES", "NO") AS ?identity)
           (IF(EXISTS { ?asset f5:hasKmsPolicy ?kms }, "YES", "NO") AS ?kms)
           (IF(EXISTS { ?asset f5:hasObservabilityPolicy ?observability }, "YES", "NO") AS ?observability)
    WHERE {
      ?asset a f5:ArchitectureAsset ; f5:assetId ?assetId ; f5:criticality ?criticalityNode .
      BIND(REPLACE(STR(?criticalityNode), "^.*#", "") AS ?criticality)
    }
    ORDER BY ?criticality ?assetId
  autonomics: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?policyId ?broker ?direct ?parallelism ?algorithm WHERE {
      ?policy a f5:AutonomicPolicy ;
              f5:autonomicPolicyId ?policyId ;
              f5:broker ?broker ;
              f5:directActuation ?direct ;
              f5:maxParallelism ?parallelism ;
              f5:receiptAlgorithm ?algorithm .
    } ORDER BY ?policyId
---
