---
to: docs/FORTUNE5_ARCHITECTURE_CATALOG.md
force: true
sparql:
  programs: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?programId ?releaseIdentity WHERE {
      ?program a f5:EnterpriseArchitectureProgram ;
               f5:programId ?programId ;
               f5:releaseIdentity ?releaseIdentity .
    } ORDER BY ?programId
  assets: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?assetId ?title ?owner ?criticality ?lifecycle
           (GROUP_CONCAT(DISTINCT ?capabilityId; separator=", ") AS ?capabilities)
           (GROUP_CONCAT(DISTINCT ?regionId; separator=", ") AS ?regions)
    WHERE {
      ?asset a f5:ArchitectureAsset ;
             f5:assetId ?assetId ;
             f5:title ?title ;
             f5:owner ?owner ;
             f5:criticality ?criticalityNode ;
             f5:lifecycleState ?lifecycleNode ;
             f5:deployedIn ?region .
      BIND(REPLACE(STR(?criticalityNode), "^.*#", "") AS ?criticality)
      BIND(REPLACE(STR(?lifecycleNode), "^.*#", "") AS ?lifecycle)
      ?region f5:regionId ?regionId .
      OPTIONAL { ?asset f5:realizesCapability ?capability . ?capability f5:capabilityId ?capabilityId }
    }
    GROUP BY ?assetId ?title ?owner ?criticality ?lifecycle
    ORDER BY ?criticality ?assetId
  capabilities: |
    PREFIX f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#>
    SELECT ?capabilityId ?title ?owner ?lifecycle
           (GROUP_CONCAT(DISTINCT ?assetId; separator=", ") AS ?assets)
    WHERE {
      ?capability a f5:EnterpriseCapability ;
                  f5:capabilityId ?capabilityId ;
                  f5:title ?title ;
                  f5:owner ?owner ;
                  f5:lifecycleState ?lifecycleNode ;
                  f5:realizedBy ?asset .
      BIND(REPLACE(STR(?lifecycleNode), "^.*#", "") AS ?lifecycle)
      ?asset f5:assetId ?assetId .
    }
    GROUP BY ?capabilityId ?title ?owner ?lifecycle
    ORDER BY ?capabilityId
---
