---
to: generated/cmd-cell/src/lib.rs
force: true
sh_after: rustfmt generated/cmd-cell/src/lib.rs
sparql:
  design: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?coverage ?expected ?maximum WHERE {
      ?design a cmd:DesignSpace ; dcterms:title ?title ; cmd:coverageMode ?coverage ;
              cmd:expectedCandidateCount ?expected ; cmd:maxCandidates ?maximum .
    }
    LIMIT 1
  dimensions: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?dimension_name ?dimension_order WHERE {
      ?design a cmd:DesignSpace ; cmd:hasDimension ?dimension .
      ?dimension cmd:name ?dimension_name ; cmd:order ?dimension_order .
    }
    ORDER BY ?dimension_order ?dimension_name
  options: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?dimension_name ?option_name ?reversible ?resource_cost WHERE {
      ?design a cmd:DesignSpace ; cmd:hasDimension ?dimension .
      ?dimension cmd:name ?dimension_name ; cmd:hasOption ?option .
      ?option cmd:name ?option_name ; cmd:reversible ?reversible ; cmd:resourceCost ?resource_cost .
    }
    ORDER BY ?dimension_name ?option_name
  candidates: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?standing
           (COALESCE(STR(?authority), "") AS ?authorized_by)
           ?output_path WHERE {
      ?design a cmd:DesignSpace ; cmd:hasCandidate ?candidate .
      ?candidate cmd:name ?candidate_name ; cmd:standing ?standing ; cmd:outputRelativePath ?output_path .
      OPTIONAL { ?candidate cmd:authorizedBy ?authority }
    }
    ORDER BY ?candidate_name
  selections: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?dimension_name ?option_name WHERE {
      ?design a cmd:DesignSpace ; cmd:hasCandidate ?candidate ; cmd:hasDimension ?dimension .
      ?candidate cmd:name ?candidate_name ; cmd:selectsOption ?option .
      ?dimension cmd:name ?dimension_name ; cmd:hasOption ?option .
      ?option cmd:name ?option_name .
    }
    ORDER BY ?candidate_name ?dimension_name
  proofs: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?proof_id ?proof_status WHERE {
      ?candidate a cmd:Candidate ; cmd:name ?candidate_name ; cmd:requiresProof ?proof .
      ?proof cmd:proofId ?proof_id ; cmd:proofStatus ?proof_status .
    }
    ORDER BY ?candidate_name ?proof_id
  broker: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?broker_name ?root_path ?receipt_algorithm ?replay_mode WHERE {
      ?design a cmd:DesignSpace ; cmd:hasBroker ?broker .
      ?broker cmd:name ?broker_name ; cmd:rootPath ?root_path ;
              cmd:receiptAlgorithm ?receipt_algorithm ; cmd:replayMode ?replay_mode .
    }
    LIMIT 1
---
//! GENERATED by ggen-combinatorial-maximalism-pack.
//!
//! The admitted graph is the authority. This module makes premature authority
//! collapse unrepresentable at the public actuation boundary and emits real
//! BLAKE3 receipts for every surviving filesystem mutation.

use serde::{Deserialize, Serialize};
use std::collections::{BTreeMap, BTreeSet};
use std::fmt::{Display, Formatter};
use std::fs::{self, File};
use std::io::Write;
use std::path::{Component, Path, PathBuf};
use std::time::{SystemTime, UNIX_EPOCH};

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum CoverageMode {
    Exhaustive,
    Pairwise,
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum Standing {
    Candidate,
    Verified,
}

