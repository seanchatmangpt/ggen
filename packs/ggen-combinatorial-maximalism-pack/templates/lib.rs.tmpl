#[derive(Debug)]
pub struct CmdError {
    pub code: &'static str,
    pub detail: String,
}

impl CmdError {
    fn new(code: &'static str, detail: impl Into<String>) -> Self {
        Self {
            code,
            detail: detail.into(),
        }
    }
}

impl Display for CmdError {
    fn fmt(&self, formatter: &mut Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}: {}", self.code, self.detail)
    }
}

impl std::error::Error for CmdError {}

pub type Result<T> = std::result::Result<T, CmdError>;

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Receipt {
    pub schema: String,
    pub standing: String,
    pub design: String,
    pub broker: String,
    pub candidate: String,
    pub authority: String,
    pub output_relative_path: String,
    pub input_blake3: String,
    pub output_blake3: String,
    pub previous_receipt_blake3: Option<String>,
    pub timestamp_unix_ms: u128,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ReceiptEnvelope {
    pub receipt: Receipt,
    pub receipt_blake3: String,
}

fn refuse<T>(code: &'static str, detail: impl Into<String>) -> Result<T> {
    Err(CmdError::new(code, detail))
}

fn safe_relative(path: &str) -> Result<PathBuf> {
    let value = Path::new(path);
    if value.as_os_str().is_empty() || value.is_absolute() {
        return refuse("UNSAFE_RELATIVE_PATH", path);
    }
    if value.components().any(|component| {
        matches!(
            component,
            Component::ParentDir | Component::RootDir | Component::Prefix(_)
        )
    }) {
        return refuse("UNSAFE_RELATIVE_PATH", path);
    }
    Ok(value.to_path_buf())
}

fn selections_for(candidate: &str) -> Result<BTreeMap<&'static str, &'static str>> {
    let mut selected = BTreeMap::new();
    for selection in DESIGN
        .selections
        .iter()
        .filter(|selection| selection.candidate == candidate)
    {
        if selected
            .insert(selection.dimension, selection.option)
            .is_some()
        {
            return refuse(
                "MULTIPLE_OPTIONS_FOR_DIMENSION",
                format!("{} / {}", candidate, selection.dimension),
            );
        }
    }
    Ok(selected)
}

pub fn validate_design() -> Result<()> {
    if DESIGN.dimensions.len() < 2 {
        return refuse("INSUFFICIENT_DIMENSIONS", DESIGN.dimensions.len().to_string());
    }
    if DESIGN.candidates.is_empty() || DESIGN.candidates.len() > DESIGN.max_candidates {
        return refuse(
            "CANDIDATE_BOUND_VIOLATION",
            format!("{} not in 1..={}", DESIGN.candidates.len(), DESIGN.max_candidates),
        );
    }
    if DESIGN.candidates.len() != DESIGN.expected_candidate_count {
        return refuse(
            "EXPECTED_CANDIDATE_COUNT_MISMATCH",
            format!(
                "{} != {}",
                DESIGN.candidates.len(),
                DESIGN.expected_candidate_count
            ),
        );
    }
    if DESIGN.broker.receipt_algorithm != "blake3" {
        return refuse(
            "RECEIPT_ALGORITHM_REFUSED",
            DESIGN.broker.receipt_algorithm,
        );
    }
    if DESIGN.broker.replay_mode != "exact-output" {
        return refuse("REPLAY_MODE_REFUSED", DESIGN.broker.replay_mode);
    }
    safe_relative(DESIGN.broker.root_path)?;

    let mut dimension_names = BTreeSet::new();
    let mut dimension_orders = BTreeSet::new();
    let mut options_by_dimension: BTreeMap<&str, BTreeSet<&str>> = BTreeMap::new();
    for dimension in DESIGN.dimensions {
        if !dimension_names.insert(dimension.name) {
            return refuse("DUPLICATE_DIMENSION", dimension.name);
        }
        if !dimension_orders.insert(dimension.order) {
            return refuse("DUPLICATE_DIMENSION_ORDER", dimension.order.to_string());
        }
        options_by_dimension.insert(dimension.name, BTreeSet::new());
    }

    for option in DESIGN.options {
        if !option.reversible {
            return refuse("IRREVERSIBLE_CONSTRUCTION_OPTION", option.name);
        }
        if !option.resource_cost.is_finite() || option.resource_cost < 0.0 {
            return refuse("INVALID_RESOURCE_COST", option.name);
        }
        let Some(options) = options_by_dimension.get_mut(option.dimension) else {
            return refuse("OPTION_DIMENSION_UNKNOWN", option.dimension);
        };
        if !options.insert(option.name) {
            return refuse(
                "DUPLICATE_OPTION",
                format!("{} / {}", option.dimension, option.name),
            );
        }
    }
    for (dimension, options) in &options_by_dimension {
        if options.len() < 2 {
            return refuse("INSUFFICIENT_OPTIONS", *dimension);
        }
    }

    let mut candidate_names = BTreeSet::new();
    let mut output_paths = BTreeSet::new();
    let mut signatures = BTreeSet::new();
    let ordered_dimensions: Vec<&str> = DESIGN
        .dimensions
        .iter()
        .map(|dimension| dimension.name)
        .collect();

    for candidate in DESIGN.candidates {
        if !candidate_names.insert(candidate.name) {
            return refuse("DUPLICATE_CANDIDATE", candidate.name);
        }
        safe_relative(candidate.output_relative_path)?;
        if !output_paths.insert(candidate.output_relative_path) {
            return refuse("DUPLICATE_OUTPUT_PATH", candidate.output_relative_path);
        }
        if candidate.authorized_by.is_some() && candidate.standing != Standing::Verified {
            return refuse("AUTHORIZATION_WITHOUT_VERIFICATION", candidate.name);
        }
        if candidate.standing == Standing::Verified {
            let proofs: Vec<&ProofSpec> = DESIGN
                .proofs
                .iter()
                .filter(|proof| proof.candidate == candidate.name)
                .collect();
            if proofs.is_empty() || proofs.iter().any(|proof| proof.status != "SATISFIED") {
                return refuse("VERIFICATION_PROOF_REFUSED", candidate.name);
            }
        }

        let selected = selections_for(candidate.name)?;
        if selected.len() != ordered_dimensions.len() {
            return refuse("CANDIDATE_NOT_TOTAL", candidate.name);
        }
        let mut signature = Vec::with_capacity(ordered_dimensions.len());
        for dimension in &ordered_dimensions {
            let Some(option) = selected.get(dimension) else {
                return refuse(
                    "CANDIDATE_DIMENSION_MISSING",
                    format!("{} / {}", candidate.name, dimension),
                );
            };
            let Some(known_options) = options_by_dimension.get(dimension) else {
                return refuse("DIMENSION_UNKNOWN", *dimension);
            };
            if !known_options.contains(option) {
                return refuse(
                    "CANDIDATE_OPTION_UNKNOWN",
                    format!("{} / {} / {}", candidate.name, dimension, option),
                );
            }
            signature.push(*option);
        }
        if !signatures.insert(signature.join("|")) {
            return refuse("DUPLICATE_CANDIDATE_SIGNATURE", candidate.name);
        }
    }

    match DESIGN.coverage_mode {
        CoverageMode::Exhaustive => {
            let expected = options_by_dimension.values().try_fold(1usize, |acc, options| {
                acc.checked_mul(options.len())
                    .ok_or_else(|| CmdError::new("COMBINATION_COUNT_OVERFLOW", DESIGN.title))
            })?;
            if expected != DESIGN.expected_candidate_count || signatures.len() != expected {
                return refuse(
                    "EXHAUSTIVE_COVERAGE_REFUSED",
                    format!(
                        "product={expected}, expected={}, unique={}",
                        DESIGN.expected_candidate_count,
                        signatures.len()
                    ),
                );
            }
        }
        CoverageMode::Pairwise => {
            for left_index in 0..ordered_dimensions.len() {
                for right_index in (left_index + 1)..ordered_dimensions.len() {
                    let left_dimension = ordered_dimensions[left_index];
                    let right_dimension = ordered_dimensions[right_index];
                    let left_options = &options_by_dimension[left_dimension];
                    let right_options = &options_by_dimension[right_dimension];
                    for left_option in left_options {
                        for right_option in right_options {
                            let covered = DESIGN.candidates.iter().any(|candidate| {
                                selections_for(candidate.name).is_ok_and(|selected| {
                                    selected.get(left_dimension) == Some(left_option)
                                        && selected.get(right_dimension) == Some(right_option)
                                })
                            });
                            if !covered {
                                return refuse(
                                    "PAIRWISE_COVERAGE_REFUSED",
                                    format!(
                                        "{}={} / {}={}",
                                        left_dimension,
                                        left_option,
                                        right_dimension,
                                        right_option
                                    ),
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    Ok(())
}

fn now_unix_ms() -> Result<u128> {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|duration| duration.as_millis())
        .map_err(|error| CmdError::new("CLOCK_BEFORE_UNIX_EPOCH", error.to_string()))
}

fn write_file_synced(path: &Path, bytes: &[u8]) -> Result<()> {
    if let Some(parent) = path.parent() {
        fs::create_dir_all(parent)
            .map_err(|error| CmdError::new("CREATE_PARENT_REFUSED", error.to_string()))?;
    }
    let mut file = File::create(path)
        .map_err(|error| CmdError::new("FILE_CREATE_REFUSED", error.to_string()))?;
    file.write_all(bytes)
        .map_err(|error| CmdError::new("FILE_WRITE_REFUSED", error.to_string()))?;
    file.sync_all()
        .map_err(|error| CmdError::new("FILE_SYNC_REFUSED", error.to_string()))?;
    Ok(())
}

fn atomic_head_write(path: &Path, value: &str) -> Result<()> {
    let temporary = path.with_extension("tmp");
    write_file_synced(&temporary, value.as_bytes())?;
    fs::rename(&temporary, path)
        .map_err(|error| CmdError::new("HEAD_RENAME_REFUSED", error.to_string()))
}

pub struct Broker {
    workspace: PathBuf,
}

impl Broker {
    pub fn new(workspace: impl Into<PathBuf>) -> Self {
        Self {
            workspace: workspace.into(),
        }
    }

    fn root(&self) -> Result<PathBuf> {
        Ok(self.workspace.join(safe_relative(DESIGN.broker.root_path)?))
    }

    pub fn actuate(&self, candidate_name: &str, payload: &[u8]) -> Result<PathBuf> {
        validate_design()?;
        let candidate = DESIGN
            .candidates
            .iter()
            .find(|candidate| candidate.name == candidate_name)
            .ok_or_else(|| CmdError::new("CANDIDATE_UNKNOWN", candidate_name))?;
        if candidate.standing != Standing::Verified {
            return refuse("CANDIDATE_NOT_VERIFIED", candidate.name);
        }
        let authority = candidate
            .authorized_by
            .ok_or_else(|| CmdError::new("CANDIDATE_NOT_AUTHORIZED", candidate.name))?;

        let root = self.root()?;
        let transactions = root.join("transactions");
        let staging_parent = root.join(".staging");
        fs::create_dir_all(&transactions)
            .map_err(|error| CmdError::new("TRANSACTION_ROOT_REFUSED", error.to_string()))?;
        fs::create_dir_all(&staging_parent)
            .map_err(|error| CmdError::new("STAGING_ROOT_REFUSED", error.to_string()))?;

        let timestamp = now_unix_ms()?;
        let input_blake3 = blake3::hash(payload).to_hex().to_string();
        let nonce = format!("{}-{}-{}", timestamp, candidate.name, &input_blake3[..16]);
        let staging = staging_parent.join(nonce);
        fs::create_dir(&staging)
            .map_err(|error| CmdError::new("STAGING_CREATE_REFUSED", error.to_string()))?;

        let output_relative = safe_relative(candidate.output_relative_path)?;
        let output_path = staging.join(&output_relative);
        if let Err(error) = write_file_synced(&output_path, payload) {
            let _ = fs::remove_dir_all(&staging);
            return Err(error);
        }
        let output_bytes = match fs::read(&output_path) {
            Ok(bytes) => bytes,
            Err(error) => {
                let _ = fs::remove_dir_all(&staging);
                return refuse("OUTPUT_READBACK_REFUSED", error.to_string());
            }
        };
        let output_blake3 = blake3::hash(&output_bytes).to_hex().to_string();
        let head_path = root.join("HEAD");
        let previous_receipt_blake3 = fs::read_to_string(&head_path)
            .ok()
            .map(|value| value.trim().to_owned())
            .filter(|value| !value.is_empty());

        let receipt = Receipt {
            schema: "https://chatmangpt.com/schema/cmd-receipt/v1".to_owned(),
            standing: "ACTUATED".to_owned(),
            design: DESIGN.title.to_owned(),
            broker: DESIGN.broker.name.to_owned(),
            candidate: candidate.name.to_owned(),
            authority: authority.to_owned(),
            output_relative_path: candidate.output_relative_path.to_owned(),
            input_blake3,
            output_blake3,
            previous_receipt_blake3,
            timestamp_unix_ms: timestamp,
        };
        let receipt_payload = serde_json::to_vec(&receipt)
            .map_err(|error| CmdError::new("RECEIPT_SERIALIZE_REFUSED", error.to_string()))?;
        let receipt_blake3 = blake3::hash(&receipt_payload).to_hex().to_string();
        let envelope = ReceiptEnvelope {
            receipt,
            receipt_blake3: receipt_blake3.clone(),
        };
        let envelope_bytes = serde_json::to_vec_pretty(&envelope)
            .map_err(|error| CmdError::new("RECEIPT_ENVELOPE_REFUSED", error.to_string()))?;
        if let Err(error) = write_file_synced(&staging.join("receipt.json"), &envelope_bytes) {
            let _ = fs::remove_dir_all(&staging);
            return Err(error);
        }

        let final_transaction = transactions.join(&receipt_blake3);
        if final_transaction.exists() {
            let _ = fs::remove_dir_all(&staging);
            return refuse("TRANSACTION_ALREADY_EXISTS", receipt_blake3);
        }
        if let Err(error) = fs::rename(&staging, &final_transaction) {
            let _ = fs::remove_dir_all(&staging);
            return refuse("TRANSACTION_COMMIT_REFUSED", error.to_string());
        }

        let receipt_path = final_transaction.join("receipt.json");
        if let Err(error) = atomic_head_write(&head_path, &receipt_blake3) {
            eprintln!("HEAD_INDEX_PARTIAL: {error}");
        }
        Ok(receipt_path)
    }

    pub fn replay(&self, receipt_path: &Path) -> Result<()> {
        validate_design()?;
        let bytes = fs::read(receipt_path)
            .map_err(|error| CmdError::new("RECEIPT_READ_REFUSED", error.to_string()))?;
        let envelope: ReceiptEnvelope = serde_json::from_slice(&bytes)
            .map_err(|error| CmdError::new("RECEIPT_PARSE_REFUSED", error.to_string()))?;
        let payload = serde_json::to_vec(&envelope.receipt)
            .map_err(|error| CmdError::new("RECEIPT_SERIALIZE_REFUSED", error.to_string()))?;
        let observed_receipt_blake3 = blake3::hash(&payload).to_hex().to_string();
        if observed_receipt_blake3 != envelope.receipt_blake3 {
            return refuse(
                "RECEIPT_DIGEST_MISMATCH",
                format!(
                    "{} != {}",
                    observed_receipt_blake3, envelope.receipt_blake3
                ),
            );
        }
        if envelope.receipt.schema != "https://chatmangpt.com/schema/cmd-receipt/v1"
            || envelope.receipt.standing != "ACTUATED"
            || envelope.receipt.design != DESIGN.title
            || envelope.receipt.broker != DESIGN.broker.name
        {
            return refuse("RECEIPT_SUBJECT_MISMATCH", receipt_path.display().to_string());
        }

        let transaction = receipt_path
            .parent()
            .ok_or_else(|| CmdError::new("RECEIPT_PARENT_MISSING", receipt_path.display().to_string()))?;
        let output_path = transaction.join(safe_relative(
            &envelope.receipt.output_relative_path,
        )?);
        let output = fs::read(&output_path)
            .map_err(|error| CmdError::new("OUTPUT_READ_REFUSED", error.to_string()))?;
        let observed_output_blake3 = blake3::hash(&output).to_hex().to_string();
        if observed_output_blake3 != envelope.receipt.output_blake3 {
            return refuse(
                "OUTPUT_DIGEST_MISMATCH",
                format!(
                    "{} != {}",
                    observed_output_blake3, envelope.receipt.output_blake3
                ),
            );
        }

        if let Some(previous) = &envelope.receipt.previous_receipt_blake3 {
            let previous_path = self.root()?.join("transactions").join(previous).join("receipt.json");
            if !previous_path.is_file() {
                return refuse("PREVIOUS_RECEIPT_MISSING", previous);
            }
        }
        Ok(())
    }
}
