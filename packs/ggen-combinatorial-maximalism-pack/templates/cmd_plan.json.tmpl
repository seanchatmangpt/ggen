---
to: generated/cmd-plan.json
force: true
sparql:
  design: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?crate_name ?binary_name ?version ?coverage_mode ?expected ?maximum WHERE {
      ?design a cmd:DesignSpace ; dcterms:title ?title ; cmd:crateName ?crate_name ;
              cmd:binaryName ?binary_name ; cmd:version ?version ; cmd:coverageMode ?coverage_mode ;
              cmd:expectedCandidateCount ?expected ; cmd:maxCandidates ?maximum .
    }
    LIMIT 1
  dimensions: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?dimension_name ?dimension_order WHERE {
      ?design a cmd:DesignSpace ; cmd:hasDimension ?dimension .
      ?dimension cmd:name ?dimension_name ; cmd:order ?dimension_order .
    }
    ORDER BY ?dimension_order ?dimension_name
  options: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?dimension_name ?option_name ?reversible ?resource_cost WHERE {
      ?design a cmd:DesignSpace ; cmd:hasDimension ?dimension .
      ?dimension cmd:name ?dimension_name ; cmd:hasOption ?option .
      ?option cmd:name ?option_name ; cmd:reversible ?reversible ; cmd:resourceCost ?resource_cost .
    }
    ORDER BY ?dimension_name ?option_name
  candidates: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?standing
           (COALESCE(STR(?authority), "") AS ?authorized_by)
           ?output_path WHERE {
      ?design a cmd:DesignSpace ; cmd:hasCandidate ?candidate .
      ?candidate cmd:name ?candidate_name ; cmd:standing ?standing ; cmd:outputRelativePath ?output_path .
      OPTIONAL { ?candidate cmd:authorizedBy ?authority }
    }
    ORDER BY ?candidate_name
  selections: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?dimension_name ?option_name WHERE {
      ?design a cmd:DesignSpace ; cmd:hasCandidate ?candidate ; cmd:hasDimension ?dimension .
      ?candidate cmd:name ?candidate_name ; cmd:selectsOption ?option .
      ?dimension cmd:name ?dimension_name ; cmd:hasOption ?option .
      ?option cmd:name ?option_name .
    }
    ORDER BY ?candidate_name ?dimension_name
  proofs: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?candidate_name ?proof_id ?proof_status WHERE {
      ?candidate a cmd:Candidate ; cmd:name ?candidate_name ; cmd:requiresProof ?proof .
      ?proof cmd:proofId ?proof_id ; cmd:proofStatus ?proof_status .
    }
    ORDER BY ?candidate_name ?proof_id
  broker: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?broker_name ?root_path ?receipt_algorithm ?replay_mode WHERE {
      ?design a cmd:DesignSpace ; cmd:hasBroker ?broker .
      ?broker cmd:name ?broker_name ; cmd:rootPath ?root_path ;
              cmd:receiptAlgorithm ?receipt_algorithm ; cmd:replayMode ?replay_mode .
    }
    LIMIT 1
---
{
{% for d in design %}  "schema": "https://chatmangpt.com/schema/cmd-plan/v1",
  "title": {{ d.title | json_encode | safe }},
  "crate_name": {{ d.crate_name | json_encode | safe }},
  "binary_name": {{ d.binary_name | json_encode | safe }},
  "version": {{ d.version | json_encode | safe }},
  "coverage_mode": {{ d.coverage_mode | json_encode | safe }},
  "expected_candidate_count": {{ d.expected }},
  "max_candidates": {{ d.maximum }},{% endfor %}
  "dimensions": [
{% for dimension in dimensions %}    {"name": {{ dimension.dimension_name | json_encode | safe }}, "order": {{ dimension.dimension_order }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "options": [
{% for option in options %}    {"dimension": {{ option.dimension_name | json_encode | safe }}, "name": {{ option.option_name | json_encode | safe }}, "reversible": {{ option.reversible }}, "resource_cost": {{ option.resource_cost }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "candidates": [
{% for candidate in candidates %}    {"name": {{ candidate.candidate_name | json_encode | safe }}, "standing": {{ candidate.standing | json_encode | safe }}, "authorized_by": {% if candidate.authorized_by %}{{ candidate.authorized_by | json_encode | safe }}{% else %}null{% endif %}, "output_relative_path": {{ candidate.output_path | json_encode | safe }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "selections": [
{% for selection in selections %}    {"candidate": {{ selection.candidate_name | json_encode | safe }}, "dimension": {{ selection.dimension_name | json_encode | safe }}, "option": {{ selection.option_name | json_encode | safe }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "proofs": [
{% for proof in proofs %}    {"candidate": {{ proof.candidate_name | json_encode | safe }}, "id": {{ proof.proof_id | json_encode | safe }}, "status": {{ proof.proof_status | json_encode | safe }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
{% for b in broker %}  "broker": {"name": {{ b.broker_name | json_encode | safe }}, "root_path": {{ b.root_path | json_encode | safe }}, "receipt_algorithm": {{ b.receipt_algorithm | json_encode | safe }}, "replay_mode": {{ b.replay_mode | json_encode | safe }}}
{% endfor %}}
