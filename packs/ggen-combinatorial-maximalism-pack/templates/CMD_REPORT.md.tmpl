---
to: generated/CMD_REPORT.md
force: true
sparql:
  design: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?coverage ?expected ?maximum WHERE {
      ?design a cmd:DesignSpace ; dcterms:title ?title ; cmd:coverageMode ?coverage ;
              cmd:expectedCandidateCount ?expected ; cmd:maxCandidates ?maximum .
    }
    LIMIT 1
  dimensions: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?name ?order (COUNT(DISTINCT ?option) AS ?option_count) WHERE {
      ?design a cmd:DesignSpace ; cmd:hasDimension ?dimension .
      ?dimension cmd:name ?name ; cmd:order ?order ; cmd:hasOption ?option .
    }
    GROUP BY ?name ?order
    ORDER BY ?order
  candidates: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?name ?standing (COALESCE(STR(?authority), "none") AS ?authority) ?path WHERE {
      ?design a cmd:DesignSpace ; cmd:hasCandidate ?candidate .
      ?candidate cmd:name ?name ; cmd:standing ?standing ; cmd:outputRelativePath ?path .
      OPTIONAL { ?candidate cmd:authorizedBy ?authority }
    }
    ORDER BY ?name
  broker: |
    PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
    SELECT ?name ?root ?algorithm ?replay WHERE {
      ?design a cmd:DesignSpace ; cmd:hasBroker ?broker .
      ?broker cmd:name ?name ; cmd:rootPath ?root ; cmd:receiptAlgorithm ?algorithm ; cmd:replayMode ?replay .
    }
    LIMIT 1
---
