name: Generated Fortune-5 Contract

on:
  pull_request:
  push:

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      - uses: dtolnay/rust-toolchain@nightly
      - run: cargo test
      - run: cargo run --quiet --bin verify > VERIFIER_REPORT.json
      - run: grep -q '"standing": "ALIVE"' VERIFIER_REPORT.json
