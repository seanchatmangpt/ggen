# gall-core-pack ontology
#
# Generic constitutional vocabulary for ggen-first Gall checkpoint programs.
# Program-specific capabilities, checkpoints, commands, exclusions, evidence,
# and crowns are declared by consumers. Standing is never authored: templates
# derive it from admitted gall:CheckpointEvidence and the pack gates enforce
# crown closure over that evidence.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gall: <http://seanchatmangpt.github.io/packs/gall-core#> .

# --- Core objects -----------------------------------------------------------

gall:GallProgram a rdfs:Class ;
    rdfs:comment "One complete checkpoint program for a repository, release, or bounded system. A program owns the declared capability and checkpoint universe from which ggen manufactures the roadmap, runners, evidence ledger, and crown report." .

gall:Capability a rdfs:Class ;
    rdfs:comment "A useful system consequence claimed by the program. Every checkpoint must produce at least one capability." .

gall:Checkpoint a rdfs:Class ;
    rdfs:comment "A dependency-closed proof cut that produces a useful capability and carries runner, positive-witness, negative-falsifier, receipt, and clean-replay obligations." .

gall:RequiredCheckpoint a rdfs:Class ;
    rdfs:subClassOf gall:Checkpoint ;
    rdfs:comment "A checkpoint that must be included by any crown for its owning program." .

gall:Crown a rdfs:Class ;
    rdfs:comment "Release closure over a program's checkpoint universe. Declaring a crown activates hard evidence gates: every included checkpoint must have green, exact-revision, clean-worktree evidence and every required checkpoint must be included." .

gall:Exclusion a rdfs:Class ;
    rdfs:comment "A first-class boundary for an object intentionally outside the admitted release domain. Exclusions require an object and a reason; they cannot silently remove a crowned checkpoint." .

# --- Obligations ------------------------------------------------------------

gall:Obligation a rdfs:Class ;
    rdfs:comment "An executable evidence obligation carrying a stable name and command." .

gall:PositiveWitness a rdfs:Class ;
    rdfs:subClassOf gall:Obligation ;
    rdfs:comment "Executable proof that the checkpoint's useful consequence works on admitted input." .

gall:NegativeFalsifier a rdfs:Class ;
    rdfs:subClassOf gall:Obligation ;
    rdfs:comment "Executable sabotage or invalid-input check that exits zero only when the claimed law correctly detects or refuses the defect." .

gall:ReceiptObligation a rdfs:Class ;
    rdfs:subClassOf gall:Obligation ;
    rdfs:comment "Executable verification of the deterministic receipt produced by the checkpoint." .

gall:ReplayObligation a rdfs:Class ;
    rdfs:subClassOf gall:Obligation ;
    rdfs:comment "Executable replay command run in a detached clean git worktree at the exact recorded revision." .

# --- Evidence ---------------------------------------------------------------

gall:CheckpointEvidence a rdfs:Class ;
    rdfs:comment "Observed evidence emitted by the generated scripts/gall/run-checkpoints.sh runner. It records real exit codes, exact git revision, tracked-source dirtiness, graph-hash binding, and whether replay occurred in a detached clean worktree." .

gall:Standing a rdfs:Class ;
    rdfs:comment "Derived checkpoint standing. These individuals are vocabulary values only; consumers must never attach gall:declaredStanding to a checkpoint." .

gall:UNKNOWN a gall:Standing .
gall:UNSUPPORTED a gall:Standing .
gall:BUILD_BROKEN a gall:Standing .
gall:BLOCKED a gall:Standing .
gall:PARTIAL_ALIVE a gall:Standing .
gall:ALIVE a gall:Standing .

# --- Checkpoint archetypes --------------------------------------------------

gall:CheckpointArchetype a rdfs:Class .
gall:CensusCheckpoint a gall:CheckpointArchetype .
gall:ExecutableFloorCheckpoint a gall:CheckpointArchetype .
gall:SemanticCheckpoint a gall:CheckpointArchetype .
gall:ProjectionCheckpoint a gall:CheckpointArchetype .
gall:CorrespondenceCheckpoint a gall:CheckpointArchetype .
gall:IntegrationCheckpoint a gall:CheckpointArchetype .
gall:BoundaryCheckpoint a gall:CheckpointArchetype .
gall:StressCheckpoint a gall:CheckpointArchetype .
gall:ReplayCheckpoint a gall:CheckpointArchetype .
gall:CrownCheckpoint a gall:CheckpointArchetype .

# --- Identity and ownership -------------------------------------------------

gall:programId a rdf:Property .
gall:releaseIdentity a rdf:Property .
gall:hasCheckpoint a rdf:Property .
gall:hasCrown a rdf:Property .
gall:capabilityId a rdf:Property .
gall:checkpointId a rdf:Property .
gall:crownId a rdf:Property .
gall:title a rdf:Property .
gall:description a rdf:Property .
gall:archetype a rdf:Property .
gall:producesCapability a rdf:Property .
gall:requiresCheckpoint a rdf:Property .
gall:ownsArtifact a rdf:Property .
gall:artifactPath a rdf:Property .
gall:includesCheckpoint a rdf:Property .

# --- Executable contract ----------------------------------------------------

gall:runnerCommand a rdf:Property ;
    rdfs:comment "Command that actuates the checkpoint's useful system in the mutable consumer worktree." .

gall:positiveWitness a rdf:Property .
gall:negativeFalsifier a rdf:Property .
gall:receiptObligation a rdf:Property .
gall:replayObligation a rdf:Property .
gall:name a rdf:Property .
gall:command a rdf:Property .

# --- Evidence fields --------------------------------------------------------

gall:forCheckpoint a rdf:Property .
gall:runnerExitCode a rdf:Property .
gall:witnessExitCode a rdf:Property .
gall:falsifierExitCode a rdf:Property .
gall:receiptExitCode a rdf:Property .
gall:replayExitCode a rdf:Property .
gall:exactRevision a rdf:Property .
gall:sourceDirty a rdf:Property .
gall:independentReplay a rdf:Property .
gall:verifiedGraphHash a rdf:Property .
gall:recordedAt a rdf:Property .

# --- Boundaries and anti-assertion law -------------------------------------

gall:excludedObject a rdf:Property .
gall:reason a rdf:Property .
gall:declaredStanding a rdf:Property ;
    rdfs:comment "Forbidden consumer property. Standing is derived from observed evidence; any authored use is refused by 050_manual_standing_forbidden.rq." .
