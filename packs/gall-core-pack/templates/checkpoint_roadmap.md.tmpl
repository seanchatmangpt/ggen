---
to: docs/GALL_CHECKPOINT_ROADMAP.md
force: true
sparql:
  programs: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?programId ?releaseIdentity ?jiraProjectKey ?profileId ?provider ?executionMode
           ?agentMode ?maxParallelism ?branchPattern ?runtimeDirectory ?receiptDirectory WHERE {
      ?program a gall:GallProgram ;
               gall:programId ?programId ;
               gall:releaseIdentity ?releaseIdentity ;
               gall:jiraProjectKey ?jiraProjectKey ;
               gall:hasAutomationProfile ?profile .
      ?profile a gall:AutomationProfile ;
               gall:automationProfileId ?profileId ;
               gall:trackerProvider ?providerNode ;
               gall:executionMode ?executionModeNode ;
               gall:agentMode ?agentModeNode ;
               gall:maxParallelism ?maxParallelism ;
               gall:branchPattern ?branchPattern ;
               gall:runtimeDirectory ?runtimeDirectory ;
               gall:receiptDirectory ?receiptDirectory .
      ?providerNode gall:providerName ?provider .
      ?executionModeNode gall:modeName ?executionMode .
      ?agentModeNode gall:agentModeName ?agentMode .
    } ORDER BY ?programId
  checkpoints: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?checkpointId ?title ?capabilityId ?capabilityTitle ?runnerCommand WHERE {
      ?checkpoint a gall:Checkpoint ;
                  gall:checkpointId ?checkpointId ;
                  gall:title ?title ;
                  gall:producesCapability ?capability ;
                  gall:runnerCommand ?runnerCommand .
      ?capability gall:capabilityId ?capabilityId ;
                  gall:title ?capabilityTitle .
    } ORDER BY ?checkpointId
  dependencies: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?checkpointId ?dependencyId WHERE {
      ?checkpoint a gall:Checkpoint ;
                  gall:checkpointId ?checkpointId ;
                  gall:requiresCheckpoint ?dependency .
      ?dependency gall:checkpointId ?dependencyId .
    } ORDER BY ?checkpointId ?dependencyId
  work_items: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
    SELECT ?workItemId ?summary ?checkpointId ?order ?issueType ?priority ?state WHERE {
      ?workItem a gall:WorkItem ;
                gall:workItemId ?workItemId ;
                gall:summary ?summary ;
                gall:belongsToCheckpoint ?checkpoint ;
                gall:implementationOrder ?order ;
                gall:issueType ?issueTypeNode ;
                gall:priority ?priorityNode ;
                gall:protocolState ?stateNode .
      ?checkpoint gall:checkpointId ?checkpointId .
      ?issueTypeNode gall:jiraName ?issueType .
      ?priorityNode gall:priorityName ?priority .
      ?stateNode gall:stateName ?state .
    } ORDER BY xsd:integer(?order) ?workItemId
  work_dependencies: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?workItemId ?dependencyId WHERE {
      ?workItem a gall:WorkItem ;
                gall:workItemId ?workItemId ;
                gall:dependsOnWorkItem ?dependency .
      ?dependency gall:workItemId ?dependencyId .
    } ORDER BY ?workItemId ?dependencyId
  obligations: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?checkpointId ?kind ?name ?command WHERE {
      ?checkpoint a gall:Checkpoint ;
                  gall:checkpointId ?checkpointId .
      {
        ?checkpoint gall:positiveWitness ?obligation .
        BIND("positive-witness" AS ?kind)
      }
      UNION
      {
        ?checkpoint gall:negativeFalsifier ?obligation .
        BIND("negative-falsifier" AS ?kind)
      }
      UNION
      {
        ?checkpoint gall:receiptObligation ?obligation .
        BIND("receipt" AS ?kind)
      }
      UNION
      {
        ?checkpoint gall:replayObligation ?obligation .
        BIND("clean-replay" AS ?kind)
      }
      ?obligation gall:name ?name ;
                  gall:command ?command .
    } ORDER BY ?checkpointId ?kind
---
