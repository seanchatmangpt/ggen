---
to: scripts/gall/run-checkpoints.sh
force: true
sparql:
  checkpoints: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    SELECT ?checkpoint ?checkpointId ?runnerCommand ?witnessCommand ?falsifierCommand ?receiptCommand ?replayCommand WHERE {
      ?checkpoint a gall:Checkpoint ;
                  gall:checkpointId ?checkpointId ;
                  gall:runnerCommand ?runnerCommand ;
                  gall:positiveWitness ?witness ;
                  gall:negativeFalsifier ?falsifier ;
                  gall:receiptObligation ?receipt ;
                  gall:replayObligation ?replay .
      ?witness gall:command ?witnessCommand .
      ?falsifier gall:command ?falsifierCommand .
      ?receipt gall:command ?receiptCommand .
      ?replay gall:command ?replayCommand .
    } ORDER BY ?checkpointId
---
{% raw %}#!/usr/bin/env bash
# GENERATED by `ggen sync run` from gall-core-pack.
#
# Runs every checkpoint's real actuation, positive witness, negative falsifier,
# receipt verifier, and replay command. Replay executes in a detached clean git
# worktree at the exact recorded revision. The script records reality into an
# evidence mini-pack; it always exits 0. gall-core-pack gates judge the emitted
# facts on the next sync.
set -uo pipefail

cd "$(dirname "$0")/../.."
mkdir -p evidence/gall/templates

RECORDED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
REVISION="$(git rev-parse HEAD 2>/dev/null || echo UNVERSIONED)"
SOURCE_DIRTY=false
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  if [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    SOURCE_DIRTY=true
  fi
else
  SOURCE_DIRTY=true
fi

GRAPH_HASH="unsynced"
if [ -f .ggen-v2/receipt.json ]; then
  GRAPH_HASH="$(python3 -c 'import json; print(json.load(open(".ggen-v2/receipt.json"))["payload"]["graph_hash"])' 2>/dev/null || echo unsynced)"
fi

REPLAY_PARENT="$(mktemp -d)"
REPLAY_TREE="$REPLAY_PARENT/tree"
export REPLAY_TREE
WORKTREE_READY=false
if [ "$REVISION" != "UNVERSIONED" ]; then
  if git worktree add --detach "$REPLAY_TREE" "$REVISION" >/dev/null 2>&1; then
    WORKTREE_READY=true
  fi
fi

LAST_CODE=125
run_step() { # stable-name, command-string
  local name="$1" cmd="$2"
  local log="${TMPDIR:-/tmp}/gall-$name-$$.log"
  bash -c "$cmd" >"$log" 2>&1
  LAST_CODE=$?
  printf '  %-48s exit %s\n' "$name" "$LAST_CODE"
  rm -f "$log"
}

OUT="evidence/gall/ontology.ttl"
cat > "$OUT" <<EOF
# GENERATED by scripts/gall/run-checkpoints.sh at $RECORDED_AT -- do not edit.
# Real exit codes from real commands; crown gates judge these facts.
@prefix gall:  <http://seanchatmangpt.github.io/packs/gall-core#> .
@prefix galle: <http://seanchatmangpt.github.io/evidence/gall#> .

EOF

printf 'Gall checkpoint evidence at %s\n' "$REVISION"
{% endraw %}{% for row in checkpoints %}
run_step '{{ row.checkpointId }}:runner' '{{ row.runnerCommand }}'
RUNNER_CODE="$LAST_CODE"
run_step '{{ row.checkpointId }}:witness' '{{ row.witnessCommand }}'
WITNESS_CODE="$LAST_CODE"
run_step '{{ row.checkpointId }}:falsifier' '{{ row.falsifierCommand }}'
FALSIFIER_CODE="$LAST_CODE"
run_step '{{ row.checkpointId }}:receipt' '{{ row.receiptCommand }}'
RECEIPT_CODE="$LAST_CODE"
if [ "$WORKTREE_READY" = true ]; then
  run_step '{{ row.checkpointId }}:replay' 'cd "$REPLAY_TREE" && {{ row.replayCommand }}'
  REPLAY_CODE="$LAST_CODE"
  if [ "$REPLAY_CODE" -eq 0 ]; then
    INDEPENDENT_REPLAY=true
  else
    INDEPENDENT_REPLAY=false
  fi
else
  REPLAY_CODE=125
  INDEPENDENT_REPLAY=false
  printf '  %-48s exit %s\n' '{{ row.checkpointId }}:replay' "$REPLAY_CODE"
fi
cat >> "$OUT" <<EOF
galle:checkpoint-{{ row.checkpointId }} a gall:CheckpointEvidence ;
    gall:forCheckpoint <{{ row.checkpoint }}> ;
    gall:runnerExitCode $RUNNER_CODE ;
    gall:witnessExitCode $WITNESS_CODE ;
    gall:falsifierExitCode $FALSIFIER_CODE ;
    gall:receiptExitCode $RECEIPT_CODE ;
    gall:replayExitCode $REPLAY_CODE ;
    gall:exactRevision "$REVISION" ;
    gall:sourceDirty $SOURCE_DIRTY ;
    gall:independentReplay $INDEPENDENT_REPLAY ;
    gall:verifiedGraphHash "$GRAPH_HASH" ;
    gall:recordedAt "$RECORDED_AT" .

EOF
{% endfor %}{% raw %}

if [ "$WORKTREE_READY" = true ]; then
  git worktree remove --force "$REPLAY_TREE" >/dev/null 2>&1 || true
fi
rmdir "$REPLAY_PARENT" >/dev/null 2>&1 || true

if [ ! -f evidence/gall/pack.toml ]; then
  cat > evidence/gall/pack.toml <<'EOF'
[pack]
name = "gall-evidence"
version = "0.0.0"
description = "GENERATED Gall checkpoint evidence with real command exit codes, exact revision, graph binding, and clean-worktree replay. Never hand-edit."
EOF
fi

if [ ! -f evidence/gall/templates/evidence_note.md.tmpl ]; then
  cat > evidence/gall/templates/evidence_note.md.tmpl <<'EOF'
---
to: receipts/GALL_EVIDENCE_ADMITTED.md
---
# Gall evidence admitted

This file is rendered only after `evidence/gall/ontology.ttl` enters the union
graph as an unlocked local pack and all active crown gates pass.
EOF
fi

echo "Gall evidence recorded -> $OUT"
echo "Wire this unlocked mini-pack in ggen.toml before crown activation:"
echo '  gall-evidence = { path = "evidence/gall", lock = false }'
exit 0
{% endraw %}