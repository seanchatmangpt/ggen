---
to: docs/GALL_AGENT_WORK_ORDERS.md
force: true
sparql:
  items: |
    PREFIX gall: <http://seanchatmangpt.github.io/packs/gall-core#>
    PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
    SELECT ?releaseIdentity ?workItemId ?issueType ?summary ?objective ?rationale
           ?checkpointId ?checkpointTitle ?order ?priority ?component ?state ?assigneeRole
           ?reviewerRole ?approvalGate ?branch ?agentMode
           (GROUP_CONCAT(DISTINCT ?dependencyId; separator="`, `") AS ?dependencies)
           (GROUP_CONCAT(DISTINCT ?context; separator="`\n- `") AS ?contexts)
           (GROUP_CONCAT(DISTINCT ?allowed; separator="`\n- `") AS ?allowedPaths)
           (GROUP_CONCAT(DISTINCT ?forbidden; separator="`\n- `") AS ?forbiddenPaths)
           (GROUP_CONCAT(DISTINCT ?must; separator="\n- ") AS ?mustDo)
           (GROUP_CONCAT(DISTINCT ?mustNot; separator="\n- ") AS ?mustNotDo)
           (GROUP_CONCAT(DISTINCT ?outside; separator="\n- ") AS ?outOfScope)
           (GROUP_CONCAT(DISTINCT ?acceptance; separator="\n- ") AS ?acceptanceCriteria)
           (GROUP_CONCAT(DISTINCT ?done; separator="\n- ") AS ?definitionOfDone)
           (GROUP_CONCAT(DISTINCT ?verify; separator="`\n- `") AS ?verificationCommands)
           (GROUP_CONCAT(DISTINCT ?evidence; separator="`\n- `") AS ?evidenceArtifacts)
           (GROUP_CONCAT(DISTINCT ?question; separator="\n- ") AS ?adversarialQuestions)
    WHERE {
      ?program a gall:GallProgram ;
               gall:releaseIdentity ?releaseIdentity ;
               gall:hasAutomationProfile ?profile ;
               gall:hasWorkItem ?workItem .
      ?profile gall:branchPattern ?branchPattern ; gall:agentMode ?agentModeNode .
      ?agentModeNode gall:agentModeName ?agentMode .
      ?workItem a gall:WorkItem ;
                gall:workItemId ?workItemId ;
                gall:issueType ?issueTypeNode ;
                gall:summary ?summary ;
                gall:objective ?objective ;
                gall:rationale ?rationale ;
                gall:belongsToCheckpoint ?checkpoint ;
                gall:implementationOrder ?order ;
                gall:priority ?priorityNode ;
                gall:component ?component ;
                gall:protocolState ?stateNode ;
                gall:assigneeRole ?assigneeRole ;
                gall:reviewerRole ?reviewerRole ;
                gall:approvalGate ?approvalGate ;
                gall:requiredContext ?context ;
                gall:allowedPath ?allowed ;
                gall:forbiddenPath ?forbidden ;
                gall:mustDo ?must ;
                gall:mustNotDo ?mustNot ;
                gall:outOfScope ?outside ;
                gall:acceptanceCriterion ?acceptance ;
                gall:definitionOfDone ?done ;
                gall:verificationCommand ?verify ;
                gall:evidenceArtifact ?evidence ;
                gall:adversarialQuestion ?question .
      BIND(REPLACE(STR(?branchPattern), "\\{workItemId\\}", STR(?workItemId)) AS ?branch)
      ?issueTypeNode gall:jiraName ?issueType .
      ?priorityNode gall:priorityName ?priority .
      ?stateNode gall:stateName ?state .
      ?checkpoint gall:checkpointId ?checkpointId ; gall:title ?checkpointTitle .
      OPTIONAL { ?workItem gall:dependsOnWorkItem ?dependency . ?dependency gall:workItemId ?dependencyId }
    }
    GROUP BY ?releaseIdentity ?workItemId ?issueType ?summary ?objective ?rationale
             ?checkpointId ?checkpointTitle ?order ?priority ?component ?state ?assigneeRole
             ?reviewerRole ?approvalGate ?branch ?agentMode
    ORDER BY xsd:integer(?order) ?workItemId
---
# Gall Coding-Agent Work Orders

GENERATED by `ggen sync run` from the admitted Gall program graph. Do not hand-edit.

These work orders are normative execution contracts. An agent must not infer omitted scope, broaden authority, replace evidence with assertions, or mark a work item complete without running every declared verifier.

