# MESSAGE: OCEL event time must be an xsd:dateTime literal so ordering survives projection and replay.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?event ?time WHERE {
  ?event a geocel:ManufacturingEvent ; geocel:eventTime ?time .
  FILTER(datatype(?time) != xsd:dateTime)
}
