# MESSAGE: each GgenPrimitiveObject must identify exactly one primitive.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?object (COUNT(?v) AS ?count) WHERE { ?object a geocel:GgenPrimitiveObject . OPTIONAL { ?object geocel:primitive ?v } } GROUP BY ?object HAVING(COUNT(?v) != 1)
