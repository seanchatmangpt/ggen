# MESSAGE: ManufacturingEvent must remain aligned as a PROV Activity.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT * WHERE { FILTER NOT EXISTS { geocel:ManufacturingEvent rdfs:subClassOf prov:Activity } }
