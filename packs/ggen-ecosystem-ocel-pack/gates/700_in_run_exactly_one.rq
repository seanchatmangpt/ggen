# MESSAGE: each ManufacturingEvent must belong to exactly one ManufacturingRun.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?event (COUNT(?v) AS ?count) WHERE { ?event a geocel:ManufacturingEvent . OPTIONAL { ?event geocel:inRun ?v } } GROUP BY ?event HAVING(COUNT(?v) != 1)
