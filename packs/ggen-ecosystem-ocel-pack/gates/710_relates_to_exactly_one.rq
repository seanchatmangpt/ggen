# MESSAGE: each ManufacturingEvent must relate to exactly one ManufacturingObject.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?event (COUNT(?v) AS ?count) WHERE { ?event a geocel:ManufacturingEvent . OPTIONAL { ?event geocel:relatesTo ?v } } GROUP BY ?event HAVING(COUNT(?v) != 1)
