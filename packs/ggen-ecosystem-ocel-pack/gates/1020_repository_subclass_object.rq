# MESSAGE: RepositoryObject must remain a ManufacturingObject specialization.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT * WHERE { FILTER NOT EXISTS { geocel:RepositoryObject rdfs:subClassOf geocel:ManufacturingObject } }
