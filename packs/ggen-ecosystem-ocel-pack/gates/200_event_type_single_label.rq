# MESSAGE: each event type used by manufacture must resolve to exactly one SKOS preferred label.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?type (COUNT(DISTINCT ?label) AS ?count) WHERE {
  ?event a geocel:ManufacturingEvent ; geocel:eventType ?type .
  OPTIONAL { ?type skos:prefLabel ?label }
} GROUP BY ?type HAVING(COUNT(DISTINCT ?label) != 1)
