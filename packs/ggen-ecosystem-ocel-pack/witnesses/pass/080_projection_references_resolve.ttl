@prefix geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#> .
@prefix ex: <urn:ggen:witness:> .
ex:run a geocel:ManufacturingRun ; geocel:runId "run-1" .
ex:repo a geocel:RepositoryObject ; geocel:objectId "repo-1" ; geocel:repository "seanchatmangpt/ggen" ; geocel:exactHead "0123456789abcdef0123456789abcdef01234567" .
ex:event a geocel:ManufacturingEvent ; geocel:inRun ex:run ; geocel:relatesTo ex:repo .
