@prefix geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#> .
@prefix ex: <urn:ggen:witness:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:run a geocel:ManufacturingRun ; geocel:runId "run" .
ex:e1 a geocel:ManufacturingEvent ; geocel:inRun ex:run ; geocel:sequence "0"^^xsd:integer .
ex:e2 a geocel:ManufacturingEvent ; geocel:inRun ex:run ; geocel:sequence "1"^^xsd:integer .
