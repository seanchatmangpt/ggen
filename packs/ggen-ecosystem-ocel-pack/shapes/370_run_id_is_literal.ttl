@prefix geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

geocel:ShaclGate370 a sh:NodeShape ;
    dcterms:source "gates/370_run_id_is_literal.rq" ;
    sh:targetSubjectsOf geocel:runId ;
    sh:property [ sh:path geocel:runId ; sh:nodeKind sh:Literal ] .
