geocel:ShaclGate380 a sh:NodeShape ; dcterms:source "gates/380_cell_is_literal.rq" ; sh:targetSubjectsOf geocel:cell ; sh:property [ sh:path geocel:cell ; sh:nodeKind sh:Literal ] .
