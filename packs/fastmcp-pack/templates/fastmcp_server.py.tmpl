---
to: src/fastmcp_server.py
sparql:
  servers: "PREFIX fmcp: <http://seanchatmangpt.github.io/packs/fastmcp#> SELECT ?name WHERE { ?server a fmcp:Server ; fmcp:name ?name . } ORDER BY ?server"
  tools: "PREFIX fmcp: <http://seanchatmangpt.github.io/packs/fastmcp#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?name ?function ?description ?argument ?argumentDescription ?returnTemplate WHERE { ?tool a fmcp:Tool ; fmcp:name ?name ; fmcp:function ?function ; dcterms:description ?description ; fmcp:argument ?argument ; fmcp:argumentDescription ?argumentDescription ; fmcp:returnTemplate ?returnTemplate . } ORDER BY ?name"
---
# GENERATED by ggen from fastmcp-pack/ontology.ttl. Do not hand-edit.
from __future__ import annotations

from fastmcp import FastMCP

mcp = FastMCP({{ servers[0].name | json_encode | safe }})

{% for tool in tools %}
@mcp.tool(name={{ tool.name | json_encode | safe }}, description={{ tool.description | json_encode | safe }})
def {{ tool.function }}({{ tool.argument }}: str) -> str:
    """{{ tool.description }}

    Args:
        {{ tool.argument }}: {{ tool.argumentDescription }}
    """
    return {{ tool.returnTemplate | json_encode | safe }}.format({{ tool.argument }}={{ tool.argument }})

{% endfor %}
if __name__ == "__main__":
    mcp.run()
