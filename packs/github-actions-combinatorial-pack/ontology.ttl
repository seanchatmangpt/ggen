@prefix ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical graph. Generated GitHub workflow/doc/lock projections are not editing authority.
# Open-world by design: new GitHub events, runners, permissions, Marketplace listings,
# reusable workflows, connector operations, artifacts, principals, and execution routes
# are RDF individuals. Selection is a bounded query over this graph, never a closed enum.

ci:github-actions-calculus a ci:CapabilityGraph ;
    dcterms:title "GitHub Cloud + Actions Combinatorial Capability Graph" ;
    dcterms:description "Preserve maximal lawful GitHub control/execution/materialization possibilities, then admit the cheapest dependency-closed exact-subject plan that binds authority, execution, consequence, receipt, and replay." ;
    ci:worldAssumption "open" ;
    ci:selectionObjective "min(cycle_time + information_loss + verification_risk + transport_cost + future_WIP)" ;
    ci:exactHeadRequired true ;
    ci:zeroUnreceiptedActuation true ;
    ci:extensionMechanism "add RDF individuals; projection remains query-driven" ;
    ci:governingEquation "A = mu(O*); R = receipt(A)" .

# -----------------------------------------------------------------------------
# Standing and failure ontology
# -----------------------------------------------------------------------------
ci:Unknown a ci:Standing ; ci:token "UNKNOWN" .
ci:PartialAlive a ci:Standing ; ci:token "PARTIAL_ALIVE" .
ci:Alive a ci:Standing ; ci:token "ALIVE" .
ci:BuildBroken a ci:Standing ; ci:token "BUILD_BROKEN" .
ci:Blocked a ci:Standing ; ci:token "BLOCKED" .
ci:Unsupported a ci:Standing ; ci:token "UNSUPPORTED" .
ci:Refused a ci:Standing ; ci:token "REFUSED" .

ci:SourceDefect a ci:FailureClass ; ci:token "SOURCE_DEFECT" .
ci:TestDefect a ci:FailureClass ; ci:token "TEST_DEFECT" .
ci:WorkflowDefect a ci:FailureClass ; ci:token "WORKFLOW_DEFECT" .
ci:ToolchainDrift a ci:FailureClass ; ci:token "TOOLCHAIN_DRIFT" .
ci:DependencyDrift a ci:FailureClass ; ci:token "DEPENDENCY_DRIFT" .
ci:LockfileDrift a ci:FailureClass ; ci:token "LOCKFILE_DRIFT" .
ci:PlatformVariance a ci:FailureClass ; ci:token "PLATFORM_VARIANCE" .
ci:Timeout a ci:FailureClass ; ci:token "TIMEOUT" .
ci:ResourceExhaustion a ci:FailureClass ; ci:token "RESOURCE_EXHAUSTION" .
ci:NetworkTransient a ci:FailureClass ; ci:token "NETWORK_TRANSIENT" .
ci:CacheCorruption a ci:FailureClass ; ci:token "CACHE_CORRUPTION" .
ci:AuthorityFailure a ci:FailureClass ; ci:token "AUTHORITY_FAILURE" .
ci:MissingSecret a ci:FailureClass ; ci:token "MISSING_SECRET" .
ci:Flake a ci:FailureClass ; ci:token "FLAKE" .
ci:ExternalProvider a ci:FailureClass ; ci:token "EXTERNAL_PROVIDER" .
ci:BaseDrift a ci:FailureClass ; ci:token "BASE_DRIFT" .
ci:GeneratedDrift a ci:FailureClass ; ci:token "GENERATED_DRIFT" .
ci:UnknownFailure a ci:FailureClass ; ci:token "UNKNOWN" .

# -----------------------------------------------------------------------------
# GitHub cloud operating planes: canonical precedence in ChatGPT cloud sessions
# Connector -> Actions -> Artifacts -> local verification capsule -> CLI fallback.
# The CLI is an implementation edge, never the ontology of GitHub.
# -----------------------------------------------------------------------------
ci:connector-control-plane a ci:TransportPlane ;
    ci:key "github-connector" ; ci:order 10 ;
    dcterms:description "Authenticated GitHub App control plane over repositories, Git objects, PRs, checks, workflow evidence, and mutations." .
ci:actions-execution-plane a ci:TransportPlane ;
    ci:key "github-actions" ; ci:order 20 ;
    dcterms:description "Repository-native remote execution plane for toolchains, integrations, matrices, and artifact manufacture." .
ci:artifact-materialization-plane a ci:TransportPlane ;
    ci:key "artifacts" ; ci:order 30 ;
    dcterms:description "Immutable materialization plane for source capsules, packages, bundles, verifier reports, toolchains, and receipts." .
ci:local-verification-plane a ci:TransportPlane ;
    ci:key "local-verification-capsule" ; ci:order 40 ;
    dcterms:description "ChatGPT runtime inspection/replay/hash/verification capsule; local network access is not GitHub authority." .
ci:cli-fallback-plane a ci:TransportPlane ;
    ci:key "cli-fallback" ; ci:order 50 ;
    dcterms:description "Optional git/gh/ssh/package-manager accelerators used when useful, never sovereign prerequisites." .

# Authority principals are intentionally non-interchangeable.
ci:chatgpt-connector-principal a ci:Principal ;
    ci:key "chatgpt-github-app" ;
    ci:authorityDomain "connected GitHub App installation" ;
    ci:crossRepositoryPotential true .
ci:actions-github-token-principal a ci:Principal ;
    ci:key "actions-github-token" ;
    ci:authorityDomain "repository-scoped workflow GITHUB_TOKEN" ;
    ci:crossRepositoryPotential false .
ci:github-app-installation-principal a ci:Principal ;
    ci:key "github-app-installation-token" ;
    ci:authorityDomain "explicit GitHub App installation scope" ;
    ci:crossRepositoryPotential true .
ci:oidc-federated-principal a ci:Principal ;
    ci:key "oidc-federated" ;
    ci:authorityDomain "external cloud trust policy bound to GitHub OIDC claims" .
ci:human-authority-principal a ci:Principal ;
    ci:key "human-authority" ;
    ci:authorityDomain "minimal external authority escalation; last relevant edge" .

# Connector capability graph. These are semantic operations, not a promise about
# a particular historical tool spelling. Runtime discovery decides which edges exist.
ci:repo-discovery a ci:ConnectorCapability ; ci:key "repository-discovery" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:repo-metadata a ci:ConnectorCapability ; ci:key "repository-metadata" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:file-fetch a ci:ConnectorCapability ; ci:key "file-fetch" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:blob-fetch a ci:ConnectorCapability ; ci:key "blob-fetch" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:tree-fetch a ci:ConnectorCapability ; ci:key "tree-fetch" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:commit-fetch a ci:ConnectorCapability ; ci:key "commit-fetch" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:pr-fetch a ci:ConnectorCapability ; ci:key "pr-fetch" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:pr-diff a ci:ConnectorCapability ; ci:key "pr-diff" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:status-fetch a ci:ConnectorCapability ; ci:key "commit-status" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:workflow-run-fetch a ci:ConnectorCapability ; ci:key "workflow-runs" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:workflow-job-fetch a ci:ConnectorCapability ; ci:key "workflow-jobs" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:workflow-step-fetch a ci:ConnectorCapability ; ci:key "workflow-steps" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:workflow-log-fetch a ci:ConnectorCapability ; ci:key "workflow-job-logs" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:workflow-artifact-fetch a ci:ConnectorCapability ; ci:key "workflow-artifacts" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:artifact-download a ci:ConnectorCapability ; ci:key "artifact-download" ; ci:plane ci:connector-control-plane ; ci:mutates false .
ci:branch-create a ci:ConnectorCapability ; ci:key "branch-create" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:blob-create a ci:ConnectorCapability ; ci:key "blob-create" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:tree-create a ci:ConnectorCapability ; ci:key "tree-create" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:commit-create a ci:ConnectorCapability ; ci:key "commit-create" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:ref-update a ci:ConnectorCapability ; ci:key "ref-update" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:pr-create a ci:ConnectorCapability ; ci:key "pr-create" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:pr-update a ci:ConnectorCapability ; ci:key "pr-update" ; ci:plane ci:connector-control-plane ; ci:mutates true .
ci:workflow-rerun a ci:ConnectorCapability ; ci:key "workflow-rerun" ; ci:plane ci:connector-control-plane ; ci:mutates true .

# -----------------------------------------------------------------------------
# Workflow operator state machines: named semantics survive transport changes.
# -----------------------------------------------------------------------------
ci:gh-fix-ci a ci:WorkflowOperator ;
    ci:key "gh-fix-ci" ;
    ci:stage "resolve-exact-pr-head", "enumerate-checks", "fetch-failing-logs",
             "first-causal-error", "diff-relevance", "minimum-repair",
             "verify", "publish", "reobserve-exact-head", "repeat-to-closure" ;
    ci:completionCondition "all requested actionable GitHub Actions boundaries close on the current exact head" .
ci:yeet a ci:WorkflowOperator ;
    ci:key "yeet" ;
    ci:stage "scope-freeze", "idempotency-check", "purpose-branch",
             "intentional-commit", "pre-publish-verification", "publish-remote-ref",
             "draft-pr", "reobserve-identities" ;
    ci:completionCondition "intended commit/ref/draft-PR graph is independently reobserved; merge is out of scope unless separately authorized" .
ci:fix-ci-yeet-loop a ci:WorkflowOperator ;
    ci:key "fix-ci-x-yeet" ;
    ci:stage "FIX_CI", "local-receipt", "YEET", "exact-head-CI-observation", "repeat" ;
    ci:completionCondition "requested CI boundary ALIVE at exact current PR head" .

# -----------------------------------------------------------------------------
# Current GitHub workflow event catalogue. Open-world: not an enum.
# -----------------------------------------------------------------------------
ci:branch-protection-rule a ci:EventKind ; ci:key "branch_protection_rule" ; ci:trustBoundary "default-branch-governance" ; ci:order 10 .
ci:check-run a ci:EventKind ; ci:key "check_run" ; ci:trustBoundary "check-event" ; ci:order 20 .
ci:check-suite a ci:EventKind ; ci:key "check_suite" ; ci:trustBoundary "check-event" ; ci:order 30 .
ci:create-event a ci:EventKind ; ci:key "create" ; ci:trustBoundary "git-ref" ; ci:order 40 .
ci:delete-event a ci:EventKind ; ci:key "delete" ; ci:trustBoundary "git-ref" ; ci:order 50 .
ci:deployment a ci:EventKind ; ci:key "deployment" ; ci:trustBoundary "deployment" ; ci:order 60 .
ci:deployment-status a ci:EventKind ; ci:key "deployment_status" ; ci:trustBoundary "deployment" ; ci:order 70 .
ci:discussion a ci:EventKind ; ci:key "discussion" ; ci:trustBoundary "discussion-event" ; ci:order 80 .
ci:discussion-comment a ci:EventKind ; ci:key "discussion_comment" ; ci:trustBoundary "discussion-event" ; ci:order 90 .
ci:fork a ci:EventKind ; ci:key "fork" ; ci:trustBoundary "repository-event" ; ci:order 100 .
ci:gollum a ci:EventKind ; ci:key "gollum" ; ci:trustBoundary "wiki-event" ; ci:order 110 .
ci:image-version a ci:EventKind ; ci:key "image_version" ; ci:trustBoundary "image-event" ; ci:order 120 .
ci:issue-comment a ci:EventKind ; ci:key "issue_comment" ; ci:trustBoundary "comment-event" ; ci:order 130 .
ci:issues a ci:EventKind ; ci:key "issues" ; ci:trustBoundary "issue-event" ; ci:order 140 .
ci:label a ci:EventKind ; ci:key "label" ; ci:trustBoundary "label-event" ; ci:order 150 .
ci:merge-group a ci:EventKind ; ci:key "merge_group" ; ci:trustBoundary "merge-queue" ; ci:order 160 .
ci:milestone a ci:EventKind ; ci:key "milestone" ; ci:trustBoundary "milestone-event" ; ci:order 170 .
ci:page-build a ci:EventKind ; ci:key "page_build" ; ci:trustBoundary "pages-event" ; ci:order 180 .
ci:public-event a ci:EventKind ; ci:key "public" ; ci:trustBoundary "repository-visibility" ; ci:order 190 .
ci:pull-request a ci:EventKind ; ci:key "pull_request" ; ci:trustBoundary "untrusted-change" ; ci:order 200 .
ci:pull-request-review a ci:EventKind ; ci:key "pull_request_review" ; ci:trustBoundary "review-event" ; ci:order 210 .
ci:pull-request-review-comment a ci:EventKind ; ci:key "pull_request_review_comment" ; ci:trustBoundary "review-comment" ; ci:order 220 .
ci:pull-request-target a ci:EventKind ; ci:key "pull_request_target" ; ci:trustBoundary "privileged-base" ; ci:order 230 .
ci:push a ci:EventKind ; ci:key "push" ; ci:trustBoundary "repository-ref" ; ci:order 240 .
ci:registry-package a ci:EventKind ; ci:key "registry_package" ; ci:trustBoundary "package-event" ; ci:order 250 .
ci:release a ci:EventKind ; ci:key "release" ; ci:trustBoundary "release" ; ci:order 260 .
ci:repository-dispatch a ci:EventKind ; ci:key "repository_dispatch" ; ci:trustBoundary "external-dispatch" ; ci:order 270 .
ci:schedule a ci:EventKind ; ci:key "schedule" ; ci:trustBoundary "repository-schedule" ; ci:order 280 .
ci:status-event a ci:EventKind ; ci:key "status" ; ci:trustBoundary "commit-status" ; ci:order 290 .
ci:watch a ci:EventKind ; ci:key "watch" ; ci:trustBoundary "repository-event" ; ci:order 300 .
ci:workflow-call a ci:EventKind ; ci:key "workflow_call" ; ci:trustBoundary "caller" ; ci:order 310 .
ci:workflow-dispatch a ci:EventKind ; ci:key "workflow_dispatch" ; ci:trustBoundary "authorized-manual" ; ci:order 320 .
ci:workflow-run a ci:EventKind ; ci:key "workflow_run" ; ci:trustBoundary "upstream-workflow" ; ci:order 330 .

# -----------------------------------------------------------------------------
# Runner / execution substrate
# -----------------------------------------------------------------------------
ci:github-hosted a ci:RunnerFamily ; ci:key "github-hosted" .
ci:larger-runner a ci:RunnerFamily ; ci:key "larger-runner" .
ci:self-hosted a ci:RunnerFamily ; ci:key "self-hosted" .
ci:arc-scale-set a ci:RunnerFamily ; ci:key "arc-scale-set" .
ci:job-container a ci:RunnerCapability ; ci:key "job-container" .
ci:service-container a ci:RunnerCapability ; ci:key "service-container" .
ci:linux-x64 a ci:RunnerCapability ; ci:key "linux-x64" .
ci:linux-arm64 a ci:RunnerCapability ; ci:key "linux-arm64" .
ci:macos-arm64 a ci:RunnerCapability ; ci:key "macos-arm64" .
ci:windows-x64 a ci:RunnerCapability ; ci:key "windows-x64" .
ci:gpu a ci:RunnerCapability ; ci:key "gpu" .
ci:static-ip a ci:RunnerCapability ; ci:key "static-ip" .
ci:private-networking a ci:RunnerCapability ; ci:key "private-networking" .
ci:autoscaling a ci:RunnerCapability ; ci:key "autoscaling" .

