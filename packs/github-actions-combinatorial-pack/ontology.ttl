ci:needs-dag a ci:CompositionCapability ; ci:key "needs" .
ci:matrix a ci:CompositionCapability ; ci:key "strategy.matrix" .
ci:matrix-include a ci:CompositionCapability ; ci:key "strategy.matrix.include" .
ci:matrix-exclude a ci:CompositionCapability ; ci:key "strategy.matrix.exclude" .
ci:fail-fast a ci:CompositionCapability ; ci:key "strategy.fail-fast" .
ci:max-parallel a ci:CompositionCapability ; ci:key "strategy.max-parallel" .
ci:concurrency a ci:CompositionCapability ; ci:key "concurrency" .
ci:cancel-in-progress a ci:CompositionCapability ; ci:key "cancel-in-progress" .
ci:reusable-workflow a ci:CompositionCapability ; ci:key "workflow_call" .
ci:workflow-template a ci:CompositionCapability ; ci:key "workflow-template" .
ci:yaml-anchor a ci:CompositionCapability ; ci:key "yaml-anchor" .
ci:environment a ci:CompositionCapability ; ci:key "environment" .
ci:cache a ci:CompositionCapability ; ci:key "cache" .
ci:artifact a ci:CompositionCapability ; ci:key "artifact" .
ci:oidc a ci:CompositionCapability ; ci:key "oidc" .
ci:attestation a ci:CompositionCapability ; ci:key "attestation" .
ci:release-capability a ci:CompositionCapability ; ci:key "release" .
ci:package-publish a ci:CompositionCapability ; ci:key "package-publish" .
ci:codeql a ci:CompositionCapability ; ci:key "codeql" .
ci:dependency-review a ci:CompositionCapability ; ci:key "dependency-review" .
ci:secret-scanning a ci:CompositionCapability ; ci:key "secret-scanning" .
ci:job-output a ci:CompositionCapability ; ci:key "job-output" .
ci:step-output a ci:CompositionCapability ; ci:key "step-output" .

# Current GITHUB_TOKEN scope vocabulary; still modeled open-world.
ci:perm-actions a ci:PermissionScope ; ci:key "actions" ; ci:accessModes "read,write,none" .
ci:perm-artifact-metadata a ci:PermissionScope ; ci:key "artifact-metadata" ; ci:accessModes "read,write,none" .
ci:perm-attestations a ci:PermissionScope ; ci:key "attestations" ; ci:accessModes "read,write,none" .
ci:perm-checks a ci:PermissionScope ; ci:key "checks" ; ci:accessModes "read,write,none" .
ci:perm-code-quality a ci:PermissionScope ; ci:key "code-quality" ; ci:accessModes "read,write,none" .
ci:perm-contents a ci:PermissionScope ; ci:key "contents" ; ci:accessModes "read,write,none" .
ci:perm-deployments a ci:PermissionScope ; ci:key "deployments" ; ci:accessModes "read,write,none" .
ci:perm-discussions a ci:PermissionScope ; ci:key "discussions" ; ci:accessModes "read,write,none" .
ci:perm-id-token a ci:PermissionScope ; ci:key "id-token" ; ci:accessModes "write,none" .
ci:perm-issues a ci:PermissionScope ; ci:key "issues" ; ci:accessModes "read,write,none" .
ci:perm-models a ci:PermissionScope ; ci:key "models" ; ci:accessModes "read,none" .
ci:perm-packages a ci:PermissionScope ; ci:key "packages" ; ci:accessModes "read,write,none" .
ci:perm-pages a ci:PermissionScope ; ci:key "pages" ; ci:accessModes "read,write,none" .
ci:perm-pull-requests a ci:PermissionScope ; ci:key "pull-requests" ; ci:accessModes "read,write,none" .
ci:perm-security-events a ci:PermissionScope ; ci:key "security-events" ; ci:accessModes "read,write,none" .
ci:perm-statuses a ci:PermissionScope ; ci:key "statuses" ; ci:accessModes "read,write,none" .
ci:perm-vulnerability-alerts a ci:PermissionScope ; ci:key "vulnerability-alerts" ; ci:accessModes "read,none" .

# -----------------------------------------------------------------------------
# Marketplace/action supply chain: preserve candidates, pin admitted selections.
# A MarketplaceListing is discovery only. MarketplaceAction means admitted executable.
# -----------------------------------------------------------------------------
ci:javascript-action a ci:ActionKind ; ci:key "javascript" .
ci:docker-action a ci:ActionKind ; ci:key "docker" .
ci:composite-action a ci:ActionKind ; ci:key "composite" .
ci:local-action a ci:ActionKind ; ci:key "local" .
ci:marketplace-action a ci:ActionKind ; ci:key "marketplace" .
ci:reusable-workflow-action a ci:ActionKind ; ci:key "reusable-workflow" .

ci:marketplace-registry a ci:OpenCapabilityRegistry ;
    ci:key "github-marketplace" ;
    ci:worldAssumption "open" ;
    ci:admissionRule "listing/candidate -> source identity -> publisher policy -> full commit SHA -> capability closure -> permission/network/side-effect closure -> MarketplaceAction" .

# Capability families. New capabilities are additive.
ci:cap-checkout a ci:ActionCapability ; ci:key "source-checkout" .
ci:cap-cache a ci:ActionCapability ; ci:key "dependency-cache" .
ci:cap-artifact-upload a ci:ActionCapability ; ci:key "artifact-upload" .
ci:cap-artifact-download a ci:ActionCapability ; ci:key "artifact-download" .
ci:cap-toolchain a ci:ActionCapability ; ci:key "toolchain-setup" .
ci:cap-format a ci:ActionCapability ; ci:key "format" .
ci:cap-lint a ci:ActionCapability ; ci:key "lint" .
ci:cap-build a ci:ActionCapability ; ci:key "build" .
ci:cap-test a ci:ActionCapability ; ci:key "test" .
ci:cap-coverage a ci:ActionCapability ; ci:key "coverage" .
ci:cap-code-scan a ci:ActionCapability ; ci:key "code-scanning" .
ci:cap-dependency-review a ci:ActionCapability ; ci:key "dependency-review" .
ci:cap-sbom a ci:ActionCapability ; ci:key "sbom" .
ci:cap-attest a ci:ActionCapability ; ci:key "provenance-attestation" .
ci:cap-sign a ci:ActionCapability ; ci:key "signing" .
ci:cap-container-build a ci:ActionCapability ; ci:key "container-build" .
ci:cap-registry-login a ci:ActionCapability ; ci:key "registry-login" .
ci:cap-package-publish a ci:ActionCapability ; ci:key "package-publish" .
ci:cap-release a ci:ActionCapability ; ci:key "release-publish" .
ci:cap-pages a ci:ActionCapability ; ci:key "pages-deploy" .
ci:cap-cloud-auth a ci:ActionCapability ; ci:key "cloud-auth-oidc" .
ci:cap-infra a ci:ActionCapability ; ci:key "infrastructure-provision" .
ci:cap-kubernetes a ci:ActionCapability ; ci:key "kubernetes-deploy" .
ci:cap-pr-mutation a ci:ActionCapability ; ci:key "pull-request-mutation" .
ci:cap-issue-mutation a ci:ActionCapability ; ci:key "issue-mutation" .
ci:cap-label a ci:ActionCapability ; ci:key "labeling" .
ci:cap-notify a ci:ActionCapability ; ci:key "notification" .
ci:cap-benchmark a ci:ActionCapability ; ci:key "benchmark" .
ci:cap-fuzz a ci:ActionCapability ; ci:key "fuzz" .
ci:cap-chaos a ci:ActionCapability ; ci:key "chaos" .
ci:cap-docs a ci:ActionCapability ; ci:key "docs-build" .
ci:cap-secret-retrieval a ci:ActionCapability ; ci:key "secret-retrieval" .
ci:cap-cross-repo a ci:ActionCapability ; ci:key "cross-repo-materialization" .
ci:cap-receipt a ci:ActionCapability ; ci:key "receipt-emission" .
ci:cap-github-models a ci:ActionCapability ; ci:key "github-model-inference" .

# Immutable seed selections. Tags/releases are discovery labels only; execution uses SHA.
ci:checkout-v4 a ci:MarketplaceAction ;
    dcterms:title "actions/checkout v4 admitted selection" ;
    ci:usesPath "actions/checkout" ;
    ci:sourceRepository "actions/checkout" ;
    ci:publisher "actions" ;
    ci:releaseLabel "v4" ;
    ci:sha "11d5960a326750d5838078e36cf38b85af677262" ;
    ci:role "checkout" ;
    ci:providesCapability ci:cap-checkout ;
    ci:trustedPublisher true ;
    ci:provenanceChecked true ;
    ci:networkRequired true ;
    ci:sideEffect "read" ;
    ci:requiresScope "contents" .

ci:cache-v4 a ci:MarketplaceAction ;
    dcterms:title "actions/cache v4 admitted selection" ;
    ci:usesPath "actions/cache" ;
    ci:sourceRepository "actions/cache" ;
    ci:publisher "actions" ;
    ci:releaseLabel "v4" ;
    ci:sha "0057852bfaa89a56745cba8c7296529d2fc39830" ;
    ci:role "cache" ;
    ci:providesCapability ci:cap-cache ;
    ci:trustedPublisher true ;
    ci:provenanceChecked true ;
    ci:networkRequired true ;
    ci:sideEffect "cache-write" .

ci:upload-artifact-v4 a ci:MarketplaceAction ;
    dcterms:title "actions/upload-artifact v4 admitted selection" ;
    ci:usesPath "actions/upload-artifact" ;
    ci:sourceRepository "actions/upload-artifact" ;
    ci:publisher "actions" ;
    ci:releaseLabel "v4" ;
    ci:sha "ea165f8d65b6e75b540449e92b4886f43607fa02" ;
    ci:role "receipt-upload" ;
    ci:providesCapability ci:cap-artifact-upload ;
    ci:trustedPublisher true ;
    ci:provenanceChecked true ;
    ci:networkRequired true ;
    ci:sideEffect "artifact-write" .

# High-value dependency closures that can be selected without inventing authority.
ci:attested-binary-capability a ci:CapabilityClosure ;
    ci:requiresCapability ci:cap-build, ci:cap-attest ;
    ci:requiresScope "contents", "id-token", "attestations" ;
    ci:evidence "artifact digest + provenance attestation + verifier receipt" .
ci:attested-container-capability a ci:CapabilityClosure ;
    ci:requiresCapability ci:cap-container-build, ci:cap-attest ;
    ci:requiresScope "contents", "id-token", "attestations", "packages" ;
    ci:evidence "container digest + provenance attestation + registry consequence + verifier receipt" .

# -----------------------------------------------------------------------------
# Candidate execution routes. Route failure is topology; task failure requires closure.
# -----------------------------------------------------------------------------
ci:RouteAvailable a ci:RouteState ; ci:token "AVAILABLE" .
ci:RouteCandidate a ci:RouteState ; ci:token "CANDIDATE" .
ci:RouteAttemptedFailed a ci:RouteState ; ci:token "ATTEMPTED_FAILED" .
ci:RouteEliminated a ci:RouteState ; ci:token "ELIMINATED" .
ci:RouteSucceeded a ci:RouteState ; ci:token "SUCCEEDED" .

ci:connector-native a ci:ExecutionRoute ;
    ci:key "connector_native" ; ci:plane ci:connector-control-plane ; ci:priority 10 ; ci:reversible true .
ci:git-object-transport a ci:ExecutionRoute ;
    ci:key "git_object_transport" ; ci:plane ci:connector-control-plane ; ci:priority 11 ; ci:reversible true .
ci:remote-runner a ci:ExecutionRoute ;
    ci:key "remote_runner" ; ci:plane ci:actions-execution-plane ; ci:priority 20 ; ci:reversible true .
ci:alternate-runner a ci:ExecutionRoute ;
    ci:key "alternate_runner" ; ci:plane ci:actions-execution-plane ; ci:priority 21 ; ci:reversible true .
ci:workflow-artifact a ci:ExecutionRoute ;
    ci:key "workflow_artifact" ; ci:plane ci:artifact-materialization-plane ; ci:priority 30 ; ci:reversible true .
ci:retained-artifact a ci:ExecutionRoute ;
    ci:key "retained_artifact" ; ci:plane ci:artifact-materialization-plane ; ci:priority 31 ; ci:reversible true .
ci:immutable-package a ci:ExecutionRoute ;
    ci:key "immutable_package" ; ci:plane ci:artifact-materialization-plane ; ci:priority 32 ; ci:reversible true .
ci:exact-archive a ci:ExecutionRoute ;
    ci:key "exact_archive" ; ci:plane ci:artifact-materialization-plane ; ci:priority 33 ; ci:reversible true .
ci:git-bundle a ci:ExecutionRoute ;
    ci:key "git_bundle" ; ci:plane ci:artifact-materialization-plane ; ci:priority 34 ; ci:reversible true .
ci:local-native a ci:ExecutionRoute ;
    ci:key "local_native" ; ci:plane ci:local-verification-plane ; ci:priority 40 ; ci:reversible true .
ci:local-portable a ci:ExecutionRoute ;
    ci:key "local_portable" ; ci:plane ci:local-verification-plane ; ci:priority 41 ; ci:reversible true .
ci:cached-toolchain a ci:ExecutionRoute ;
    ci:key "cached_toolchain" ; ci:plane ci:local-verification-plane ; ci:priority 42 ; ci:reversible true .
ci:cross-compile a ci:ExecutionRoute ;
    ci:key "cross_compile" ; ci:plane ci:local-verification-plane ; ci:priority 43 ; ci:reversible true .
ci:qemu-route a ci:ExecutionRoute ;
    ci:key "qemu" ; ci:plane ci:local-verification-plane ; ci:priority 44 ; ci:reversible true .
ci:protocol-equivalent a ci:ExecutionRoute ;
    ci:key "protocol_equivalent" ; ci:plane ci:local-verification-plane ; ci:priority 45 ; ci:reversible true .
ci:bounded-reimplementation a ci:ExecutionRoute ;
    ci:key "bounded_reimplementation" ; ci:plane ci:local-verification-plane ; ci:priority 46 ; ci:reversible true .
ci:cli-fallback a ci:ExecutionRoute ;
    ci:key "git-gh-cli" ; ci:plane ci:cli-fallback-plane ; ci:priority 50 ; ci:reversible true .
ci:hybrid-route a ci:ExecutionRoute ;
    ci:key "hybrid" ; ci:plane ci:local-verification-plane ; ci:priority 60 ; ci:reversible true .

# Source materialization ladder.
ci:verified-checkout-route a ci:MaterializationRoute ; ci:key "verified-checkout" ; ci:order 10 .
ci:exact-sha-archive-route a ci:MaterializationRoute ; ci:key "exact-sha-archive" ; ci:order 20 .
ci:bundle-route a ci:MaterializationRoute ; ci:key "git-bundle" ; ci:order 30 .
ci:workflow-source-artifact-route a ci:MaterializationRoute ; ci:key "workflow-source-artifact" ; ci:order 40 .
ci:connector-tree-route a ci:MaterializationRoute ; ci:key "connector-tree" ; ci:order 50 .
ci:sparse-closure-route a ci:MaterializationRoute ; ci:key "dependency-closed-sparse-tree" ; ci:order 60 .
ci:remote-exact-head-route a ci:MaterializationRoute ; ci:key "remote-exact-head-execution" ; ci:order 70 .

# Cross-private dependency ladder: default Actions token failure does not close the graph.
ci:existing-package-route a ci:DependencyRoute ; ci:key "existing-immutable-package" ; ci:order 10 .
ci:existing-build-artifact-route a ci:DependencyRoute ; ci:key "existing-build-artifact" ; ci:order 20 .
ci:dependency-side-manufacture-route a ci:DependencyRoute ; ci:key "dependency-side-artifact-manufacture" ; ci:order 30 .
ci:existing-app-token-route a ci:DependencyRoute ; ci:key "existing-github-app-token-strategy" ; ci:order 40 .
ci:same-repo-materialization-route a ci:DependencyRoute ; ci:key "same-repository-materialization" ; ci:order 50 .
ci:reusable-build-product-route a ci:DependencyRoute ; ci:key "reusable-build-product" ; ci:order 60 .
ci:lawful-vendor-route a ci:DependencyRoute ; ci:key "lawful-exact-vendor-snapshot" ; ci:order 70 .
ci:minimal-human-authority-route a ci:DependencyRoute ; ci:key "minimal-external-authority" ; ci:order 80 .

# First-class artifact transport.
ci:source-capsule a ci:ArtifactKind ; ci:key "source-capsule" .
ci:git-bundle-artifact a ci:ArtifactKind ; ci:key "git-bundle" .
ci:portable-toolchain a ci:ArtifactKind ; ci:key "portable-toolchain" .
ci:immutable-package-artifact a ci:ArtifactKind ; ci:key "immutable-package" .
ci:verifier-report a ci:ArtifactKind ; ci:key "verifier-report" .
ci:receipt-artifact a ci:ArtifactKind ; ci:key "receipt" .
ci:sbom-artifact a ci:ArtifactKind ; ci:key "sbom" .
ci:attestation-artifact a ci:ArtifactKind ; ci:key "attestation" .

# Example task graph used as doctrine data: Connector is available; CLI is merely a candidate.
ci:cloud-publication-task a ci:Task ;
    ci:key "connector-first-publication" ;
    ci:standing ci:Unknown ;
    ci:hasRoute ci:cloud-route-connector, ci:cloud-route-actions, ci:cloud-route-artifact, ci:cloud-route-local, ci:cloud-route-cli .
ci:cloud-route-connector a ci:RouteAttempt ; ci:route ci:connector-native ; ci:routeState ci:RouteAvailable .
ci:cloud-route-actions a ci:RouteAttempt ; ci:route ci:remote-runner ; ci:routeState ci:RouteCandidate .
ci:cloud-route-artifact a ci:RouteAttempt ; ci:route ci:workflow-artifact ; ci:routeState ci:RouteCandidate .
ci:cloud-route-local a ci:RouteAttempt ; ci:route ci:local-portable ; ci:routeState ci:RouteCandidate .
ci:cloud-route-cli a ci:RouteAttempt ; ci:route ci:cli-fallback ; ci:routeState ci:RouteCandidate .

# -----------------------------------------------------------------------------
# Selected bounded plan: one exact-head ggen self-verifier projection.
# Maximalism is in the canonical graph, not in workflow fan-out.
# -----------------------------------------------------------------------------
ci:crown-ci a ci:WorkflowPlan ;
    dcterms:title "Crown CI" ;
    prov:wasDerivedFrom ci:github-actions-calculus ;
    ci:selected true ;
    ci:name "Crown CI" ;
    ci:concurrencyGroup "crown-ci-${{ github.workflow }}-${{ github.ref }}" ;
    ci:hasEvent ci:selected-push, ci:selected-pull-request, ci:selected-workflow-dispatch ;
    ci:hasPermission ci:contents-read ;
    ci:defaultJob ci:verify-job ;
    ci:exactHeadRequired true ;
    ci:receiptRequired true .

ci:selected-push a ci:Event ; ci:key "push" ; ci:eventKind ci:push ; ci:order 10 .
ci:selected-pull-request a ci:Event ; ci:key "pull_request" ; ci:eventKind ci:pull-request ; ci:order 20 .
ci:selected-workflow-dispatch a ci:Event ; ci:key "workflow_dispatch" ; ci:eventKind ci:workflow-dispatch ; ci:order 30 .

ci:contents-read a ci:PermissionGrant ;
    ci:scope "contents" ; ci:access "read" ; ci:scopeKind ci:perm-contents ; ci:order 10 .

ci:verify-job a ci:JobPlan ;
    ci:id "verify" ;
    ci:runner "ubuntu-latest" ;
    ci:runnerFamily ci:github-hosted ;
    ci:timeoutMinutes 20 ;
    ci:networkPolicy "egress-allow" ;
    ci:checksOutUntrustedCode false ;
    ci:authorizedActuation true ;
    ci:emitsReceipt true ;
    ci:verifyCommand "cargo test -p ggen-engine --test github_actions_combinatorial_pack_e2e" ;
    ci:cachePath "target" ;
    ci:cacheKey "${{ runner.os }}-ggen-${{ hashFiles('**/Cargo.lock') }}" ;
    ci:usesAction ci:checkout-v4, ci:cache-v4, ci:upload-artifact-v4 ;
    ci:checkoutAction ci:checkout-v4 ;
    ci:cacheAction ci:cache-v4 ;
    ci:uploadAction ci:upload-artifact-v4 .
