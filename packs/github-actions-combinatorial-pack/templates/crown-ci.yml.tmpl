---
to: .github/workflows/crown-ci.yml
sparql:
  workflow: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT ?name ?concurrency WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:name ?name ; ci:concurrencyGroup ?concurrency . } ORDER BY ?workflow LIMIT 1"
  events: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT ?key ?order WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:hasEvent ?event . ?event ci:key ?key ; ci:order ?order . } ORDER BY ?order ?key"
  permissions: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT ?scope ?access ?order WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:hasPermission ?grant . ?grant ci:scope ?scope ; ci:access ?access ; ci:order ?order . } ORDER BY ?order ?scope"
  job: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT ?id ?runner ?timeout ?verify ?cachePath ?cacheKey WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:defaultJob ?job . ?job ci:id ?id ; ci:runner ?runner ; ci:timeoutMinutes ?timeout ; ci:verifyCommand ?verify ; ci:cachePath ?cachePath ; ci:cacheKey ?cacheKey . } ORDER BY ?job LIMIT 1"
  checkout: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT (CONCAT(STR(?path), '@', STR(?sha)) AS ?uses) WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:defaultJob ?job . ?job ci:checkoutAction ?action . ?action ci:usesPath ?path ; ci:sha ?sha . } LIMIT 1"
  cache: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT (CONCAT(STR(?path), '@', STR(?sha)) AS ?uses) WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:defaultJob ?job . ?job ci:cacheAction ?action . ?action ci:usesPath ?path ; ci:sha ?sha . } LIMIT 1"
  upload: "PREFIX ci: <http://seanchatmangpt.github.io/packs/github-actions-ci#> SELECT (CONCAT(STR(?path), '@', STR(?sha)) AS ?uses) WHERE { ?workflow a ci:WorkflowPlan ; ci:selected true ; ci:defaultJob ?job . ?job ci:uploadAction ?action . ?action ci:usesPath ?path ; ci:sha ?sha . } LIMIT 1"
---
# GENERATED by ggen from github-actions-combinatorial-pack/ontology.ttl. Do not hand-edit.
name: {{ workflow[0].name | json_encode | safe }}

on:
{% for event in events %}
  {{ event.key }}:
{% endfor %}

permissions:
{% for permission in permissions %}
  {{ permission.scope }}: {{ permission.access }}
{% endfor %}

concurrency:
  group: {{ workflow[0].concurrency | json_encode | safe }}
  cancel-in-progress: true

jobs:
  {{ job[0].id }}:
    runs-on: {{ job[0].runner | json_encode | safe }}
    timeout-minutes: {{ job[0].timeout }}
    steps:
      - name: Checkout exact subject
        uses: {{ checkout[0].uses | json_encode | safe }}

      - name: Restore bounded build cache
        uses: {{ cache[0].uses | json_encode | safe }}
        with:
          path: {{ job[0].cachePath | json_encode | safe }}
          key: {{ job[0].cacheKey | json_encode | safe }}

      - name: Verify admitted subject
        shell: bash
        run: |
          set -euo pipefail
          {{ job[0].verify }}

      - name: Manufacture exact-head receipt
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .ggen/receipts
          python3 - <<'PY'
          import json
          import os
          from pathlib import Path

          receipt = {
              "repository": os.environ.get("GITHUB_REPOSITORY", ""),
              "head_sha": os.environ.get("GITHUB_SHA", ""),
              "ref": os.environ.get("GITHUB_REF", ""),
              "workflow": os.environ.get("GITHUB_WORKFLOW", ""),
              "run_id": os.environ.get("GITHUB_RUN_ID", ""),
              "run_attempt": os.environ.get("GITHUB_RUN_ATTEMPT", ""),
              "actor": os.environ.get("GITHUB_ACTOR", ""),
              "standing": "OBSERVED_EXECUTION_PENDING_CHECK_CONCLUSION",
          }
          Path(".ggen/receipts/crown-ci.json").write_text(
              json.dumps(receipt, sort_keys=True, indent=2) + "\n",
              encoding="utf-8",
          )
          PY

      - name: Upload receipt
        if: always()
        uses: {{ upload[0].uses | json_encode | safe }}
        with:
          name: crown-ci-receipt
          path: .ggen/receipts/crown-ci.json
          if-no-files-found: error
