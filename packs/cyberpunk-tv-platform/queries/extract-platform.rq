PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?title ?subtitle ?version ?receipt_algorithm
WHERE {
  tv:CyberpunkPlatform tv:title ?title ;
                       tv:subtitle ?subtitle ;
                       tv:receiptedBy ?receipt_policy .
  ?receipt_policy tv:receiptAlgorithm ?receipt_algorithm .
  <https://ggen.dev/ontology/cyberpunk-tv> dct:hasVersion ?version .
}
ORDER BY ?title
