{% for row in sparql_results %}
[package]
name = "cyberpunk-tv-wasm"
version = "{{ row["version"] }}"
edition = "2021"
license = "AGPL-3.0-or-later"
description = "Generated deterministic WASM body for {{ row["title"] }}"

[lib]
crate-type = ["cdylib", "rlib"]

[[bin]]
name = "receipt"
path = "src/bin/receipt.rs"

[dependencies]
blake3 = "1.5"
hex = "0.4"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde-wasm-bindgen = "0.6"
wasm-bindgen = "0.2"

[profile.release]
lto = true
opt-level = "z"
codegen-units = 1
panic = "abort"
strip = true

# Independent nested workspace: this crate is generated under packs/ inside the
# ggen root workspace tree but must never join it; without an empty [workspace]
# table cargo walks up to the ggen root manifest and refuses with "believes
# it's in a workspace when it's not" (zero-code ladder failure, CI 2026-11-04).
# Placed last so it does not capture subsequent keys into [workspace].
[workspace]
{% endfor %}
