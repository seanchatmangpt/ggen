<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <style>
    html, body, #app { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #020308; color: white; font-family: Inter, system-ui, sans-serif; }
    #map { position: absolute; inset: 0; }
    #hud { position: absolute; inset: 3rem auto auto 3rem; width: min(38rem, 70vw); padding: 1.5rem; background: rgba(2,3,8,.74); backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,.18); }
    #diagram { margin-top: 1rem; background: rgba(255,255,255,.04); padding: 1rem; }
    h1 { margin: 0; font-size: clamp(2rem, 5vw, 5rem); letter-spacing: -.06em; }
    p { opacity: .78; font-size: clamp(1rem, 1.8vw, 1.5rem); }
  </style>
</head>
<body>
  <div id="app"><div id="map"></div><section id="hud"><h1>{{ title }}</h1><p>{{ subtitle }}</p><div id="diagram"></div></section></div>
  <script type="module" src="/src/main.js"></script>
</body>
</html>
