{% for row in sparql_results %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#050711" />
  <meta name="description" content="{{ row["subtitle"] }}" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="stylesheet" href="/src/style.css" />
  <title>{{ row["title"] }}</title>
</head>
<body>
  <div id="app" data-mode="matrix">
    <video id="media" playsinline preload="metadata" aria-label="User-supplied watch-party media"></video>
    <div id="deck" aria-label="Spatial world projection"></div>
    <div id="ambient" aria-hidden="true"></div>

    <header id="masthead">
      <div>
        <p class="eyebrow">CYBERPUNK TELEVISION MANUFACTURING SYSTEM</p>
        <h1>{{ row["title"] }}</h1>
        <p id="subtitle">{{ row["subtitle"] }}</p>
      </div>
      <div id="standing" role="status" aria-live="polite">BOOTING</div>
    </header>

    <nav id="modes" aria-label="Platform modes"></nav>

    <main id="surface">
      <section id="cinema-panel" class="panel" data-panel="cinema">
        <h2>Cinema</h2>
        <p>Bind licensed local media or a user-authorized URL. The platform synchronizes playback state; it does not distribute the underlying work.</p>
        <div class="row">
          <label class="button" tabindex="0">Choose media<input id="media-file" type="file" accept="video/*" hidden /></label>
          <button id="media-url-button" type="button">Bind media URL</button>
          <button id="play-toggle" type="button">Play / Pause</button>
        </div>
        <output id="media-status">No media bound</output>
      </section>

      <section id="matrix-panel" class="panel" data-panel="matrix">
        <h2>Matrix</h2>
        <p>deck.gl projects places, routes, labels, and participant presence from the same RDF subject loaded by UNRDF.</p>
        <div id="selection" class="readout">Select a node with the remote or pointer.</div>
      </section>

      <section id="construct-panel" class="panel" data-panel="construct">
        <h2>Construct</h2>
        <div id="diagram" aria-label="Mermaid semantic system projection"></div>
        <pre id="sparql-readout" tabindex="0"></pre>
      </section>

      <section id="governance-panel" class="panel" data-panel="governance">
        <h2>Governance</h2>
        <p>Motion → second → quorum → vote → adoption or clean defeat. The procedure is projected from RDF and rule closure.</p>
        <div id="motion-board"></div>
        <div class="row">
          <button data-governance="second" type="button">Second</button>
          <button data-governance="yes" type="button">Vote yes</button>
          <button data-governance="no" type="button">Vote no</button>
          <button data-governance="adjourn" type="button">Adjourn</button>
        </div>
      </section>

      <section id="market-panel" class="panel" data-panel="market">
        <h2>Declarative Market</h2>
        <p>Each party submits a SPARQL CONSTRUCT. The terms are content-addressed before the procedure can adopt a settlement.</p>
        <label>Party A CONSTRUCT<textarea id="proposal-a" spellcheck="false"></textarea></label>
        <label>Party B CONSTRUCT<textarea id="proposal-b" spellcheck="false"></textarea></label>
        <div class="row">
          <button id="commit-proposals" type="button">Commit proposals</button>
          <button id="evaluate-settlement" type="button">Evaluate procedure</button>
        </div>
        <output id="market-status">No committed proposals</output>
        <div id="rights-board"></div>
      </section>

      <section id="receipt-panel" class="panel" data-panel="receipt">
        <h2>Receipts and Replay</h2>
        <pre id="receipt-log" tabindex="0"></pre>
      </section>
    </main>

    <aside id="telemetry" aria-label="Semantic runtime telemetry">
      <span id="clock">00:00:00.000</span>
      <span id="session-state">LOCAL</span>
      <span id="graph-size">0 QUADS</span>
      <span id="wasm-state">WASM UNKNOWN</span>
    </aside>

    <dialog id="url-dialog">
      <form method="dialog">
        <h2>Bind authorized media URL</h2>
        <label>URL<input id="media-url" type="url" required /></label>
        <div class="row"><button value="cancel">Cancel</button><button id="bind-url" value="default">Bind</button></div>
      </form>
    </dialog>
  </div>
  <script type="module" src="/src/main.js"></script>
</body>
</html>
{% endfor %}
