  TV[Television runtime]
  BRCE[Bounded broker]
  RECEIPT[BLAKE3 receipt and replay]
  LEGACY[ggen-legacy equivalence]

  RDF --> RULES --> GGEN --> WASM --> UNRDF --> TV
  TV --> BRCE --> RECEIPT --> LEGACY
