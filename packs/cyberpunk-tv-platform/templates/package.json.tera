{% for row in sparql_results %}
{
  "name": "cyberpunk-tv-platform",
  "private": true,
  "version": "{{ row["version"] }}",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "wasm": "wasm-pack build wasm --target web --out-dir ../src/wasm --release",
    "build": "npm run wasm && vite build",
    "verify": "node scripts/verify.mjs",
    "replay": "node scripts/replay.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check": "cargo test --manifest-path wasm/Cargo.toml && cargo check --manifest-path wasm/Cargo.toml --all-targets && npm run build && npm run verify && npm run replay && npm run e2e"
  },
  "dependencies": {
    "@deck.gl/core": "9.1.14",
    "@deck.gl/layers": "9.1.14",
    "@unrdf/oxigraph": "26.5.5",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "vite": "7.0.0"
  }
}
{% endfor %}
