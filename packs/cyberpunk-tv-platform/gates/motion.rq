# Gate equivalent of tv:MotionShape (SHACL-at-sync retired, FM-LAW-017).
# true = violation.
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>
ASK {
  ?subject a tv:Motion .
  {
    FILTER NOT EXISTS { ?subject dct:title ?v . }
  } UNION {
    ?subject dct:title ?t1, ?t2 . FILTER(STR(?t1) != STR(?t2))
  } UNION {
    FILTER NOT EXISTS { ?subject tv:motionState ?k . FILTER(?k IN ("introduced", "seconded", "debating", "amended", "voting", "adopted", "defeated", "adjourned")) }
  } UNION {
    FILTER NOT EXISTS { ?subject tv:quorumRequired ?q . FILTER(?q >= 1) }
  } UNION {
    FILTER NOT EXISTS { ?subject tv:hasProposal ?p . ?p a tv:EscrowProposal . }
  }
}
