# Count arms (minCount 3 caps / 2 proposals / 6 modes / 3 projections),
# SHACL-at-sync retired with FM-LAW-017. true = violation.
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>
ASK {
  {
    SELECT (COUNT(?x) AS ?n) WHERE {
      ?subject tv:hasCapability ?x . ?x a tv:Capability .
      ?subject a tv:DeviceProfile .
    } GROUP BY ?subject
  }
  FILTER(?n < 3)
}
