# Gate equivalent of tv:CapabilityShape (SHACL-at-sync retired, FM-LAW-017).
# true = violation.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>
ASK {
  ?subject a tv:Capability .
  {
    FILTER NOT EXISTS { ?subject tv:capabilityId ?v . FILTER(datatype(?v) = xsd:string) }
  } UNION {
    ?subject tv:capabilityId ?c1, ?c2 . FILTER(STR(?c1) != STR(?c2))
  } UNION {
    ?subject tv:capabilityId ?c . FILTER(STRLEN(STR(?c)) < 2)
  }
}
