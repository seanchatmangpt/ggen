# Gate equivalent of tv:ModeShape (SHACL-at-sync retired, FM-LAW-017).
# true = violation.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>
ASK {
  ?subject a tv:Mode .
  {
    FILTER NOT EXISTS { ?subject tv:modeId ?v . FILTER(datatype(?v) = xsd:string) }
  } UNION {
    ?subject tv:modeId ?m1, ?m2 . FILTER(STR(?m1) != STR(?m2))
  } UNION {
    FILTER NOT EXISTS { ?subject tv:nextMode ?n . ?n a tv:Mode . }
  } UNION {
    FILTER NOT EXISTS { ?subject tv:requiresCapability ?c . ?c a tv:Capability . }
  }
}
