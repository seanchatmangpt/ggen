@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tv: <https://ggen.dev/ontology/cyberpunk-tv#> .

<https://ggen.dev/ontology/cyberpunk-tv>
    a owl:Ontology, dcat:Dataset, prov:Entity ;
    dct:title "Cyberpunk Television Manufacturing Platform"@en ;
    dct:description "Public semantic authority for manufacturing television-native cyberpunk worlds, watch parties, governed exchange, projections, runtime bodies, receipts, and replay."@en ;
    dct:hasVersion "26.8.3" ;
    dct:license <https://spdx.org/licenses/AGPL-3.0-or-later.html> ;
    prov:wasAttributedTo tv:ChatmanFoundry .

# Classes

tv:Platform a owl:Class .
tv:Capability a owl:Class .
tv:Mode a owl:Class .
tv:Projection a owl:Class .
tv:DeviceProfile a owl:Class .
tv:RuntimeBody a owl:Class .
tv:WorldNode a owl:Class .
tv:WorldEdge a owl:Class .
tv:Scene a owl:Class .
tv:WatchSession a owl:Class .
tv:Participant a owl:Class .
tv:MediaBinding a owl:Class .
tv:Motion a owl:Class .
tv:Vote a owl:Class .
tv:EscrowProposal a owl:Class .
tv:Settlement a owl:Class .
tv:ReceiptPolicy a owl:Class .
tv:RemoteBinding a owl:Class .
tv:AccessibilityProfile a owl:Class .
tv:SynchronizationProfile a owl:Class .
tv:ManufactureProfile a owl:Class .

