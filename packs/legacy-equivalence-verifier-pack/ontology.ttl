eqv:MachineVerifierReport a eqv:VerifierReport ;
    dcterms:title "Legacy Equivalence Verifier Report" ;
    eqv:reportSchema "ggen.legacy-equivalence.verifier-report.v1" ;
    eqv:entrypoint "consumer/legacy-equivalence/suites/verify-all.sh" .
