# --- REAL 11: genesis-core (original) -- ARCHIVED, restoration proof -----
eqv:LegacyCapabilityGenesisCoreOriginal a eqv:LegacyCapability ;
    eqv:caseId "legacy_genesis_core_crate_original" ;
    dcterms:title "genesis-core (original, distinct from genesis-core-v2) -- deleted whole crate, dfa3664a5" .

eqv:CaseGenesisCoreOriginal a eqv:EquivalenceCase ;
    eqv:order 20 ;
    eqv:caseId "legacy-genesis-core-crate-original" ;
    dcterms:title "REAL: genesis-core (original) is ARCHIVED -- proves restoration from git history is possible, not equivalence" ;
    eqv:forCapability eqv:LegacyCapabilityGenesisCoreOriginal ;
    eqv:legacyAdapter "git show dfa3664a56c68478fcaf25706febad42bff496bc^:crates/genesis-core/Cargo.toml >/dev/null 2>&1 && echo ok" ;
    eqv:currentAdapter "N/A" ;
    eqv:successInput "" ;
    eqv:failureInput "" ;
    eqv:normalizationPolicy "none" ;
    eqv:expectedDisposition "ARCHIVED" ;
    eqv:observableSurface "recovery_result" ;
    eqv:timeoutSeconds 15 ;
    eqv:recoveryAction "mkdir -p \"$EQV_OUT/restored\" && git show dfa3664a56c68478fcaf25706febad42bff496bc^:crates/genesis-core/Cargo.toml > \"$EQV_OUT/restored/Cargo.toml\" && test -s \"$EQV_OUT/restored/Cargo.toml\"" ;
    rdfs:comment "No live current_adapter is asserted; genesis-core-v2's link to this crate is an unconfirmed naming inference per legacy-capabilities.ttl's own rdfs:comment, so this case proves restorability only, not lineage." .

