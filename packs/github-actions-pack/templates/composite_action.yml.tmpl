{#- Renders one .github/actions/ACTIONDIRNAME/action.yml per
    gha:CompositeAction individual, from typed gha:Step facts. Pure Tera,
    no frontmatter -- see workflow.yml.tmpl's header comment for why, and
    for why GROUP_CONCAT separators here are "%%GHA_SEP%%" rather than "|"
    (real content can legitimately contain "|") and why multi-line values
    are re-indented by looping split("\n") rather than the `indent` filter.

    The consumer's [[generation.rules]] entry supplies, per row (one row
    per gha:CompositeAction): actionDirName, actionPurpose, inputs
    (repeatable "name: description", %%GHA_SEP%%-joined), inputDefaults
    (repeatable "name:default", %%GHA_SEP%%-joined), outputs (repeatable
    "name: description", %%GHA_SEP%%-joined). output_file containing
    actionDirName triggers per-row rendering. -#}
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
name: {{ actionPurpose | default(value=actionDirName) }}
description: {{ actionPurpose | default(value=actionDirName) }}

{%- if inputs %}
inputs:
{%- for kv in inputs | split(pat="%%GHA_SEP%%") %}
  {{ kv }}
    required: false
{%- if inputDefaults %}
{%- for dv in inputDefaults | split(pat="%%GHA_SEP%%") %}
{%- if dv is starting_with(kv | split(pat=":") | first) %}
    default: {{ dv | split(pat=":") | last | trim }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}

{%- if outputs %}
outputs:
{%- for kv in outputs | split(pat="%%GHA_SEP%%") %}
  {{ kv }}
{%- endfor %}
{%- endif %}

runs:
  using: composite
  steps:
{%- set steps_q = 'PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#> SELECT ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition (GROUP_CONCAT(DISTINCT ?with; separator="%%GHA_SEP%%") AS ?withParams) (GROUP_CONCAT(DISTINCT ?env; separator="%%GHA_SEP%%") AS ?envVars) WHERE { ?step a gha:Step ; gha:inJob ?action ; gha:stepOrder ?stepOrder . ?action gha:actionDirName "' ~ actionDirName ~ '" . OPTIONAL { ?step gha:stepName ?stepName . } OPTIONAL { ?step gha:stepId ?stepId . } OPTIONAL { ?step gha:usesAction ?usesAction . } OPTIONAL { ?step gha:runCommand ?runCommand . } OPTIONAL { ?step gha:condition ?condition . } OPTIONAL { ?step gha:withParam ?with . } OPTIONAL { ?step gha:envVar ?env . } } GROUP BY ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition ORDER BY ?stepOrder' -%}
{%- set my_steps = sparql(query=steps_q) -%}
{%- for step in my_steps %}
    - {% if step.stepName %}name: {{ step.stepName }}
        {% endif -%}
{%- if step.stepId %}id: {{ step.stepId }}
        {% endif -%}
{%- if step.condition %}if: {{ step.condition }}
        {% endif -%}
{%- if step.usesAction %}uses: {{ step.usesAction }}
        {% endif -%}
{%- if step.withParams %}with:
{%- for kv in step.withParams | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.envVars %}env:
{%- for kv in step.envVars | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.runCommand %}shell: bash
      run: |
{{ self::reindent(text=step.runCommand, spaces="          ") }}
{%- endif %}
{%- endfor %}
