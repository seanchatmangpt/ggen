{#- Renders one real .github/workflows/FILENAME file per gha:Workflow
    individual, from typed gha:Job/gha:Step facts -- not an echoed literal.

    Pure Tera, no frontmatter: [[generation.rules]]-consumed templates in
    this ecosystem never use a --- sparql: --- frontmatter block (that is a
    separate, sync.rs-native mechanism for self-discovered pack templates,
    not what a consumer's own ggen.toml rule invokes). Matches the real,
    working pattern in .specify/templates/docs/pack_maturity_model.md.tera:
    an inline sparql(query='...') Tera function call for any data beyond
    what the driving rule's own query row supplies.

    The consumer's [[generation.rules]] entry supplies, per row (one row
    per gha:Workflow, excluding any carrying gha:ownedBy): wf (the
    workflow's own subject IRI, needed below to filter nested queries),
    fileName, purpose, onBlock, workflowEnv (comma-joined KEY=value pairs),
    concurrencyPolicy, permissionCeiling, triggers (comma-joined event
    labels). output_file containing fileName triggers per-row rendering --
    one output file per gha:Workflow.

    GROUP_CONCAT separators below use "%%GHA_SEP%%", never a bare "|" --
    real step values (e.g. `a || b || c` expressions) legitimately contain
    "|", so joining on that character corrupts them on split-back-apart.
    Multi-line values (run: blocks) are re-indented by looping split("\n")
    and prefixing each line with literal spaces, not the `indent` filter --
    empirically this template's first draft got indent(width=N, first=false)
    wrong (verified against a real diff of ggen's own ci.yml, not assumed)
    and this looping form is unambiguous. -#}
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
name: {{ purpose | default(value=fileName) }}

{%- if onBlock %}
on:
{{ self::reindent(text=onBlock, spaces="  ") }}
{%- else %}
on:
{%- for t in triggers | split(pat=",") %}
  {{ t }}:
{%- endfor %}
{%- endif %}

{%- if concurrencyPolicy and concurrencyPolicy != "none" %}

concurrency:
{{ self::reindent(text=concurrencyPolicy, spaces="  ") }}
{%- endif %}

permissions:
  {{ permissionCeiling }}

{%- if workflowEnv %}

env:
{%- for kv in workflowEnv | split(pat=",") %}
  {{ kv }}
{%- endfor %}
{%- endif %}

jobs:
{%- set jobs_q = 'PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#> SELECT ?jobName ?runner ?timeoutMinutes ?condition ?jobPermissions ?jobExtra (GROUP_CONCAT(DISTINCT ?dep; separator=",") AS ?dependsOnList) WHERE { ?job a gha:Job ; gha:inWorkflow <' ~ wf ~ '> ; gha:jobName ?jobName . OPTIONAL { ?job gha:runner ?runner . } OPTIONAL { ?job gha:timeoutMinutes ?timeoutMinutes . } OPTIONAL { ?job gha:condition ?condition . } OPTIONAL { ?job gha:jobPermissions ?jobPermissions . } OPTIONAL { ?job gha:jobExtra ?jobExtra . } OPTIONAL { ?job gha:dependsOn ?depJob . ?depJob gha:jobName ?dep . } } GROUP BY ?jobName ?runner ?timeoutMinutes ?condition ?jobPermissions ?jobExtra ORDER BY ?jobName' -%}
{%- set my_jobs = sparql(query=jobs_q) -%}
{%- for job in my_jobs %}
  {{ job.jobName }}:
    runs-on: {{ job.runner | default(value="ubuntu-latest") }}
{%- if job.timeoutMinutes %}
    timeout-minutes: {{ job.timeoutMinutes }}
{%- endif %}
{%- if job.dependsOnList %}
    needs: [{{ job.dependsOnList }}]
{%- endif %}
{%- if job.condition %}
    if: {{ job.condition }}
{%- endif %}
{%- if job.jobPermissions %}
    permissions:
{{ self::reindent(text=job.jobPermissions, spaces="      ") }}
{%- endif %}
{%- if job.jobExtra %}
{{ self::reindent(text=job.jobExtra, spaces="    ") }}
{%- endif %}
    steps:
{%- set steps_q = 'PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#> SELECT ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition ?continueOnError (GROUP_CONCAT(DISTINCT ?with; separator="%%GHA_SEP%%") AS ?withParams) (GROUP_CONCAT(DISTINCT ?env; separator="%%GHA_SEP%%") AS ?envVars) WHERE { ?step a gha:Step ; gha:inJob ?job ; gha:stepOrder ?stepOrder . ?job gha:jobName "' ~ job.jobName ~ '" ; gha:inWorkflow <' ~ wf ~ '> . OPTIONAL { ?step gha:stepName ?stepName . } OPTIONAL { ?step gha:stepId ?stepId . } OPTIONAL { ?step gha:usesAction ?usesAction . } OPTIONAL { ?step gha:runCommand ?runCommand . } OPTIONAL { ?step gha:condition ?condition . } OPTIONAL { ?step gha:continueOnError ?continueOnError . } OPTIONAL { ?step gha:withParam ?with . } OPTIONAL { ?step gha:envVar ?env . } } GROUP BY ?stepOrder ?stepName ?stepId ?usesAction ?runCommand ?condition ?continueOnError ORDER BY ?stepOrder' -%}
{%- set my_steps = sparql(query=steps_q) -%}
{%- for step in my_steps %}
      - {% if step.stepName %}name: {{ step.stepName }}
        {% endif -%}
{%- if step.stepId %}id: {{ step.stepId }}
        {% endif -%}
{%- if step.condition %}if: {{ step.condition }}
        {% endif -%}
{%- if step.usesAction %}uses: {{ step.usesAction }}
        {% endif -%}
{%- if step.withParams %}with:
{%- for kv in step.withParams | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.envVars %}env:
{%- for kv in step.envVars | split(pat="%%GHA_SEP%%") %}
          {{ kv }}
{%- endfor %}
        {% endif -%}
{%- if step.continueOnError %}continue-on-error: true
        {% endif -%}
{%- if step.runCommand %}run: |
{{ self::reindent(text=step.runCommand, spaces="          ") }}
{%- endif %}
{%- endfor %}
{%- endfor %}
