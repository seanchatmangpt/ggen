from __future__ import annotations

import sys
from pathlib import Path

_AUTOFDE_LAB_SRC = Path.home() / "autofde-lab" / "src"
if str(_AUTOFDE_LAB_SRC) not in sys.path:
    sys.path.insert(0, str(_AUTOFDE_LAB_SRC))

import pytest

ONTOLOGY_AZUREGOAT_ROWS = [
{% for row in azuregoat_rows -%}
    {"step_id": "{{ row.step_id }}", "manual_step": "{{ row.manual_step }}", "description": "{{ row.description | replace(from='\"', to='\\\"') }}"},
{% endfor -%}
]

ONTOLOGY_AZUREGOAT_MANUAL_COUNT = {{ azuregoat_manual_count.0.manual_step_count }}

ONTOLOGY_TERRAGOAT_STEP_IDS = [
{% for row in terragoat_rows -%}
    "{{ row.step_id }}",
{% endfor -%}
]


def _azuregoat_available():
    try:
        from autofde_lab.hub.domain.azuregoat_privesc.azuregoat_privesc import (  # noqa: F401
            ATTACK_STEPS,
        )
    except ImportError:
        return False
    return True


pytestmark = pytest.mark.skipif(
    not _azuregoat_available(),
    reason="real ~/autofde-lab checkout with an installed autofde_lab package is required "
    "for this fidelity proof (BLOCKED:AUTOFDE_LAB_NOT_IMPORTABLE, not silently skipped without "
    "a named reason)",
)


def test_ontology_azuregoat_step_count_matches_real_attack_steps():
    from autofde_lab.hub.domain.azuregoat_privesc.azuregoat_privesc import ATTACK_STEPS

    assert len(ONTOLOGY_AZUREGOAT_ROWS) == len(ATTACK_STEPS)


def test_ontology_azuregoat_step_ids_match_real_attack_steps_exactly():
    from autofde_lab.hub.domain.azuregoat_privesc.azuregoat_privesc import ATTACK_STEPS

    real_ids = [step.id for step in ATTACK_STEPS]
    ontology_ids = [row["step_id"] for row in ONTOLOGY_AZUREGOAT_ROWS]
    assert ontology_ids == real_ids


def test_ontology_azuregoat_manual_step_count_matches_real_manual_parse():
    from autofde_lab.hub.domain.azuregoat_privesc.azuregoat_privesc import (
        DEFAULT_MANUAL_FILE,
        parse_manual_steps,
    )

    real_manual_steps = parse_manual_steps(DEFAULT_MANUAL_FILE)
    assert len(real_manual_steps) == ONTOLOGY_AZUREGOAT_MANUAL_COUNT


def test_ontology_terragoat_finding_ids_match_real_parsed_findings():
    from autofde_lab.hub.domain.terragoat.terragoat_remediation import (
        DEFAULT_TERRAFORM_FILE,
        parse_findings,
    )

    real_findings = parse_findings(DEFAULT_TERRAFORM_FILE, max_findings=len(ONTOLOGY_TERRAGOAT_STEP_IDS))
    assert len(real_findings) == len(ONTOLOGY_TERRAGOAT_STEP_IDS)
