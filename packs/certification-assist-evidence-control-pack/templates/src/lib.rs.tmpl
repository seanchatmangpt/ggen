fn put(hasher: &mut blake3::Hasher, value: &[u8]) {
    hasher.update(&(value.len() as u64).to_le_bytes());
    hasher.update(value);
}

fn digest_json<T: Serialize>(value: &T) -> Result<[u8; 32], ControlError> {
    let bytes = serde_json::to_vec(value).map_err(|_| ControlError::ReceiptMismatch)?;
    Ok(blake3::hash(&bytes).into())
}

