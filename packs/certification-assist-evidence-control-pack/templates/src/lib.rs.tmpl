    pub exposure: usize,
    pub difficulty_bps: u16,
    pub discrimination_bps: i32,
    pub supported: bool,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct PsychometricReport {
    pub standing: EvidenceStanding,
    pub learner_count: usize,
    pub item_count: usize,
    pub item_statistics: Vec<ItemStatistic>,
}

#[derive(Default)]
pub struct PsychometricController {
    responses: Vec<ItemResponse>,
    seen: HashSet<[u8; 32]>,
}

impl PsychometricController {
    pub fn admit(&mut self, response: ItemResponse) -> Result<(), ControlError> {
        response.verify()?;
        if !self.seen.insert(response.evidence_digest) {
            return Err(ControlError::DuplicateObservation);
        }
        self.responses.push(response);
        Ok(())
    }

    pub fn calibrate(&self) -> Result<PsychometricReport, ControlError> {
        validate_policies()?;
        let learners = self
            .responses
            .iter()
            .map(|response| response.learner_id.as_str())
            .collect::<BTreeSet<_>>();
        let items = self
            .responses
            .iter()
            .map(|response| response.item_id.as_str())
            .collect::<BTreeSet<_>>();
        let mut statistics = Vec::new();
        for item in &items {
            let responses = self
                .responses
                .iter()
                .filter(|response| response.item_id == *item)
                .collect::<Vec<_>>();
            let exposure = responses.len();
            let correct = responses.iter().filter(|response| response.correct).count();
            let difficulty_bps = if exposure == 0 {
                0
            } else {
                ((correct * 10_000) / exposure) as u16
            };
            let high = responses
                .iter()
                .filter(|response| response.total_score_bps >= 5_000)
                .collect::<Vec<_>>();
            let low = responses
                .iter()
                .filter(|response| response.total_score_bps < 5_000)
                .collect::<Vec<_>>();
            let rate = |group: &[&ItemResponse]| -> i32 {
                if group.is_empty() {
                    0
                } else {
                    (group.iter().filter(|response| response.correct).count() * 10_000
                        / group.len()) as i32
                }
            };
            let discrimination_bps = rate(&high) - rate(&low);
            let supported = exposure >= PSYCHOMETRIC_POLICY.min_exposure
                && difficulty_bps >= PSYCHOMETRIC_POLICY.min_difficulty_bps
                && difficulty_bps <= PSYCHOMETRIC_POLICY.max_difficulty_bps
                && discrimination_bps >= PSYCHOMETRIC_POLICY.min_discrimination_bps;
            statistics.push(ItemStatistic {
                item_id: (*item).to_string(),
                exposure,
                difficulty_bps,
                discrimination_bps,
                supported,
            });
        }
        let sample_complete = learners.len() >= PSYCHOMETRIC_POLICY.min_learners
            && items.len() >= PSYCHOMETRIC_POLICY.min_items
            && statistics
                .iter()
                .all(|item| item.exposure >= PSYCHOMETRIC_POLICY.min_exposure);
        let standing = if self.responses.is_empty() {
            EvidenceStanding::Unknown
        } else if !sample_complete {
            EvidenceStanding::Collecting
        } else if statistics.iter().all(|item| item.supported) {
            EvidenceStanding::Supported
        } else {
            EvidenceStanding::Refuted
        };
        Ok(PsychometricReport {
            standing,
            learner_count: learners.len(),
            item_count: items.len(),
            item_statistics: statistics,
        })
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum PsychometricIntentKind {
    CollectResponses,
    QuarantineItem,
    RebalanceForm,
    Maintain,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct PsychometricIntent {
    pub kind: PsychometricIntentKind,
    pub item_id: Option<String>,
    pub direct_actuation: bool,
    pub standing_promoted: bool,
}

pub fn psychometric_autonomic_plan(report: &PsychometricReport) -> Result<Vec<PsychometricIntent>, ControlError> {
    validate_policies()?;
    let mut intents = Vec::new();
    if report.learner_count < PSYCHOMETRIC_POLICY.min_learners
        || report.item_count < PSYCHOMETRIC_POLICY.min_items
    {
        intents.push(PsychometricIntent {
            kind: PsychometricIntentKind::CollectResponses,
            item_id: None,
            direct_actuation: false,
            standing_promoted: false,
        });
    }
    for item in report.item_statistics.iter().filter(|item| !item.supported) {
        intents.push(PsychometricIntent {
            kind: PsychometricIntentKind::QuarantineItem,
            item_id: Some(item.item_id.clone()),
            direct_actuation: false,
            standing_promoted: false,
        });
    }
    if report.standing == EvidenceStanding::Refuted {
        intents.push(PsychometricIntent {
            kind: PsychometricIntentKind::RebalanceForm,
            item_id: None,
            direct_actuation: false,
            standing_promoted: false,
        });
    }
    if report.standing == EvidenceStanding::Supported {
        intents.push(PsychometricIntent {
            kind: PsychometricIntentKind::Maintain,
            item_id: None,
            direct_actuation: false,
            standing_promoted: false,
        });
    }
    intents.truncate(PSYCHOMETRIC_POLICY.max_cycles);
    Ok(intents)
}

