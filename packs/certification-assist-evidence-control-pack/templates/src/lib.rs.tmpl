#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct IssuerCredentialEvidence {
    pub issuer_id: String,
    pub credential_id: String,
    pub subject_id: String,
    pub credential_name: String,
    pub issued_at_tick: u64,
    pub observed_at_tick: u64,
    pub expires_at_tick: u64,
    pub sequence: u64,
    pub status: IssuerCredentialStatus,
    pub proof_digest: [u8; 32],
}

impl IssuerCredentialEvidence {
    #[allow(clippy::too_many_arguments)]
    pub fn attest(
        anchor: &IssuerTrustAnchor,
        credential_id: &str,
        subject_id: &str,
        credential_name: &str,
        issued_at_tick: u64,
        observed_at_tick: u64,
        expires_at_tick: u64,
        sequence: u64,
        status: IssuerCredentialStatus,
    ) -> Self {
        let mut evidence = Self {
            issuer_id: anchor.issuer_id.clone(),
            credential_id: credential_id.to_string(),
            subject_id: subject_id.to_string(),
            credential_name: credential_name.to_string(),
            issued_at_tick,
            observed_at_tick,
            expires_at_tick,
            sequence,
            status,
            proof_digest: [0; 32],
        };
        evidence.proof_digest = issuer_proof(&evidence, &anchor.reference_verification_key);
        evidence
    }
}

fn issuer_proof(evidence: &IssuerCredentialEvidence, key: &[u8; 32]) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new_keyed(key);
    put(&mut hasher, b"certification-assist-issuer-evidence/v1");
    put(&mut hasher, evidence.issuer_id.as_bytes());
    put(&mut hasher, evidence.credential_id.as_bytes());
    put(&mut hasher, evidence.subject_id.as_bytes());
    put(&mut hasher, evidence.credential_name.as_bytes());
    hasher.update(&evidence.issued_at_tick.to_le_bytes());
    hasher.update(&evidence.observed_at_tick.to_le_bytes());
    hasher.update(&evidence.expires_at_tick.to_le_bytes());
    hasher.update(&evidence.sequence.to_le_bytes());
    hasher.update(&[evidence.status as u8]);
    hasher.finalize().into()
}

