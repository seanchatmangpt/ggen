}

pub struct IssuerStandingSynchronizer {
    anchors: BTreeMap<String, [u8; 32]>,
    last_sequence: BTreeMap<String, u64>,
    standing: BTreeMap<String, IssuerStanding>,
    seen: HashSet<[u8; 32]>,
}

impl IssuerStandingSynchronizer {
    pub fn new(anchors: impl IntoIterator<Item = IssuerTrustAnchor>) -> Self {
        Self {
            anchors: anchors
                .into_iter()
                .map(|anchor| (anchor.issuer_id, anchor.reference_verification_key))
                .collect(),
            last_sequence: BTreeMap::new(),
            standing: BTreeMap::new(),
            seen: HashSet::new(),
        }
    }

    pub fn standing(&self, credential_id: &str) -> IssuerStanding {
        self.standing
            .get(credential_id)
            .copied()
            .unwrap_or(IssuerStanding::Unknown)
    }

    pub fn sync(
        &mut self,
        evidence: &IssuerCredentialEvidence,
        now_tick: u64,
    ) -> Result<IssuerStandingReport, ControlError> {
        validate_policies()?;
        let key = self
            .anchors
            .get(&evidence.issuer_id)
            .ok_or_else(|| ControlError::UnknownIssuer(evidence.issuer_id.clone()))?;
        if issuer_proof(evidence, key) != evidence.proof_digest {
            return Err(ControlError::IssuerProofMismatch);
        }
        if !self.seen.insert(evidence.proof_digest) {
            return Err(ControlError::DuplicateReplay);
        }
        if evidence.sequence == 0
            || self
                .last_sequence
                .get(&evidence.credential_id)
                .is_some_and(|last| evidence.sequence <= *last)
        {
            return Err(ControlError::StaleIssuerStatus);
        }
        if evidence.observed_at_tick > now_tick
            || now_tick.saturating_sub(evidence.observed_at_tick)
                > ISSUER_POLICY.max_status_age_ticks
        {
            return Err(ControlError::StaleIssuerStatus);
        }
        let standing = if now_tick >= evidence.expires_at_tick {
            IssuerStanding::Expired
        } else {
            match evidence.status {
                IssuerCredentialStatus::Active => IssuerStanding::Active,
                IssuerCredentialStatus::Suspended => IssuerStanding::Suspended,
                IssuerCredentialStatus::Revoked => IssuerStanding::Revoked,
            }
        };
        self.last_sequence
            .insert(evidence.credential_id.clone(), evidence.sequence);
        self.standing
            .insert(evidence.credential_id.clone(), standing);
        Ok(IssuerStandingReport {
            credential_id: evidence.credential_id.clone(),
            standing,
            observed_at_tick: evidence.observed_at_tick,
            expires_at_tick: evidence.expires_at_tick,
            evidence_digest: evidence.proof_digest,
        })
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum IssuerIntentKind {
    RefreshStatus,
    Renew,
    ReviewSuspension,
    Reacquire,
    Maintain,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct IssuerIntent {
    pub kind: IssuerIntentKind,
    pub direct_actuation: bool,
    pub external_standing_awarded: bool,
}

pub fn issuer_autonomic_plan(
    report: &IssuerStandingReport,
    now_tick: u64,
) -> Result<Vec<IssuerIntent>, ControlError> {
    validate_policies()?;
    let mut kinds = Vec::new();
    if now_tick.saturating_sub(report.observed_at_tick) > ISSUER_POLICY.max_status_age_ticks {
        kinds.push(IssuerIntentKind::RefreshStatus);
    }
    match report.standing {
        IssuerStanding::Active => {
            if report.expires_at_tick.saturating_sub(now_tick) <= ISSUER_POLICY.renewal_window_ticks {
                kinds.push(IssuerIntentKind::Renew);
            } else {
                kinds.push(IssuerIntentKind::Maintain);
            }
        }
        IssuerStanding::Suspended => kinds.push(IssuerIntentKind::ReviewSuspension),
        IssuerStanding::Revoked | IssuerStanding::Expired => kinds.push(IssuerIntentKind::Reacquire),
        IssuerStanding::Unknown => kinds.push(IssuerIntentKind::RefreshStatus),
    }
    kinds.truncate(ISSUER_POLICY.max_cycles);
    Ok(kinds
        .into_iter()
        .map(|kind| IssuerIntent {
            kind,
            direct_actuation: false,
            external_standing_awarded: false,
        })
        .collect())
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct ControlReceipt {
    pub domain: String,
    pub subject: String,
    pub evidence_digest: [u8; 32],
    pub predecessor: Option<[u8; 32]>,
    pub receipt_digest: [u8; 32],
}

impl ControlReceipt {
    pub fn verify(&self) -> Result<(), ControlError> {
        if self.receipt_digest
            != control_receipt_digest(
                &self.domain,
                &self.subject,
                &self.evidence_digest,
                self.predecessor.as_ref(),
            )
        {
            return Err(ControlError::ReceiptMismatch);
        }
        Ok(())
    }
}

#[derive(Default)]
pub struct ControlLedger {
    receipts: Vec<ControlReceipt>,
}

impl ControlLedger {
    pub fn issue(
        &mut self,
        domain: &str,
        subject: &str,
        evidence_digest: [u8; 32],
    ) -> Result<ControlReceipt, ControlError> {
        let predecessor = self.receipts.last().map(|receipt| receipt.receipt_digest);
        let receipt_digest = control_receipt_digest(
            domain,
            subject,
            &evidence_digest,
            predecessor.as_ref(),
        );
        let receipt = ControlReceipt {
            domain: domain.to_string(),
            subject: subject.to_string(),
            evidence_digest,
            predecessor,
            receipt_digest,
        };
        receipt.verify()?;
        self.receipts.push(receipt.clone());
        Ok(receipt)
    }
}

fn control_receipt_digest(
    domain: &str,
    subject: &str,
    evidence_digest: &[u8; 32],
    predecessor: Option<&[u8; 32]>,
) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-control-receipt/v1");
    put(&mut hasher, domain.as_bytes());
    put(&mut hasher, subject.as_bytes());
    hasher.update(evidence_digest);
    if let Some(predecessor) = predecessor {
        hasher.update(&[1]);
        hasher.update(predecessor);
    } else {
        hasher.update(&[0]);
    }
    hasher.finalize().into()
}

#[derive(Default)]
pub struct ControlReplayVerifier {
    seen: HashSet<[u8; 32]>,
    predecessor: Option<[u8; 32]>,
}

impl ControlReplayVerifier {
    pub fn replay(&mut self, receipt: &ControlReceipt) -> Result<(), ControlError> {
        receipt.verify()?;
        if self.seen.contains(&receipt.receipt_digest) {
            return Err(ControlError::DuplicateReplay);
        }
        if receipt.predecessor != self.predecessor {
            return Err(ControlError::ReceiptMismatch);
        }
        self.seen.insert(receipt.receipt_digest);
        self.predecessor = Some(receipt.receipt_digest);
        Ok(())
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct OperatingReceipts {
    pub automatic_receipts: Vec<[u8; 32]>,
    pub autonomic_receipts: Vec<[u8; 32]>,
}

pub fn execute_operating_rail() -> Result<OperatingReceipts, Box<dyn Error>> {
    let temp = tempfile::tempdir()?;
    let actuator = FilesystemActuator::new(temp.path().join("actuation"));
    let machine = FoundationMachine::new(ExecutionPolicy::full_level5(1024 * 1024));
    let mut router = TriggerRouter::new();
    for (kind, dimension, action_id) in [
        ("learner-observation", Dimension::AutomationClosure, "learner-efficacy-evaluate"),
        ("psychometric-calibration", Dimension::AutomationClosure, "psychometric-calibrate"),
        ("issuer-status-sync", Dimension::AutomationClosure, "issuer-standing-sync"),
        ("learner-repair", Dimension::AutonomicClosure, "learner-efficacy-repair"),
        ("item-repair", Dimension::AutonomicClosure, "psychometric-item-repair"),
        ("issuer-maintenance", Dimension::AutonomicClosure, "issuer-standing-maintenance"),
    ] {
        router.insert(Route::new(kind, dimension, action_id)?)?;
    }
    let mut runtime = AutomaticRuntime::new(
        TriggerAdmissionPolicy::new(
            [
                "learner-observation",
                "psychometric-calibration",
                "issuer-status-sync",
                "learner-repair",
                "item-repair",
                "issuer-maintenance",
            ],
            4096,
            10_000,
        ),
        router,
        OperationsGovernor::new(
            RetryPolicy::new(2, 1),
            CircuitBreaker::new(3),
            ErrorBudget::new(16, 1),
        ),
    );
    let mut observer = FilesystemConsequenceObserver;
    let mut automatic_receipts = Vec::new();
    for (sequence, kind, payload) in [
        (1, "learner-observation", b"learner=sean;objective=network-flow".as_slice()),
        (2, "psychometric-calibration", b"form=systems-dominion-a".as_slice()),
        (3, "issuer-status-sync", b"credential=aws-saa".as_slice()),
    ] {
        let receipt = runtime.execute(
            Trigger::new(
                format!("certification-control-{sequence}"),
                kind,
                sequence,
                payload.to_vec(),
            ),
            &machine,
            &actuator,
            &mut observer,
        )?;
        receipt.verify()?;
        automatic_receipts.push(receipt.receipt_digest);
    }

    let mut autonomic_receipts = Vec::new();
    for (id, desired, repair_kind) in [
        ("learner-efficacy-resource", b"standing=supported".as_slice(), "learner-repair"),
        ("psychometric-resource", b"standing=supported".as_slice(), "item-repair"),
        ("issuer-standing-resource", b"standing=active".as_slice(), "issuer-maintenance"),
    ] {
        let initial = Action::new(
            format!("{id}-initial"),
            Dimension::AutonomicClosure,
            b"standing=unknown".to_vec(),
        );
        let grant = machine.derive_grant(&initial)?;
        let receipt = actuator.actuate(&grant, &initial)?;
        let mut resource = AutonomicResource::new(id, desired.to_vec(), receipt.action_id, repair_kind)?;
        let result = AutonomicOperationsController::new(3).converge(
            &mut resource,
            &mut runtime,
            &machine,
            &actuator,
            &mut observer,
        )?;
        result.verify()?;
        if !result.converged {
            return Err("evidence-control autonomic rail did not converge".into());
        }
        autonomic_receipts.push(result.receipt_digest);
    }
    Ok(OperatingReceipts {
        automatic_receipts,
        autonomic_receipts,
    })
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
pub struct ControlReport {
    pub standing: &'static str,
    pub capabilities: usize,
    pub proof_surfaces: usize,
    pub learner_efficacy: EvidenceStanding,
    pub psychometric_validity: EvidenceStanding,
    pub external_issuer_standing: IssuerStanding,
    pub learner_intents: usize,
    pub psychometric_intents: usize,
    pub issuer_intents: usize,
    pub control_receipts: Vec<[u8; 32]>,
    pub automatic_receipts: Vec<[u8; 32]>,
    pub autonomic_receipts: Vec<[u8; 32]>,
}

pub fn supported_learner_fixture() -> Result<LearnerEfficacyReport, ControlError> {
    let mut controller = LearnerEfficacyController::default();
    for (index, (phase, score)) in [
        (AssessmentPhase::Baseline, 4_000),
        (AssessmentPhase::Baseline, 4_500),
        (AssessmentPhase::Post, 7_000),
        (AssessmentPhase::Post, 7_500),
        (AssessmentPhase::Retention, 7_000),
        (AssessmentPhase::Retention, 7_200),
        (AssessmentPhase::Transfer, 7_200),
        (AssessmentPhase::Transfer, 7_400),
    ]
    .into_iter()
    .enumerate()
    {
        controller.admit(LearnerObservation::issue(
            "learner-sean",
            "network-flow",
            phase,
            score,
            index as u64 + 1,
        ))?;
    }
    controller.evaluate("learner-sean", "network-flow")
}

pub fn supported_psychometric_fixture() -> Result<PsychometricReport, ControlError> {
    let mut controller = PsychometricController::default();
    let learners = [
        ("h1", 8_000, [true, true, true, true]),
        ("h2", 8_000, [true, true, true, true]),
        ("h3", 8_000, [true, true, true, false]),
        ("h4", 8_000, [true, false, false, false]),
        ("l1", 3_000, [true, true, false, false]),
        ("l2", 3_000, [false, false, false, false]),
        ("l3", 3_000, [false, false, false, false]),
        ("l4", 3_000, [false, false, false, false]),
    ];
    let mut sequence = 1u64;
    for (learner, total, answers) in learners {
        for (index, correct) in answers.into_iter().enumerate() {
            controller.admit(ItemResponse::issue(
                learner,
                &format!("item-{}", index + 1),
                "systems-dominion-a",
                correct,
                total,
                sequence,
            ))?;
            sequence += 1;
        }
    }
    controller.calibrate()
}

pub fn active_issuer_fixture(
    now_tick: u64,
) -> Result<(IssuerStandingReport, Vec<IssuerIntent>), ControlError> {
    let anchor = IssuerTrustAnchor {
        issuer_id: "issuer.example".to_string(),
        reference_verification_key: [7; 32],
    };
    let evidence = IssuerCredentialEvidence::attest(
        &anchor,
        "credential-aws-saa",
        "learner-sean",
        "AWS Solutions Architect Associate",
        100,
        now_tick,
        200,
        1,
        IssuerCredentialStatus::Active,
    );
    let mut synchronizer = IssuerStandingSynchronizer::new([anchor]);
    let report = synchronizer.sync(&evidence, now_tick)?;
    let intents = issuer_autonomic_plan(&report, 180)?;
    Ok((report, intents))
}

pub fn verify() -> Result<ControlReport, Box<dyn Error>> {
    validate_policies()?;
    if CAPABILITIES.len() != 9 || CAPABILITIES.len() * REQUIRED_PROOF_SURFACES != 27 {
        return Err("evidence-control crown cardinality mismatch".into());
    }

    let learner_report = supported_learner_fixture()?;
    let learner_intents = learner_autonomic_plan(&LearnerEfficacyReport {
        standing: EvidenceStanding::Collecting,
        baseline_count: 1,
        post_count: 0,
        retention_count: 0,
        transfer_count: 0,
        ..learner_report.clone()
    })?;
    if learner_report.standing != EvidenceStanding::Supported
        || learner_intents.is_empty()
        || learner_intents.iter().any(|intent| intent.direct_actuation || intent.standing_promoted)
    {
        return Err(Box::new(ControlError::DirectActuationRefused));
    }

    let psychometric_report = supported_psychometric_fixture()?;
    let psychometric_intents = psychometric_autonomic_plan(&PsychometricReport {
        standing: EvidenceStanding::Refuted,
        item_statistics: vec![ItemStatistic {
            item_id: "weak-item".to_string(),
            exposure: 8,
            difficulty_bps: 5_000,
            discrimination_bps: 0,
            supported: false,
        }],
        ..psychometric_report.clone()
    })?;
    if psychometric_report.standing != EvidenceStanding::Supported
        || psychometric_intents.is_empty()
        || psychometric_intents.iter().any(|intent| intent.direct_actuation || intent.standing_promoted)
    {
        return Err(Box::new(ControlError::DirectActuationRefused));
    }

    let (issuer_report, issuer_intents) = active_issuer_fixture(120)?;
    if issuer_report.standing != IssuerStanding::Active
        || issuer_intents.is_empty()
        || issuer_intents.iter().any(|intent| intent.direct_actuation || intent.external_standing_awarded)
    {
        return Err(Box::new(ControlError::DirectActuationRefused));
    }

    let mut ledger = ControlLedger::default();
    let learner_receipt = ledger.issue(
        "learner-efficacy",
        &learner_report.learner_id,
        digest_json(&learner_report)?,
    )?;
    let psychometric_receipt = ledger.issue(
        "psychometric-validity",
        "systems-dominion-a",
        digest_json(&psychometric_report)?,
    )?;
    let issuer_receipt = ledger.issue(
        "issuer-standing",
        &issuer_report.credential_id,
        issuer_report.evidence_digest,
    )?;
    let mut replay = ControlReplayVerifier::default();
    for receipt in [&learner_receipt, &psychometric_receipt, &issuer_receipt] {
        replay.replay(receipt)?;
    }
    if !matches!(replay.replay(&issuer_receipt), Err(ControlError::DuplicateReplay)) {
        return Err("duplicate control replay was not refused".into());
    }

    let operating = execute_operating_rail()?;
    Ok(ControlReport {
        standing: "ALIVE",
        capabilities: CAPABILITIES.len(),
        proof_surfaces: CAPABILITIES.len() * REQUIRED_PROOF_SURFACES,
        learner_efficacy: learner_report.standing,
        psychometric_validity: psychometric_report.standing,
        external_issuer_standing: issuer_report.standing,
        learner_intents: learner_intents.len(),
        psychometric_intents: psychometric_intents.len(),
        issuer_intents: issuer_intents.len(),
        control_receipts: vec![
            learner_receipt.receipt_digest,
            psychometric_receipt.receipt_digest,
            issuer_receipt.receipt_digest,
        ],
        automatic_receipts: operating.automatic_receipts,
        autonomic_receipts: operating.autonomic_receipts,
    })
}
