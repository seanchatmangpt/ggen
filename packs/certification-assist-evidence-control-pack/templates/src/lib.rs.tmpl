    Maintain,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct LearnerIntent {
    pub kind: LearnerIntentKind,
    pub direct_actuation: bool,
    pub standing_promoted: bool,
}

pub fn learner_autonomic_plan(report: &LearnerEfficacyReport) -> Result<Vec<LearnerIntent>, ControlError> {
    validate_policies()?;
    let mut kinds = Vec::new();
    for (count, kind) in [
        (report.baseline_count, LearnerIntentKind::CollectBaseline),
        (report.post_count, LearnerIntentKind::CollectPost),
        (report.retention_count, LearnerIntentKind::CollectRetention),
        (report.transfer_count, LearnerIntentKind::CollectTransfer),
    ] {
        if count < LEARNER_POLICY.min_observations_per_phase {
            kinds.push(kind);
        }
    }
    if report.standing == EvidenceStanding::Refuted {
        if report.gain_bps < LEARNER_POLICY.min_gain_bps {
            kinds.push(LearnerIntentKind::Remediate);
        }
        if report.retention_bps < LEARNER_POLICY.min_retention_bps {
            kinds.push(LearnerIntentKind::SpaceRetrieval);
        }
        if report.transfer_bps < LEARNER_POLICY.min_transfer_bps {
            kinds.push(LearnerIntentKind::PracticeTransfer);
        }
    }
    if report.standing == EvidenceStanding::Supported {
        kinds.push(LearnerIntentKind::Maintain);
    }
    kinds.truncate(LEARNER_POLICY.max_cycles);
    Ok(kinds
        .into_iter()
        .map(|kind| LearnerIntent {
            kind,
            direct_actuation: false,
            standing_promoted: false,
        })
        .collect())
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct ItemResponse {
    pub learner_id: String,
    pub item_id: String,
    pub form_id: String,
    pub correct: bool,
    pub total_score_bps: u16,
    pub sequence: u64,
    pub evidence_digest: [u8; 32],
}

impl ItemResponse {
    pub fn issue(
        learner: &str,
        item: &str,
        form: &str,
        correct: bool,
        total_score_bps: u16,
        sequence: u64,
    ) -> Self {
        let evidence_digest = item_response_digest(
            learner,
            item,
            form,
            correct,
            total_score_bps,
            sequence,
        );
        Self {
            learner_id: learner.to_string(),
            item_id: item.to_string(),
            form_id: form.to_string(),
            correct,
            total_score_bps,
            sequence,
            evidence_digest,
        }
    }

    pub fn verify(&self) -> Result<(), ControlError> {
        if self.total_score_bps > 10_000 {
            return Err(ControlError::InvalidScore(self.total_score_bps));
        }
        if self.sequence == 0 {
            return Err(ControlError::InvalidSequence);
        }
        if self.evidence_digest
            != item_response_digest(
                &self.learner_id,
                &self.item_id,
                &self.form_id,
                self.correct,
                self.total_score_bps,
                self.sequence,
            )
        {
            return Err(ControlError::EvidenceMismatch);
        }
        Ok(())
    }
}

fn item_response_digest(
    learner: &str,
    item: &str,
    form: &str,
    correct: bool,
    total_score_bps: u16,
    sequence: u64,
) -> [u8; 32] {
    let mut hasher = blake3::Hasher::new();
    put(&mut hasher, b"certification-assist-item-response/v1");
    put(&mut hasher, learner.as_bytes());
    put(&mut hasher, item.as_bytes());
    put(&mut hasher, form.as_bytes());
    hasher.update(&[u8::from(correct)]);
    hasher.update(&total_score_bps.to_le_bytes());
    hasher.update(&sequence.to_le_bytes());
    hasher.finalize().into()
}

