}

#[derive(Default)]
pub struct LearnerEfficacyController {
    observations: Vec<LearnerObservation>,
    seen: HashSet<[u8; 32]>,
}

impl LearnerEfficacyController {
    pub fn admit(&mut self, observation: LearnerObservation) -> Result<(), ControlError> {
        observation.verify()?;
        if !self.seen.insert(observation.evidence_digest) {
            return Err(ControlError::DuplicateObservation);
        }
        self.observations.push(observation);
        Ok(())
    }

    fn average(&self, learner: &str, objective: &str, phase: AssessmentPhase) -> (usize, u16) {
        let scores = self
            .observations
            .iter()
            .filter(|item| {
                item.learner_id == learner
                    && item.objective_slug == objective
                    && item.phase == phase
            })
            .map(|item| u64::from(item.score_bps))
            .collect::<Vec<_>>();
        if scores.is_empty() {
            (0, 0)
        } else {
            (scores.len(), (scores.iter().sum::<u64>() / scores.len() as u64) as u16)
        }
    }

    pub fn evaluate(&self, learner: &str, objective: &str) -> Result<LearnerEfficacyReport, ControlError> {
        validate_policies()?;
        let (baseline_count, baseline_bps) = self.average(learner, objective, AssessmentPhase::Baseline);
        let (post_count, post_bps) = self.average(learner, objective, AssessmentPhase::Post);
        let (retention_count, retention_bps) = self.average(learner, objective, AssessmentPhase::Retention);
        let (transfer_count, transfer_bps) = self.average(learner, objective, AssessmentPhase::Transfer);
        let gain_bps = i32::from(post_bps) - i32::from(baseline_bps);
        let counts = [baseline_count, post_count, retention_count, transfer_count];
        let standing = if counts.iter().all(|count| *count == 0) {
            EvidenceStanding::Unknown
        } else if counts
            .iter()
            .any(|count| *count < LEARNER_POLICY.min_observations_per_phase)
        {
            EvidenceStanding::Collecting
        } else if gain_bps >= LEARNER_POLICY.min_gain_bps
            && retention_bps >= LEARNER_POLICY.min_retention_bps
            && transfer_bps >= LEARNER_POLICY.min_transfer_bps
        {
            EvidenceStanding::Supported
        } else {
            EvidenceStanding::Refuted
        };
        Ok(LearnerEfficacyReport {
            learner_id: learner.to_string(),
            objective_slug: objective.to_string(),
            standing,
            baseline_count,
            post_count,
            retention_count,
            transfer_count,
            baseline_bps,
            post_bps,
            retention_bps,
            transfer_bps,
            gain_bps,
        })
    }
}

