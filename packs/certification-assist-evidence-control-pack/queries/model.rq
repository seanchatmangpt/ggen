PREFIX caec: <https://chatmangpt.com/ontology/certification-assist-evidence-control#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?recordKind ?order ?slug ?rustVariant ?name ?category ?outcome
       ?maxCycles ?directActuation ?minObservationsPerPhase ?minGainBps
       ?minRetentionBps ?minTransferBps ?minLearners ?minItems ?minExposure
       ?minDifficultyBps ?maxDifficultyBps ?minDiscriminationBps
       ?maxStatusAgeTicks ?renewalWindowTicks ?issuerEvidenceRequired ?description
WHERE {
  {
    ?s a caec:Capability ;
      caec:order ?order ; caec:slug ?slug ; caec:rustVariant ?rustVariant ;
      rdfs:label ?name ; caec:category ?category ; caec:outcome ?outcome .
    BIND("capability" AS ?recordKind)
  }
  UNION
  {
    ?s a caec:LearnerPolicy ;
      caec:maxCycles ?maxCycles ; caec:directActuation ?directActuation ;
      caec:minObservationsPerPhase ?minObservationsPerPhase ;
      caec:minGainBps ?minGainBps ; caec:minRetentionBps ?minRetentionBps ;
      caec:minTransferBps ?minTransferBps ; caec:description ?description .
    BIND(1 AS ?order)
    BIND("learner-policy" AS ?recordKind)
  }
  UNION
  {
    ?s a caec:PsychometricPolicy ;
      caec:maxCycles ?maxCycles ; caec:directActuation ?directActuation ;
      caec:minLearners ?minLearners ; caec:minItems ?minItems ;
      caec:minExposure ?minExposure ; caec:minDifficultyBps ?minDifficultyBps ;
      caec:maxDifficultyBps ?maxDifficultyBps ;
      caec:minDiscriminationBps ?minDiscriminationBps ;
      caec:description ?description .
    BIND(1 AS ?order)
    BIND("psychometric-policy" AS ?recordKind)
  }
  UNION
  {
    ?s a caec:IssuerPolicy ;
      caec:maxCycles ?maxCycles ; caec:directActuation ?directActuation ;
      caec:maxStatusAgeTicks ?maxStatusAgeTicks ;
      caec:renewalWindowTicks ?renewalWindowTicks ;
      caec:issuerEvidenceRequired ?issuerEvidenceRequired ;
      caec:description ?description .
    BIND(1 AS ?order)
    BIND("issuer-policy" AS ?recordKind)
  }
}
ORDER BY ?recordKind ?order
