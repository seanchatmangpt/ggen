// Do not edit this projection by hand.

/// Canonical version of the manufactured temporal execution contract.
pub const TEMPORAL_RUNTIME_VERSION: &str = "{{ p.version }}";
pub const TEMPORAL_ABI_VERSION: u16 = {{ p.abi_version }};
pub const TEMPORAL_RECEIPT_VERSION: u16 = {{ p.receipt_version }};
pub const MAXIMUM_TEMPORAL_STEPS: usize = {{ p.maximum_temporal_steps }};
pub const LOGICAL_TIME_UNIT: &str = "{{ p.logical_time_unit }}";
pub const RECEIPT_ALGORITHM: &str = "{{ p.receipt_algorithm }}";
pub const CANONICAL_STATUS: &str = "{{ p.canonical_status }}";

/// Stable language-neutral refusal codes. New codes are append-only.
#[repr(u16)]
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TemporalRefusalCode {
{%- for row in refusals %}
    {{ row.variant }} = {{ row.code }},
{%- endfor %}
}

/// Fixed-layout deployment profile shared by native and WebAssembly hosts.
#[repr(C)]
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct TemporalRuntimeProfile {
    pub abi_version: u16,
    pub receipt_version: u16,
    pub maximum_temporal_steps: u16,
    pub deterministic: u8,
    pub llm_dependency: u8,
    pub stable_rust_safety: u8,
    pub nightly_specialization: u8,
    pub panic_across_boundary: u8,
    pub ambient_authority: u8,
}

pub const TEMPORAL_RUNTIME_PROFILE: TemporalRuntimeProfile = TemporalRuntimeProfile {
    abi_version: TEMPORAL_ABI_VERSION,
    receipt_version: TEMPORAL_RECEIPT_VERSION,
    maximum_temporal_steps: MAXIMUM_TEMPORAL_STEPS as u16,
    deterministic: {% if p.deterministic == true %}1{% else %}0{% endif %},
    llm_dependency: {% if p.llm_dependency == true %}1{% else %}0{% endif %},
    stable_rust_safety: {% if p.stable_rust_safety == true %}1{% else %}0{% endif %},
    nightly_specialization: {% if p.nightly_specialization == true %}1{% else %}0{% endif %},
    panic_across_boundary: {% if p.panic_across_boundary == true %}1{% else %}0{% endif %},
    ambient_authority: {% if p.ambient_authority == true %}1{% else %}0{% endif %},
};
