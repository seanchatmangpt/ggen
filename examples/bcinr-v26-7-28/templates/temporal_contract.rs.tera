{%- set p = sparql_results | first -%}
{%- set refusals = sparql(query='PREFIX bvr: <https://ggen.dev/ns/bcinr-v26-7-28#> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> SELECT ?variant ?code ?label WHERE { ?refusal a bvr:Refusal ; bvr:code ?code ; skos:prefLabel ?label . BIND(REPLACE(STR(?refusal), "^https://ggen.dev/ns/bcinr-v26-7-28#", "") AS ?variant) } ORDER BY ?code') -%}
