{%- set scenarios = sparql(query='PREFIX bvr: <https://ggen.dev/ns/bcinr-v26-7-28#> SELECT ?id ?workers ?concurrency ?substitution ?speculation ?human ?standing WHERE { ?scenario a bvr:Scenario ; bvr:scenarioId ?id ; bvr:workers ?workers ; bvr:requiresConcurrency ?concurrency ; bvr:requiresSubstitution ?substitution ; bvr:requiresSpeculation ?speculation ; bvr:requiresHumanApproval ?human ; bvr:expectedStanding ?standing . } ORDER BY ?id') -%}
// GENERATED BY ggen FROM examples/bcinr-v26-7-28/runtime.ttl.
// Do not edit this projection by hand.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ManufacturedScenarioDescriptor {
    pub id: &'static str,
    pub workers: u16,
    pub requires_concurrency: bool,
    pub requires_substitution: bool,
    pub requires_speculation: bool,
    pub requires_human_approval: bool,
    pub expected_standing: &'static str,
}

pub const MANUFACTURED_SCENARIOS: [ManufacturedScenarioDescriptor; {{ scenarios | length }}] = [
{%- for row in scenarios %}
    ManufacturedScenarioDescriptor {
        id: "{{ row.id }}",
        workers: {{ row.workers }},
        requires_concurrency: {% if row.concurrency == true %}true{% else %}false{% endif %},
        requires_substitution: {% if row.substitution == true %}true{% else %}false{% endif %},
        requires_speculation: {% if row.speculation == true %}true{% else %}false{% endif %},
        requires_human_approval: {% if row.human == true %}true{% else %}false{% endif %},
        expected_standing: "{{ row.standing }}",
    },
{%- endfor %}
];
