{%- set p = sparql_results | first -%}
{%- set refusals = sparql(query='PREFIX bvr: <https://ggen.dev/ns/bcinr-v26-7-28#> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> SELECT ?variant ?code ?label WHERE { ?refusal a bvr:Refusal ; bvr:code ?code ; skos:prefLabel ?label . BIND(UCASE(REPLACE(STR(?refusal), "^https://ggen.dev/ns/bcinr-v26-7-28#", "")) AS ?variant) } ORDER BY ?code') -%}
/* GENERATED BY ggen FROM examples/bcinr-v26-7-28/runtime.ttl. */
#ifndef BCINR_TEMPORAL_V26_7_28_H
#define BCINR_TEMPORAL_V26_7_28_H

#include <stdint.h>

#define BCINR_TEMPORAL_RUNTIME_VERSION "{{ p.version }}"
#define BCINR_TEMPORAL_ABI_VERSION {{ p.abi_version }}u
#define BCINR_TEMPORAL_RECEIPT_VERSION {{ p.receipt_version }}u
#define BCINR_TEMPORAL_MAX_STEPS {{ p.maximum_temporal_steps }}u

typedef enum bcinr_temporal_refusal_code {
{%- for row in refusals %}
    BCINR_TEMPORAL_{{ row.variant }} = {{ row.code }},
{%- endfor %}
} bcinr_temporal_refusal_code;

typedef struct bcinr_temporal_runtime_profile {
    uint16_t abi_version;
    uint16_t receipt_version;
    uint16_t maximum_temporal_steps;
    uint8_t deterministic;
    uint8_t llm_dependency;
    uint8_t stable_rust_safety;
    uint8_t nightly_specialization;
    uint8_t panic_across_boundary;
    uint8_t ambient_authority;
} bcinr_temporal_runtime_profile;

#endif
