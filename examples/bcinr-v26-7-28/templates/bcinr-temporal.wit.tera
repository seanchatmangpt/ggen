{%- set p = sparql_results | first -%}
{%- set refusals = sparql(query='PREFIX bvr: <https://ggen.dev/ns/bcinr-v26-7-28#> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> SELECT ?label ?code WHERE { ?refusal a bvr:Refusal ; bvr:code ?code ; skos:prefLabel ?label . } ORDER BY ?code') -%}
// GENERATED BY ggen FROM examples/bcinr-v26-7-28/runtime.ttl.
package bcinr:temporal@{{ p.version }};

interface runtime {
    enum refusal-code {
{%- for row in refusals %}
        {{ row.label | replace(from="_", to="-") }},
{%- endfor %}
    }

    record runtime-profile {
        abi-version: u16,
        receipt-version: u16,
        maximum-temporal-steps: u16,
        deterministic: bool,
        llm-dependency: bool,
        stable-rust-safety: bool,
        nightly-specialization: bool,
        panic-across-boundary: bool,
        ambient-authority: bool,
    }

    record temporal-step {
        action: string,
        start-millis: u64,
        duration-millis: u64,
    }

    record execution-receipt {
        version: u16,
        goal-reached: bool,
        execution-root: string,
    }

    variant execution-outcome {
        completed(execution-receipt),
        refused(refusal-code),
    }

    profile: func() -> runtime-profile;
    execute: func(steps: list<temporal-step>) -> execution-outcome;
}

world bcinr-temporal {
    export runtime;
}
