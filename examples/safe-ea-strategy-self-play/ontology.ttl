  sp:hasAction ex:action-portfolio-to-pi-consume-runway-for-features ;
  sp:hasAction ex:action-portfolio-to-pi-admit-pi-plan ;
  sp:hasInitialMetric ex:initial-portfolio-to-pi-BusinessValue ;
  sp:hasInvariant ex:invariant-min-portfolio-to-pi-BusinessValue ;
  sp:hasInvariant ex:invariant-max-portfolio-to-pi-BusinessValue ;
  sp:hasInitialMetric ex:initial-portfolio-to-pi-FlowEfficiency ;
