@prefix sp: <https://ggen.dev/ontology/self-play#> .
@prefix ex: <https://example.org/ea-self-play/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:program a sp:SelfPlayProgram ;
  sp:programId "safe-ea-strategy-self-play-v26.7.30" ;
  dcterms:title "Non-LLM SAFe and Enterprise Architecture as Strategy self-play" ;
  sp:executionMode sp:DeterministicRuleSelfPlay ;
  sp:llmCalls 0 ;
  sp:directActuation false ;
  sp:requiredBroker "BRCE" ;
  sp:witness "cargo test --manifest-path generated/Cargo.toml --all-targets" ;
  sp:falsifier "tamper one real move receipt and require independent refusal" ;
  sp:independentVerifier "ea-self-play-verifier" ;
  sp:receiptVerifier "ggen receipt verify" ;
  sp:replayCommand "run ea-self-play twice and compare exact stdout bytes" ;
  sp:hasScenario ex:scenario-portfolio-to-pi ;
  sp:hasScenario ex:scenario-runway-to-release ;
  sp:hasScenario ex:scenario-operating-model-core ;
  sp:hasScenario ex:scenario-platform-engagement-transition .

ex:scenario-portfolio-to-pi a sp:Scenario ;
  sp:scenarioId "portfolio-to-pi" ;
  sp:maxRounds 4 ;
  sp:coversUseCase sp:SafePortfolioEpicFunnel ;
  sp:coversUseCase sp:SafePiPlanning ;
  sp:coversUseCase sp:SafeDependencyResolution ;
  sp:hasPolicy ex:policy-portfolio-to-pi-BusinessOwner ;
  sp:hasPolicy ex:policy-portfolio-to-pi-ProductManagement ;
  sp:hasPolicy ex:policy-portfolio-to-pi-ReleaseTrainEngineer ;
