ex:policy-portfolio-to-pi-BusinessOwner a sp:ActorPolicy ;
  sp:actorRole sp:BusinessOwner ;
  sp:minimumUtility 1 ;
  sp:hasWeight ex:weight-portfolio-to-pi-BusinessOwner-BusinessValue ;
  sp:hasWeight ex:weight-portfolio-to-pi-BusinessOwner-DecisionRights ;
  sp:hasWeight ex:weight-portfolio-to-pi-BusinessOwner-Cost ;
  sp:hasWeight ex:weight-portfolio-to-pi-BusinessOwner-Risk ;
  sp:authorityToken "strategy_decision"  .
ex:weight-portfolio-to-pi-BusinessOwner-BusinessValue a sp:PolicyWeight ; sp:metric sp:BusinessValue ; sp:weight 5 .
