# MESSAGE: Operator (derived) requires exactly one tpot:operatorId (xsd:string).
# MESSAGE: one tpot:wrapsAlgorithm -> pi:ProcessIntelligenceAlgorithm, one
# MESSAGE: tpot:atStage -> tpot:PipelineStage, one tpot:fitnessScore (xsd:decimal),
# MESSAGE: and copied tiers/category/wasmExport (opSpeedTier/opQualityTier xsd:integer,
# MESSAGE: opCategory/wasmExport xsd:string).
# Gate equivalent of tpot:OperatorShape (SHACL-at-sync retired, FM-LAW-017).
# Any row = violation.
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX pi:   <https://wasm4pm.dev/pi#>
PREFIX tpot: <https://wasm4pm.dev/tpot#>

SELECT ?operator ?problem
WHERE {
  ?operator a tpot:Operator .
  {
    VALUES ?problem { "missing or non-string tpot:operatorId" }
    FILTER NOT EXISTS { ?operator tpot:operatorId ?v . FILTER(datatype(?v) = xsd:string) }
  } UNION {
    VALUES ?problem { "tpot:operatorId has more than one value" }
    ?operator tpot:operatorId ?v1, ?v2 .
    FILTER(STR(?v1) != STR(?v2))
  } UNION {
    VALUES ?problem { "missing tpot:wrapsAlgorithm -> pi:ProcessIntelligenceAlgorithm" }
    FILTER NOT EXISTS { ?operator tpot:wrapsAlgorithm ?a . ?a a pi:ProcessIntelligenceAlgorithm }
  } UNION {
    VALUES ?problem { "tpot:wrapsAlgorithm has more than one value" }
    ?operator tpot:wrapsAlgorithm ?a1, ?a2 .
    FILTER(?a1 != ?a2)
  } UNION {
    VALUES ?problem { "missing tpot:atStage -> tpot:PipelineStage" }
    FILTER NOT EXISTS { ?operator tpot:atStage ?s . ?s a tpot:PipelineStage }
  } UNION {
    VALUES ?problem { "tpot:atStage has more than one value" }
    ?operator tpot:atStage ?s1, ?s2 .
    FILTER(?s1 != ?s2)
  } UNION {
    VALUES ?problem { "missing or non-decimal tpot:fitnessScore" }
    FILTER NOT EXISTS { ?operator tpot:fitnessScore ?v . FILTER(datatype(?v) = xsd:decimal) }
  } UNION {
    VALUES ?problem { "tpot:fitnessScore has more than one value" }
    ?operator tpot:fitnessScore ?v1, ?v2 .
    FILTER(STR(?v1) != STR(?v2))
  } UNION {
    VALUES ?problem { "missing or non-integer tpot:opSpeedTier" }
    FILTER NOT EXISTS { ?operator tpot:opSpeedTier ?v . FILTER(datatype(?v) = xsd:integer) }
  } UNION {
    VALUES ?problem { "missing or non-integer tpot:opQualityTier" }
    FILTER NOT EXISTS { ?operator tpot:opQualityTier ?v . FILTER(datatype(?v) = xsd:integer) }
  } UNION {
    VALUES ?problem { "missing or non-string tpot:opCategory" }
    FILTER NOT EXISTS { ?operator tpot:opCategory ?v . FILTER(datatype(?v) = xsd:string) }
  } UNION {
    VALUES ?problem { "missing or non-string tpot:wasmExport" }
    FILTER NOT EXISTS { ?operator tpot:wasmExport ?v . FILTER(datatype(?v) = xsd:string) }
  }
}
ORDER BY STR(?operator) STR(?problem)
