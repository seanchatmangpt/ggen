<urn:ig:d:frontier> a cmd:Dimension ; cmd:name "observational-frontier" ; cmd:order 4 ; skos:definition "Whether execution stays inside already inspectable states or exposes a previously inaccessible state." ; cmd:hasOption <urn:ig:o:frontier:0>, <urn:ig:o:frontier:1> .
<urn:ig:o:frontier:0> a cmd:Option ; cmd:name "known-state" ; cmd:belongsToDimension <urn:ig:d:frontier> ; cmd:reversible true ; cmd:resourceCost 1.0 .
