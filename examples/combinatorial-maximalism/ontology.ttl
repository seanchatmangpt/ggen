<urn:ig:o:reach:1> a cmd:Option ; cmd:name "controlled-falsification" ; cmd:belongsToDimension <urn:ig:d:reach> ; cmd:reversible true ; cmd:resourceCost 1.5 .

<urn:ig:d:aperture> a cmd:Dimension ; cmd:name "effective-aperture" ; cmd:order 2 ; skos:definition "Whether evidence is isolated to one repository or composed across independent repositories into one observational system." ; cmd:hasOption <urn:ig:o:aperture:0>, <urn:ig:o:aperture:1> .
