@prefix cmd:     <https://chatmangpt.com/ontology/cmd#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# Instrument-gain calibration uses the existing bounded CMD apparatus. The
# historical candidate identifiers remain stable execution handles for the
# verifier court; the ontology below is the authoritative experimental meaning.
#
# Axis 1 combines experimental reach + effective aperture.
# Axis 2 combines operationalization + observational frontier + stored work.
# Their Cartesian product yields four reversible calibration regimes. Only the
# full-instrument regime is verified and authorized for receipted actuation.

<urn:cmd:specimen> a cmd:DesignSpace ;
    dcterms:title "Instrument gain no-handwriting calibration cell" ;
    dcterms:description "Measure capability latent in the existing software instrument while new packs, new GGen capabilities, and handwritten implementation are excluded." ;
    cmd:crateName "cmd-cell" ;
    cmd:binaryName "cmdctl" ;
    cmd:version "26.8.27" ;
    cmd:coverageMode "exhaustive" ;
    cmd:expectedCandidateCount 4 ;
    cmd:maxCandidates 8 ;
    cmd:hasDimension <urn:cmd:dimension:observation-regime>, <urn:cmd:dimension:capitalization-regime> ;
    cmd:hasCandidate
        <urn:cmd:candidate:native-json>,
        <urn:cmd:candidate:native-turtle>,
        <urn:cmd:candidate:wasm-json>,
        <urn:cmd:candidate:wasm-turtle> ;
    cmd:hasBroker <urn:cmd:broker:filesystem> .

<urn:cmd:dimension:observation-regime> a cmd:Dimension ;
    cmd:name "observation-regime" ;
    cmd:order 1 ;
    skos:definition "Experimental reach and effective aperture: from local pattern observation to coordinated controlled falsification." ;
    cmd:hasOption <urn:cmd:option:pattern-local>, <urn:cmd:option:falsification-federated> .

<urn:cmd:dimension:capitalization-regime> a cmd:Dimension ;
    cmd:name "capitalization-regime" ;
    cmd:order 2 ;
    skos:definition "Operationalization, observational frontier, and stored work: from human-remembrance of known states with fresh implementation to enforced law exposing new observables from the existing instrument." ;
    cmd:hasOption <urn:cmd:option:human-known-fresh>, <urn:cmd:option:enforced-new-stored> .

<urn:cmd:option:pattern-local> a cmd:Option ;
    cmd:name "pattern-observation+single-repository" ;
    skos:definition "Baseline: recognize patterns inside one repository without manufacturing a coordinated falsification state." ;
    cmd:belongsToDimension <urn:cmd:dimension:observation-regime> ;
    cmd:reversible true ;
    cmd:resourceCost 1.0 .

<urn:cmd:option:falsification-federated> a cmd:Option ;
    cmd:name "controlled-falsification+coordinated-repositories" ;
    skos:definition "Instrument regime: manufacture controlled falsification states and compose independent repository evidence into one effective aperture." ;
    cmd:belongsToDimension <urn:cmd:dimension:observation-regime> ;
    cmd:reversible true ;
    cmd:resourceCost 1.5 .

<urn:cmd:option:human-known-fresh> a cmd:Option ;
    cmd:name "human-remembrance+known-state+fresh-implementation" ;
    skos:definition "Baseline: architectural law depends on human remembrance, remains inside already inspectable states, and requires fresh implementation." ;
    cmd:belongsToDimension <urn:cmd:dimension:capitalization-regime> ;
    cmd:reversible true ;
    cmd:resourceCost 1.0 .

<urn:cmd:option:enforced-new-stored> a cmd:Option ;
    cmd:name "enforced-law+new-observable+existing-instrument" ;
    skos:definition "Instrument regime: discovered law is executable infrastructure, exposes a previously inaccessible observable, and manufactures capability from already-capitalized executable knowledge." ;
    cmd:belongsToDimension <urn:cmd:dimension:capitalization-regime> ;
    cmd:reversible true ;
    cmd:resourceCost 1.5 .

# Stable candidate names are acceptance handles retained by the existing court.
<urn:cmd:candidate:native-json> a cmd:Candidate ;
    cmd:name "native-json" ;
    dcterms:description "Full instrument: federated falsification plus enforced/new/stored capitalization." ;
    cmd:standing "VERIFIED" ;
    cmd:authorizedBy "instrument-gain-calibration-authority" ;
    cmd:selectsOption <urn:cmd:option:falsification-federated>, <urn:cmd:option:enforced-new-stored> ;
    cmd:outputRelativePath "artifacts/native-json.json" ;
    cmd:requiresProof <urn:cmd:proof:instrument-gain-closure>, <urn:cmd:proof:no-handwriting-boundary> .

<urn:cmd:candidate:native-turtle> a cmd:Candidate ;
    cmd:name "native-turtle" ;
    dcterms:description "High observational aperture with fresh human implementation retained." ;
    cmd:standing "CANDIDATE" ;
    cmd:selectsOption <urn:cmd:option:falsification-federated>, <urn:cmd:option:human-known-fresh> ;
    cmd:outputRelativePath "artifacts/native-turtle.ttl" .

<urn:cmd:candidate:wasm-json> a cmd:Candidate ;
    cmd:name "wasm-json" ;
    dcterms:description "Stored executable capitalization while observation remains local and pattern-based." ;
    cmd:standing "CANDIDATE" ;
    cmd:selectsOption <urn:cmd:option:pattern-local>, <urn:cmd:option:enforced-new-stored> ;
    cmd:outputRelativePath "artifacts/wasm-json.json" .

<urn:cmd:candidate:wasm-turtle> a cmd:Candidate ;
    cmd:name "wasm-turtle" ;
    dcterms:description "Baseline regime: local pattern observation with human-known-fresh implementation." ;
    cmd:standing "CANDIDATE" ;
    cmd:selectsOption <urn:cmd:option:pattern-local>, <urn:cmd:option:human-known-fresh> ;
    cmd:outputRelativePath "artifacts/wasm-turtle.ttl" .

<urn:cmd:proof:instrument-gain-closure> a cmd:ProofObligation ;
    cmd:proofId "INSTRUMENT-GAIN-DESIGN-CLOSURE" ;
    cmd:proofStatus "SATISFIED" .

<urn:cmd:proof:no-handwriting-boundary> a cmd:ProofObligation ;
    cmd:proofId "INSTRUMENT-GAIN-NO-HANDWRITING-BOUNDARY" ;
    cmd:proofStatus "SATISFIED" .

<urn:cmd:broker:filesystem> a cmd:Broker ;
    cmd:name "instrument-gain-filesystem-broker" ;
    cmd:rootPath ".cmd/runtime" ;
    cmd:receiptAlgorithm "blake3" ;
    cmd:replayMode "exact-output" .

<urn:cmd:actuation:native-json> a cmd:ActuationContract ;
    cmd:name "instrument-gain-target-actuation" ;
    cmd:fromCandidate <urn:cmd:candidate:native-json> ;
    cmd:throughBroker <urn:cmd:broker:filesystem> ;
    cmd:receiptRequired true ;
    cmd:producesReceipt <urn:cmd:receipt:runtime> .

<urn:cmd:receipt:runtime> a cmd:Receipt .
<urn:cmd:intent:materialize-native-json> a cmd:Intent .
<urn:cmd:hook:design-selection> a cmd:IntentHook ;
    cmd:emitsIntent <urn:cmd:intent:materialize-native-json> .
