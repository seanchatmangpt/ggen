<urn:ig:d:stored> a cmd:Dimension ; cmd:name "stored-work" ; cmd:order 5 ; skos:definition "Whether capability requires new implementation or is latent in the already-built executable instrument." ; cmd:hasOption <urn:ig:o:stored:0>, <urn:ig:o:stored:1> .
