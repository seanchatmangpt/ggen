<urn:ig:d:ops> a cmd:Dimension ; cmd:name "operationalization" ; cmd:order 3 ; skos:definition "Whether discovered architectural law depends on human memory or is enforced by executable infrastructure." ; cmd:hasOption <urn:ig:o:ops:0>, <urn:ig:o:ops:1> .
<urn:ig:o:ops:0> a cmd:Option ; cmd:name "human-remembrance" ; cmd:belongsToDimension <urn:ig:d:ops> ; cmd:reversible true ; cmd:resourceCost 1.0 .
