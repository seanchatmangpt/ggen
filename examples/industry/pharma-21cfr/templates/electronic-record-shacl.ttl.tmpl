---
to: "generated/pharma-21cfr-shacl.ttl"
sparql:
  required: |
    PREFIX p11: <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
    SELECT ?cls ?prop WHERE {
      ?cls p11:requiresProperty ?prop .
    } ORDER BY ?cls ?prop
force: true
---
{# Renders SHACL from the ontology's own requiresProperty annotations.
   One sh:NodeShape per (class, required property) pair; a class with N
   required properties gets N shapes targeting the same class, which is
   valid SHACL. #}
# GENERATED by industry-pharma-21cfr/templates/electronic-record-shacl.ttl.tmpl — do not hand-edit.
@prefix p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{% for row in required %}
[] a sh:NodeShape ;
    sh:targetClass <{{ row.cls }}> ;
    rdfs:label "Part 11 required property on {{ row.cls }}" ;
    sh:property [
        sh:path <{{ row.prop }}> ;
        sh:minCount 1 ;
        sh:message "21 CFR Part 11 refusal: {{ row.cls }} without {{ row.prop }}"
    ] .
{% endfor %}