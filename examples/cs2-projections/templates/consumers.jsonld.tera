{
  "@context": {
    "cs2": "https://chatman.ai/cs2#",
    "subject": {"@id": "cs2:implements", "@type": "@id"},
    "consumer": {"@id": "cs2:consumer", "@type": "@id"},
    "authority": "cs2:authorityCeiling",
    "work_id": "cs2:workId",
    "projection": "cs2:expectedProjection"
  },
  "@graph": [
{% for row in sparql_results -%}
    {
      "@id": "{{ row["consumer"] }}",
      "@type": "cs2:ConsumerProjection",
      "subject": "{{ row["subject"] }}",
      "authority": "{{ row["authority"] }}",
      "consumer": "{{ row["consumer"] }}",
      "work_id": "{{ row["work_id"] }}",
      "projection": "{{ row["projection"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor -%}
  ]
}
