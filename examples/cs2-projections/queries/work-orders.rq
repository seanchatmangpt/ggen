PREFIX cs2: <https://chatman.ai/cs2#>

SELECT ?subject ?authority ?work ?work_id ?consumer ?projection ?priority ?state
WHERE {
  VALUES ?subject { cs2:RFC-CS2-001 }
  ?subject a cs2:SemanticWorld ; cs2:authorityCeiling ?authority_iri .
  BIND(REPLACE(STR(?authority_iri), "^.*[#/]", "") AS ?authority)
  ?work a cs2:Work ; cs2:implements ?subject ; cs2:consumer ?consumer .
  ?consumer a cs2:Consumer ; cs2:workId ?work_id ; cs2:expectedProjection ?projection .
  OPTIONAL { ?work cs2:priority ?priority_raw }
  OPTIONAL { ?work cs2:state ?state_raw }
  BIND(COALESCE(STR(?priority_raw), "P2") AS ?priority)
  BIND(COALESCE(STR(?state_raw), "READY") AS ?state)
}
ORDER BY ?priority STR(?work_id) STR(?consumer)
