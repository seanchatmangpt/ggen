# Fixture exercising the 5 "misc family" dspy:Optimizer kinds not covered by the
# gepa-trusted-monitor example: AvatarOptimizer, InferRules, SIMBA, LabeledFewShot, and
# BetterTogether (wrapping one of the other four via dspy:wrapsPromptOptimizer).
#
# Real dspy 3.1.3 constructor/compile signatures used here were supplied pre-verified by the
# task brief, not re-derived in this fixture.
@prefix dspy:    <http://seanchatmangpt.github.io/packs/dspy#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

dspy:misc-signature a dspy:Signature ;
    dcterms:title "AnswerQuestion" ;
    dcterms:description "Answer a question given some context." ;
    dspy:className "AnswerQuestion" ;
    dspy:hasInput dspy:misc-question-input ;
    dspy:hasOutput dspy:misc-answer-output .

dspy:misc-question-input a dspy:InputField ;
    dspy:name "question" ; dspy:pythonType "str" ;
    dcterms:description "The question to answer." .

dspy:misc-answer-output a dspy:OutputField ;
    dspy:name "answer" ; dspy:pythonType "str" ;
    dcterms:description "The answer to the question." .

dspy:misc-module a dspy:Module ;
    dcterms:description "Predict over AnswerQuestion, the shared optimization target for all 5 optimizers in this fixture." ;
    dspy:name "predictor" ; dspy:kind "Predict" ; dspy:signature dspy:misc-signature .

# ── AvatarOptimizer ─────────────────────────────────────────────────────────

dspy:misc-avatar a dspy:Optimizer ;
    dcterms:description "AvatarOptimizer over the predictor." ;
    dspy:name "avatar_opt" ; dspy:kind "AvatarOptimizer" ;
    dspy:optimizes dspy:misc-module ; dspy:metricFunction "avatar_metric" ;
    dspy:avatarMaxIters 5 ; dspy:lowerBound 0 ; dspy:upperBound 5 ;
    dspy:maxPositiveInputs 10 ; dspy:maxNegativeInputs 10 ; dspy:optimizeFor "max" .

# ── InferRules ──────────────────────────────────────────────────────────────

dspy:misc-inferrules a dspy:Optimizer ;
    dcterms:description "InferRules over the predictor." ;
    dspy:name "inferrules_opt" ; dspy:kind "InferRules" ;
    dspy:optimizes dspy:misc-module ; dspy:metricFunction "inferrules_metric" ;
    dspy:numCandidates 8 ; dspy:numRules 6 ; dspy:numThreads 4 .

# ── SIMBA ───────────────────────────────────────────────────────────────────

dspy:misc-simba a dspy:Optimizer ;
    dcterms:description "SIMBA over the predictor." ;
    dspy:name "simba_opt" ; dspy:kind "SIMBA" ;
    dspy:optimizes dspy:misc-module ; dspy:metricFunction "simba_metric" ;
    dspy:bsize 16 ; dspy:numCandidates 4 ; dspy:maxSteps 6 ; dspy:maxDemos 3 ;
    dspy:promptModel "openai/gpt-5" ; dspy:demoInputFieldMaxlen 50000 ;
    dspy:numThreads 4 ; dspy:temperatureForSampling 0.3 ; dspy:temperatureForCandidates 0.25 .

# ── LabeledFewShot ──────────────────────────────────────────────────────────

dspy:misc-labeledfewshot a dspy:Optimizer ;
    dcterms:description "LabeledFewShot over the predictor." ;
    dspy:name "labeledfewshot_opt" ; dspy:kind "LabeledFewShot" ;
    dspy:optimizes dspy:misc-module ; dspy:metricFunction "labeledfewshot_metric" ;
    dspy:kValue 8 .

# ── BetterTogether (wraps AvatarOptimizer as its prompt_optimizer) ──────────

dspy:misc-bettertogether a dspy:Optimizer ;
    dcterms:description "BetterTogether over the predictor, wrapping avatar_opt as its prompt_optimizer." ;
    dspy:name "bettertogether_opt" ; dspy:kind "BetterTogether" ;
    dspy:optimizes dspy:misc-module ; dspy:metricFunction "bettertogether_metric" ;
    dspy:wrapsPromptOptimizer dspy:misc-avatar ; dspy:seedInt 42 .
