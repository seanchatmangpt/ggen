# Equivalent of Hygen's `name = HelloWorld` case-conversion example.
@prefix ex:   <http://example.org/hygen-examples/component#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:Component a rdfs:Class ; rdfs:label "Component" .
ex:name a rdf:Property ; rdfs:domain ex:Component ; rdfs:range xsd:string .

ex:HelloWorldComponent
    a       ex:Component ;
    ex:name "HelloWorld" .
