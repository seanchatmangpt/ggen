{#-
  verification-harness (sync-hardening item 4) — opt-in via
  [generation.verification_harness] in ggen.toml. Rendered twice by
  ggen-engine's declarative-rules pipeline (generation_rules.rs) with
  `part` = "tsconfig" | "verify_mjs"; each render yields ONE file's
  contents. Path aliases are derived from the manifest's own
  [[generation.rules]] `output_file` layout — never guessed.
  Absent flag = nothing is rendered or written.
-#}
{% if part == "tsconfig" %}
{
  "//": "Generated by ggen {{ actuator }} — DO NOT EDIT. Re-rendered by `ggen sync run` while [generation.verification_harness] is present in ggen.toml.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
{%- for a in aliases %}

      "{{ a.name }}": ["{{ a.target }}"]{%- if not loop.last %},{% endif %}
{%- endfor %}

    }
  },
  "include": [
{%- for a in aliases %}
    "{{ a.target }}/**/*"{%- if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
{% else %}
// Generated by ggen {{ actuator }} — DO NOT EDIT. Re-rendered by `ggen sync run`
// while [generation.verification_harness] is present in ggen.toml.
//
// Typecheck entry for the generated surface. Aliases below mirror
// tsconfig.verify.json's `paths` (derived from the manifest's own
// [[generation.rules]] output_file layout). Dependencies are DECLARED here,
// never assumed hoisted into node_modules.
//
// Run: `npx tsc -p tsconfig.verify.json`
//
// Declared runtime peers: {{ peers | join(se=", ") }}
{% for peer in peers -%}
{% if peer == "xstate" -%}
// xstate smoke: actor creation is exercised against the DECLARED peer only.
// Add project-local smoke steps here; the harness never guesses package
// layout beyond the peers listed above.
{% endif -%}
{% endfor -%}
export {};
{% endif %}
