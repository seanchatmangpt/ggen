{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.dev/schema/epistemic-consumer-receipt-r52.json",
  "type": "object",
  "required": ["schema","consumer_repo","consumer_base","consumer_head","producer_repo","producer_head","producer_pack","evidence_root","checks","consequential_do","standing"],
  "properties": {
    "schema": {"const":"ggen.epistemic-consumer-receipt/1"},
    "consumer_repo": {"const":"seanchatmangpt/ggen"},
    "consumer_base": {"pattern":"^[0-9a-f]{40}$"},
    "consumer_head": {"pattern":"^[0-9a-f]{40}$"},
    "producer_head": {"pattern":"^[0-9a-f]{40}$"},
    "evidence_root": {"minLength":1},
    "consequential_do": {"const":false},
    "standing": {"enum":["PARTIAL_ALIVE","ALIVE","BUILD_BROKEN","UNKNOWN"]}
  }
}
