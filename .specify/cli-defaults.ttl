@prefix cdf: <http://ggen.org/cli-defaults#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The live CLI noun modules are still generated from an external/missing Praxis graph.
# This bounded ontology owns only the compatibility relation that permits `ggen noun`
# to mean `ggen noun default-verb`. It does not claim ownership of nouns, verbs,
# arguments, handlers, or behavior.

cdf:DefaultVerbBinding a rdfs:Class .
cdf:noun a rdf:Property ; rdfs:domain cdf:DefaultVerbBinding ; rdfs:range xsd:string .
cdf:verb a rdf:Property ; rdfs:domain cdf:DefaultVerbBinding ; rdfs:range xsd:string .
cdf:order a rdf:Property ; rdfs:domain cdf:DefaultVerbBinding ; rdfs:range xsd:integer .

cdf:sync a cdf:DefaultVerbBinding ; cdf:noun "sync" ; cdf:verb "run" ; cdf:order 1 .
cdf:doctor a cdf:DefaultVerbBinding ; cdf:noun "doctor" ; cdf:verb "check" ; cdf:order 2 .
cdf:graph a cdf:DefaultVerbBinding ; cdf:noun "graph" ; cdf:verb "query" ; cdf:order 3 .
cdf:receipt a cdf:DefaultVerbBinding ; cdf:noun "receipt" ; cdf:verb "verify" ; cdf:order 4 .
