//! Auto-generated noun default verbs.
//! DO NOT EDIT — generated by root ggen.toml rule `cli-default-verbs`
//! from `.specify/cli-defaults.ttl`. Edit the ontology, then `ggen sync run`.

use std::ffi::{OsStr, OsString};

/// Ontology-ordered `(noun, default verb)` compatibility bindings.
pub const DEFAULT_VERBS: &[(&str, &str)] = &[
{%- for row in results %}
    ("{{ row["noun"] }}", "{{ row["verb"] }}"),
{%- endfor %}
];

/// Return the ontology-declared default verb for one noun.
pub fn default_verb(noun: &OsStr) -> Option<&'static str> {
    DEFAULT_VERBS
        .iter()
        .find(|(candidate, _)| noun == OsStr::new(candidate))
        .map(|(_, verb)| *verb)
}

/// Insert a default verb only when argv contains a declared noun by itself.
///
/// Explicit `--help` and `-h` remain noun-help requests and are never rewritten.
pub fn inject_default_verb(argv: &mut Vec<OsString>) {
    let Some(noun) = argv.get(1) else {
        return;
    };
    let Some(verb) = default_verb(noun.as_os_str()) else {
        return;
    };
    if argv
        .get(2)
        .is_some_and(|value| value == OsStr::new("--help") || value == OsStr::new("-h"))
    {
        return;
    }
    if argv.len() == 2 {
        argv.push(OsString::from(verb));
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn every_binding_injects_exactly_one_declared_verb() {
        for (noun, verb) in DEFAULT_VERBS {
            let mut argv = vec![OsString::from("ggen"), OsString::from(noun)];
            inject_default_verb(&mut argv);
            assert_eq!(
                argv,
                vec![OsString::from("ggen"), OsString::from(noun), OsString::from(verb)]
            );
        }
    }

    #[test]
    fn explicit_verbs_and_help_are_preserved() {
        for (noun, verb) in DEFAULT_VERBS {
            let mut explicit = vec![
                OsString::from("ggen"),
                OsString::from(noun),
                OsString::from(verb),
            ];
            let before = explicit.clone();
            inject_default_verb(&mut explicit);
            assert_eq!(explicit, before);

            for help in ["--help", "-h"] {
                let mut argv = vec![
                    OsString::from("ggen"),
                    OsString::from(noun),
                    OsString::from(help),
                ];
                let before = argv.clone();
                inject_default_verb(&mut argv);
                assert_eq!(argv, before);
            }
        }
    }

    #[test]
    fn unknown_nouns_are_not_rewritten() {
        let mut argv = vec![OsString::from("ggen"), OsString::from("unknown")];
        let before = argv.clone();
        inject_default_verb(&mut argv);
        assert_eq!(argv, before);
    }
}
