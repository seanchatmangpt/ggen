{%- set diags = sparql(query="PREFIX rf: <http://ggen.org/repo-facts#> SELECT ?order ?code ?severity ?meaning ?owner WHERE { ?diag a rf:DiagnosticCode ; rf:order ?order ; rf:code ?code ; rf:severity ?severity ; rf:meaning ?meaning ; rf:owner ?owner . FILTER(?order = '001' || ?order = '002' || ?order = '003' || ?order = '004' || ?order = '005') } ORDER BY ?order") -%}
//! GENERATED by `ggen sync run` from `.specify/repo-facts.ttl` (`rf:DiagnosticCode`
//! individuals), rule `gen-diag-codes-rust` in root `ggen.toml`. Edit the ontology,
//! then `ggen sync run`.
//!
//! Deliberately AUGMENTS `crates/ggen-lsp/src/analyzers/tera_analyzer.rs` -- it does not
//! replace or gate any of that file's real, load-bearing checks. This table covers all
//! 5 of 5 `GGEN-*` codes: GGEN-TPL-001 / GGEN-OUT-001 (CP7), plus GGEN-YIELD-001 /
//! GGEN-RULE-001 / GGEN-QUERY-002 (this pass) -- verified against the real emission
//! sites in `tera_analyzer.rs` (`yield_001_diagnostics`, `unbound_rule_file_diagnostics`,
//! `select_star_diagnostics`) before extending the filter; all three severities matched
//! the ontology facts already, no hand-correction needed.

/// One row of the generated diagnostic-code table.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct DiagnosticCodeFact {
    pub code: &'static str,
    pub severity: &'static str,
    pub meaning: &'static str,
    pub owner: &'static str,
}

pub const GENERATED_DIAGNOSTIC_CODES: &[DiagnosticCodeFact] = &[
{%- for row in diags %}
    DiagnosticCodeFact {
        code: {{ row.code | replace(from="**", to="") | json_encode() }},
        severity: {{ row.severity | json_encode() }},
        meaning: {{ row.meaning | json_encode() }},
        owner: {{ row.owner | replace(from="`", to="") | json_encode() }},
    },
{%- endfor %}
];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn generated_table_has_exactly_five_rows() {
        assert_eq!(GENERATED_DIAGNOSTIC_CODES.len(), 5);
    }
}
