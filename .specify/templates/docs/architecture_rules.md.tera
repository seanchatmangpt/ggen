{#- .claude/rules/architecture.md — compressed one-page projection of
    .specify/repo-facts.ttl. Prose sections come from rf:ArchSection literals
    with sid prefix "compressed-" rendered verbatim; the crate count is derived
    from rf:crateCount (never hardcoded). The verbose full-document variant
    lives in the same template's history; the compressed literals are the
    admitted source of truth for this surface. -#}
{%- set A = sparql(query='PREFIX rf: <http://ggen.org/repo-facts#> SELECT ?sid ?text WHERE { ?x a rf:ArchSection ; rf:sid ?sid ; rf:text ?text . } ORDER BY ?sid') -%}
{%- set s_intro = A | filter(attribute="sid", value="compressed-intro") | first -%}
{%- set s_crates = A | filter(attribute="sid", value="compressed-crates") | first -%}
{%- set s_two = A | filter(attribute="sid", value="compressed-twoschemas") | first -%}
{%- set s_removed = A | filter(attribute="sid", value="compressed-removed") | first -%}
{%- set s_packs = A | filter(attribute="sid", value="compressed-packs") | first -%}
{%- set s_patterns = A | filter(attribute="sid", value="compressed-patterns") | first -%}
{%- set s_nav = A | filter(attribute="sid", value="compressed-nav") | first -%}
{%- set D = sparql(query='PREFIX rf: <http://ggen.org/repo-facts#> SELECT ?cc WHERE { rf:doc rf:crateCount ?cc . } LIMIT 1') -%}
{%- set cc = D | first -%}
---
auto_load: false
category: reference
priority: normal
version: 26.5.4
---

