# ci-workflows.ttl — ggen's own real CI workflow, as typed individuals
# against packs/github-actions-pack's gha: vocabulary.
#
# This is ggen's own consumer-side instance data (github-actions-pack
# ships zero individuals — see that pack's pack.toml/README for the
# schema-only contract). Facts transcribed 2026-08-12 directly from the
# real, current .github/workflows/ci.yml (149 lines, read in full, not
# from any prior survey/transcription) — action refs, SHAs, run commands,
# and job structure below are copied verbatim from that file.
@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gha:WfCi a gha:Workflow ;
    gha:fileName "ci.yml" ;
    gha:purpose "CI" ;
    gha:trigger gha:EventPullRequest, gha:EventPush, gha:EventMergeGroup, gha:EventWorkflowDispatch ;
    gha:onBlock """pull_request:
push:
  branches: [main]
merge_group:
workflow_dispatch:""" ;
    gha:concurrencyPolicy """group: ci-errc-${{ github.event.pull_request.number || github.ref }}
cancel-in-progress: true""" ;
    gha:permissionCeiling "contents: read" ;
    gha:workflowEnv "CARGO_TERM_COLOR: always" ;
    gha:workflowEnv "RUST_BACKTRACE: 1" ;
    gha:performsOperation gha:OpReadSource ;
    gha:evidenceObligation "ci-status job's aggregate assertion (ADMISSION == success and DEEP in success|skipped)" ;
    gha:standingEffect "confers merge admissibility on the tested ref" .

# --- admission job ---

gha:JobAdmission a gha:Job ;
    gha:inWorkflow gha:WfCi ;
    gha:jobName "admission" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 5 ;
    gha:jobExtra """name: Fast Admission
outputs:
  deep_matrix_json: ${{ steps.admit.outputs.deep_matrix_json }}
  base: ${{ steps.identity.outputs.base }}
  head: ${{ steps.identity.outputs.head }}""" ;
    gha:evidenceEmitted "exact-head receipt + routing report artifact" ;
    gha:failureClassification "gate refusal: the candidate cannot be admitted to deep evidence" .

gha:StepAdmissionCheckout a gha:Step ;
    gha:inJob gha:JobAdmission ; gha:stepOrder 1 ;
    gha:stepName "Checkout exact candidate" ;
    gha:usesAction "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2" ;
    gha:withParam "ref: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" ;
    gha:withParam "fetch-depth: 0" ;
    gha:withParam "persist-credentials: false" .

gha:StepAdmissionIdentity a gha:Step ;
    gha:inJob gha:JobAdmission ; gha:stepOrder 2 ;
    gha:stepName "Resolve admitted identities" ;
    gha:stepId "identity" ;
    gha:envVar "EVENT_BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}" ;
    gha:envVar "EVENT_HEAD: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" ;
    gha:runCommand """set -euo pipefail
base="$EVENT_BASE"
[[ -n "$base" && ! "$base" =~ ^0+$ ]] || base="$(git rev-parse HEAD^)"
echo "base=$base" >> "$GITHUB_OUTPUT"
echo "head=$EVENT_HEAD" >> "$GITHUB_OUTPUT\"""" .

gha:StepAdmissionAdmit a gha:Step ;
    gha:inJob gha:JobAdmission ; gha:stepOrder 3 ;
    gha:stepName "Manufacture exact-head receipt and routing" ;
    gha:stepId "admit" ;
    gha:continueOnError true ;
    gha:runCommand """python3 scripts/ci/fast_admission.py \\
  --repository '${{ github.repository }}' \\
  --base '${{ steps.identity.outputs.base }}' \\
  --head '${{ steps.identity.outputs.head }}' \\
  --workflow '${{ github.workflow }}' \\
  --run-id '${{ github.run_id }}' \\
  --receipt ci-receipts/errc-receipt.json \\
  --routing-report ci-receipts/routing.json \\
  --github-output "$GITHUB_OUTPUT\"""" .

gha:StepAdmissionUploadReceipt a gha:Step ;
    gha:inJob gha:JobAdmission ; gha:stepOrder 4 ;
    gha:stepName "Upload exact-head receipt" ;
    gha:condition "always()" ;
    gha:usesAction "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2" ;
    gha:withParam "name: ggen-ci-errc-${{ steps.identity.outputs.head }}" ;
    gha:withParam "path: ci-receipts/" ;
    gha:withParam "if-no-files-found: error" ;
    gha:withParam "retention-days: 14" .

gha:StepAdmissionEnforce a gha:Step ;
    gha:inJob gha:JobAdmission ; gha:stepOrder 5 ;
    gha:stepName "Enforce fast admission" ;
    gha:condition "always()" ;
    gha:runCommand "test '${{ steps.admit.outcome }}' = success" .

# --- deep job ---

gha:JobDeep a gha:Job ;
    gha:inWorkflow gha:WfCi ;
    gha:jobName "deep" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 60 ;
    gha:dependsOn gha:JobAdmission ;
    gha:condition "needs.admission.result == 'success'" ;
    gha:jobExtra """name: Deep / ${{ matrix.lane }}
strategy:
  fail-fast: false
  matrix: ${{ fromJSON(needs.admission.outputs.deep_matrix_json) }}""" ;
    gha:evidenceEmitted "per-lane evidence per scripts/ci/fast_admission.py's routing report" ;
    gha:failureClassification "production defect scoped to one evidence lane" .

gha:StepDeepCheckout a gha:Step ;
    gha:inJob gha:JobDeep ; gha:stepOrder 1 ;
    gha:usesAction "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683" ;
    gha:withParam "ref: ${{ needs.admission.outputs.head }}" ;
    gha:withParam "fetch-depth: 0" ;
    gha:withParam "persist-credentials: false" .

gha:StepDeepReclaimSpace a gha:Step ;
    gha:inJob gha:JobDeep ; gha:stepOrder 2 ;
    gha:stepName "Reclaim runner space" ;
    gha:condition "matrix.lane == 'integration_deep'" ;
    gha:runCommand "sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc || true" .

gha:StepDeepSetupRust a gha:Step ;
    gha:inJob gha:JobDeep ; gha:stepOrder 3 ;
    gha:stepName "Set up Rust evidence lane" ;
    gha:condition "contains(fromJSON('[\"core_deep\",\"integration_deep\",\"quality_deep\",\"security_deep\",\"lsp_deep\"]'), matrix.lane)" ;
    gha:usesAction "./.github/actions/setup-ggen-build" ;
    gha:withParam "components: ${{ matrix.lane == 'quality_deep' && 'rustfmt,clippy' || '' }}" ;
    gha:withParam "cache-key-suffix: errc-${{ matrix.lane }}" .

gha:StepDeepInstallCargoAudit a gha:Step ;
    gha:inJob gha:JobDeep ; gha:stepOrder 4 ;
    gha:stepName "Install security verifier" ;
    gha:condition "matrix.lane == 'security_deep'" ;
    gha:usesAction "taiki-e/install-action@6c6fd71fe4fb72c3697d269963d0e15df8adedad # v2.85.10" ;
    gha:withParam "tool: cargo-audit" .

gha:StepDeepExecute a gha:Step ;
    gha:inJob gha:JobDeep ; gha:stepOrder 5 ;
    gha:stepName "Execute owned evidence" ;
    gha:envVar "BASE: ${{ needs.admission.outputs.base }}" ;
    gha:envVar "LANE: ${{ matrix.lane }}" ;
    gha:runCommand """set -euo pipefail
case "$LANE" in
  fast_only) echo 'No deep evidence is applicable.' ;;
  ci_deep)
    python3 scripts/ci/test_errc_router.py
    python3 scripts/ci/test-g0-workflow-inventory.py
    ;;
  core_deep)
    cargo check --workspace --exclude ggen-lsp
    cargo build --workspace --exclude ggen-lsp
    cargo test --workspace --lib --exclude ggen-lsp
    cargo test --doc --workspace --exclude ggen-lsp
    ;;
  integration_deep) cargo test --workspace --exclude ggen-lsp ;;
  quality_deep)
    just fmt-check
    ./scripts/ci/guard-process-intelligence-boundary.sh
    cargo clippy --workspace --all-targets --exclude ggen-lsp || echo '::warning::clippy debt remains advisory'
    ;;
  security_deep) cargo audit || echo '::warning::pre-existing RUSTSEC debt remains advisory' ;;
  docs_deep) git diff --check "$BASE"...HEAD ;;
  lsp_deep) cargo check -p ggen-lsp --all-features ;;
  *) echo "REFUSED:UNKNOWN_EVIDENCE_LANE:$LANE" >&2; exit 2 ;;
esac""" .

# --- ci-status job ---

gha:JobCiStatusReal a gha:Job ;
    gha:inWorkflow gha:WfCi ;
    gha:jobName "ci-status" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 2 ;
    gha:condition "always()" ;
    gha:dependsOn gha:JobAdmission, gha:JobDeep ;
    gha:jobExtra "name: CI Status" ;
    gha:evidenceEmitted "aggregate required-check conclusion" ;
    gha:failureClassification "gate refusal: the ref is inadmissible; nothing downstream may treat it as green" .

gha:StepCiStatusAssert a gha:Step ;
    gha:inJob gha:JobCiStatusReal ; gha:stepOrder 1 ;
    gha:stepName "Assert applicable evidence succeeded" ;
    gha:envVar "ADMISSION: ${{ needs.admission.result }}" ;
    gha:envVar "DEEP: ${{ needs.deep.result }}" ;
    gha:runCommand """test "$ADMISSION" = success || { echo 'BUILD_BROKEN:FAST_GATE_FAILED' >&2; exit 1; }
case "$DEEP" in success|skipped) ;; *) echo 'BUILD_BROKEN:DEEP_LANE_FAILED' >&2; exit 1;; esac""" .

# --- reusable ggen sync manufacturing rail ---
#
# This workflow is intentionally modeled as semantic instance data and projected
# by github-actions-pack. The committed workflow bytes are not an editing
# authority; `.specify/ci-workflows.ttl` is. CONSTRUCT and DO are separated:
# `construct` has no repository write authority and emits an immutable artifact +
# attestation; `publish` is optional, receives only the manufactured patch, and
# is the sole job permitted to push.

gha:WfGgenSyncRun a gha:Workflow ;
    gha:fileName "ggen-sync-run.yml" ;
    gha:purpose "GGen Sync Run" ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:onBlock """workflow_call:
  inputs:
    ggen_version:
      description: Exact ggen release tag bundled by this workflow revision
      required: false
      type: string
      default: v26.8.27
    ggen_asset_sha256:
      description: SHA-256 of ggen-x86_64-unknown-linux-gnu.tar.gz
      required: false
      type: string
      default: ab442ced90a9836fd4eb07a5d61eb58293843cd515d864699fc0d0453444a035
    marketplace_sha:
      description: Exact seanchatmangpt/ggen-marketplace commit required for every pack
      required: false
      type: string
      default: 4c4232515b43d40cef8288c43eacfab2c31ab485
    working_directory:
      description: Consumer project directory containing ggen.toml
      required: false
      type: string
      default: .
    publish_changes:
      description: Allow the separate DO job to commit and push the exact manufactured patch
      required: false
      type: boolean
      default: false
    commit_message:
      description: Commit message used only by the optional DO job
      required: false
      type: string
      default: chore(ggen): sync generated artifacts
workflow_dispatch:
  inputs:
    ggen_version:
      description: Exact ggen release tag
      required: true
      type: string
      default: v26.8.27
    ggen_asset_sha256:
      description: SHA-256 of the Linux release asset
      required: true
      type: string
      default: ab442ced90a9836fd4eb07a5d61eb58293843cd515d864699fc0d0453444a035
    marketplace_sha:
      description: Exact ggen-marketplace commit
      required: true
      type: string
      default: 4c4232515b43d40cef8288c43eacfab2c31ab485
    working_directory:
      description: Consumer project directory
      required: true
      type: string
      default: .
    publish_changes:
      description: Commit and push the manufactured patch
      required: true
      type: boolean
      default: false
    commit_message:
      description: Commit message for the optional DO job
      required: true
      type: string
      default: chore(ggen): sync generated artifacts""" ;
    gha:concurrencyPolicy """group: ggen-sync-${{ github.repository }}-${{ github.ref }}
cancel-in-progress: false""" ;
    gha:permissionCeiling "contents: read" ;
    gha:noPushTriggerReason "reusable workflow_call target; workflow_dispatch is an explicit operator path" ;
    gha:performsOperation gha:OpReadSource ;
    gha:evidenceObligation "exact candidate SHA, ggen release asset SHA-256, marketplace commit SHA, sync outcome, generated patch digest, and GGen receipt are bound into an attested run receipt" ;
    gha:standingEffect "successful construct proves a real ggen sync run against exact GitHub identities; optional publish separately actuates the manufactured patch" .

gha:JobGgenSyncConstruct a gha:Job ;
    gha:inWorkflow gha:WfGgenSyncRun ;
    gha:jobName "construct" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 20 ;
    gha:jobPermissions """contents: read
id-token: write
attestations: write""" ;
    gha:evidenceEmitted "immutable ggen-sync artifact plus GitHub artifact attestation" ;
    gha:failureClassification "REFUSED or BUILD_BROKEN before any repository write authority exists" .

gha:StepGgenSyncCheckout a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 1 ;
    gha:stepName "Checkout exact candidate" ;
    gha:usesAction "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2" ;
    gha:withParam "ref: ${{ github.sha }}" ;
    gha:withParam "fetch-depth: 0" ;
    gha:withParam "persist-credentials: false" .

gha:StepGgenSyncAdmit a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 2 ;
    gha:stepName "Admit exact GitHub producer and marketplace identities" ;
    gha:envVar "GGEN_VERSION: ${{ inputs.ggen_version }}" ;
    gha:envVar "GGEN_ASSET_SHA256: ${{ inputs.ggen_asset_sha256 }}" ;
    gha:envVar "MARKETPLACE_SHA: ${{ inputs.marketplace_sha }}" ;
    gha:envVar "WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:runCommand """set -euo pipefail
[[ "$GGEN_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'REFUSED[INVALID_GGEN_RELEASE_TAG]' >&2; exit 2; }
[[ "$GGEN_ASSET_SHA256" =~ ^[0-9a-f]{64}$ ]] || { echo 'REFUSED[INVALID_GGEN_ASSET_SHA256]' >&2; exit 2; }
[[ "$MARKETPLACE_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo 'REFUSED[INVALID_MARKETPLACE_SHA]' >&2; exit 2; }
python3 - <<'PY'
import os, re, tomllib
from pathlib import Path
workspace = Path(os.environ['GITHUB_WORKSPACE']).resolve()
root = (workspace / os.environ['WORKING_DIRECTORY']).resolve()
if root != workspace and workspace not in root.parents:
    raise SystemExit('REFUSED[WORKING_DIRECTORY_ESCAPES_WORKSPACE]')
manifest = root / 'ggen.toml'
if not manifest.is_file():
    raise SystemExit('REFUSED[GGEN_MANIFEST_MISSING]')
doc = tomllib.loads(manifest.read_text())
packs = doc.get('packs')
if not isinstance(packs, dict) or not packs:
    raise SystemExit('REFUSED[MARKETPLACE_PACKS_REQUIRED]')
expected = os.environ['MARKETPLACE_SHA']
for name, ref in sorted(packs.items()):
    if not isinstance(ref, dict):
        raise SystemExit(f'REFUSED[PACK_REF_NOT_GIT]:{name}')
    git = str(ref.get('git', '')).removesuffix('.git')
    version = str(ref.get('version', ''))
    subdir = str(ref.get('subdir', ''))
    if git != 'https://github.com/seanchatmangpt/ggen-marketplace':
        raise SystemExit(f'REFUSED[NON_MARKETPLACE_PACK]:{name}:{git}')
    if version != expected:
        raise SystemExit(f'REFUSED[MARKETPLACE_SHA_DRIFT]:{name}:{version}:{expected}')
    if not re.fullmatch(r'packs/[^/]+', subdir):
        raise SystemExit(f'REFUSED[INVALID_MARKETPLACE_PACK_SUBDIR]:{name}:{subdir}')
print(f'ALIVE: admitted {len(packs)} marketplace pack(s) at {expected}')
PY""" .

gha:StepGgenSyncInstall a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 3 ;
    gha:stepName "Install checksum-pinned ggen GitHub Release asset" ;
    gha:envVar "GGEN_VERSION: ${{ inputs.ggen_version }}" ;
    gha:envVar "GGEN_ASSET_SHA256: ${{ inputs.ggen_asset_sha256 }}" ;
    gha:runCommand """set -euo pipefail
asset='ggen-x86_64-unknown-linux-gnu.tar.gz'
archive="$RUNNER_TEMP/$asset"
install="$RUNNER_TEMP/ggen-install"
curl --fail --location --retry 3 --retry-all-errors \
  "https://github.com/seanchatmangpt/ggen/releases/download/${GGEN_VERSION}/${asset}" \
  --output "$archive"
printf '%s  %s\n' "$GGEN_ASSET_SHA256" "$archive" | sha256sum --check --strict -
rm -rf "$install"
mkdir -p "$install/unpack"
tar -xzf "$archive" -C "$install/unpack"
bin="$(find "$install/unpack" -type f -name ggen -print -quit)"
[[ -n "$bin" ]] || { echo 'BUILD_BROKEN[GGEN_BINARY_MISSING_FROM_RELEASE_ASSET]' >&2; exit 1; }
install -m 0755 "$bin" "$install/ggen"
echo "GGEN_BIN=$install/ggen" >> "$GITHUB_ENV""" .

gha:StepGgenSyncRun a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 4 ;
    gha:stepName "Manufacture with ggen sync run" ;
    gha:stepId "sync" ;
    gha:continueOnError true ;
    gha:envVar "WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:runCommand """set -euo pipefail
cd "$WORKING_DIRECTORY"
"$GGEN_BIN" sync run 2>&1 | tee "$RUNNER_TEMP/ggen-sync.log""" .

gha:StepGgenSyncReceipt a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 5 ;
    gha:stepName "Bind sync consequence into replay receipt" ;
    gha:stepId "receipt" ;
    gha:condition "always()" ;
    gha:envVar "GGEN_VERSION: ${{ inputs.ggen_version }}" ;
    gha:envVar "GGEN_ASSET_SHA256: ${{ inputs.ggen_asset_sha256 }}" ;
    gha:envVar "MARKETPLACE_SHA: ${{ inputs.marketplace_sha }}" ;
    gha:envVar "WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:envVar "SYNC_OUTCOME: ${{ steps.sync.outcome }}" ;
    gha:runCommand """set -euo pipefail
mkdir -p .ggen-github
git diff --binary -- "$WORKING_DIRECTORY" > .ggen-github/ggen-sync.patch
cp "$RUNNER_TEMP/ggen-sync.log" .ggen-github/ggen-sync.log 2>/dev/null || true
python3 - <<'PY'
import hashlib, json, os, tomllib
from pathlib import Path
workspace = Path(os.environ['GITHUB_WORKSPACE']).resolve()
root = (workspace / os.environ['WORKING_DIRECTORY']).resolve()
out = workspace / '.ggen-github'
def sha256(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()
manifest = root / 'ggen.toml'
doc = tomllib.loads(manifest.read_text())
packs = []
for name, ref in sorted(doc.get('packs', {}).items()):
    packs.append({'name': name, 'git': ref.get('git'), 'version': ref.get('version'), 'subdir': ref.get('subdir')})
source_receipt = None
for candidate in (root / '.ggen-v2/receipt.json', root / '.ggen/receipts/latest.json'):
    if candidate.is_file():
        source_receipt = candidate
        target = out / 'ggen-receipt.json'
        target.write_bytes(candidate.read_bytes())
        break
patch = out / 'ggen-sync.patch'
changed = os.popen('git diff --name-only -- ' + repr(os.environ['WORKING_DIRECTORY'])).read().splitlines()
receipt = {
  'schema': 'https://ggen.dev/receipts/github-sync/v1',
  'repository': os.environ['GITHUB_REPOSITORY'],
  'candidate_sha': os.environ['GITHUB_SHA'],
  'workflow_ref': os.environ.get('GITHUB_WORKFLOW_REF'),
  'run_id': os.environ['GITHUB_RUN_ID'],
  'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],
  'ggen_release': os.environ['GGEN_VERSION'],
  'ggen_asset_sha256': os.environ['GGEN_ASSET_SHA256'],
  'marketplace_sha': os.environ['MARKETPLACE_SHA'],
  'working_directory': os.environ['WORKING_DIRECTORY'],
  'manifest_sha256': sha256(manifest),
  'packs': packs,
  'sync_command': 'ggen sync run',
  'sync_outcome': os.environ['SYNC_OUTCOME'],
  'patch_sha256': sha256(patch),
  'changed_paths': changed,
  'ggen_receipt_sha256': sha256(source_receipt) if source_receipt else None,
}
(out / 'ggen-sync-receipt.json').write_text(json.dumps(receipt, indent=2, sort_keys=True) + '\n')
print(json.dumps(receipt, sort_keys=True))
PY
sha256sum .ggen-github/ggen-sync.patch .ggen-github/ggen-sync-receipt.json > .ggen-github/SHA256SUMS""" .

gha:StepGgenSyncUpload a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 6 ;
    gha:stepName "Upload immutable sync evidence" ;
    gha:condition "always()" ;
    gha:usesAction "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4" ;
    gha:withParam "name: ggen-sync-${{ github.run_id }}-${{ github.run_attempt }}" ;
    gha:withParam "path: .ggen-github/" ;
    gha:withParam "if-no-files-found: error" ;
    gha:withParam "retention-days: 30" .

gha:StepGgenSyncAttest a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 7 ;
    gha:stepName "Attest manufactured receipt and patch" ;
    gha:condition "steps.sync.outcome == 'success'" ;
    gha:usesAction "actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3" ;
    gha:withParam "subject-path: |\n  .ggen-github/ggen-sync-receipt.json\n  .ggen-github/ggen-sync.patch" .

gha:StepGgenSyncEnforce a gha:Step ;
    gha:inJob gha:JobGgenSyncConstruct ; gha:stepOrder 8 ;
    gha:stepName "Enforce sync and generated diff validity" ;
    gha:condition "always()" ;
    gha:runCommand """test '${{ steps.sync.outcome }}' = success || { echo 'BUILD_BROKEN[GGEN_SYNC_RUN_FAILED]' >&2; exit 1; }
git diff --check""" .

gha:JobGgenSyncPublish a gha:Job ;
    gha:inWorkflow gha:WfGgenSyncRun ;
    gha:jobName "publish" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 10 ;
    gha:dependsOn gha:JobGgenSyncConstruct ;
    gha:condition "inputs.publish_changes && needs.construct.result == 'success'" ;
    gha:jobPermissions "contents: write" ;
    gha:evidenceEmitted "one Git commit containing only the exact patch manufactured by construct" ;
    gha:failureClassification "REFUSED when the caller lacks branch/write authority or branch protection rejects direct actuation" .

gha:StepGgenSyncPublishCheckout a gha:Step ;
    gha:inJob gha:JobGgenSyncPublish ; gha:stepOrder 1 ;
    gha:stepName "Checkout exact candidate with DO authority" ;
    gha:usesAction "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2" ;
    gha:withParam "ref: ${{ github.sha }}" ;
    gha:withParam "fetch-depth: 0" ;
    gha:withParam "persist-credentials: true" .

gha:StepGgenSyncPublishDownload a gha:Step ;
    gha:inJob gha:JobGgenSyncPublish ; gha:stepOrder 2 ;
    gha:stepName "Download exact manufactured consequence" ;
    gha:usesAction "actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5" ;
    gha:withParam "name: ggen-sync-${{ github.run_id }}-${{ github.run_attempt }}" ;
    gha:withParam "path: .ggen-github" .

gha:StepGgenSyncPublishActuate a gha:Step ;
    gha:inJob gha:JobGgenSyncPublish ; gha:stepOrder 3 ;
    gha:stepName "Commit and push exact manufactured patch" ;
    gha:envVar "COMMIT_MESSAGE: ${{ inputs.commit_message }}" ;
    gha:runCommand """set -euo pipefail
[[ "$(git rev-parse HEAD)" = "$GITHUB_SHA" ]] || { echo 'REFUSED[EXACT_HEAD_DRIFT]' >&2; exit 2; }
[[ "$GITHUB_REF_TYPE" = 'branch' ]] || { echo 'REFUSED[PUBLISH_REQUIRES_BRANCH_REF]' >&2; exit 2; }
if [[ ! -s .ggen-github/ggen-sync.patch ]]; then
  echo 'ALIVE:NO_GENERATED_CHANGES'
  exit 0
fi
git apply --index --whitespace=error-all .ggen-github/ggen-sync.patch
git diff --cached --check
if git diff --cached --quiet; then
  echo 'ALIVE:NO_GENERATED_CHANGES'
  exit 0
fi
git config user.name 'github-actions[bot]'
git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
git commit -m "$COMMIT_MESSAGE"
git push origin "HEAD:${GITHUB_REF_NAME}""" .
