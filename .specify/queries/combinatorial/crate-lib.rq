PREFIX cli:  <http://ggen.org/cli#>
PREFIX cmx:  <http://ggen.org/combinatorial#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?crate_name ?crate_iri
WHERE {
    ?c a cmx:Crate ;
       rdfs:label ?crate_name .

    BIND(?c AS ?crate_iri)
}
ORDER BY ?crate_name
