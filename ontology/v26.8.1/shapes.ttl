@prefix ggen: <https://ggen.chatmangpt.com/ontology/v26.8.1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Every subsystem is bound to at least one live source path.
ggen:SubsystemShape a sh:NodeShape ;
  sh:targetClass ggen:Subsystem ;
  sh:property [ sh:path ggen:sourcePath ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# Every declared capability owner must point to a canonical capability.
ggen:CapabilityOwnerShape a sh:NodeShape ;
  sh:targetSubjectsOf ggen:implementsCapability ;
  sh:property [ sh:path ggen:implementsCapability ; sh:minCount 1 ; sh:class ggen:Capability ] .

# Pipeline stages are explicit graph nodes with at least one dependency.
ggen:StageShape a sh:NodeShape ;
  sh:targetClass ggen:Stage ;
  sh:property [ sh:path ggen:dependsOn ; sh:minCount 1 ] .

# Gates are not prose: every gate names an executable command.
ggen:GateShape a sh:NodeShape ;
  sh:targetClass ggen:Gate ;
  sh:property [ sh:path ggen:verifierCommand ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# Releases have one version and one standing, plus one or more gates.
ggen:ReleaseShape a sh:NodeShape ;
  sh:targetClass ggen:Release ;
  sh:property [ sh:path ggen:version ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ggen:hasStanding ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ggen:Standing ] ;
  sh:property [ sh:path ggen:requiresGate ; sh:minCount 1 ; sh:class ggen:Gate ] .

# Standing is closed over the repository vocabulary.
ggen:StandingShape a sh:NodeShape ;
  sh:targetSubjectsOf ggen:hasStanding ;
  sh:property [
    sh:path ggen:hasStanding ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( ggen:UNKNOWN ggen:PARTIAL_ALIVE ggen:ALIVE ggen:BLOCKED ggen:BUILD_BROKEN ggen:UNSUPPORTED )
  ] .

# Legacy capability removal requires a disposition. hasStanding is deliberately NOT
# required here: standing is a DERIVED fact, computed later by the external subsystem
# verifier (tools/v26.8.1/subsystem_evidence_manifest.py + src/bin/subsystem_verifier.rs)
# from real evidence, never authored directly onto a LegacyCapability individual at
# extraction time. Requiring it here would force fabricating a value at data-authoring
# time, defeating the point of an external, independently-recomputed standing decision.
# When the verifier does assign a standing (as a generated projection, not hand-authored
# ontology data), it must still come from the closed Standing vocabulary if present.
ggen:LegacyCapabilityShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:property [ sh:path ggen:hasDisposition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ggen:LegacyDisposition ] ;
  sh:property [ sh:path ggen:hasStanding ; sh:maxCount 1 ; sh:class ggen:Standing ] .

# Sunset law is conjunctive and fail-closed.
ggen:SunsetDecisionShape a sh:NodeShape ;
  sh:targetClass ggen:SunsetDecision ;
  sh:property [ sh:path ggen:requiresZeroUnknownStanding ; sh:hasValue true ] ;
  sh:property [ sh:path ggen:requiresZeroUnknownDisposition ; sh:hasValue true ] ;
  sh:property [ sh:path ggen:requiresReplayCompatibility ; sh:hasValue true ] ;
  sh:property [ sh:path ggen:hasStanding ; sh:minCount 1 ; sh:maxCount 1 ] .

# --- G3 ontology-closure shapes (LegacyCapability disposition/subsystem constraints) ---
#
# The properties referenced below (ggen:equivalenceVerifier, ggen:migrationPath,
# ggen:rollbackPath, ggen:archivePath, ggen:owningSubsystem, ggen:refusalRationale) are
# consumed here against the fixed G3 schema; they are declared in ontology.ttl by a
# concurrent agent extending that file with the LegacyCapability class. sh:path does not
# require the predicate to carry an owl:*Property declaration to be validated, so these
# shapes are load-bearing independent of ontology.ttl's edit order. ggen:refusalCode
# already exists as an owl:DatatypeProperty in ontology.ttl (confirmed by reading the file
# before writing this shape); ggen:refusalRationale is assumed to be its companion
# free-text property, following the same "typed refusal" pairing as ggen:Refusal ---
# `ggen:refusalCode` for the stable code, `ggen:refusalRationale` for the rationale — and is
# flagged here as an assumption, not a verified fact, per the G3 task brief.

# Disposition is a closed enum: exactly one value from the six admitted dispositions.
ggen:LegacyDispositionEnumShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:property [
    sh:path ggen:hasDisposition ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( ggen:PRESERVED ggen:SUBSUMED ggen:REPLACED ggen:ARCHIVED ggen:REFUSED ggen:DISPOSITION_UNKNOWN )
  ] .

# PRESERVED/SUBSUMED capabilities must carry an equivalence verifier once dispositioned.
# DISPOSITION_UNKNOWN is exempt (interim state); this shape only fires once the concurrent
# agent's extraction has actually assigned PRESERVED or SUBSUMED.
ggen:LegacyEquivalenceVerifierShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ggen:hasDisposition ; sh:in ( ggen:PRESERVED ggen:SUBSUMED ) ] ] ]
    [ sh:property [ sh:path ggen:equivalenceVerifier ; sh:minCount 1 ] ]
  ) .

# REPLACED capabilities must carry both a migration path and a rollback path once
# dispositioned (not required while disposition is DISPOSITION_UNKNOWN or any other value).
ggen:LegacyReplacedPathsShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ggen:hasDisposition ; sh:hasValue ggen:REPLACED ] ] ]
    [
      sh:property [ sh:path ggen:migrationPath ; sh:minCount 1 ] ;
      sh:property [ sh:path ggen:rollbackPath ; sh:minCount 1 ]
    ]
  ) .

# ARCHIVED capabilities must carry an archive path once dispositioned.
ggen:LegacyArchivedPathShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ggen:hasDisposition ; sh:hasValue ggen:ARCHIVED ] ] ]
    [ sh:property [ sh:path ggen:archivePath ; sh:minCount 1 ] ]
  ) .

# REFUSED capabilities must carry a stable typed refusal code and a rationale.
ggen:LegacyRefusedShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:or (
    [ sh:not [ sh:property [ sh:path ggen:hasDisposition ; sh:hasValue ggen:REFUSED ] ] ]
    [
      sh:property [ sh:path ggen:refusalCode ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
      sh:property [ sh:path ggen:refusalRationale ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ]
    ]
  ) .

# owningSubsystem is a unique value from the closed 10-subsystem vocabulary that
# docs/v26.8.1/coverage-matrix.csv's subsystem rows also use.
ggen:LegacyOwningSubsystemShape a sh:NodeShape ;
  sh:targetClass ggen:LegacyCapability ;
  sh:property [
    sh:path ggen:owningSubsystem ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in ( "governance" "system" "engine" "graph" "projection" "evidence" "products" "verification" "economics" "legacy" )
  ] .
