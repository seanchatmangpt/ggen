    gsh:mustNotDo "Do not preserve a generated comment as a substitute for an executable projection and receipt path." ;
    gsh:acceptanceCriterion "A clean checkout regenerates the exact file from one named owner and verifies identical bytes." ;
    gsh:verificationCommand "python3 self-host/scripts/observe_exact_tree.py --check" ;
    gsh:status "OPEN" .

