{%- set contract = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?version ?schema ?authority ?generator ?producer ?receiver ?consumer ?title ?description WHERE { bec:ContractV1 bec:contractVersion ?version ; dcterms:identifier ?schema ; bec:authorityPath ?authority ; bec:generatorConfig ?generator ; bec:producerRepository ?producer ; bec:receiverRepository ?receiver ; bec:consumerRepository ?consumer ; dcterms:title ?title ; dcterms:description ?description . }') | first -%}
{%- set standings = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> SELECT ?order ?code WHERE { ?x a bec:Standing ; bec:order ?order ; bec:code ?code . } ORDER BY ?order') -%}
{%- set claims = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?description WHERE { ?x a bec:ClaimKind ; bec:order ?order ; bec:code ?code ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set evidence = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> SELECT ?order ?code ?maxStanding WHERE { ?x a bec:EvidenceKind ; bec:order ?order ; bec:code ?code ; bec:maxStanding ?maxStanding . } ORDER BY ?order') -%}
{%- set rules = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?description WHERE { ?x a bec:AdmissionRule ; bec:order ?order ; bec:code ?code ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set receipts = sparql(query='PREFIX bec: <https://ggen.dev/ontology/bcinr-evidence-contract#> SELECT ?code ?field WHERE { ?x a bec:ReceiptShape ; bec:code ?code ; bec:requiredField ?field . } ORDER BY ?code ?field') -%}
{"authority":{{ contract.authority | json_encode() }},"claims":[{%- for row in claims -%}{"code":{{ row.code | json_encode() }},"description":{{ row.description | json_encode() }},"order":{{ row.order }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"consumer_repository":{{ contract.consumer | json_encode() }},"description":{{ contract.description | json_encode() }},"evidence":[{%- for row in evidence -%}{"code":{{ row.code | json_encode() }},"max_standing":{{ row.maxStanding | json_encode() }},"order":{{ row.order }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"generator":{{ contract.generator | json_encode() }},"producer_repository":{{ contract.producer | json_encode() }},"receipt_fields":{%- set_global previous = "" -%}{ {% for row in receipts %}{% if row.code != previous %}{% if not loop.first %}],{% endif %}{{ row.code | json_encode() }}:[{% set_global previous = row.code %}{% else %},{% endif %}{{ row.field | json_encode() }}{% endfor %}]},"receiver_repository":{{ contract.receiver | json_encode() }},"rules":[{%- for row in rules -%}{"code":{{ row.code | json_encode() }},"description":{{ row.description | json_encode() }},"order":{{ row.order }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"schema":{{ contract.schema | json_encode() }},"standings":[{%- for row in standings -%}{"code":{{ row.code | json_encode() }},"order":{{ row.order }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"title":{{ contract.title | json_encode() }},"version":{{ contract.version | json_encode() }}}