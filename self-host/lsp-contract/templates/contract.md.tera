{%- set contract = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?version ?schema ?legacyRepository ?legacyBranch WHERE { lspc:ContractV1 lspc:contractVersion ?version ; lspc:schema ?schema ; lspc:legacyRepository ?legacyRepository ; lspc:legacyBranch ?legacyBranch . }') | first -%}
{%- set methods = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?method ?rustHandler ?family ?capability WHERE { ?x a lspc:Method ; lspc:order ?order ; lspc:method ?method ; lspc:rustHandler ?rustHandler ; lspc:family ?family ; lspc:capabilityKey ?capability . } ORDER BY ?order') -%}
{%- set surfaces = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?extension ?analyzer ?description WHERE { ?x a lspc:Surface ; lspc:order ?order ; lspc:extension ?extension ; lspc:analyzer ?analyzer ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set diagnostics = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?severity ?owner ?description WHERE { ?x a lspc:Diagnostic ; lspc:order ?order ; lspc:code ?code ; lspc:severity ?severity ; lspc:owner ?owner ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set invariants = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?description WHERE { ?x a lspc:Invariant ; lspc:order ?order ; lspc:code ?code ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set representations = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?id ?repository ?path ?role WHERE { ?x a lspc:Representation ; lspc:order ?order ; lspc:identifier ?id ; lspc:repository ?repository ; lspc:path ?path ; lspc:role ?role . } ORDER BY ?order') -%}
