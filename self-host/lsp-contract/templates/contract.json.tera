{%- set contract = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?version ?schema ?authority ?generator ?legacyRepository ?legacyBranch WHERE { lspc:ContractV1 lspc:contractVersion ?version ; lspc:schema ?schema ; lspc:authorityPath ?authority ; lspc:generatorConfig ?generator ; lspc:legacyRepository ?legacyRepository ; lspc:legacyBranch ?legacyBranch . }') | first -%}
{%- set diagnostics = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?severity ?description ?owner WHERE { ?x a lspc:Diagnostic ; lspc:order ?order ; lspc:code ?code ; lspc:severity ?severity ; dcterms:description ?description ; lspc:owner ?owner . } ORDER BY ?order') -%}
{%- set invariants = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?code ?description WHERE { ?x a lspc:Invariant ; lspc:order ?order ; lspc:code ?code ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set methods = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?method ?rustHandler ?legacyHandler ?kind ?family ?capability ?description WHERE { ?x a lspc:Method ; lspc:order ?order ; lspc:method ?method ; lspc:rustHandler ?rustHandler ; lspc:legacyHandler ?legacyHandler ; lspc:kind ?kind ; lspc:family ?family ; lspc:capabilityKey ?capability ; dcterms:description ?description . } ORDER BY ?order') -%}
{%- set representations = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?id ?repository ?path ?role ?state WHERE { ?x a lspc:Representation ; lspc:order ?order ; lspc:identifier ?id ; lspc:repository ?repository ; lspc:path ?path ; lspc:role ?role ; lspc:state ?state . } ORDER BY ?order') -%}
{%- set surfaces = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?order ?extension ?analyzer ?description WHERE { ?x a lspc:Surface ; lspc:order ?order ; lspc:extension ?extension ; lspc:analyzer ?analyzer ; dcterms:description ?description . } ORDER BY ?order') -%}
{"authority":{{ contract.authority | json_encode() }},"capabilities":{"callHierarchyProvider":true,"codeActionProvider":{"codeActionKinds":["quickfix"],"resolveProvider":false},"codeLensProvider":{"resolveProvider":false},"completionProvider":{"triggerCharacters":[":","@",".","{","[","\"","|"]},"definitionProvider":true,"documentFormattingProvider":true,"documentRangeFormattingProvider":true,"documentSymbolProvider":true,"foldingRangeProvider":true,"hoverProvider":true,"inlayHintProvider":true,"referencesProvider":true,"renameProvider":{"prepareProvider":true},"semanticTokensProvider":{"full":true,"legend":{"tokenModifiers":[],"tokenTypes":["namespace","class","property","variable","keyword","string","number","comment","function"]}},"textDocumentSync":{"change":1,"openClose":true,"save":{"includeText":false}},"typeHierarchyProvider":true,"workspaceSymbolProvider":true},"diagnostics":[{%- for row in diagnostics -%}{"code":{{ row.code | json_encode() }},"description":{{ row.description | json_encode() }},"order":{{ row.order }},"owner":{{ row.owner | json_encode() }},"severity":{{ row.severity | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"generator":{{ contract.generator | json_encode() }},"invariants":[{%- for row in invariants -%}{"code":{{ row.code | json_encode() }},"description":{{ row.description | json_encode() }},"order":{{ row.order }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"legacy":{"branch":{{ contract.legacyBranch | json_encode() }},"repository":{{ contract.legacyRepository | json_encode() }}},"methods":[{%- for row in methods -%}{"capability":{% if row.capability == "none" %}null{% else %}{{ row.capability | json_encode() }}{% endif %},"description":{{ row.description | json_encode() }},"family":{{ row.family | json_encode() }},"kind":{{ row.kind | json_encode() }},"legacy_handler":{{ row.legacyHandler | json_encode() }},"method":{{ row.method | json_encode() }},"order":{{ row.order }},"required_by":["legacy-lsp","rust-lsp"],"rust_handler":{{ row.rustHandler | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"representations":[{%- for row in representations -%}{"id":{{ row.id | json_encode() }},"order":{{ row.order }},"path":{{ row.path | json_encode() }},"repository":{{ row.repository | json_encode() }},"role":{{ row.role | json_encode() }},"state":{{ row.state | json_encode() }}}{% if not loop.last %},{% endif %}{%- endfor -%}],"schema":{{ contract.schema | json_encode() }},"surfaces":[{%- for row in surfaces -%}{"analyzer":{{ row.analyzer | json_encode() }},"description":{{ row.description | json_encode() }},"extension":{{ row.extension | json_encode() }},"order":{{ row.order }},"required_by":["legacy-lsp","rust-lsp"]}{% if not loop.last %},{% endif %}{%- endfor -%}],"version":{{ contract.version | json_encode() }}}
