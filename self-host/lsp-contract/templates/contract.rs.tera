{%- set contract = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?version ?schema WHERE { lspc:ContractV1 lspc:contractVersion ?version ; lspc:schema ?schema . }') | first -%}
{%- set methods = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?method WHERE { ?x a lspc:Method ; lspc:order ?order ; lspc:method ?method . } ORDER BY ?order') -%}
{%- set surfaces = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?extension WHERE { ?x a lspc:Surface ; lspc:order ?order ; lspc:extension ?extension . } ORDER BY ?order') -%}
{%- set diagnostics = sparql(query='PREFIX lspc: <https://ggen.dev/ontology/lsp-contract#> SELECT ?order ?code WHERE { ?x a lspc:Diagnostic ; lspc:order ?order ; lspc:code ?code . } ORDER BY ?order') -%}
//! GENERATED by ggen from `self-host/lsp-contract/ontology.ttl`.
//! Edit the ontology and rerun the self-host contract projection.

pub const CONTRACT_VERSION: &str = {{ contract.version | json_encode() }};
pub const CONTRACT_SCHEMA: &str = {{ contract.schema | json_encode() }};
pub const GGEN_SRC_004: &str = "GGEN-SRC-004";

pub const REQUIRED_METHODS: &[&str] = &[
{%- for row in methods %}
    {{ row.method | json_encode() }},
{%- endfor %}
];

pub const REQUIRED_SURFACES: &[&str] = &[
{%- for row in surfaces %}
    {{ row.extension | json_encode() }},
{%- endfor %}
];

pub const DECLARED_DIAGNOSTICS: &[&str] = &[
{%- for row in diagnostics %}
    {{ row.code | json_encode() }},
{%- endfor %}
];

#[must_use]
pub fn has_method(method: &str) -> bool {
    REQUIRED_METHODS.contains(&method)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn generated_contract_is_sorted_and_unique() {
        let mut methods = REQUIRED_METHODS.to_vec();
        methods.sort_unstable();
        methods.dedup();
        assert_eq!(methods.len(), REQUIRED_METHODS.len());
        assert_eq!(REQUIRED_METHODS.len(), 29);
        assert_eq!(REQUIRED_SURFACES.len(), 8);
        assert_eq!(DECLARED_DIAGNOSTICS.len(), 11);
    }
}
