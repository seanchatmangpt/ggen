@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lspc: <https://ggen.dev/ontology/lsp-contract#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lspc:ContractV1 a lspc:Contract ;
    lspc:authorityPath "self-host/lsp-contract/ontology.ttl" ;
    lspc:contractVersion "26.8.5" ;
    lspc:generatorConfig "self-host/lsp-contract/ggen.toml" ;
    lspc:legacyBranch "agent/ggen-legacy-lsp-max" ;
    lspc:legacyRepository "seanchatmangpt/ggen-legacy" ;
    lspc:schema "ggen.lsp.contract/1" .

lspc:Diagnostic001 a lspc:Diagnostic ; dcterms:description "Generated Rust module declaration has no generation-rule owner." ; lspc:code "GGEN-SRC-004" ; lspc:order 1 ; lspc:owner "both" ; lspc:severity "error" .
lspc:Diagnostic002 a lspc:Diagnostic ; dcterms:description "Template projection consumes a variable not selected by its paired query." ; lspc:code "GGEN-TPL-001" ; lspc:order 2 ; lspc:owner "rust" ; lspc:severity "error" .
lspc:Diagnostic003 a lspc:Diagnostic ; dcterms:description "Generation rule references an unavailable source." ; lspc:code "GGEN-RULE-001" ; lspc:order 3 ; lspc:owner "rust" ; lspc:severity "error" .
lspc:Diagnostic004 a lspc:Diagnostic ; dcterms:description "Generation output is not lawfully bound." ; lspc:code "GGEN-OUT-001" ; lspc:order 4 ; lspc:owner "rust" ; lspc:severity "error" .
lspc:Diagnostic005 a lspc:Diagnostic ; dcterms:description "Declared harness command is not represented by the project harness." ; lspc:code "GGEN-HARNESS-001" ; lspc:order 5 ; lspc:owner "rust" ; lspc:severity "error" .
lspc:Diagnostic006 a lspc:Diagnostic ; dcterms:description "TOML parse refusal." ; lspc:code "GGEN-TOML-001" ; lspc:order 6 ; lspc:owner "legacy" ; lspc:severity "error" .
lspc:Diagnostic007 a lspc:Diagnostic ; dcterms:description "ggen.toml lacks a required project declaration." ; lspc:code "GGEN-MANIFEST-001" ; lspc:order 7 ; lspc:owner "legacy" ; lspc:severity "error" .
lspc:Diagnostic008 a lspc:Diagnostic ; dcterms:description "Turtle prefix is used without declaration." ; lspc:code "GGEN-TTL-001" ; lspc:order 8 ; lspc:owner "legacy" ; lspc:severity "error" .
lspc:Diagnostic009 a lspc:Diagnostic ; dcterms:description "Tera delimiter is unclosed." ; lspc:code "GGEN-TERA-001" ; lspc:order 9 ; lspc:owner "legacy" ; lspc:severity "error" .
lspc:Diagnostic010 a lspc:Diagnostic ; dcterms:description "SPARQL delimiters or query form are invalid." ; lspc:code "GGEN-SPARQL-001" ; lspc:order 10 ; lspc:owner "legacy" ; lspc:severity "error" .
lspc:Diagnostic011 a lspc:Diagnostic ; dcterms:description "N-Triples or N-Quads statement is not terminated." ; lspc:code "GGEN-RDF-001" ; lspc:order 11 ; lspc:owner "legacy" ; lspc:severity "error" .

lspc:Invariant001 a lspc:Invariant ; dcterms:description "Protocol handlers construct results; they do not gain ambient shell, network, or filesystem-write authority." ; lspc:code "ZERO_UNRECEIPTED_ACTUATION" ; lspc:order 1 .
lspc:Invariant002 a lspc:Invariant ; dcterms:description "Standard output contains only Content-Length framed JSON-RPC." ; lspc:code "STDOUT_FRAME_PURITY" ; lspc:order 2 .
lspc:Invariant003 a lspc:Invariant ; dcterms:description "Open buffers are authoritative and didChange replaces complete content." ; lspc:code "FULL_SYNC_AUTHORITY" ; lspc:order 3 .
lspc:Invariant004 a lspc:Invariant ; dcterms:description "Diagnostic replacement removes only the refreshed document's registry entries." ; lspc:code "DOCUMENT_SCOPED_REGISTRY" ; lspc:order 4 .
lspc:Invariant005 a lspc:Invariant ; dcterms:description "The workspace gate opens only when no represented document has an active gating error." ; lspc:code "GLOBAL_GATE_CONJUNCTION" ; lspc:order 5 .
lspc:Invariant006 a lspc:Invariant ; dcterms:description "Generated Rust module declarations require generation-rule ownership." ; lspc:code "GENERATED_SOURCE_OWNERSHIP" ; lspc:order 6 .
lspc:Invariant007 a lspc:Invariant ; dcterms:description "A capability is advertised only when every required request has an implemented dispatch path." ; lspc:code "CAPABILITY_TRUTH" ; lspc:order 7 .
lspc:Invariant008 a lspc:Invariant ; dcterms:description "ggen-legacy independently executes the contract and may not crown the Rust implementation." ; lspc:code "LEGACY_INDEPENDENT_RECEIVER" ; lspc:order 8 .
lspc:Invariant009 a lspc:Invariant ; dcterms:description "Two ggen projections from the same ontology must be byte-identical outside receipt state." ; lspc:code "PROJECTION_FIXED_POINT" ; lspc:order 9 .
lspc:Invariant010 a lspc:Invariant ; dcterms:description "Unobserved or unavailable representation evidence remains UNKNOWN or BLOCKED." ; lspc:code "UNKNOWN_IS_NOT_ADMITTED" ; lspc:order 10 .

lspc:Method001 a lspc:Method ; dcterms:description "Initialize and negotiate capabilities." ; lspc:capabilityKey "none" ; lspc:family "lifecycle" ; lspc:kind "request" ; lspc:legacyHandler "initialize" ; lspc:method "initialize" ; lspc:order 1 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "initialize" .
