lspc:Surface004 a lspc:Surface ; dcterms:description "SPARQL query source" ; lspc:analyzer "sparql" ; lspc:extension "rq" ; lspc:order 4 ; lspc:requiredBy "legacy-lsp", "rust-lsp" .
