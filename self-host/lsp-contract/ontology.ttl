lspc:Method003 a lspc:Method ; dcterms:description "Clear session state and acknowledge shutdown." ; lspc:capabilityKey "none" ; lspc:family "lifecycle" ; lspc:kind "request" ; lspc:legacyHandler "shutdown" ; lspc:method "shutdown" ; lspc:order 3 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "shutdown" .
lspc:Method004 a lspc:Method ; dcterms:description "Terminate after shutdown." ; lspc:capabilityKey "none" ; lspc:family "lifecycle" ; lspc:kind "notification" ; lspc:legacyHandler "framework" ; lspc:method "exit" ; lspc:order 4 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "framework" .
lspc:Method005 a lspc:Method ; dcterms:description "Open a full document and publish diagnostics." ; lspc:capabilityKey "textDocumentSync" ; lspc:family "synchronization" ; lspc:kind "notification" ; lspc:legacyHandler "did_open" ; lspc:method "textDocument/didOpen" ; lspc:order 5 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "did_open" .
lspc:Method006 a lspc:Method ; dcterms:description "Replace full document content and republish diagnostics." ; lspc:capabilityKey "textDocumentSync" ; lspc:family "synchronization" ; lspc:kind "notification" ; lspc:legacyHandler "did_change" ; lspc:method "textDocument/didChange" ; lspc:order 6 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "did_change" .
lspc:Method007 a lspc:Method ; dcterms:description "Acknowledge save without ambient mutation." ; lspc:capabilityKey "textDocumentSync" ; lspc:family "synchronization" ; lspc:kind "notification" ; lspc:legacyHandler "did_save" ; lspc:method "textDocument/didSave" ; lspc:order 7 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "did_save" .
lspc:Method008 a lspc:Method ; dcterms:description "Release buffer authority and clear or recompute diagnostics." ; lspc:capabilityKey "textDocumentSync" ; lspc:family "synchronization" ; lspc:kind "notification" ; lspc:legacyHandler "did_close" ; lspc:method "textDocument/didClose" ; lspc:order 8 ; lspc:requiredBy "legacy-lsp", "rust-lsp" ; lspc:rustHandler "did_close" .
