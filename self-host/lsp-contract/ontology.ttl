lspc:Representation001 a lspc:Representation ; lspc:identifier "rust-lsp" ; lspc:order 1 ; lspc:path "crates/ggen-lsp" ; lspc:repository "seanchatmangpt/ggen" ; lspc:role "kernel-runtime" ; lspc:state "required" .
lspc:Representation002 a lspc:Representation ; lspc:identifier "rust-contract" ; lspc:order 2 ; lspc:path "crates/ggen-lsp/src/generated_contract.rs" ; lspc:repository "seanchatmangpt/ggen" ; lspc:role "generated-runtime-contract" ; lspc:state "required" .
lspc:Representation003 a lspc:Representation ; lspc:identifier "contract-json" ; lspc:order 3 ; lspc:path "crates/ggen-lsp/generated/lsp-contract.json" ; lspc:repository "seanchatmangpt/ggen" ; lspc:role "generated-portable-contract" ; lspc:state "required" .
lspc:Representation004 a lspc:Representation ; lspc:identifier "contract-doc" ; lspc:order 4 ; lspc:path "docs/generated/LSP_CONTRACT.md" ; lspc:repository "seanchatmangpt/ggen" ; lspc:role "generated-human-projection" ; lspc:state "required" .
