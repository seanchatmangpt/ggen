{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.dev/schema/r47-consumer-receipt.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","standing","consumer_repo","candidate_sha","admitted_target_base","producer_repo","producer_sha","producer_fixture","producer_fixture_sha256","authority","consequential_do","replay"],
  "properties": {
    "schema_version": {"const": 1},
    "standing": {"const": "ALIVE"},
    "consumer_repo": {"const": "seanchatmangpt/ggen"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "admitted_target_base": {"const": "f4e1bce1efdcdc4f6c2531be9f66070950f7ec93"},
    "producer_repo": {"const": "seanchatmangpt/ggen-marketplace"},
    "producer_sha": {"const": "b942ff54f7d00e376dd2f28beb930390f4feb97b"},
    "producer_fixture": {"type": "string"},
    "producer_fixture_sha256": {"type": ["string","null"]},
    "authority": {"const": "VERIFY_ONLY"},
    "consequential_do": {"const": false},
    "replay": {"type": "string", "minLength": 1}
  }
}
