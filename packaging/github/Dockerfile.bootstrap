# syntax=docker/dockerfile:1
FROM scratch
ARG TARGETARCH
COPY bin/${TARGETARCH}/ggen /ggen/bin/ggen
COPY ggen-package-manifest.json /ggen/ggen-package-manifest.json
COPY bootstrap.sh /ggen/bootstrap.sh
LABEL io.ggen.package.kind="scheduled-task-bootstrap-payload"
LABEL io.ggen.package.layout="/ggen"
CMD ["/ggen/bootstrap.sh"]
