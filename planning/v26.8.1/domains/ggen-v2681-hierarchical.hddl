(define (domain ggen-v2681-hierarchical)
  (:requirements :typing :negative-preconditions :hierarchy :method-preconditions)
  (:types subsystem evidence verifier receipt release capability legacy)
  (:predicates
    (declared ?x - object) (observed ?x - object) (admitted ?x - object)
    (verified ?x - object) (receipted ?x - object) (replayed ?x - object)
    (falsified-negative ?x - object) (mapped ?c - capability)
    (legacy-safe ?l - legacy) (release-admitted ?r - release))
  (:task achieve-v2681 (?r - release))
  (:task close-subsystem (?s - subsystem))
  (:task prove-sunset (?l - legacy))
  (:method m-achieve-v2681
    :parameters (?r - release ?l - legacy)
    :task (achieve-v2681 ?r)
    :precondition (declared ?r)
    :ordered-subtasks (and
      (inventory-all-subsystems)
      (close-all-subsystems)
      (prove-sunset ?l)
      (promote-release ?r)))
  (:method m-close-subsystem
    :parameters (?s - subsystem)
    :task (close-subsystem ?s)
    :precondition (declared ?s)
    :ordered-subtasks (and
      (observe-subsystem ?s)
      (verify-positive ?s)
      (verify-negative ?s)
      (replay-subsystem ?s)
      (bind-receipt ?s)
      (admit-subsystem ?s)))
  (:method m-prove-sunset
    :parameters (?l - legacy)
    :task (prove-sunset ?l)
    :precondition (declared ?l)
    :ordered-subtasks (and
      (inventory-legacy ?l)
      (map-all-capabilities ?l)
      (run-parity-witnesses ?l)
      (run-loss-falsifiers ?l)
      (admit-legacy-safe ?l)))
  (:action inventory-all-subsystems :parameters () :precondition () :effect ())
  (:action close-all-subsystems :parameters () :precondition () :effect ())
  (:action observe-subsystem :parameters (?s - subsystem) :precondition (declared ?s) :effect (observed ?s))
  (:action verify-positive :parameters (?s - subsystem) :precondition (observed ?s) :effect (verified ?s))
  (:action verify-negative :parameters (?s - subsystem) :precondition (verified ?s) :effect (falsified-negative ?s))
  (:action replay-subsystem :parameters (?s - subsystem) :precondition (verified ?s) :effect (replayed ?s))
  (:action bind-receipt :parameters (?s - subsystem) :precondition (and (verified ?s) (replayed ?s)) :effect (receipted ?s))
  (:action admit-subsystem :parameters (?s - subsystem) :precondition (and (verified ?s) (falsified-negative ?s) (replayed ?s) (receipted ?s)) :effect (admitted ?s))
  (:action inventory-legacy :parameters (?l - legacy) :precondition (declared ?l) :effect (observed ?l))
  (:action map-all-capabilities :parameters (?l - legacy) :precondition (observed ?l) :effect ())
  (:action run-parity-witnesses :parameters (?l - legacy) :precondition (observed ?l) :effect (verified ?l))
  (:action run-loss-falsifiers :parameters (?l - legacy) :precondition (verified ?l) :effect (falsified-negative ?l))
  (:action admit-legacy-safe :parameters (?l - legacy) :precondition (and (verified ?l) (falsified-negative ?l)) :effect (legacy-safe ?l))
  (:action promote-release :parameters (?r - release) :precondition (forall (?s - subsystem) (admitted ?s)) :effect (release-admitted ?r))
)
